        replacement_chunks {
          target_content: "            <span className=\"text-[11px] text-slate-500 dark:text-slate-400\">\n              {activeBoardMeta.subtitle}\n            </span>\n          </div>"
          replacement_content: "            <span className=\"text-[11px] text-slate-500 dark:text-slate-400\">\n              {activeBoardMeta.subtitle}\n            </span>\n          </div>\n\n          {/* Dynamic Pareto 80/20 Status Strip + Recalculate Action */}\n          {paretoProfile && (\n            <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-2.5 rounded-xl border border-slate-200 bg-white px-3.5 py-2.5 dark:border-slate-800 dark:bg-slate-900\">\n              <div className=\"flex items-start sm:items-center gap-2 text-xs min-w-0\">\n                <BarChart3\n                  className={cn(\n                    \'h-4 w-4 shrink-0 mt-0.5 sm:mt-0\',\n                    paretoProfile.analysis.hasEnoughData\n                      ? \'text-emerald-600 dark:text-emerald-400\'\n                      : \'text-sky-600 dark:text-sky-400\'\n                  )}\n                />\n                <div className=\"min-w-0\">\n                  {paretoProfile.analysis.hasEnoughData ? (\n                    <p className=\"text-slate-700 dark:text-slate-200\">\n                      <strong className=\"font-semibold text-emerald-700 dark:text-emerald-400\">\n                        Pareto 80/20 ativo\n                      </strong>{\' \'}\n                      <span className=\"text-slate-500 dark:text-slate-400 tabular-nums\">\n                        \302\267 {paretoProfile.analysis.totalQuestions} quest\303\265es no banco (N\303\272cleo \342\211\24480% = +3%, 80\342\200\22395% = 0%, &gt;95% = -3%)\n                      </span>\n                    </p>\n                  ) : (\n                    <p className=\"text-slate-700 dark:text-slate-200\">\n                      <strong className=\"font-semibold text-sky-700 dark:text-sky-400\">\n                        Fallback na matriz padr\303\243o\n                      </strong>{\' \'}\n                      <span className=\"text-slate-500 dark:text-slate-400 tabular-nums\">\n                        \302\267 {paretoProfile.analysis.totalQuestions}/{PARETO_MIN_QUESTIONS} quest\303\265es de{\' \'}\n                        {EXAM_BOARD_LABELS[activeBoard]} no banco (curva Pareto estimada)\n                      </span>\n                    </p>\n                  )}\n                </div>\n              </div>\n\n              <Button\n                type=\"button\"\n                variant=\"outline\"\n                size=\"sm\"\n                onClick={handleRecalculatePareto}\n                className=\"shrink-0\"\n              >\n                <BarChart3 className=\"h-3.5 w-3.5\" />\n                <span>Recalcular pelo Pareto do Banco</span>\n              </Button>\n            </div>\n          )}"
          start_line: 284
