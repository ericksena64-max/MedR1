              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const hrs = Math.max(1, Math.round(days * 24));"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
