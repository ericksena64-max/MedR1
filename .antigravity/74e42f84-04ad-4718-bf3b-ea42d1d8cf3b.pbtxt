  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState } from \'react\';\nimport {\n  Bookmark,\n  XCircle,\n  ArrowRight,\n  CheckCircle2,\n  BookOpenCheck,\n  Layers,\n  Check,\n  Sparkles,\n} from \'lucide-react\';\nimport type { MedicalQuestion, UserAnswerRecord } from \'../../types/medical\';\nimport { Button } from \'../ui/Button\';\nimport { Switch } from \'../ui/Switch\';\n\ninterface ErrorNotebookViewProps {\n  questions: MedicalQuestion[];\n  answers: Record<string, UserAnswerRecord>;\n  bookmarks: string[];\n  flashcardQuestionIds: Set<string>;\n  autoCreateFlashcardsOnError: boolean;\n  onToggleAutoCreate: (enabled: boolean) => void;\n  onGenerateFlashcards: (questions: MedicalQuestion[]) => number;\n  onCreateSingleFlashcard: (question: MedicalQuestion) => void;\n  onToggleBookmark: (id: string) => void;\n  onOpenQuestion: (questionId: string) => void;\n  onLaunchErrorReview: () => void;\n  onGoToFlashcards: () => void;\n}\n\nexport function ErrorNotebookView({\n  questions,\n  answers,\n  bookmarks,\n  flashcardQuestionIds,\n  autoCreateFlashcardsOnError,\n  onToggleAutoCreate,\n  onGenerateFlashcards,\n  onCreateSingleFlashcard,\n  onToggleBookmark,\n  onOpenQuestion,\n  onLaunchErrorReview,\n  onGoToFlashcards,\n}: ErrorNotebookViewProps) {\n  const [generatedFeedback, setGeneratedFeedback] = useState<number | null>(null);\n\n  const pendingForFlashcards = questions.filter(\n    (q) => !flashcardQuestionIds.has(q.id)\n  );\n\n  const handleBulkGenerate = () => {\n    const count = onGenerateFlashcards(pendingForFlashcards);\n    if (count > 0) {\n      setGeneratedFeedback(count);\n      window.setTimeout(() => setGeneratedFeedback(null), 4000);\n    }\n  };\n\n  return (\n    <div className=\"space-y-5\">\n      <div className=\"rounded-xl border border-slate-200 bg-white p-5 sm:p-6 dark:border-slate-800 dark:bg-slate-900 space-y-4\">\n        <div className=\"flex flex-col lg:flex-row lg:items-center justify-between gap-4\">\n          <div>\n            <h2 className=\"font-display text-lg font-bold text-slate-900 dark:text-white\">\n              Caderno de Erros e Quest\303\265es Favoritadas\n            </h2>\n            <p className=\"mt-1 text-sm text-slate-500 dark:text-slate-400\">\n              Todas as quest\303\265es que voc\303\252 errou ou salvou ficam reunidas aqui e podem virar flashcards SRS em um clique.\n            </p>\n          </div>\n\n          <div className=\"flex flex-wrap items-center gap-2.5 shrink-0\">\n            <Button\n              variant=\"outline\"\n              size=\"md\"\n              disabled={pendingForFlashcards.length === 0}\n              onClick={handleBulkGenerate}\n            >\n              <Layers className=\"h-4 w-4\" />\n              <span>\n                {pendingForFlashcards.length > 0\n                  ? `Gerar Flashcards (${pendingForFlashcards.length})`\n                  : \'Todos j\303\241 s\303\243o Flashcards\'}\n              </span>\n            </Button>\n\n            <Button\n              variant=\"primary\"\n              size=\"md\"\n              disabled={questions.length === 0}\n              onClick={onLaunchErrorReview}\n            >\n              <BookOpenCheck className=\"h-4 w-4\" />\n              <span>Revisar lista ({questions.length})</span>\n            </Button>\n          </div>\n        </div>\n\n        {/* Automation setting + feedback */}\n        <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3 pt-4 border-t border-slate-100 dark:border-slate-800\">\n          <div className=\"flex items-center gap-3\">\n            <Switch\n              id=\"auto-srs-on-error\"\n              checked={autoCreateFlashcardsOnError}\n              onCheckedChange={onToggleAutoCreate}\n              label=\"Gerar flashcard automaticamente sempre que eu errar uma quest\303\243o\"\n            />\n          </div>\n\n          {generatedFeedback !== null && (\n            <div className=\"flex items-center gap-2 text-xs font-semibold text-emerald-700 dark:text-emerald-400\">\n              <CheckCircle2 className=\"h-4 w-4\" />\n              <span>\n                {generatedFeedback}{\' \'}\n                {generatedFeedback === 1\n                  ? \'flashcard criado\'\n                  : \'flashcards criados\'}{\' \'}\n                para revis\303\243o hoje.\n              </span>\n              <button\n                type=\"button\"\n                onClick={onGoToFlashcards}\n                className=\"underline hover:text-emerald-800 dark:hover:text-emerald-300 cursor-pointer\"\n              >\n                Abrir Flashcards\n              </button>\n            </div>\n          )}\n        </div>\n      </div>\n\n      {questions.length === 0 ? (\n        <div className=\"rounded-xl border border-slate-200 bg-white p-12 text-center dark:border-slate-800 dark:bg-slate-900\">\n          <p className=\"font-display text-base font-semibold text-slate-900 dark:text-white\">\n            Seu Caderno de Erros est\303\241 limpo\n          </p>\n          <p className=\"mt-1.5 text-sm text-slate-500 dark:text-slate-400 max-w-md mx-auto\">\n            Salve quest\303\265es dif\303\255ceis durante o estudo ou responda quest\303\265es no banco para montar automaticamente sua fila de revis\303\243o e flashcards SRS.\n          </p>\n        </div>\n      ) : (\n        <div className=\"divide-y divide-slate-200 rounded-xl border border-slate-200 bg-white dark:divide-slate-800 dark:border-slate-800 dark:bg-slate-900 overflow-hidden\">\n          {questions.map((q) => {\n            const ans = answers[q.id];\n            const isBookmarked = bookmarks.includes(q.id);\n            const wasMissed = ans && !ans.isCorrect;\n            const hasCard = flashcardQuestionIds.has(q.id);\n\n            return (\n              <div\n                key={q.id}\n                className=\"flex flex-col md:flex-row md:items-center justify-between gap-4 p-5 hover:bg-slate-50/70 dark:hover:bg-slate-800/40 transition-colors\"\n              >\n                <div className=\"min-w-0 space-y-1.5 flex-1\">\n                  <div className=\"flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-slate-500 dark:text-slate-400\">\n                    <span className=\"font-mono font-semibold text-slate-800 dark:text-slate-200\">\n                      {q.instituicao} {q.ano}\n                    </span>\n                    <span aria-hidden=\"true\">\302\267</span>\n                    <span>{q.grandeArea}</span>\n                    <span aria-hidden=\"true\">/</span>\n                    <span>{q.tema}</span>\n                    <span aria-hidden=\"true\">\302\267</span>\n                    {wasMissed ? (\n                      <span className=\"inline-flex items-center gap-1 font-medium text-red-700 dark:text-red-400\">\n                        <XCircle className=\"h-3.5 w-3.5\" />\n                        <span>Errada (marcou {ans.selectedLetter})</span>\n                      </span>\n                    ) : ans?.isCorrect ? (\n                      <span className=\"inline-flex items-center gap-1 font-medium text-emerald-700 dark:text-emerald-400\">\n                        <CheckCircle2 className=\"h-3.5 w-3.5\" />\n                        <span>Acertada \302\267 Favoritada</span>\n                      </span>\n                    ) : (\n                      <span className=\"font-medium text-sky-700 dark:text-sky-400\">\n                        Salva para revis\303\243o\n                      </span>\n                    )}\n                  </div>\n\n                  <p className=\"text-sm font-medium text-slate-900 dark:text-slate-100 line-clamp-2 max-w-[75ch]\">\n                    {q.enunciado}\n                  </p>\n                  <p className=\"text-xs text-slate-500 dark:text-slate-400 line-clamp-1\">\n                    P\303\251rola: {q.perolaClinica}\n                  </p>\n                </div>\n\n                <div className=\"flex flex-wrap items-center gap-2 shrink-0\">\n                  {hasCard ? (\n                    <Button\n                      variant=\"ghost\"\n                      size=\"sm\"\n                      onClick={onGoToFlashcards}\n                      className=\"text-emerald-700 dark:text-emerald-400\"\n                    >\n                      <Check className=\"h-3.5 w-3.5\" />\n                      <span>No baralho SRS</span>\n                    </Button>\n                  ) : (\n                    <Button\n                      variant=\"secondary\"\n                      size=\"sm\"\n                      onClick={() => onCreateSingleFlashcard(q)}\n                    >\n                      <Sparkles className=\"h-3.5 w-3.5\" />\n                      <span>Criar Flashcard</span>\n                    </Button>\n                  )}\n\n                  {isBookmarked && (\n                    <Button\n                      variant=\"ghost\"\n                      size=\"sm\"\n                      onClick={() => onToggleBookmark(q.id)}\n                      title=\"Remover dos favoritos\"\n                    >\n                      <Bookmark className=\"h-4 w-4 fill-sky-600 text-sky-600 dark:fill-sky-400 dark:text-sky-400\" />\n                    </Button>\n                  )}\n\n                  <Button\n                    variant=\"outline\"\n                    size=\"sm\"\n                    onClick={() => onOpenQuestion(q.id)}\n                  >\n                    <span>Abrir quest\303\243o</span>\n                    <ArrowRight className=\"h-3.5 w-3.5\" />\n                  </Button>\n                </div>\n              </div>\n            );\n          })}\n        </div>\n      )}\n    </div>\n  );\n}\n"
        path {
          absolute_uri: "file:///src/components/notebook/ErrorNotebookView.tsx"
        }
        overwrite: true
      }
    }
