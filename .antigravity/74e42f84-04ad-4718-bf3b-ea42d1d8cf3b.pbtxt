            }
            lines {
              text: "    grandeArea: \'Medicina Preventiva e Social\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    tema: \'Vigil\303\242ncia em Sa\303\272de\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    subtema: \'Doen\303\247as de Notifica\303\247\303\243o Compuls\303\263ria Imediata (SINAN)\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    banca: \'AREMG\',"
