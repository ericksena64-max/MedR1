            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "/**"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " * Computes all 4 FSRS scheduling outcomes simultaneously so monotonicity"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " * (Again < Hard <= Good < Easy) is strictly guaranteed on every card state."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
