          replacement_content: "export function FlashcardsView({\n  flashcards,\n  reviewsTodayStats,\n  retentionMode,\n  onChangeRetentionMode,\n  targetBoard,\n  onChangeTargetBoard,\n  userAccuracyByTopic,\n  communityMedianByTopic,\n  onReviewCard,\n  onCreateCustomCard,\n  onDeleteCard,\n  onOpenOriginalQuestion,\n  onGoToQuestions,\n}: FlashcardsViewProps) {"
          start_line: 125
          end_line: 136
        }
        replacement_chunks {
          target_content: "  const fsrsOutcomes = useMemo(\n    () => (activeCard ? computeAllFsrsOutcomes(activeCard, targetRetention) : null),\n    [activeCard, targetRetention]\n  );\n\n  const activeRetrievabilityPct = activeCard\n    ? getCardCurrentRetrievabilityPct(activeCard)\n    : null;\n\n  const hoveredOutcome =\n    hoveredRating && fsrsOutcomes ? fsrsOutcomes[hoveredRating] : null;\n  const hoveredConfig = hoveredRating\n    ? RATING_CONFIG.find((c) => c.rating === hoveredRating) ?? null\n    : null;"
          replacement_content: "  const activeCalibration = useMemo(\n    () =>\n      activeCard\n        ? resolveCardRetention(\n            activeCard,\n            retentionMode,\n            targetBoard,\n            userAccuracyByTopic,\n            communityMedianByTopic\n          )\n        : null,\n    [\n      activeCard,\n      retentionMode,\n      targetBoard,\n      userAccuracyByTopic,\n      communityMedianByTopic,\n    ]\n  );\n\n  const fsrsOutcomes = useMemo(\n    () =>\n      activeCard && activeCalibration\n        ? computeAllFsrsOutcomes(activeCard, activeCalibration.retention)\n        : null,\n    [activeCard, activeCalibration]\n  );\n\n  const activeRetrievabilityPct = activeCard\n    ? getCardCurrentRetrievabilityPct(activeCard)\n    : null;\n\n  const hoveredOutcome =\n    hoveredRating && fsrsOutcomes ? fsrsOutcomes[hoveredRating] : null;\n  const hoveredConfig = hoveredRating\n    ? RATING_CONFIG.find((c) => c.rating === hoveredRating) ?? null\n    : null;"
          start_line: 276
          end_line: 291
        }
        replacement_chunks {
          target_content: "            {/* Discrete FSRS Target Retention Control */}\n            <div className=\"flex items-center gap-2\">\n              <span className=\"text-xs text-slate-500 dark:text-slate-400 whitespace-nowrap\">\n                Reten\303\247\303\243o FSRS:\n              </span>\n              <div\n                role=\"group\"\n                aria-label=\"Reten\303\247\303\243o desejada do algoritmo FSRS\"\n                className=\"inline-flex rounded-lg border border-slate-200 bg-slate-50 p-0.5 dark:border-slate-700 dark:bg-slate-950/60\"\n              >\n                {RETENTION_OPTIONS.map((opt) => {\n                  const active = targetRetention === opt.value;\n                  return (\n                    <button\n                      key={opt.value}\n                      type=\"button\"\n                      onClick={() => onChangeTargetRetention(opt.value)}\n                      aria-pressed={active}\n                      className={cn(\n                        \'rounded-md px-2 py-1 font-mono text-[11px] font-semibold tabular-nums transition-colors cursor-pointer whitespace-nowrap\',\n                        active\n                          ? \'bg-white text-sky-700 shadow-sm dark:bg-slate-800 dark:text-sky-300\'\n                          : \'text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-200\'\n                      )}\n                    >\n                      {opt.label}\n                    </button>\n                  );\n                })}\n              </div>\n            </div>\n          </div>"
          replacement_content: "            {/* Banca-Alvo Selector (UEPA, ENARE, Geral) */}\n            <div className=\"flex items-center gap-2\">\n              <span className=\"text-xs text-slate-500 dark:text-slate-400 whitespace-nowrap\">\n                Banca-Alvo:\n              </span>\n              <div\n                role=\"group\"\n                aria-label=\"Selecionar banca-alvo para calibra\303\247\303\243o FSRS\"\n                className=\"inline-flex rounded-lg border border-slate-200 bg-slate-50 p-0.5 dark:border-slate-700 dark:bg-slate-950/60\"\n              >\n                {BOARD_OPTIONS.map((opt) => {\n                  const active = targetBoard === opt.value;\n                  return (\n                    <button\n                      key={opt.value}\n                      type=\"button\"\n                      onClick={() => onChangeTargetBoard(opt.value)}\n                      aria-pressed={active}\n                      className={cn(\n                        \'rounded-md px-2.5 py-1 text-[11px] font-semibold transition-colors cursor-pointer whitespace-nowrap\',\n                        active\n                          ? retentionMode === \'dinamica\'\n                            ? \'bg-white text-sky-700 shadow-sm dark:bg-slate-800 dark:text-sky-300\'\n                            : \'bg-white text-slate-800 shadow-sm dark:bg-slate-800 dark:text-slate-200\'\n                          : \'text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-200\'\n                      )}\n                    >\n                      {opt.label}\n                    </button>\n                  );\n                })}\n              </div>\n            </div>\n\n            {/* FSRS Target Retention Control (Dynamic + Fixed 85/90/95%) */}\n            <div className=\"flex items-center gap-2\">\n              <span className=\"text-xs text-slate-500 dark:text-slate-400 whitespace-nowrap\">\n                Reten\303\247\303\243o FSRS:\n              </span>\n              <div\n                role=\"group\"\n                aria-label=\"Modo de reten\303\247\303\243o desejada do algoritmo FSRS\"\n                className=\"inline-flex rounded-lg border border-slate-200 bg-slate-50 p-0.5 dark:border-slate-700 dark:bg-slate-950/60\"\n              >\n                {RETENTION_OPTIONS.map((opt) => {\n                  const active = retentionMode === opt.value;\n                  const isDynamicOpt = opt.value === \'dinamica\';\n                  return (\n                    <button\n                      key={String(opt.value)}\n                      type=\"button\"\n                      onClick={() => onChangeRetentionMode(opt.value)}\n                      aria-pressed={active}\n                      className={cn(\n                        \'inline-flex items-center gap-1 rounded-md px-2 py-1 text-[11px] font-semibold tabular-nums transition-colors cursor-pointer whitespace-nowrap\',\n                        !isDynamicOpt && \'font-mono\',\n                        active\n                          ? \'bg-white text-sky-700 shadow-sm dark:bg-slate-800 dark:text-sky-300\'\n                          : \'text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-200\'\n                      )}\n                    >\n                      {isDynamicOpt && <SlidersHorizontal className=\"h-3 w-3\" />}\n                      <span>{opt.label}</span>\n                    </button>\n                  );\n                })}\n              </div>\n            </div>\n          </div>"
