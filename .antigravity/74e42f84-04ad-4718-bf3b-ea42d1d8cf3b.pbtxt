          replacement_content: "import type {\n  AlternativeLetter,\n  Flashcard,\n  GrandeAreaId,\n  LiveRankingUser,\n  MedicalQuestion,\n  QuestionFilters,\n  SrsRating,\n  StudyMode,\n  UserAnswerRecord,\n  UserProfile,\n} from \'../types/medical\';\nimport { MEDICAL_QUESTIONS } from \'../data/questions\';\nimport { INITIAL_FLASHCARDS } from \'../data/flashcardsSeed\';\nimport {\n  HISTORICAL_AREA_PERFORMANCE,\n  HISTORICAL_TOPIC_PERFORMANCE,\n  TEMPORAL_EVOLUTION_MONTHLY,\n  TEMPORAL_EVOLUTION_WEEKLY,\n} from \'../data/analyticsSeed\';\nimport { DEFAULT_USER_PROFILE, INITIAL_LIVE_PEERS } from \'../data/rankingSeed\';\nimport { GRANDES_AREAS, MEDICAL_CODENAMES } from \'../data/taxonomy\';\nimport {\n  computeDifficulty,\n  computePerformanceStatus,\n  computeWeightedScore,\n} from \'../lib/utils\';\nimport {\n  buildFlashcardFromQuestion,\n  computeNextSrsState,\n  isCardDueToday,\n} from \'../lib/srs\';\n\nconst STORAGE_KEY_ANSWERS = \'medr1_answers_v1\';\nconst STORAGE_KEY_BOOKMARKS = \'medr1_bookmarks_v1\';\nconst STORAGE_KEY_PROFILE = \'medr1_profile_v1\';\nconst STORAGE_KEY_THEME = \'medr1_theme_v1\';\nconst STORAGE_KEY_FLASHCARDS = \'medr1_flashcards_v1\';\nconst STORAGE_KEY_AUTO_SRS = \'medr1_auto_srs_v1\';\nconst STORAGE_KEY_REVIEWS_TODAY = \'medr1_reviews_today_v1\';"
          start_line: 2
          end_line: 31
        }
        replacement_chunks {
          target_content: "  const [profile, setProfile] = useState<UserProfile>(() =>\n    safeReadStorage(STORAGE_KEY_PROFILE, DEFAULT_USER_PROFILE)\n  );\n\n  const [livePeers, setLivePeers] = useState<LiveRankingUser[]>(INITIAL_LIVE_PEERS);"
          replacement_content: "  const [profile, setProfile] = useState<UserProfile>(() =>\n    safeReadStorage(STORAGE_KEY_PROFILE, DEFAULT_USER_PROFILE)\n  );\n\n  const [flashcards, setFlashcards] = useState<Flashcard[]>(() =>\n    safeReadStorage(STORAGE_KEY_FLASHCARDS, INITIAL_FLASHCARDS)\n  );\n\n  const [autoCreateFlashcardsOnError, setAutoCreateFlashcardsOnError] =\n    useState<boolean>(() => safeReadStorage(STORAGE_KEY_AUTO_SRS, false));\n\n  const [reviewsTodayStats, setReviewsTodayStats] = useState<{\n    date: string;\n    total: number;\n    passed: number;\n  }>(() => {\n    const today = new Date().toISOString().slice(0, 10);\n    const saved = safeReadStorage(STORAGE_KEY_REVIEWS_TODAY, {\n      date: today,\n      total: 0,\n      passed: 0,\n    });\n    return saved.date === today ? saved : { date: today, total: 0, passed: 0 };\n  });\n\n  const [livePeers, setLivePeers] = useState<LiveRankingUser[]>(INITIAL_LIVE_PEERS);"
          start_line: 76
          end_line: 82
        }
        replacement_chunks {
          target_content: "  useEffect(() => {\n    try {\n      window.localStorage.setItem(STORAGE_KEY_PROFILE, JSON.stringify(profile));\n    } catch {\n      // ignore\n    }\n  }, [profile]);"
          replacement_content: "  useEffect(() => {\n    try {\n      window.localStorage.setItem(STORAGE_KEY_PROFILE, JSON.stringify(profile));\n    } catch {\n      // ignore\n    }\n  }, [profile]);\n\n  useEffect(() => {\n    try {\n      window.localStorage.setItem(STORAGE_KEY_FLASHCARDS, JSON.stringify(flashcards));\n    } catch {\n      // ignore\n    }\n  }, [flashcards]);\n\n  useEffect(() => {\n    try {\n      window.localStorage.setItem(\n        STORAGE_KEY_AUTO_SRS,\n        JSON.stringify(autoCreateFlashcardsOnError)\n      );\n    } catch {\n      // ignore\n    }\n  }, [autoCreateFlashcardsOnError]);\n\n  useEffect(() => {\n    try {\n      window.localStorage.setItem(\n        STORAGE_KEY_REVIEWS_TODAY,\n        JSON.stringify(reviewsTodayStats)\n      );\n    } catch {\n      // ignore\n    }\n  }, [reviewsTodayStats]);"
          start_line: 113
          end_line: 121
        }
        replacement_chunks {
          target_content: "  const recordAnswer = useCallback(\n    (\n      question: MedicalQuestion,\n      selectedLetter: AlternativeLetter,\n      mode: StudyMode,\n      timeSpentSec = 45\n    ) => {\n      const isCorrect = selectedLetter === question.gabaritoOficial;\n      const record: UserAnswerRecord = {\n        questionId: question.id,\n        selectedLetter,\n        isCorrect,\n        answeredAt: new Date().toISOString(),\n        mode,\n        timeSpentSec,\n      };\n      setAnswers((prev) => ({\n        ...prev,\n        [question.id]: record,\n      }));\n    },\n    []\n  );\n\n  const recordBatchAnswers = useCallback(\n    (\n      items: Array<{\n        question: MedicalQuestion;\n        selectedLetter: AlternativeLetter;\n        timeSpentSec: number;\n      }>\n    ) => {\n      setAnswers((prev) => {\n        const next = { ...prev };\n        for (const item of items) {\n          next[item.question.id] = {\n            questionId: item.question.id,\n            selectedLetter: item.selectedLetter,\n            isCorrect: item.selectedLetter === item.question.gabaritoOficial,\n            answeredAt: new Date().toISOString(),\n            mode: \'simulado\',\n            timeSpentSec: item.timeSpentSec,\n          };\n        }\n        return next;\n      });\n    },\n    []\n  );"
          replacement_content: "  const createFlashcardFromQuestion = useCallback(\n    (question: MedicalQuestion, source: \'perola\' | \'caderno_erros\' = \'perola\'): boolean => {\n      let created = false;\n      setFlashcards((prev) => {\n        if (prev.some((fc) => fc.questionId === question.id)) {\n          return prev;\n        }\n        created = true;\n        return [buildFlashcardFromQuestion(question, source), ...prev];\n      });\n      return created;\n    },\n    []\n  );\n\n  const recordAnswer = useCallback(\n    (\n      question: MedicalQuestion,\n      selectedLetter: AlternativeLetter,\n      mode: StudyMode,\n      timeSpentSec = 45\n    ) => {\n      const isCorrect = selectedLetter === question.gabaritoOficial;\n      const record: UserAnswerRecord = {\n        questionId: question.id,\n        selectedLetter,\n        isCorrect,\n        answeredAt: new Date().toISOString(),\n        mode,\n        timeSpentSec,\n      };\n      setAnswers((prev) => ({\n        ...prev,\n        [question.id]: record,\n      }));\n      if (!isCorrect && autoCreateFlashcardsOnError) {\n        createFlashcardFromQuestion(question, \'caderno_erros\');\n      }\n    },\n    [autoCreateFlashcardsOnError, createFlashcardFromQuestion]\n  );\n\n  const recordBatchAnswers = useCallback(\n    (\n      items: Array<{\n        question: MedicalQuestion;\n        selectedLetter: AlternativeLetter;\n        timeSpentSec: number;\n      }>\n    ) => {\n      setAnswers((prev) => {\n        const next = { ...prev };\n        for (const item of items) {\n          next[item.question.id] = {\n            questionId: item.question.id,\n            selectedLetter: item.selectedLetter,\n            isCorrect: item.selectedLetter === item.question.gabaritoOficial,\n            answeredAt: new Date().toISOString(),\n            mode: \'simulado\',\n            timeSpentSec: item.timeSpentSec,\n          };\n        }\n        return next;\n      });\n      if (autoCreateFlashcardsOnError) {\n        const missedQuestions = items\n          .filter((item) => item.selectedLetter !== item.question.gabaritoOficial)\n          .map((item) => item.question);\n        if (missedQuestions.length > 0) {\n          setFlashcards((prev) => {\n            const existingIds = new Set(prev.map((fc) => fc.questionId));\n            const additions = missedQuestions\n              .filter((q) => !existingIds.has(q.id))\n              .map((q) => buildFlashcardFromQuestion(q, \'caderno_erros\'));\n            return additions.length > 0 ? [...additions, ...prev] : prev;\n          });\n        }\n      }\n    },\n    [autoCreateFlashcardsOnError]\n  );\n\n  const generateFlashcardsFromErrors = useCallback(\n    (questions: MedicalQuestion[]): number => {\n      let addedCount = 0;\n      setFlashcards((prev) => {\n        const existingIds = new Set(prev.map((fc) => fc.questionId));\n        const additions = questions\n          .filter((q) => !existingIds.has(q.id))\n          .map((q) => buildFlashcardFromQuestion(q, \'caderno_erros\'));\n        addedCount = additions.length;\n        return additions.length > 0 ? [...additions, ...prev] : prev;\n      });\n      return addedCount;\n    },\n    []\n  );\n\n  const reviewFlashcard = useCallback((cardId: string, rating: SrsRating) => {\n    const now = new Date();\n    setFlashcards((prev) =>\n      prev.map((card) => {\n        if (card.id !== cardId) return card;\n        const srs = computeNextSrsState(card, rating, now);\n        return {\n          ...card,\n          ...srs,\n          lastReviewedAt: now.toISOString(),\n        };\n      })\n    );\n    const today = now.toISOString().slice(0, 10);\n    setReviewsTodayStats((prev) => {\n      const base = prev.date === today ? prev : { date: today, total: 0, passed: 0 };\n      return {\n        date: today,\n        total: base.total + 1,\n        passed: base.passed + (rating >= 2 ? 1 : 0),\n      };\n    });\n  }, []);\n\n  const createCustomFlashcard = useCallback(\n    (payload: {\n      grandeAreaId: GrandeAreaId;\n      tema: string;\n      front: string;\n      backPearl: string;\n    }) => {\n      const areaMeta = GRANDES_AREAS.find((a) => a.id === payload.grandeAreaId);\n      const nowIso = new Date().toISOString();\n      const newCard: Flashcard = {\n        id: `fc-manual-${Date.now()}`,\n        grandeAreaId: payload.grandeAreaId,\n        grandeArea: areaMeta?.name ?? \'Cl\303\255nica M\303\251dica\',\n        tema: payload.tema.trim() || \'Revis\303\243o Geral\',\n        front: payload.front.trim(),\n        backPearl: payload.backPearl.trim(),\n        source: \'manual\',\n        createdAt: nowIso,\n        dueAt: nowIso,\n        intervalDays: 0,\n        easeFactor: 2.5,\n        repetitions: 0,\n        lapses: 0,\n      };\n      setFlashcards((prev) => [newCard, ...prev]);\n    },\n    []\n  );\n\n  const deleteFlashcard = useCallback((cardId: string) => {\n    setFlashcards((prev) => prev.filter((fc) => fc.id !== cardId));\n  }, []);"
          start_line: 148
          end_line: 197
        }
        replacement_chunks {
          target_content: "  const errorNotebookQuestions = useMemo(() => {\n    return MEDICAL_QUESTIONS.filter((q) => {\n      const ans = answers[q.id];\n      const missed = ans && !ans.isCorrect;\n      const saved = bookmarks.includes(q.id);\n      return missed || saved;\n    });\n  }, [answers, bookmarks]);\n\n  const resetProgress = useCallback(() => {\n    setAnswers({});\n  }, []);\n\n  return {\n    darkMode,\n    setDarkMode,\n    answers,\n    bookmarks,\n    profile,\n    recordAnswer,\n    recordBatchAnswers,\n    toggleBookmark,\n    updateProfile,\n    generateRandomPseudonym,\n    filterQuestions,\n    analytics,\n    liveRanking,\n    errorNotebookQuestions,\n    resetProgress,\n  };\n}"
          replacement_content: "  const errorNotebookQuestions = useMemo(() => {\n    return MEDICAL_QUESTIONS.filter((q) => {\n      const ans = answers[q.id];\n      const missed = ans && !ans.isCorrect;\n      const saved = bookmarks.includes(q.id);\n      return missed || saved;\n    });\n  }, [answers, bookmarks]);\n\n  const flashcardQuestionIds = useMemo(\n    () =>\n      new Set(\n        flashcards\n          .map((fc) => fc.questionId)\n          .filter((id): id is string => Boolean(id))\n      ),\n    [flashcards]\n  );\n\n  const dueFlashcardsCount = useMemo(\n    () => flashcards.filter((fc) => isCardDueToday(fc)).length,\n    [flashcards]\n  );\n\n  const resetProgress = useCallback(() => {\n    setAnswers({});\n  }, []);\n\n  return {\n    darkMode,\n    setDarkMode,\n    answers,\n    bookmarks,\n    profile,\n    flashcards,\n    flashcardQuestionIds,\n    dueFlashcardsCount,\n    reviewsTodayStats,\n    autoCreateFlashcardsOnError,\n    setAutoCreateFlashcardsOnError,\n    recordAnswer,\n    recordBatchAnswers,\n    toggleBookmark,\n    updateProfile,\n    generateRandomPseudonym,\n    createFlashcardFromQuestion,\n    generateFlashcardsFromErrors,\n    reviewFlashcard,\n    createCustomFlashcard,\n    deleteFlashcard,\n    filterQuestions,\n    analytics,\n    liveRanking,\n    errorNotebookQuestions,\n    resetProgress,\n  };\n}"
