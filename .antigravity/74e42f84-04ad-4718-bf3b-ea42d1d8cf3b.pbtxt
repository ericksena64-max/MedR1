    content: "  referencias: string[];\n}\n\nexport interface UserAnswerRecord {\n  questionId: string;\n  selectedLetter: AlternativeLetter;\n  isCorrect: boolean;\n  answeredAt: string;\n  mode: StudyMode;\n  timeSpentSec: number;\n}\n\nexport interface QuestionFilters {\n  search: string;\n  grandeAreaId: string;\n  tema: string;\n  subtema: string;\n  banca: string;\n  instituicao: string;\n  regiao: string;\n  ano: string;\n  dificuldade: string;\n  status: StudentFilterStatus;\n  comImagens: boolean;\n  excluirAnuladasDesatualizadas: boolean;\n}\n\nexport interface UserProfile {\n  id: string;\n  realName: string;\n  pseudonym: string;\n  usePseudonym: boolean;\n  targetSpecialty: string;\n  targetInstitution: string;\n  avatarInitials: string;\n}"
