      arguments_json: "{\"Description\":\"Add Flashcards navigation item with due-today counter to Sidebar\", \"Instruction\":\"Import Layers icon, accept dueFlashcardsCount prop, and add Flashcards entry to navItems\", \"ReplacementChunks\":[{\"AllowMultiple\":false, \"EndLine\":10, \"ReplacementContent\":\"import {\\n  BookOpenCheck,\\n  BarChart3,\\n  Trophy,\\n  BookmarkCheck,\\n  Layers,\\n  X,\\n  Stethoscope,\\n  ShieldCheck,\\n} from \'lucide-react\';\", \"StartLine\":2, \"TargetContent\":\"import {\\n  BookOpenCheck,\\n  BarChart3,\\n  Trophy,\\n  BookmarkCheck,\\n  X,\\n  Stethoscope,\\n  ShieldCheck,\\n} from \'lucide-react\';\"}, {\"AllowMultiple\":false, \"EndLine\":23, \"ReplacementContent\":\"  profile: UserProfile;\\n  errorNotebookCount: number;\\n  dueFlashcardsCount: number;\\n  onlineTotal: number;\", \"StartLine\":17, \"TargetContent\":\"  profile: UserProfile;\\n  errorNotebookCount: number;\\n  onlineTotal: number;\"}, {\"AllowMultiple\":false, \"EndLine\":36, \"ReplacementContent\":\"  profile,\\n  errorNotebookCount,\\n  dueFlashcardsCount,\\n  onlineTotal,\", \"StartLine\":28, \"TargetContent\":\"  profile,\\n  errorNotebookCount,\\n  onlineTotal,\"}, {\"AllowMultiple\":false, \"EndLine\":65, \"ReplacementContent\":\"    {\\n      id: \'caderno_erros\',\\n      label: \'Caderno de Erros\',\\n      icon: BookmarkCheck,\\n      meta: String(errorNotebookCount),\\n    },\\n    {\\n      id: \'flashcards\',\\n      label: \'Flashcards\',\\n      icon: Layers,\\n      meta: dueFlashcardsCount > 0 ? `${dueFlashcardsCount} hoje` : \'0\',\\n      highlightMeta: dueFlashcardsCount > 0,\\n    },\\n  ];\", \"StartLine\":54, \"TargetContent\":\"    {\\n      id: \'caderno_erros\',\\n      label: \'Caderno de Erros\',\\n      icon: BookmarkCheck,\\n      meta: String(errorNotebookCount),\\n    },\\n  ];\"}, {\"AllowMultiple\":false, \"EndLine\":44, \"ReplacementContent\":\"  const navItems: Array<{\\n    id: ActiveTab;\\n    label: string;\\n    icon: React.ComponentType<{ className?: string }>;\\n    meta?: string;\\n    highlightMeta?: boolean;\\n  }> = [\", \"StartLine\":36, \"TargetContent\":\"  const navItems: Array<{\\n    id: ActiveTab;\\n    label: string;\\n    icon: React.ComponentType<{ className?: string }>;\\n    meta?: string;\\n  }> = [\"}, {\"AllowMultiple\":false, \"EndLine\":125, \"ReplacementContent\":\"              {item.meta && (\\n                <span\\n                  className={cn(\\n                    \'font-mono text-xs tabular-nums whitespace-nowrap\',\\n                    item.highlightMeta\\n                      ? \'font-semibold text-sky-600 dark:text-sky-400\'\\n                      : \'text-slate-500 dark:text-slate-400\'\\n                  )}\\n                >\\n                  {item.meta}\\n                </span>\\n              )}\", \"StartLine\":115, \"TargetContent\":\"              {item.meta && (\\n                <span className=\\\"font-mono text-xs tabular-nums text-slate-500 dark:text-slate-400\\\">\\n                  {item.meta}\\n                </span>\\n              )}\"}], \"TargetFile\":\"/src/components/layout/Sidebar.tsx\", \"toolAction\":\"Adding Flashcards route to Sidebar\", \"toolSummary\":\"Add Flashcards nav to Sidebar\"}"
