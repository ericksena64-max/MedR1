    content: "  const activeQuestion = filteredQuestions[currentIndex];\n\n  return (\n    <div className=\"min-h-screen flex bg-[#F8FAFC] text-slate-900 dark:bg-[#0F172A] dark:text-slate-100\">\n      {/* Persistent Navigation Sidebar (hidden cleanly in Focus Mode) */}\n      {!focusMode && (\n        <Sidebar\n          activeTab={activeTab}\n          onSelectTab={setActiveTab}\n          profile={store.profile}\n          errorNotebookCount={store.errorNotebookQuestions.length}\n          onlineTotal={store.liveRanking.onlineTotal}\n          currentUserRank={store.liveRanking.currentUser.rank}\n          mobileOpen={mobileMenuOpen}\n          onCloseMobile={() => setMobileMenuOpen(false)}\n        />\n      )}\n\n      {/* Main Content Shell */}\n      <div className=\"flex-1 flex flex-col min-w-0\">\n        <TopBar\n          activeTab={activeTab}\n          darkMode={store.darkMode}\n          onToggleDarkMode={() => store.setDarkMode((d) => !d)}\n          focusMode={focusMode}\n          onToggleFocusMode={() => setFocusMode((f) => !f)}\n          onOpenMobileMenu={() => setMobileMenuOpen(true)}\n        />\n\n        <main\n          className={cn(\n            \'flex-1 w-full mx-auto px-4 sm:px-6 lg:px-8 py-6\',\n            focusMode ? \'max-w-4xl\' : \'max-w-[1440px]\'\n          )}\n        >\n          {/* TAB 1: BANCO DE QUEST\303\225ES */}\n          {activeTab === \'questoes\' && (\n            <div\n              className={cn(\n                \'grid grid-cols-1 gap-6 items-start\',\n                !focusMode && \'xl:grid-cols-12\'\n              )}\n            >\n              {/* Primary Question Column */}\n              <div\n                className={cn(\n                  \'space-y-5 min-w-0\',\n                  !focusMode && \'xl:col-span-8 2xl:col-span-9\'\n                )}\n              >\n                {/* Filter Engine hidden in Focus Mode or Active Simulado */}\n                {!focusMode && !simuladoActive && (\n                  <FilterPanel\n                    filters={filters}\n                    onChange={(next) => {\n                      setFilters(next);\n                      setCurrentIndex(0);\n                    }}\n                    onReset={() => {\n                      setFilters(DEFAULT_FILTERS);\n                      setCurrentIndex(0);\n                    }}\n                    resultCount={filteredQuestions.length}\n                    mode={mode}\n                    onChangeMode={handleModeChange}\n                    onStartSimulado={handleStartSimulado}\n                    simuladoActive={simuladoActive}\n                  />\n                )}\n\n                {/* Simulado Countdown & Navigator Bar */}\n                {mode === \'simulado\' && simuladoActive && (\n                  <SimuladoBar\n                    questions={filteredQuestions}\n                    currentIndex={currentIndex}\n                    onSelectIndex={setCurrentIndex}\n                    draftAnswers={simuladoDrafts}\n                    flaggedIds={flaggedIds}\n                    secondsLeft={simuladoSecondsLeft}\n                    paused={simuladoPaused}\n                    onTogglePause={() => setSimuladoPaused((p) => !p)}\n                    finished={simuladoFinished}\n                    onFinish={finishSimulado}\n                    onRestart={handleRestartSimulado}\n                  />\n                )}\n\n                {/* Active Question Solver or Empty State */}\n                {activeQuestion ? (\n                  mode === \'simulado\' && !simuladoActive ? (\n                    <section className=\"rounded-xl border border-slate-200 bg-white p-8 sm:p-10 text-center dark:border-slate-800 dark:bg-slate-900 space-y-4\">\n                      <h2 className=\"font-display text-xl font-bold text-slate-900 dark:text-white\">\n                        Pronto para o Simulado na \303\215ntegra?\n                      </h2>\n                      <p className=\"mx-auto max-w-lg text-sm leading-relaxed text-slate-600 dark:text-slate-400\">\n                        Voc\303\252 configurou{\' \'}\n                        <strong className=\"text-slate-900 dark:text-white tabular-nums\">\n                          {filteredQuestions.length} quest\303\265es\n                        </strong>{\' \'}\n                        com tempo estimado de{\' \'}\n                        <strong className=\"font-mono text-slate-900 dark:text-white tabular-nums\">\n                          {filteredQuestions.length * 3} minutos\n                        </strong>\n                        . Coment\303\241rios e estat\303\255sticas da comunidade permanecer\303\243o bloqueados at\303\251 a entrega, com suporte a riscar alternativas e marcar d\303\272vidas para revis\303\243o.\n                      </p>\n                      <div className=\"pt-2 flex flex-wrap items-center justify-center gap-3\">\n                        <Button\n                          variant=\"primary\"\n                          size=\"lg\"\n                          onClick={handleStartSimulado}\n                        >\n                          Iniciar Simulado agora\n                        </Button>\n                        <Button\n                          variant=\"outline\"\n                          size=\"lg\"\n                          onClick={() => handleModeChange(\'estudo\')}\n                        >\n                          Voltar ao Modo Estudo\n                        </Button>\n                      </div>\n                    </section>\n                  ) : (\n                    <>\n                      {/* Quick question stepper pills for Study Mode */}\n                      {mode === \'estudo\' && filteredQuestions.length > 1 && (\n                        <div className=\"flex items-center gap-1.5 overflow-x-auto pb-1\">\n                          {filteredQuestions.map((q, idx) => {\n                            const ans = store.answers[q.id];\n                            const isCurrent = idx === currentIndex;\n                            return (\n                              <button\n                                key={q.id}\n                                type=\"button\"\n                                onClick={() => setCurrentIndex(idx)}\n                                className={cn(\n                                  \'flex h-8 min-w-[34px] items-center justify-center rounded-lg border px-2 font-mono text-xs font-medium tabular-nums transition-colors cursor-pointer shrink-0\',\n                                  isCurrent &&\n                                    \'ring-2 ring-sky-500 ring-offset-1 dark:ring-offset-[#0F172A]\',\n                                  ans\n                                    ? ans.isCorrect\n                                      ? \'border-emerald-300 bg-emerald-50 text-emerald-700 dark:border-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300\'\n                                      : \'border-red-300 bg-red-50 text-red-700 dark:border-red-800 dark:bg-red-950/60 dark:text-red-300\'\n                                    : isCurrent\n                                    ? \'border-sky-500 bg-sky-50 text-sky-700 dark:border-sky-400 dark:bg-sky-950/50 dark:text-sky-300\'\n                                    : \'border-slate-200 bg-white text-slate-600 hover:bg-slate-50 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-400 dark:hover:bg-slate-800\'\n                                )}\n                                title={`${q.instituicao} ${q.ano} \302\267 ${q.tema}`}\n                              >\n                                {idx + 1}\n                              </button>\n                            );\n                          })}\n                        </div>\n                      )}\n\n                      <QuestionCard\n                        question={activeQuestion}\n                        index={currentIndex}\n                        total={filteredQuestions.length}\n                        mode={mode}\n                        existingAnswer={store.answers[activeQuestion.id]}\n                        simuladoDraft={simuladoDrafts[activeQuestion.id]}\n                        simuladoFinished={simuladoFinished}\n                        isBookmarked={store.bookmarks.includes(activeQuestion.id)}\n                        isFlagged={flaggedIds.includes(activeQuestion.id)}\n                        onToggleBookmark={() =>\n                          store.toggleBookmark(activeQuestion.id)\n                        }\n                        onToggleFlag={() => handleToggleFlag(activeQuestion.id)}\n                        onSubmitStudyAnswer={(letter) =>\n                          store.recordAnswer(activeQuestion, letter, \'estudo\', 52)\n                        }\n                        onSelectSimuladoDraft={(letter) =>\n                          setSimuladoDrafts((prev) => ({\n                            ...prev,\n                            [activeQuestion.id]: letter,\n                          }))\n                        }\n                        onPrev={() =>\n                          setCurrentIndex((i) => Math.max(0, i - 1))\n                        }\n                        onNext={() =>\n                          setCurrentIndex((i) =>\n                            Math.min(filteredQuestions.length - 1, i + 1)\n                          )\n                        }\n                        benchmarks={(() => {\n                          const areaRow = store.analytics.areaRows.find(\n                            (r) => r.grandeAreaId === activeQuestion.grandeAreaId\n                          );\n                          const topicRow =\n                            store.analytics.topicRows.find(\n                              (r) => r.label === activeQuestion.tema\n                            ) ?? areaRow;\n                          const overallSlice = {\n                            label: \'Vis\303\243o Geral\',\n                            studentPct: store.analytics.overallStudentPct,\n                            communityMedianPct: store.analytics.overallMedianPct,\n                            delta: store.analytics.overallDelta,\n                            status: store.analytics.overallStatus,\n                            answered: store.analytics.totalAnswered,\n                          };\n                          return {\n                            topic: topicRow\n                              ? {\n                                  label: topicRow.label,\n                                  studentPct: topicRow.studentPct,\n                                  communityMedianPct: topicRow.communityMedianPct,\n                                  delta: topicRow.delta,\n                                  status: topicRow.status,\n                                  answered: topicRow.answered,\n                                }\n                              : overallSlice,\n                            area: areaRow\n                              ? {\n                                  label: areaRow.label,\n                                  studentPct: areaRow.studentPct,\n                                  communityMedianPct: areaRow.communityMedianPct,\n                                  delta: areaRow.delta,\n                                  status: areaRow.status,\n                                  answered: areaRow.answered,\n                                }\n                              : overallSlice,\n                            overall: overallSlice,\n                          };\n                        })()}\n                      />\n                    </>\n                  )\n                ) : (\n                  <section className=\"rounded-xl border border-slate-200 bg-white p-12 text-center dark:border-slate-800 dark:bg-slate-900 space-y-3\">\n                    <SearchX className=\"mx-auto h-8 w-8 text-slate-400\" />\n                    <h2 className=\"font-display text-base font-bold text-slate-900 dark:text-white\">\n                      Nenhuma quest\303\243o encontrada com esses filtros\n                    </h2>\n                    <p className=\"text-sm text-slate-500 dark:text-slate-400 max-w-md mx-auto\">\n                      Tente ampliar a Grande \303\201rea, remover a busca textual ou redefinir o status do aluno para visualizar mais quest\303\265es.\n                    </p>\n                    <div className=\"pt-2\">\n                      <Button\n                        variant=\"outline\"\n                        size=\"sm\"\n                        onClick={() => {\n                          setFilters(DEFAULT_FILTERS);\n                          setCurrentIndex(0);\n                        }}\n                      >\n                        <RotateCcw className=\"h-3.5 w-3.5\" />\n                        <span>Limpar todos os filtros</span>\n                      </Button>\n                    </div>\n                  </section>\n                )}\n              </div>\n\n              {/* Right Side Widget: Live Online Top 10+ Ranking (hidden in Focus Mode) */}\n              {!focusMode && (\n                <div className=\"xl:col-span-4 2xl:col-span-3 xl:sticky xl:top-22\">\n                  <LiveRankingWidget\n                    top10={store.liveRanking.top10}\n                    currentUser={store.liveRanking.currentUser}\n                    onlineTotal={store.liveRanking.onlineTotal}\n                    profile={store.profile}\n                    onUpdateProfile={store.updateProfile}\n                    onGeneratePseudonym={store.generateRandomPseudonym}\n                    onOpenFullRanking={() => setActiveTab(\'ranking\')}\n                  />\n                </div>\n              )}\n            </div>\n          )}\n\n          {/* TAB 2: DESEMPENHO & MEDIANA */}\n          {activeTab === \'desempenho\' && (\n            <PerformanceDashboard\n              analytics={store.analytics}\n              darkMode={store.darkMode}\n            />\n          )}\n\n          {/* TAB 3: RANKING AO VIVO DEDICADO */}\n          {activeTab === \'ranking\' && (\n            <LiveRankingPage\n              allEntries={store.liveRanking.all}\n              currentUser={store.liveRanking.currentUser}\n              onlineTotal={store.liveRanking.onlineTotal}\n              profile={store.profile}\n              onUpdateProfile={store.updateProfile}\n              onGeneratePseudonym={store.generateRandomPseudonym}\n            />\n          )}\n\n          {/* TAB 4: CADERNO DE ERROS */}\n          {activeTab === \'caderno_erros\' && (\n            <ErrorNotebookView\n              questions={store.errorNotebookQuestions}\n              answers={store.answers}\n              bookmarks={store.bookmarks}\n              onToggleBookmark={store.toggleBookmark}\n              onOpenQuestion={handleOpenQuestionFromNotebook}\n              onLaunchErrorReview={handleLaunchErrorReview}\n            />\n          )}\n        </main>\n      </div>\n    </div>\n  );\n}\n"
    num_lines: 484
    num_bytes: 20002
    line_range_bytes: 14630
  }
}
