            }
            lines {
              text: "        ? `${lead} ${lastSentence}`"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        : `${question.enunciado.slice(0, 240).trim()}\342\200\246`;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const nowIso = new Date().toISOString();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  return {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
