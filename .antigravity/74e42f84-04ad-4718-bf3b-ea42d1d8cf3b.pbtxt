            }
            lines {
              text: "    regiao: \'Sudeste\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ano: 2021,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    tipoProva: \'Acesso Direto\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    anulada: false,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    desatualizada: true,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    enunciado:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'[Quest\303\243o marcada como Desatualizada pela mudan\303\247a nas diretrizes de IC] Paciente de 64 anos com ICFER (FEVE 30%), classe funcional NYHA II, sem diabetes mellitus, j\303\241 em uso otimizado de enalapril, carvedilol e espironolactona. Segundo o protocolo vigente \303\240 \303\251poca da prova (2021), qual classe n\303\243o era considerada terapia modificadora de mortalidade obrigat\303\263ria de primeira linha para pacientes n\303\243o diab\303\251ticos?\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    alternativas: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        letter: \'A\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        text: \'Betabloqueadores cardiosseletivos (bisoprolol ou succinato de metoprolol).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        explanation: \'Incorreta. Betabloqueadores j\303\241 constitu\303\255am pilar cl\303\241ssico de redu\303\247\303\243o de mortalidade na ICFER.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        communityPct: 8.4,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        letter: \'B\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        text: \'Antagonistas do receptor mineralocorticoide (espironolactona).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        explanation: \'Incorreta. A espironolactona j\303\241 era recomendada em NYHA II-IV com FEVE \342\211\244 35%.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        communityPct: 11.2,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
