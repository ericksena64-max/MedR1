      create_file {
        instruction: "import React, { useMemo, useState, useEffect } from \'react\';\nimport {\n  Bookmark,\n  CheckCircle2,\n  XCircle,\n  AlertTriangle,\n  Strikethrough,\n  Flag,\n  ChevronLeft,\n  ChevronRight,\n  ChevronDown,\n  ChevronUp,\n  BookOpen,\n  FileText,\n  Users,\n  ArrowUp,\n  ArrowDown,\n  ArrowLeft,\n  Layers,\n  Check,\n  X,\n  Lightbulb,\n  HelpCircle,\n  Map as MapIcon,\n  Target,\n  SlidersHorizontal,\n} from \'lucide-react\';\nimport type {\n  AlternativeLetter,\n  MedicalQuestion,\n  StudyMode,\n  UserAnswerRecord,\n} from \'../../types/medical\';\nimport { computeDifficulty, cn } from \'../../lib/utils\';\nimport { ClinicalImageViewer } from \'./ClinicalImageViewer\';\nimport {\n  StudentVsMedianBar,\n  type BenchmarkSlice,\n} from \'./StudentVsMedianBar\';\nimport { Button } from \'../ui/Button\';\n\nexport interface SessionQuestionSummary {\n  id: string;\n  institutionLabel: string;\n  tema: string;\n  status: \'correct\' | \'wrong\' | \'draft\' | \'unanswered\';\n  isFlagged: boolean;\n}\n\ninterface QuestionCardProps {\n  question: MedicalQuestion;\n  index: number;\n  total: number;\n  mode: StudyMode;\n  existingAnswer?: UserAnswerRecord;\n  simuladoDraft?: AlternativeLetter;\n  simuladoFinished: boolean;\n  isBookmarked: boolean;\n  isFlagged: boolean;\n  onToggleBookmark: () => void;\n  onToggleFlag: () => void;\n  onSubmitStudyAnswer: (letter: AlternativeLetter) => void;\n  onSelectSimuladoDraft: (letter: AlternativeLetter) => void;\n  onPrev: () => void;\n  onNext: () => void;\n  sessionQuestions?: SessionQuestionSummary[];\n  onSelectQuestionIndex?: (idx: number) => void;\n  filtersOpen?: boolean;\n  onToggleFilters?: () => void;\n  onFinishSession?: () => void;\n  benchmarks?: {\n    topic: BenchmarkSlice;\n    area: BenchmarkSlice;\n    overall: BenchmarkSlice;\n  };\n  hasFlashcard?: boolean;\n  onCreateFlashcard?: () => void;\n  onOpenFlashcards?: () => void;\n}\n\ntype CommentaryTab = \'alternativas\' | \'referencias\';\n\nexport function QuestionCard({\n  question,\n  index,\n  total,\n  mode,\n  existingAnswer,\n  simuladoDraft,\n  simuladoFinished,\n  isBookmarked,\n  isFlagged,\n  onToggleBookmark,\n  onToggleFlag,\n  onSubmitStudyAnswer,\n  onSelectSimuladoDraft,\n  onPrev,\n  onNext,\n  sessionQuestions = [],\n  onSelectQuestionIndex,\n  filtersOpen,\n  onToggleFilters,\n  onFinishSession,\n  benchmarks,\n  hasFlashcard = false,\n  onCreateFlashcard,\n  onOpenFlashcards,\n}: QuestionCardProps) {\n  const [selectedPending, setSelectedPending] = useState<AlternativeLetter | null>(null);\n  const [eliminated, setEliminated] = useState<AlternativeLetter[]>([]);\n  const [strikeToolActive, setStrikeToolActive] = useState(false);\n  const [showHint, setShowHint] = useState(false);\n  const [showHelp, setShowHelp] = useState(false);\n  const [showMap, setShowMap] = useState(false);\n  const [expandedComments, setExpandedComments] = useState<AlternativeLetter[]>([]);\n  const [commentTab, setCommentTab] = useState<CommentaryTab>(\'alternativas\');\n\n  // Reset local interactive state when navigating to a new question\n  useEffect(() => {\n    setSelectedPending(null);\n    setEliminated([]);\n    setStrikeToolActive(false);\n    setShowHint(false);\n    setShowHelp(false);\n    setShowMap(false);\n    setExpandedComments([]);\n    setCommentTab(\'alternativas\');\n  }, [question.id]);\n\n  const isRevealed =\n    (mode === \'estudo\' && Boolean(existingAnswer)) ||\n    (mode === \'simulado\' && simuladoFinished);\n\n  const activeChoice: AlternativeLetter | null =\n    mode === \'simulado\'\n      ? simuladoDraft ?? null\n      : existingAnswer?.selectedLetter ?? selectedPending;\n\n  const difficulty = computeDifficulty(question.taxaAcertoGlobal);\n\n  const sessionCorrectCount = useMemo(\n    () => sessionQuestions.filter((q) => q.status === \'correct\').length,\n    [sessionQuestions]\n  );\n\n  // Identify Principal Distrator (highest community % among WRONG options)\n  const principalDistractor = useMemo(() => {\n    const wrongOptions = question.alternativas.filter(\n      (a) => a.letter !== question.gabaritoOficial\n    );\n    return wrongOptions.reduce(\n      (best, cur) => (cur.communityPct > best.communityPct ? cur : best),\n      wrongOptions[0]\n    );\n  }, [question]);\n\n  const toggleEliminate = (letter: AlternativeLetter, e?: React.MouseEvent) => {\n    e?.stopPropagation();\n    if (isRevealed) return;\n    setEliminated((prev) =>\n      prev.includes(letter) ? prev.filter((l) => l !== letter) : [...prev, letter]\n    );\n    if (selectedPending === letter) {\n      setSelectedPending(null);\n    }\n  };\n\n  const handleOptionClick = (letter: AlternativeLetter) => {\n    if (isRevealed) return;\n    if (strikeToolActive) {\n      toggleEliminate(letter);\n      return;\n    }\n    if (eliminated.includes(letter)) return;\n    if (mode === \'simulado\') {\n      onSelectSimuladoDraft(letter);\n    } else {\n      setSelectedPending(letter);\n    }\n  };\n\n  const handleToggleInlineComment = (\n    letter: AlternativeLetter,\n    e: React.MouseEvent\n  ) => {\n    e.stopPropagation();\n    setExpandedComments((prev) =>\n      prev.includes(letter) ? prev.filter((l) => l !== letter) : [...prev, letter]\n    );\n  };\n\n  const handleConfirmStudy = () => {\n    if (!selectedPending || mode !== \'estudo\') return;\n    onSubmitStudyAnswer(selectedPending);\n  };\n\n  // Keyboard shortcuts for fast medical residency solving (A-E, Enter, Left/Right)\n  useEffect(() => {\n    const handleKeyDown = (e: KeyboardEvent) => {\n      const target = e.target as HTMLElement | null;\n      if (\n        target &&\n        (target.tagName === \'INPUT\' ||\n          target.tagName === \'TEXTAREA\' ||\n          target.tagName === \'SELECT\' ||\n          target.isContentEditable)\n      ) {\n        return;\n      }\n\n      if (e.key === \'ArrowLeft\' && index > 0) {\n        e.preventDefault();\n        onPrev();\n        return;\n      }\n      if (e.key === \'ArrowRight\' && index < total - 1) {\n        e.preventDefault();\n        onNext();\n        return;\n      }\n\n      if (!isRevealed) {\n        const upper = e.key.toUpperCase() as AlternativeLetter;\n        const validLetters = question.alternativas.map((a) => a.letter);\n        if (validLetters.includes(upper) && !eliminated.includes(upper)) {\n          e.preventDefault();\n          if (mode === \'simulado\') {\n            onSelectSimuladoDraft(upper);\n          } else {\n            setSelectedPending(upper);\n          }\n          return;\n        }\n        if (e.key === \'Enter\' && mode === \'estudo\' && selectedPending) {\n          e.preventDefault();\n          onSubmitStudyAnswer(selectedPending);\n        }\n      }\n    };\n\n    window.addEventListener(\'keydown\', handleKeyDown);\n    return () => window.removeEventListener(\'keydown\', handleKeyDown);\n  }, [\n    index,\n    total,\n    onPrev,\n    onNext,\n    isRevealed,\n    question.alternativas,\n    eliminated,\n    mode,\n    onSelectSimuladoDraft,\n    selectedPending,\n    onSubmitStudyAnswer,\n  ]);\n\n  const isUserCorrect =\n    isRevealed && activeChoice === question.gabaritoOficial;\n\n  const difficultyLabel =\n    difficulty === \'Dif\303\255cil\'\n      ? \'Dificuldade: Dif\303\255cil\'\n      : difficulty === \'M\303\251dio\'\n      ? \'Dificuldade: Moderada\'\n      : \'Dificuldade: F\303\241cil\';\n\n  return (\n    <article className=\"relative rounded-2xl border border-slate-200/90 bg-white shadow-xs dark:border-slate-800 dark:bg-slate-900\">\n      {/* Top Session Bar + Segmented Progress Track */}\n      <div className=\"px-5 pt-5 pb-4 sm:px-8 sm:pt-6 space-y-4 border-b border-slate-100 dark:border-slate-800/80\">\n        <div className=\"flex flex-wrap items-center justify-between gap-3\">\n          {/* Left: Back/Filters Toggle + Prominent Question Counter */}\n          <div className=\"flex items-center gap-3.5 min-w-0\">\n            {onToggleFilters && (\n              <button\n                type=\"button\"\n                onClick={onToggleFilters}\n                className=\"inline-flex items-center gap-1.5 rounded-full border border-slate-200 bg-slate-50 px-3 py-1.5 text-xs font-medium text-slate-600 hover:border-slate-300 hover:bg-slate-100 hover:text-slate-900 dark:border-slate-700 dark:bg-slate-800/80 dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-white transition-colors cursor-pointer whitespace-nowrap\"\n              >\n                {filtersOpen ? (\n                  <>\n                    <ArrowLeft className=\"h-3.5 w-3.5\" />\n                    <span>Ocultar filtros</span>\n                  </>\n                ) : (\n                  <>\n                    <SlidersHorizontal className=\"h-3.5 w-3.5\" />\n                    <span>Filtros</span>\n                  </>\n                )}\n              </button>\n            )}\n\n            <h2 className=\"font-display text-xl sm:text-2xl font-bold tracking-tight text-slate-900 dark:text-white tabular-nums whitespace-nowrap\">\n              Quest\303\243o {index + 1}\n              <span className=\"ml-0.5 text-sm sm:text-base font-medium text-slate-400 dark:text-slate-500\">\n                /{total}\n              </span>\n            </h2>\n          </div>\n\n          {/* Right: Session Hits Counter + Finalizar + Bookmark */}\n          <div className=\"flex flex-wrap items-center gap-2 shrink-0\">\n            {sessionQuestions.length > 0 && (\n              <span className=\"inline-flex items-center gap-1.5 rounded-full border border-slate-200 bg-slate-50/80 px-3 py-1.5 text-xs font-medium text-slate-600 dark:border-slate-700 dark:bg-slate-800/70 dark:text-slate-300 tabular-nums whitespace-nowrap\">\n                <Target className=\"h-3.5 w-3.5 text-slate-500 dark:text-slate-400\" />\n                <span>\n                  {sessionCorrectCount}{\' \'}\n                  {sessionCorrectCount === 1 ? \'acerto\' : \'acertos\'}\n                </span>\n              </span>\n            )}\n\n            {mode === \'simulado\' && !simuladoFinished && (\n              <button\n                type=\"button\"\n                onClick={onToggleFlag}\n                aria-pressed={isFlagged}\n                className={cn(\n                  \'inline-flex items-center gap-1.5 rounded-full border px-3 py-1.5 text-xs font-semibold transition-colors cursor-pointer whitespace-nowrap\',\n                  isFlagged\n                    ? \'border-amber-300 bg-amber-50 text-amber-800 dark:border-amber-800 dark:bg-amber-950/50 dark:text-amber-300\'\n                    : \'border-slate-200 bg-white text-slate-600 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300\'\n                )}\n              >\n                <Flag\n                  className={cn(\n                    \'h-3.5 w-3.5\',\n                    isFlagged && \'fill-amber-500 text-amber-500\'\n                  )}\n                />\n                <span>{isFlagged ? \'Marcada\' : \'D\303\272vida\'}</span>\n              </button>\n            )}\n\n            {onFinishSession && (\n              <button\n                type=\"button\"\n                onClick={onFinishSession}\n                className=\"inline-flex items-center gap-1.5 rounded-full border border-emerald-200 bg-emerald-50/80 px-3.5 py-1.5 text-xs font-semibold text-emerald-700 hover:bg-emerald-100/80 dark:border-emerald-800/80 dark:bg-emerald-950/40 dark:text-emerald-300 dark:hover:bg-emerald-950/70 transition-colors cursor-pointer whitespace-nowrap\"\n              >\n                <Check className=\"h-3.5 w-3.5\" />\n                <span>Finalizar</span>\n              </button>\n            )}\n\n            <button\n              type=\"button\"\n              onClick={onToggleBookmark}\n              aria-pressed={isBookmarked}\n              title={isBookmarked ? \'Remover do Caderno de Erros\' : \'Salvar no Caderno de Erros\'}\n              className={cn(\n                \'inline-flex items-center gap-1.5 rounded-full border px-3 py-1.5 text-xs font-semibold transition-colors cursor-pointer whitespace-nowrap\',\n                isBookmarked\n                  ? \'border-sky-200 bg-sky-50 text-sky-700 dark:border-sky-800 dark:bg-sky-950/50 dark:text-sky-300\'\n                  : \'border-slate-200 bg-white text-slate-600 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300\'\n              )}\n            >\n              <Bookmark\n                className={cn(\n                  \'h-3.5 w-3.5\',\n                  isBookmarked && \'fill-sky-600 text-sky-600 dark:fill-sky-400 dark:text-sky-400\'\n                )}\n              />\n              <span className=\"hidden sm:inline\">\n                {isBookmarked ? \'Salva\' : \'Salvar\'}\n              </span>\n            </button>\n          </div>\n        </div>\n\n        {/* Segmented Progress Bar (clickable per question) */}\n        {sessionQuestions.length > 0 && (\n          <div\n            className=\"flex items-center gap-1\"\n            role=\"tablist\"\n            aria-label=\"Progresso das quest\303\265es na sess\303\243o\"\n          >\n            {sessionQuestions.map((sq, idx) => {\n              const isCurrent = idx === index;\n              return (\n                <button\n                  key={sq.id}\n                  type=\"button\"\n                  role=\"tab\"\n                  aria-selected={isCurrent}\n                  onClick={() => onSelectQuestionIndex?.(idx)}\n                  title={`Quest\303\243o ${idx + 1} \302\267 ${sq.institutionLabel} \302\267 ${sq.tema}`}\n                  className={cn(\n                    \'h-2 flex-1 rounded-full transition-all duration-150 cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-500\',\n                    sq.status === \'correct\' && \'bg-emerald-500 dark:bg-emerald-500\',\n                    sq.status === \'wrong\' && \'bg-red-500 dark:bg-red-500\',\n                    sq.status === \'draft\' && \'bg-sky-600 dark:bg-sky-500\',\n                    sq.status === \'unanswered\' &&\n                      (isCurrent\n                        ? \'bg-sky-600 dark:bg-sky-400\'\n                        : \'bg-slate-200/80 hover:bg-slate-300 dark:bg-slate-800 dark:hover:bg-slate-700\'),\n                    isCurrent &&\n                      \'ring-2 ring-sky-500/40 ring-offset-1 dark:ring-offset-slate-900\'\n                  )}\n                />\n              );\n            })}\n          </div>\n        )}\n      </div>\n\n      {/* Topic Metadata + 3 Circular Study Tool Buttons */}\n      <div className=\"px-5 pt-5 sm:px-8 flex flex-wrap items-center justify-between gap-3\">\n        <div className=\"flex flex-wrap items-center gap-x-2.5 gap-y-1 text-xs\">\n          <span className=\"font-semibold text-sky-700 dark:text-sky-400\">\n            {question.tema}\n          </span>\n          <span aria-hidden=\"true\" className=\"text-slate-300 dark:text-slate-700\">\n            \302\267\n          </span>\n          <span\n            className={cn(\n              \'font-medium\',\n              difficulty === \'F\303\241cil\' && \'text-emerald-700 dark:text-emerald-400\',\n              difficulty === \'M\303\251dio\' && \'text-amber-700 dark:text-amber-400\',\n              difficulty === \'Dif\303\255cil\' && \'text-slate-600 dark:text-slate-300\'\n            )}\n          >\n            {difficultyLabel}\n          </span>\n          <span aria-hidden=\"true\" className=\"text-slate-300 dark:text-slate-700\">\n            \302\267\n          </span>\n          <span className=\"font-mono text-slate-500 dark:text-slate-400\">\n            {question.instituicao} {question.ano} \302\267 {question.banca}\n          </span>\n        </div>\n\n        {/* 3 Circular Study Tool Buttons (Riscar, Dica, Atalhos) */}\n        <div className=\"flex items-center gap-2 shrink-0\">\n          {!isRevealed && (\n            <button\n              type=\"button\"\n              onClick={() => setStrikeToolActive((s) => !s)}\n              aria-pressed={strikeToolActive}\n              title={\n                strikeToolActive\n                  ? \'Desativar modo riscar alternativas\'\n                  : \'Ativar modo riscar alternativas (clique nas op\303\247\303\265es para eliminar)\'\n              }\n              className={cn(\n                \'flex h-9 w-9 items-center justify-center rounded-full border transition-colors cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-500\',\n                strikeToolActive\n                  ? \'border-sky-500 bg-sky-50 text-sky-700 dark:border-sky-400 dark:bg-sky-950/60 dark:text-sky-300\'\n                  : \'border-slate-200 bg-white text-slate-500 hover:border-slate-300 hover:bg-slate-50 hover:text-slate-800 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-slate-200\'\n              )}\n            >\n              <Strikethrough className=\"h-4 w-4\" />\n            </button>\n          )}\n\n          <button\n            type=\"button\"\n            onClick={() => {\n              setShowHint((h) => !h);\n              setShowHelp(false);\n            }}\n            aria-pressed={showHint}\n            title=\"Ver foco cl\303\255nico da quest\303\243o (sem spoiler)\"\n            className={cn(\n              \'flex h-9 w-9 items-center justify-center rounded-full border transition-colors cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-500\',\n              showHint\n                ? \'border-amber-400 bg-amber-50 text-amber-700 dark:border-amber-600 dark:bg-amber-950/50 dark:text-amber-300\'\n                : \'border-slate-200 bg-white text-slate-500 hover:border-slate-300 hover:bg-slate-50 hover:text-slate-800 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-slate-200\'\n            )}\n          >\n            <Lightbulb className=\"h-4 w-4\" />\n          </button>\n\n          <button\n            type=\"button\"\n            onClick={() => {\n              setShowHelp((h) => !h);\n              setShowHint(false);\n            }}\n            aria-pressed={showHelp}\n            title=\"Atalhos de teclado e ajuda\"\n            className={cn(\n              \'flex h-9 w-9 items-center justify-center rounded-full border transition-colors cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-500\',\n              showHelp\n                ? \'border-sky-400 bg-sky-50 text-sky-700 dark:border-sky-600 dark:bg-sky-950/50 dark:text-sky-300\'\n                : \'border-slate-200 bg-white text-slate-500 hover:border-slate-300 hover:bg-slate-50 hover:text-slate-800 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-slate-200\'\n            )}\n          >\n            <HelpCircle className=\"h-4 w-4\" />\n          </button>\n        </div>\n      </div>\n\n      {/* Optional Hint / Keyboard Help Inline Drawer */}\n      {showHint && (\n        <div className=\"mx-5 mt-3.5 sm:mx-8 rounded-xl border border-amber-200/80 bg-amber-50/60 px-4 py-3 text-xs text-amber-950 dark:border-amber-900/60 dark:bg-amber-950/25 dark:text-amber-200 flex items-start justify-between gap-3\">\n          <div className=\"space-y-0.5\">\n            <p className=\"font-semibold\">Foco Cl\303\255nico (sem revelar o gabarito)</p>\n            <p className=\"text-amber-900/90 dark:text-amber-200/90\">\n              {question.grandeArea} / {question.tema} /{\' \'}\n              <strong>{question.subtema}</strong> \302\267 {question.tipoProva} \302\267 Taxa\n              m\303\251dia da comunidade:{\' \'}\n              <span className=\"font-mono font-semibold tabular-nums\">\n                {question.taxaAcertoGlobal.toFixed(1)}%\n              </span>\n            </p>\n          </div>\n          <button\n            type=\"button\"\n            onClick={() => setShowHint(false)}\n            aria-label=\"Fechar dica\"\n            className=\"text-amber-700 hover:text-amber-900 dark:text-amber-400 cursor-pointer\"\n          >\n            <X className=\"h-4 w-4\" />\n          </button>\n        </div>\n      )}\n\n      {showHelp && (\n        <div className=\"mx-5 mt-3.5 sm:mx-8 rounded-xl border border-slate-200 bg-slate-50/80 px-4 py-3 text-xs text-slate-600 dark:border-slate-800 dark:bg-slate-950/60 dark:text-slate-300 flex items-start justify-between gap-3\">\n          <div className=\"flex flex-wrap items-center gap-x-4 gap-y-1.5\">\n            <span className=\"font-semibold text-slate-900 dark:text-white\">\n              Atalhos r\303\241pidos:\n            </span>\n            <span>\n              <kbd className=\"rounded border border-slate-300 bg-white px-1.5 py-0.5 font-mono text-[10px] dark:border-slate-700 dark:bg-slate-800\">\n                A\342\200\223E\n              </kbd>{\' \'}\n              selecionar alternativa\n            </span>\n            <span>\n              <kbd className=\"rounded border border-slate-300 bg-white px-1.5 py-0.5 font-mono text-[10px] dark:border-slate-700 dark:bg-slate-800\">\n                Enter\n              </kbd>{\' \'}\n              responder\n            </span>\n            <span>\n              <kbd className=\"rounded border border-slate-300 bg-white px-1.5 py-0.5 font-mono text-[10px] dark:border-slate-700 dark:bg-slate-800\">\n                \342\206\220 / \342\206\222\n              </kbd>{\' \'}\n              navegar quest\303\265es\n            </span>\n          </div>\n          <button\n            type=\"button\"\n            onClick={() => setShowHelp(false)}\n            aria-label=\"Fechar ajuda\"\n            className=\"text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 cursor-pointer\"\n          >\n            <X className=\"h-4 w-4\" />\n          </button>\n        </div>\n      )}\n\n      {/* Strike Mode Active Notice */}\n      {strikeToolActive && !isRevealed && (\n        <div className=\"mx-5 mt-3.5 sm:mx-8 rounded-lg border border-sky-200/80 bg-sky-50/60 px-3.5 py-2 text-xs text-sky-900 dark:border-sky-900/60 dark:bg-sky-950/30 dark:text-sky-200 flex items-center justify-between gap-2\">\n          <span>\n            Modo riscar ativo: clique nas alternativas que deseja eliminar antes de responder.\n          </span>\n          <button\n            type=\"button\"\n            onClick={() => setStrikeToolActive(false)}\n            className=\"font-semibold text-sky-700 hover:underline dark:text-sky-300 cursor-pointer whitespace-nowrap\"\n          >\n            Concluir\n          </button>\n        </div>\n      )}\n\n      {/* Notice banner if Annulled or Outdated */}\n      {(question.anulada || question.desatualizada) && (\n        <div className=\"mx-5 mt-4 sm:mx-8 flex items-start gap-2.5 rounded-lg border border-amber-200 bg-amber-50/70 px-4 py-3 text-xs text-amber-900 dark:border-amber-900/60 dark:bg-amber-950/30 dark:text-amber-200\">\n          <AlertTriangle className=\"h-4 w-4 shrink-0 mt-0.5 text-amber-600 dark:text-amber-400\" />\n          <p>\n            <strong>\n              {question.anulada\n                ? \'Quest\303\243o anulada pela banca oficial.\'\n                : \'Quest\303\243o marcada como desatualizada.\'}\n            </strong>{\' \'}\n            Ative o filtro &ldquo;Excluir anuladas/desatualizadas&rdquo; para remov\303\252-la da sua lista de treino.\n          </p>\n        </div>\n      )}\n\n      {/* Question Stem & Alternatives */}\n      <div className=\"px-5 py-6 sm:px-8\">\n        <div className=\"max-w-[75ch] space-y-5\">\n          <p className=\"text-[15.5px] sm:text-[16.5px] leading-[1.74] text-slate-800 dark:text-slate-100\">\n            {question.enunciado}\n          </p>\n\n          {/* Optional Clinical Image with Zoom Lightbox */}\n          {question.clinicalImage && (\n            <ClinicalImageViewer image={question.clinicalImage} />\n          )}\n\n          {/* Optional Structured Lab Table */}\n          {question.labTable && question.labTable.length > 0 && (\n            <div className=\"overflow-x-auto rounded-xl border border-slate-200 dark:border-slate-800\">\n              <table className=\"w-full text-left text-xs sm:text-sm\">\n                <thead className=\"border-b border-slate-200 bg-slate-50 text-slate-600 dark:border-slate-800 dark:bg-slate-950/60 dark:text-slate-400\">\n                  <tr>\n                    <th className=\"px-4 py-2.5 font-semibold\">Exame Laboratorial</th>\n                    <th className=\"px-4 py-2.5 font-semibold text-right\">Resultado</th>\n                    <th className=\"px-4 py-2.5 font-semibold text-right\">Refer\303\252ncia</th>\n                  </tr>\n                </thead>\n                <tbody className=\"divide-y divide-slate-100 dark:divide-slate-800/80\">\n                  {question.labTable.map((row) => (\n                    <tr\n                      key={row.exame}\n                      className=\"bg-white dark:bg-slate-900 hover:bg-slate-50/70 dark:hover:bg-slate-800/40\"\n                    >\n                      <td className=\"px-4 py-2.5 font-medium text-slate-800 dark:text-slate-200\">\n                        {row.exame}\n                      </td>\n                      <td className=\"px-4 py-2.5 text-right font-mono tabular-nums\">\n                        <span\n                          className={cn(\n                            \'inline-flex items-center justify-end gap-1 font-semibold\',\n                            row.alterado === \'alto\' && \'text-red-700 dark:text-red-400\',\n                            row.alterado === \'baixo\' && \'text-sky-700 dark:text-sky-400\',\n                            (!row.alterado || row.alterado === \'normal\') &&\n                              \'text-slate-900 dark:text-slate-100\'\n                          )}\n                        >\n                          {row.alterado === \'alto\' && (\n                            <ArrowUp className=\"h-3.5 w-3.5\" aria-label=\"Elevado\" />\n                          )}\n                          {row.alterado === \'baixo\' && (\n                            <ArrowDown className=\"h-3.5 w-3.5\" aria-label=\"Reduzido\" />\n                          )}\n                          {row.resultado}\n                        </span>\n                      </td>\n                      <td className=\"px-4 py-2.5 text-right font-mono text-xs tabular-nums text-slate-500 dark:text-slate-400\">\n                        {row.referencia}\n                      </td>\n                    </tr>\n                  ))}\n                </tbody>\n              </table>\n            </div>\n          )}\n        </div>\n\n        {/* Alternatives List (Clean Cards + Inline Expandable \"Ver coment\303\241rio\") */}\n        <div\n          className=\"mt-7 space-y-3\"\n          role=\"radiogroup\"\n          aria-label=\"Alternativas da quest\303\243o\"\n        >\n          {question.alternativas.map((alt) => {\n            const isEliminated = eliminated.includes(alt.letter);\n            const isSelected = activeChoice === alt.letter;\n            const isOfficial = alt.letter === question.gabaritoOficial;\n            const isWrongChosen = isRevealed && isSelected && !isOfficial;\n            const isPrincipalDistractor =\n              isRevealed &&\n              !isOfficial &&\n              principalDistractor?.letter === alt.letter;\n            const isCommentExpanded = expandedComments.includes(alt.letter);\n\n            return (\n              <div\n                key={alt.letter}\n                onClick={() => handleOptionClick(alt.letter)}\n                role=\"radio\"\n                aria-checked={isSelected}\n                tabIndex={isRevealed ? -1 : 0}\n                onKeyDown={(e) => {\n                  if (e.key === \'Enter\' || e.key === \' \') {\n                    e.preventDefault();\n                    handleOptionClick(alt.letter);\n                  }\n                }}\n                className={cn(\n                  \'group relative rounded-xl border px-4 py-4 transition-colors duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-500\',\n                  !isRevealed && !isEliminated && \'cursor-pointer\',\n                  !isRevealed &&\n                    isEliminated &&\n                    \'opacity-50 bg-slate-50 dark:bg-slate-950/40\',\n                  !isRevealed &&\n                    isSelected &&\n                    \'border-sky-500 bg-sky-50/70 dark:border-sky-400 dark:bg-sky-950/30\',\n                  !isRevealed &&\n                    !isSelected &&\n                    !isEliminated &&\n                    \'border-slate-200/90 bg-slate-50/40 hover:border-slate-300 hover:bg-white dark:border-slate-800 dark:bg-slate-950/30 dark:hover:border-slate-700 dark:hover:bg-slate-800/50\',\n                  isRevealed &&\n                    isOfficial &&\n                    \'border-emerald-300 bg-emerald-50/60 dark:border-emerald-800 dark:bg-emerald-950/30\',\n                  isRevealed &&\n                    isWrongChosen &&\n                    \'border-red-300 bg-red-50/70 dark:border-red-800 dark:bg-red-950/30\',\n                  isRevealed &&\n                    !isOfficial &&\n                    !isWrongChosen &&\n                    \'border-slate-200/90 bg-slate-50/40 dark:border-slate-800 dark:bg-slate-950/30\'\n                )}\n              >\n                <div className=\"flex items-start gap-3.5\">\n                  {/* Letter Badge (transforms into \342\234\223 or \342\234\225 upon reveal) */}\n                  <span\n                    className={cn(\n                      \'mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-lg border font-mono text-xs font-bold transition-colors\',\n                      !isRevealed &&\n                        isSelected &&\n                        \'border-sky-600 bg-sky-600 text-white dark:border-sky-400 dark:bg-sky-400 dark:text-slate-950\',\n                      !isRevealed &&\n                        !isSelected &&\n                        \'border-slate-200 bg-slate-100/90 text-slate-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300\',\n                      isRevealed &&\n                        isOfficial &&\n                        \'border-emerald-600 bg-emerald-600 text-white dark:border-emerald-500 dark:bg-emerald-500 dark:text-slate-950\',\n                      isRevealed &&\n                        isWrongChosen &&\n                        \'border-red-600 bg-red-600 text-white dark:border-red-500 dark:bg-red-500 dark:text-white\',\n                      isRevealed &&\n                        !isOfficial &&\n                        !isWrongChosen &&\n                        \'border-slate-200 bg-slate-100 text-slate-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-400\'\n                    )}\n                  >\n                    {isRevealed && isOfficial ? (\n                      <Check className=\"h-3.5 w-3.5\" aria-label={`Correta (${alt.letter})`} />\n                    ) : isRevealed && isWrongChosen ? (\n                      <X className=\"h-3.5 w-3.5\" aria-label={`Incorreta (${alt.letter})`} />\n                    ) : (\n                      alt.letter\n                    )}\n                  </span>\n\n                  {/* Alternative Text + Inline Expandable Commentary */}\n                  <div className=\"min-w-0 flex-1 space-y-2.5\">\n                    <p\n                      className={cn(\n                        \'max-w-[75ch] text-sm sm:text-[15px] leading-relaxed text-slate-800 dark:text-slate-100\',\n                        isEliminated &&\n                          !isRevealed &&\n                          \'line-through text-slate-400 dark:text-slate-500\'\n                      )}\n                    >\n                      {alt.text}\n                    </p>\n\n                    {/* Post-answer inline controls: \"Ver coment\303\241rio\" + Community % */}\n                    {isRevealed && (\n                      <div className=\"space-y-2.5 pt-0.5\">\n                        <div className=\"flex flex-wrap items-center justify-between gap-2 text-xs\">\n                          <div className=\"flex flex-wrap items-center gap-3\">\n                            <button\n                              type=\"button\"\n                              onClick={(e) => handleToggleInlineComment(alt.letter, e)}\n                              aria-expanded={isCommentExpanded}\n                              className=\"inline-flex items-center gap-1 font-medium text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-100 transition-colors cursor-pointer\"\n                            >\n                              {isCommentExpanded ? (\n                                <ChevronUp className=\"h-3.5 w-3.5\" />\n                              ) : (\n                                <ChevronDown className=\"h-3.5 w-3.5\" />\n                              )}\n                              <span>\n                                {isCommentExpanded\n                                  ? \'Ocultar coment\303\241rio\'\n                                  : \'Ver coment\303\241rio\'}\n                              </span>\n                            </button>\n\n                            {isOfficial && (\n                              <span className=\"inline-flex items-center gap-1 font-semibold text-emerald-700 dark:text-emerald-400\">\n                                <CheckCircle2 className=\"h-3.5 w-3.5\" />\n                                <span>Gabarito oficial</span>\n                              </span>\n                            )}\n                            {isWrongChosen && (\n                              <span className=\"inline-flex items-center gap-1 font-semibold text-red-700 dark:text-red-400\">\n                                <XCircle className=\"h-3.5 w-3.5\" />\n                                <span>Sua escolha</span>\n                              </span>\n                            )}\n                            {isPrincipalDistractor && (\n                              <span className=\"inline-flex items-center gap-1 font-medium text-amber-700 dark:text-amber-400\">\n                                <AlertTriangle className=\"h-3.5 w-3.5\" />\n                                <span>Principal distrator</span>\n                              </span>\n                            )}\n                          </div>\n\n                          <span className=\"font-mono font-semibold tabular-nums text-slate-600 dark:text-slate-300\">\n                            {alt.communityPct.toFixed(1)}%\n                          </span>\n                        </div>\n\n                        {/* Subtle Community Share Bar */}\n                        <div className=\"h-1.5 w-full overflow-hidden rounded-full bg-slate-200/70 dark:bg-slate-800\">\n                          <div\n                            className={cn(\n                              \'h-full rounded-full transition-all duration-300\',\n                              isOfficial && \'bg-emerald-600 dark:bg-emerald-500\',\n                              isWrongChosen && \'bg-red-500 dark:bg-red-500\',\n                              !isOfficial &&\n                                !isWrongChosen &&\n                                isPrincipalDistractor &&\n                                \'bg-amber-500 dark:bg-amber-400\',\n                              !isOfficial &&\n                                !isWrongChosen &&\n                                !isPrincipalDistractor &&\n                                \'bg-slate-400 dark:bg-slate-600\'\n                            )}\n                            style={{ width: `${Math.max(alt.communityPct, 1.5)}%` }}\n                          />\n                        </div>\n\n                        {/* Inline Expanded Explanation */}\n                        {isCommentExpanded && (\n                          <div className=\"rounded-lg border border-slate-200/80 bg-white/90 px-3.5 py-2.5 text-sm leading-relaxed text-slate-700 dark:border-slate-700/80 dark:bg-slate-900/90 dark:text-slate-200\">\n                            {alt.explanation}\n                          </div>\n                        )}\n                      </div>\n                    )}\n                  </div>\n\n                  {/* Eliminate / Strikethrough affordance */}\n                  {!isRevealed && (\n                    <button\n                      type=\"button\"\n                      onClick={(e) => toggleEliminate(alt.letter, e)}\n                      title={\n                        isEliminated\n                          ? \'Restaurar alternativa\'\n                          : \'Riscar / eliminar alternativa\'\n                      }\n                      aria-label={\n                        isEliminated\n                          ? `Restaurar alternativa ${alt.letter}`\n                          : `Riscar alternativa ${alt.letter}`\n                      }\n                      className={cn(\n                        \'shrink-0 rounded-lg p-1.5 transition-colors cursor-pointer\',\n                        isEliminated\n                          ? \'bg-slate-200 text-slate-800 dark:bg-slate-700 dark:text-slate-100\'\n                          : \'text-slate-400 opacity-70 hover:bg-slate-100 hover:text-slate-700 hover:opacity-100 dark:hover:bg-slate-800 dark:hover:text-slate-200\'\n                      )}\n                    >\n                      <Strikethrough className=\"h-4 w-4\" />\n                    </button>\n                  )}\n                </div>\n              </div>\n            );\n          })}\n        </div>\n\n        {/* Bottom Action Bar: Mapa Popover + Responder + Prev/Next */}\n        <div className=\"mt-6 flex flex-wrap items-center justify-between gap-3 border-t border-slate-100 pt-5 dark:border-slate-800\">\n          <div className=\"flex flex-wrap items-center gap-2.5\">\n            {/* Compact Mapa Trigger Button */}\n            {sessionQuestions.length > 1 && (\n              <div className=\"relative\">\n                <button\n                  type=\"button\"\n                  onClick={() => setShowMap((m) => !m)}\n                  aria-expanded={showMap}\n                  className={cn(\n                    \'inline-flex items-center gap-1.5 rounded-full border px-3.5 py-1.5 text-xs font-semibold transition-colors cursor-pointer whitespace-nowrap\',\n                    showMap\n                      ? \'border-sky-500 bg-sky-50 text-sky-700 dark:border-sky-400 dark:bg-sky-950/50 dark:text-sky-300\'\n                      : \'border-slate-200 bg-slate-50 text-slate-700 hover:border-slate-300 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800/80 dark:text-slate-200 dark:hover:bg-slate-800\'\n                  )}\n                >\n                  <MapIcon className=\"h-3.5 w-3.5\" />\n                  <span>Mapa</span>\n                </button>\n\n                {/* Question Session Map Popover */}\n                {showMap && (\n                  <div className=\"absolute bottom-full left-0 z-30 mb-2 w-72 sm:w-80 rounded-xl border border-slate-200 bg-white p-4 shadow-xl dark:border-slate-700 dark:bg-slate-900 space-y-3\">\n                    <div className=\"flex items-center justify-between gap-2\">\n                      <p className=\"font-display text-xs font-bold text-slate-900 dark:text-white\">\n                        Mapa da Sess\303\243o ({total} quest\303\265es)\n                      </p>\n                      <button\n                        type=\"button\"\n                        onClick={() => setShowMap(false)}\n                        aria-label=\"Fechar mapa\"\n                        className=\"text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 cursor-pointer\"\n                      >\n                        <X className=\"h-3.5 w-3.5\" />\n                      </button>\n                    </div>\n\n                    <div className=\"grid grid-cols-6 gap-1.5\">\n                      {sessionQuestions.map((sq, idx) => {\n                        const isCurrent = idx === index;\n                        return (\n                          <button\n                            key={sq.id}\n                            type=\"button\"\n                            onClick={() => {\n                              onSelectQuestionIndex?.(idx);\n                              setShowMap(false);\n                            }}\n                            title={`Q${idx + 1} \302\267 ${sq.institutionLabel} \302\267 ${sq.tema}`}\n                            className={cn(\n                              \'relative flex h-9 items-center justify-center rounded-lg border font-mono text-xs font-semibold tabular-nums transition-colors cursor-pointer\',\n                              isCurrent &&\n                                \'ring-2 ring-sky-500 ring-offset-1 dark:ring-offset-slate-900\',\n                              sq.status === \'correct\' &&\n                                \'border-emerald-300 bg-emerald-50 text-emerald-700 dark:border-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300\',\n                              sq.status === \'wrong\' &&\n                                \'border-red-300 bg-red-50 text-red-700 dark:border-red-800 dark:bg-red-950/60 dark:text-red-300\',\n                              sq.status === \'draft\' &&\n                                \'border-sky-300 bg-sky-50 text-sky-700 dark:border-sky-800 dark:bg-sky-950/60 dark:text-sky-300\',\n                              sq.status === \'unanswered\' &&\n                                \'border-slate-200 bg-slate-50 text-slate-600 hover:bg-slate-100 dark:border-slate-800 dark:bg-slate-950 dark:text-slate-400\'\n                            )}\n                          >\n                            {idx + 1}\n                            {sq.isFlagged && (\n                              <span\n                                aria-hidden=\"true\"\n                                className=\"absolute -top-1 -right-1 h-2 w-2 rounded-full bg-amber-500\"\n                              />\n                            )}\n                          </button>\n                        );\n                      })}\n                    </div>\n\n                    <div className=\"flex flex-wrap items-center gap-x-3 gap-y-1 border-t border-slate-100 pt-2 text-[10px] text-slate-500 dark:border-slate-800 dark:text-slate-400\">\n                      <span className=\"inline-flex items-center gap-1\">\n                        <span className=\"h-2 w-2 rounded-full bg-emerald-500\" />\n                        Certa\n                      </span>\n                      <span className=\"inline-flex items-center gap-1\">\n                        <span className=\"h-2 w-2 rounded-full bg-red-500\" />\n                        Errada\n                      </span>\n                      <span className=\"inline-flex items-center gap-1\">\n                        <span className=\"h-2 w-2 rounded-full bg-slate-300 dark:bg-slate-700\" />\n                        Pendente\n                      </span>\n                    </div>\n                  </div>\n                )}\n              </div>\n            )}\n\n            {mode === \'estudo\' && !isRevealed && (\n              <Button\n                variant=\"primary\"\n                size=\"md\"\n                disabled={!selectedPending}\n                onClick={handleConfirmStudy}\n              >\n                Responder quest\303\243o\n              </Button>\n            )}\n\n            {isRevealed && (\n              <div className=\"flex items-center gap-2 text-sm font-semibold\">\n                {isUserCorrect ? (\n                  <span className=\"inline-flex items-center gap-1.5 text-emerald-700 dark:text-emerald-400\">\n                    <CheckCircle2 className=\"h-4 w-4\" />\n                    <span>Voc\303\252 acertou \342\200\224 Gabarito {question.gabaritoOficial}</span>\n                  </span>\n                ) : activeChoice ? (\n                  <span className=\"inline-flex items-center gap-1.5 text-red-700 dark:text-red-400\">\n                    <XCircle className=\"h-4 w-4\" />\n                    <span>\n                      Voc\303\252 marcou {activeChoice} \302\267 Gabarito oficial:{\' \'}\n                      {question.gabaritoOficial}\n                    </span>\n                  </span>\n                ) : (\n                  <span className=\"inline-flex items-center gap-1.5 text-slate-600 dark:text-slate-300\">\n                    <span>\n                      Em branco \302\267 Gabarito oficial: {question.gabaritoOficial}\n                    </span>\n                  </span>\n                )}\n              </div>\n            )}\n\n            {mode === \'simulado\' && !simuladoFinished && (\n              <span className=\"text-xs text-slate-500 dark:text-slate-400\">\n                {simuladoDraft\n                  ? `Alternativa ${simuladoDraft} registrada para entrega`\n                  : \'Selecione uma alternativa ou risque distratores\'}\n              </span>\n            )}\n          </div>\n\n          <div className=\"flex items-center gap-2\">\n            <Button\n              variant=\"outline\"\n              size=\"sm\"\n              onClick={onPrev}\n              disabled={index <= 0}\n            >\n              <ChevronLeft className=\"h-4 w-4\" />\n              <span>Anterior</span>\n            </Button>\n            <Button\n              variant=\"outline\"\n              size=\"sm\"\n              onClick={onNext}\n              disabled={index >= total - 1}\n            >\n              <span>Pr\303\263xima</span>\n              <ChevronRight className=\"h-4 w-4\" />\n            </Button>\n          </div>\n        </div>\n      </div>\n\n      {/* Community Statistics & Didactic Commentary Panel (Revealed Post-Answer) */}\n      {isRevealed && (\n        <div className=\"border-t border-slate-200 bg-slate-50/70 px-5 py-6 sm:px-8 dark:border-slate-800 dark:bg-slate-950/50 space-y-6 rounded-b-2xl\">\n          {/* Community Crossing Metrics Row */}\n          <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-4 pb-5 border-b border-slate-200 dark:border-slate-800\">\n            <div>\n              <p className=\"text-xs text-slate-500 dark:text-slate-400\">\n                Taxa Global de Acertos\n              </p>\n              <p className=\"mt-1 font-mono text-xl font-bold tabular-nums text-emerald-700 dark:text-emerald-400\">\n                {question.taxaAcertoGlobal.toFixed(1)}%\n              </p>\n            </div>\n            <div>\n              <p className=\"text-xs text-slate-500 dark:text-slate-400\">\n                Principal Distrator\n              </p>\n              <p className=\"mt-1 font-mono text-xl font-bold tabular-nums text-amber-700 dark:text-amber-400\">\n                Alt. {principalDistractor?.letter}{\' \'}\n                <span className=\"text-sm font-medium\">\n                  ({principalDistractor?.communityPct.toFixed(1)}%)\n                </span>\n              </p>\n            </div>\n            <div>\n              <p className=\"text-xs text-slate-500 dark:text-slate-400\">\n                Dificuldade Din\303\242mica\n              </p>\n              <p className=\"mt-1 font-display text-base font-bold text-slate-900 dark:text-slate-100\">\n                {difficulty}\n              </p>\n            </div>\n            <div>\n              <p className=\"text-xs text-slate-500 dark:text-slate-400\">\n                Respostas na Plataforma\n              </p>\n              <p className=\"mt-1 inline-flex items-center gap-1.5 font-mono text-base font-semibold tabular-nums text-slate-800 dark:text-slate-200\">\n                <Users className=\"h-4 w-4 text-slate-400\" />\n                {question.totalRespostasComunidade.toLocaleString(\'pt-BR\')}\n              </p>\n            </div>\n          </div>\n\n          {/* Immediate Student vs. Community Median Progress Comparison (Study Mode) */}\n          {mode === \'estudo\' && benchmarks && (\n            <StudentVsMedianBar\n              topicBenchmark={benchmarks.topic}\n              areaBenchmark={benchmarks.area}\n              overallBenchmark={benchmarks.overall}\n            />\n          )}\n\n          {/* Didactic Commentary Navigation + Criar Flashcard CTA */}\n          <div className=\"space-y-4\">\n            <div className=\"flex flex-wrap items-center justify-between gap-3\">\n              <div className=\"flex flex-wrap items-center gap-1 rounded-lg bg-slate-200/70 p-1 w-fit dark:bg-slate-800\">\n                <button\n                  type=\"button\"\n                  onClick={() => setCommentTab(\'alternativas\')}\n                  className={cn(\n                    \'inline-flex items-center gap-1.5 rounded-md px-3 py-1.5 text-xs font-semibold transition-colors cursor-pointer whitespace-nowrap\',\n                    commentTab === \'alternativas\'\n                      ? \'bg-white text-slate-900 shadow-sm dark:bg-slate-950 dark:text-white\'\n                      : \'text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-200\'\n                  )}\n                >\n                  <BookOpen className=\"h-3.5 w-3.5\" />\n                  <span>Coment\303\241rio Completo</span>\n                </button>\n                <button\n                  type=\"button\"\n                  onClick={() => setCommentTab(\'referencias\')}\n                  className={cn(\n                    \'inline-flex items-center gap-1.5 rounded-md px-3 py-1.5 text-xs font-semibold transition-colors cursor-pointer whitespace-nowrap\',\n                    commentTab === \'referencias\'\n                      ? \'bg-white text-slate-900 shadow-sm dark:bg-slate-950 dark:text-white\'\n                      : \'text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-200\'\n                  )}\n                >\n                  <FileText className=\"h-3.5 w-3.5\" />\n                  <span>Refer\303\252ncias ({question.referencias.length})</span>\n                </button>\n              </div>\n\n              {onCreateFlashcard &&\n                (hasFlashcard ? (\n                  <Button\n                    variant=\"outline\"\n                    size=\"sm\"\n                    onClick={onOpenFlashcards}\n                    className=\"border-emerald-300 bg-emerald-50/70 text-emerald-700 hover:bg-emerald-100/70 dark:border-emerald-800 dark:bg-emerald-950/40 dark:text-emerald-300 dark:hover:bg-emerald-950/70\"\n                  >\n                    <Check className=\"h-3.5 w-3.5\" />\n                    <span>Salvo nos Flashcards</span>\n                  </Button>\n                ) : (\n                  <Button\n                    variant=\"outline\"\n                    size=\"sm\"\n                    onClick={onCreateFlashcard}\n                    className=\"border-sky-300 bg-white text-sky-700 hover:bg-sky-50 dark:border-sky-800 dark:bg-slate-900 dark:text-sky-300 dark:hover:bg-sky-950/40\"\n                  >\n                    <Layers className=\"h-3.5 w-3.5\" />\n                    <span>Criar Flashcard</span>\n                  </Button>\n                ))}\n            </div>\n\n            {commentTab === \'alternativas\' && (\n              <div className=\"max-w-[75ch] space-y-5\">\n                <p className=\"text-sm leading-relaxed text-slate-700 dark:text-slate-300\">\n                  {question.comentarioGeral}\n                </p>\n\n                <div className=\"divide-y divide-slate-200 border-t border-slate-200 dark:divide-slate-800 dark:border-slate-800\">\n                  {question.alternativas.map((alt) => {\n                    const correct = alt.letter === question.gabaritoOficial;\n                    return (\n                      <div key={alt.letter} className=\"py-3.5 space-y-1\">\n                        <div className=\"flex items-center gap-2 text-xs font-semibold\">\n                          <span className=\"font-mono text-slate-900 dark:text-white\">\n                            Alternativa {alt.letter}\n                          </span>\n                          <span aria-hidden=\"true\" className=\"text-slate-400\">\n                            \302\267\n                          </span>\n                          <span\n                            className={\n                              correct\n                                ? \'text-emerald-700 dark:text-emerald-400\'\n                                : \'text-red-700 dark:text-red-400\'\n                            }\n                          >\n                            {correct ? \'Correta\' : \'Incorreta\'}\n                          </span>\n                          <span aria-hidden=\"true\" className=\"text-slate-400\">\n                            \302\267\n                          </span>\n                          <span className=\"font-mono tabular-nums text-slate-500 dark:text-slate-400\">\n                            {alt.communityPct.toFixed(1)}%\n                          </span>\n                        </div>\n                        <p className=\"text-sm leading-relaxed text-slate-700 dark:text-slate-300\">\n                          {alt.explanation}\n                        </p>\n                      </div>\n                    );\n                  })}\n                </div>\n              </div>\n            )}\n\n            {commentTab === \'referencias\' && (\n              <div className=\"max-w-[75ch] space-y-2.5\">\n                <p className=\"text-xs font-semibold text-slate-600 dark:text-slate-400\">\n                  Bibliografia e Diretrizes Oficiais\n                </p>\n                <ul className=\"list-disc pl-5 space-y-2 text-sm text-slate-700 dark:text-slate-300\">\n                  {question.referencias.map((ref) => (\n                    <li key={ref}>{ref}</li>\n                  ))}\n                </ul>\n              </div>\n            )}\n          </div>\n        </div>\n      )}\n    </article>\n  );\n}\n"
