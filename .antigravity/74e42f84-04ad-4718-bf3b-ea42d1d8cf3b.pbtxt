            }
            lines {
              text: "  subtopic_id         INTEGER NOT NULL REFERENCES medical_subtopics(id),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  institution_id      INTEGER NOT NULL REFERENCES institutions(id),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  exam_year           SMALLINT NOT NULL CHECK (exam_year BETWEEN 2010 AND 2030),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  exam_type           exam_type NOT NULL DEFAULT \'ACESSO_DIRETO\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  stem                TEXT NOT NULL,        -- Enunciado cl\303\255nico completo"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  lab_table_json      JSONB,                -- Tabelas laboratoriais estruturadas"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  clinical_image_url  TEXT,                 -- ECG, RX, TC, RM, Dermatoscopia"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  clinical_image_meta JSONB,                -- { caption, modality, aspectRatio }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  official_answer     alternative_letter NOT NULL,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  is_annulled         BOOLEAN NOT NULL DEFAULT FALSE,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  is_outdated         BOOLEAN NOT NULL DEFAULT FALSE,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  has_image           BOOLEAN GENERATED ALWAYS AS (clinical_image_url IS NOT NULL) STORED,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  -- Estat\303\255sticas agregadas (atualizadas via trigger incremental / batch)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  total_attempts      INTEGER NOT NULL DEFAULT 0,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  correct_attempts    INTEGER NOT NULL DEFAULT 0,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  global_accuracy_pct NUMERIC(5,2) GENERATED ALWAYS AS ("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    CASE WHEN total_attempts > 0"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      THEN ROUND((correct_attempts::NUMERIC / total_attempts::NUMERIC) * 100, 2)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      ELSE 0"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    END"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  ) STORED,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  difficulty          difficulty_level GENERATED ALWAYS AS ("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    CASE"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      WHEN total_attempts < 20 THEN \'MEDIO\'::difficulty_level"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      WHEN (correct_attempts::NUMERIC / NULLIF(total_attempts, 0)) > 0.70 THEN \'FACIL\'::difficulty_level"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      WHEN (correct_attempts::NUMERIC / NULLIF(total_attempts, 0)) >= 0.40 THEN \'MEDIO\'::difficulty_level"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      ELSE \'DIFICIL\'::difficulty_level"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    END"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  ) STORED,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  -- Coment\303\241rio did\303\241tico estruturado"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  general_commentary  TEXT NOT NULL,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  clinical_pearl      TEXT NOT NULL,        -- P\303\251rola Cl\303\255nica / Ponto-Chave"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  references_json     JSONB NOT NULL DEFAULT \'[]\'::JSONB, -- Harrison, Sabiston, Williams, SBP..."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  -- Vetor de busca textual em portugu\303\252s (enunciado + coment\303\241rio)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  search_vector       TSVECTOR GENERATED ALWAYS AS ("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    setweight(to_tsvector(\'portuguese\', coalesce(stem, \'\')), \'A\') ||"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    setweight(to_tsvector(\'portuguese\', coalesce(general_commentary, \'\')), \'B\') ||"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    setweight(to_tsvector(\'portuguese\', coalesce(clinical_pearl, \'\')), \'B\')"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  ) STORED,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  created_at          TIMESTAMPTZ NOT NULL DEFAULT NOW(),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  updated_at          TIMESTAMPTZ NOT NULL DEFAULT NOW()"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: ");"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "CREATE TABLE question_alternatives ("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  id              UUID PRIMARY KEY DEFAULT gen_random_uuid(),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  question_id     UUID NOT NULL REFERENCES questions(id) ON DELETE CASCADE,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  letter          alternative_letter NOT NULL,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  content         TEXT NOT NULL,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  explanation     TEXT NOT NULL,            -- Justificativa espec\303\255fica alternativa por alternativa"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  selection_count INTEGER NOT NULL DEFAULT 0,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  UNIQUE (question_id, letter)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: ");"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "-- \303\215ndices compostos otimizados para o Motor de Filtros combin\303\241veis em tempo real"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "CREATE INDEX idx_questions_taxonomy ON questions(area_id, topic_id, subtopic_id);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "CREATE INDEX idx_questions_exam_meta ON questions(institution_id, exam_year DESC, exam_type);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "CREATE INDEX idx_questions_flags ON questions(is_annulled, is_outdated, has_image, difficulty);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "CREATE INDEX idx_questions_search_gin ON questions USING GIN (search_vector);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "CREATE INDEX idx_alternatives_question ON question_alternatives(question_id, letter);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "-- -----------------------------------------------------------------------------"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "-- 5. PERFIS DE ALUNOS (COM CONTROLE DE PRIVACIDADE / PSEUD\303\224NIMO)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "-- -----------------------------------------------------------------------------"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "CREATE TABLE user_profiles ("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  id                  UUID PRIMARY KEY,     -- Referencia auth.users(id) no Supabase"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  real_name           TEXT NOT NULL,        -- Ex: Dr. Jo\303\243o Silva"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  pseudonym           TEXT NOT NULL UNIQUE, -- Ex: FutureR1_Cardio"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  use_pseudonym       BOOLEAN NOT NULL DEFAULT FALSE,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  target_specialty    TEXT,                 -- Ex: Cl\303\255nica M\303\251dica, Cirurgia Geral"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  target_institution  TEXT,                 -- Ex: USP-SP, ENARE"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  avatar_initials     VARCHAR(3) NOT NULL,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  created_at          TIMESTAMPTZ NOT NULL DEFAULT NOW(),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  updated_at          TIMESTAMPTZ NOT NULL DEFAULT NOW()"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: ");"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "-- -----------------------------------------------------------------------------"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "-- 6. RESPOSTAS DOS ALUNOS, SIMULADOS E CADERNO DE ERROS"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "-- -----------------------------------------------------------------------------"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "CREATE TABLE simulados ("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  id                UUID PRIMARY KEY DEFAULT gen_random_uuid(),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  user_id           UUID NOT NULL REFERENCES user_profiles(id) ON DELETE CASCADE,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  title             TEXT NOT NULL,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  duration_seconds  INTEGER NOT NULL,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  elapsed_seconds   INTEGER NOT NULL DEFAULT 0,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  total_questions   SMALLINT NOT NULL,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  correct_count     SMALLINT NOT NULL DEFAULT 0,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  completed_at      TIMESTAMPTZ,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  created_at        TIMESTAMPTZ NOT NULL DEFAULT NOW()"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: ");"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "CREATE TABLE user_answers ("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  id                UUID PRIMARY KEY DEFAULT gen_random_uuid(),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  user_id           UUID NOT NULL REFERENCES user_profiles(id) ON DELETE CASCADE,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  question_id       UUID NOT NULL REFERENCES questions(id) ON DELETE CASCADE,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  simulado_id       UUID REFERENCES simulados(id) ON DELETE SET NULL,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  selected_letter   alternative_letter NOT NULL,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  is_correct        BOOLEAN NOT NULL,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  mode              session_mode NOT NULL DEFAULT \'ESTUDO\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  time_spent_sec    INTEGER NOT NULL DEFAULT 0,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  answered_at       TIMESTAMPTZ NOT NULL DEFAULT NOW()"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: ");"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "CREATE TABLE user_question_bookmarks ("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  user_id           UUID NOT NULL REFERENCES user_profiles(id) ON DELETE CASCADE,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  question_id       UUID NOT NULL REFERENCES questions(id) ON DELETE CASCADE,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  personal_note     TEXT,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  created_at        TIMESTAMPTZ NOT NULL DEFAULT NOW(),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  PRIMARY KEY (user_id, question_id)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: ");"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "-- \303\215ndices cr\303\255ticos para status do aluno (\"N\303\243o resolvidas\", \"Erradas\", \"Acertadas\") e s\303\251ries temporais"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "CREATE INDEX idx_user_answers_user_question ON user_answers(user_id, question_id, answered_at DESC);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "CREATE INDEX idx_user_answers_user_time ON user_answers(user_id, answered_at DESC);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "CREATE INDEX idx_user_answers_question_stats ON user_answers(question_id, selected_letter);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "CREATE INDEX idx_user_answers_daily_ranking ON user_answers(answered_at DESC, user_id) INCLUDE (is_correct);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "-- -----------------------------------------------------------------------------"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "-- 7. PRESEN\303\207A E RANKING AO VIVO (PONTUA\303\207\303\203O PONDERADA ANTI-CHUTE)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "--    F\303\263rmula: score = ROUND(questions_today * 10 * (0.4 + 0.6 * (accuracy_pct / 100.0)) + streak_bonus)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "-- -----------------------------------------------------------------------------"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "CREATE TABLE live_study_presence ("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  user_id             UUID PRIMARY KEY REFERENCES user_profiles(id) ON DELETE CASCADE,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  is_online           BOOLEAN NOT NULL DEFAULT TRUE,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  last_heartbeat_at   TIMESTAMPTZ NOT NULL DEFAULT NOW(),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  questions_today     INTEGER NOT NULL DEFAULT 0,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  correct_today       INTEGER NOT NULL DEFAULT 0,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  current_streak      INTEGER NOT NULL DEFAULT 0,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  weighted_score      NUMERIC(10,2) GENERATED ALWAYS AS ("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    CASE WHEN questions_today > 0"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      THEN ROUND("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        questions_today * 10.0 * (0.4 + 0.6 * (correct_today::NUMERIC / questions_today::NUMERIC))"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        + LEAST(current_streak * 2.5, 40.0),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        2"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      )"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      ELSE 0"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    END"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  ) STORED"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: ");"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "CREATE INDEX idx_live_presence_leaderboard"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  ON live_study_presence(is_online, weighted_score DESC, correct_today DESC)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  WHERE is_online = TRUE;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "-- -----------------------------------------------------------------------------"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "-- 8. VIEWS ANAL\303\215TICAS: MEDIANA DA COMUNIDADE (percentile_cont(0.5)) E P75"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "--    Recalculadas via REFRESH MATERIALIZED VIEW CONCURRENTLY (pg_cron a cada 15 min)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "-- -----------------------------------------------------------------------------"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "-- A) Mediana e Percentil 75 por Grande \303\201rea"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "CREATE MATERIALIZED VIEW mv_community_benchmarks_by_area AS"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "WITH user_area_accuracy AS ("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  SELECT"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ua.user_id,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    q.area_id,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    COUNT(*) AS attempts,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    (SUM(CASE WHEN ua.is_correct THEN 1 ELSE 0 END)::NUMERIC / COUNT(*)::NUMERIC) * 100.0 AS accuracy_pct"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  FROM user_answers ua"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  JOIN questions q ON q.id = ua.question_id"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  GROUP BY ua.user_id, q.area_id"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  HAVING COUNT(*) >= 5 -- Filtro estat\303\255stico para evitar ru\303\255do de amostra m\303\255nima"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: ")"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "SELECT"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  ma.id AS area_id,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  ma.name AS area_name,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  COUNT(uaa.user_id) AS active_students,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  ROUND("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    percentile_cont(0.5) WITHIN GROUP (ORDER BY uaa.accuracy_pct)::NUMERIC, 1"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  ) AS community_median_pct,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  ROUND("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    percentile_cont(0.75) WITHIN GROUP (ORDER BY uaa.accuracy_pct)::NUMERIC, 1"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  ) AS community_p75_pct,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  ROUND(AVG(uaa.accuracy_pct)::NUMERIC, 1) AS community_mean_pct"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "FROM medical_areas ma"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "LEFT JOIN user_area_accuracy uaa ON uaa.area_id = ma.id"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "GROUP BY ma.id, ma.name;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "CREATE UNIQUE INDEX idx_mv_bench_area ON mv_community_benchmarks_by_area(area_id);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "-- B) Mediana e Percentil 75 por Especialidade / Tema"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "CREATE MATERIALIZED VIEW mv_community_benchmarks_by_topic AS"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "WITH user_topic_accuracy AS ("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  SELECT"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ua.user_id,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    q.area_id,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    q.topic_id,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    (SUM(CASE WHEN ua.is_correct THEN 1 ELSE 0 END)::NUMERIC / COUNT(*)::NUMERIC) * 100.0 AS accuracy_pct"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  FROM user_answers ua"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  JOIN questions q ON q.id = ua.question_id"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  GROUP BY ua.user_id, q.area_id, q.topic_id"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  HAVING COUNT(*) >= 3"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: ")"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "SELECT"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  mt.id AS topic_id,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  mt.area_id,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  mt.name AS topic_name,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  COUNT(uta.user_id) AS active_students,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  ROUND("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    percentile_cont(0.5) WITHIN GROUP (ORDER BY uta.accuracy_pct)::NUMERIC, 1"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  ) AS community_median_pct,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  ROUND("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    percentile_cont(0.75) WITHIN GROUP (ORDER BY uta.accuracy_pct)::NUMERIC, 1"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  ) AS community_p75_pct"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "FROM medical_topics mt"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "LEFT JOIN user_topic_accuracy uta ON uta.topic_id = mt.id"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "GROUP BY mt.id, mt.area_id, mt.name;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "CREATE UNIQUE INDEX idx_mv_bench_topic ON mv_community_benchmarks_by_topic(topic_id);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "-- C) Consulta SQL de exemplo: Comparativo Aluno vs. Mediana da Comunidade por Grande \303\201rea"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "-- SELECT"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "--   b.area_name,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "--   COUNT(ua.id) AS questoes_feitas,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "--   ROUND((SUM(CASE WHEN ua.is_correct THEN 1 ELSE 0 END)::NUMERIC / NULLIF(COUNT(ua.id), 0)) * 100, 1) AS aluno_pct,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "--   b.community_median_pct AS mediana_comunidade_pct,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "--   b.community_p75_pct AS p75_comunidade_pct,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "--   ROUND("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "--     ((SUM(CASE WHEN ua.is_correct THEN 1 ELSE 0 END)::NUMERIC / NULLIF(COUNT(ua.id), 0)) * 100) - b.community_median_pct,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "--     1"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "--   ) AS delta_pct"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "-- FROM mv_community_benchmarks_by_area b"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "-- LEFT JOIN questions q ON q.area_id = b.area_id"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "-- LEFT JOIN user_answers ua ON ua.question_id = q.id AND ua.user_id = $1"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "-- GROUP BY b.area_id, b.area_name, b.community_median_pct, b.community_p75_pct"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "-- ORDER BY b.area_id;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
          }
        }
        absolute_uri: "file:///database/schema.sql"
        create_file: true
      }
    }
    use_fast_apply: true
    description: "Create complete PostgreSQL / Supabase database schema with taxonomy, indexes, and percentile_cont(0.5) median views"
    diff_stats {
      additions: 300
    }
  }
}
