              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "): Record<SrsRating, FsrsScheduleOutcome> {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
