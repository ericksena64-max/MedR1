            }
            lines {
              text: "export function computeNextFsrsState("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  card: Flashcard,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
