    content: "              </div>\n            </div>\n\n            <div className=\"flex justify-end gap-2\">\n              <Button\n                variant=\"outline\"\n                size=\"sm\"\n                onClick={() => setShowCreateForm(false)}\n              >\n                Cancelar\n              </Button>\n              <Button type=\"submit\" variant=\"primary\" size=\"sm\">\n                Salvar no baralho\n              </Button>\n            </div>\n          </form>\n        )}\n      </section>\n\n      {/* VIEW 1: ACTIVE SRS REVIEW STAGE */}\n      {viewMode === \'revisao\' && (\n        <div className=\"mx-auto max-w-3xl\">\n          {activeCard ? (\n            <article className=\"rounded-xl border border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900\">\n              {/* Card Metadata Header */}\n              <div className=\"flex flex-wrap items-center justify-between gap-2 border-b border-slate-200 px-5 py-3.5 sm:px-7 dark:border-slate-800\">\n                <div className=\"flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-slate-500 dark:text-slate-400\">\n                  <span className=\"font-semibold text-sky-700 dark:text-sky-400\">\n                    {activeCard.grandeArea}\n                  </span>\n                  <span aria-hidden=\"true\">/</span>\n                  <span className=\"font-medium text-slate-800 dark:text-slate-200\">\n                    {activeCard.tema}\n                  </span>\n                  {activeCard.institutionLabel && (\n                    <>\n                      <span aria-hidden=\"true\">\302\267</span>\n                      <span className=\"font-mono\">{activeCard.institutionLabel}</span>\n                    </>\n                  )}\n                  <span aria-hidden=\"true\">\302\267</span>\n                  <span className=\"font-medium text-slate-700 dark:text-slate-300\">\n                    {FSRS_STATE_LABEL[activeCard.state]}\n                  </span>\n                  {activeCard.state !== \'New\' && (\n                    <>\n                      <span aria-hidden=\"true\">\302\267</span>\n                      <span className=\"font-mono tabular-nums\">\n                        S {activeCard.stability.toFixed(1)}d \302\267 D{\' \'}\n                        {activeCard.difficulty.toFixed(1)}\n                        {activeRetrievabilityPct !== null\n                          ? ` \302\267 R ${activeRetrievabilityPct}%`\n                          : \'\'}\n                      </span>\n                    </>\n                  )}\n                </div>\n\n                <span className=\"font-mono text-xs tabular-nums text-slate-500 dark:text-slate-400\">\n                  {practiceAhead\n                    ? `Pr\303\241tica livre \302\267 ${sessionIndex + 1}/${dueQueue.length}`\n                    : `Restam ${dueQueue.length} hoje`}\n                </span>\n              </div>\n\n              {/* Card Body: Front always visible, Back revealed on flip */}\n              <div className=\"px-5 py-8 sm:px-8 sm:py-10 space-y-6\">\n                <div className=\"space-y-2.5\">\n                  <p className=\"text-xs font-semibold text-slate-400 dark:text-slate-500\">\n                    Frente \342\200\224 Recorda\303\247\303\243o Ativa\n                  </p>\n                  <p className=\"max-w-[72ch] text-base sm:text-lg font-medium leading-[1.68] text-slate-900 dark:text-slate-100\">\n                    {activeCard.front}\n                  </p>\n                </div>\n\n                {!flipped ? (\n                  <div className=\"pt-6 border-t border-slate-100 dark:border-slate-800 flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n                    <div className=\"flex flex-wrap items-center gap-x-3 gap-y-1.5\">\n                      <p className=\"text-xs text-slate-500 dark:text-slate-400\">\n                        Tente formular a conduta mentalmente antes de revelar o verso.\n                      </p>\n\n                      {/* Pre-flip FSRS next-review forecast tooltip trigger */}\n                      {fsrsOutcomes && (\n                        <div className=\"relative group inline-flex\">\n                          <button\n                            type=\"button\"\n                            className=\"inline-flex items-center gap-1 text-xs font-medium text-sky-700 hover:text-sky-900 dark:text-sky-400 dark:hover:text-sky-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-500 rounded cursor-help\"\n                            aria-describedby=\"pre-flip-fsrs-tooltip\"\n                          >\n                            <CalendarClock className=\"h-3.5 w-3.5\" />\n                            <span>Previs\303\243o FSRS</span>\n                          </button>\n\n                          <div\n                            id=\"pre-flip-fsrs-tooltip\"\n                            role=\"tooltip\"\n                            className=\"pointer-events-none invisible opacity-0 translate-y-1 group-hover:visible group-hover:opacity-100 group-hover:translate-y-0 group-focus-within:visible group-focus-within:opacity-100 group-focus-within:translate-y-0 transition-all duration-150 absolute bottom-full left-0 z-30 mb-2 w-64 rounded-lg border border-slate-700/80 bg-slate-900 p-3 text-left text-xs text-slate-100 shadow-lg dark:border-slate-700 dark:bg-slate-800\"\n                          >\n                            <div className=\"flex items-center justify-between border-b border-slate-700/80 pb-1.5 mb-2\">\n                              <span className=\"font-semibold text-white\">\n                                Pr\303\263xima revis\303\243o estimada\n                              </span>\n                              <span className=\"font-mono text-[10px] text-slate-400 tabular-nums\">\n                                Alvo {Math.round(targetRetention * 100)}%\n                              </span>\n                            </div>\n                            <dl className=\"space-y-1\">\n                              {RATING_CONFIG.map((cfg) => {\n                                const outcome = fsrsOutcomes[cfg.rating];\n                                return (\n                                  <div\n                                    key={cfg.rating}\n                                    className=\"flex items-center justify-between gap-2\"\n                                  >\n                                    <dt className=\"flex items-center gap-1.5 text-slate-300\">\n                                      <span\n                                        className={cn(\n                                          \'h-1.5 w-1.5 rounded-full\',\n                                          cfg.dotClass\n                                        )}\n                                      />\n                                      <span>{cfg.label}</span>\n                                    </dt>\n                                    <dd className=\"font-mono tabular-nums text-white\">\n                                      {outcome.longPreviewLabel}\n                                      <span className=\"text-slate-400\">\n                                        {\' \'}\n                                        \302\267 {formatOutcomeDate(outcome)}\n                                      </span>\n                                    </dd>\n                                  </div>\n                                );\n                              })}\n                            </dl>\n                          </div>\n                        </div>\n                      )}\n                    </div>\n\n                    <Button\n                      variant=\"primary\"\n                      size=\"lg\"\n                      onClick={() => setFlipped(true)}\n                    >\n                      <RotateCw className=\"h-4 w-4\" />\n                      <span>Virar card</span>\n                      <kbd className=\"ml-1 rounded bg-white/20 px-1.5 py-0.5 font-mono text-[11px] dark:bg-slate-950/20\">\n                        Espa\303\247o\n                      </kbd>\n                    </Button>\n                  </div>\n                ) : (\n                  <div className=\"space-y-6 pt-6 border-t border-slate-200 dark:border-slate-800\">\n                    {/* Verso: Clinical Pearl + Optional Answer Summary */}\n                    <div className=\"rounded-xl border border-sky-200 bg-sky-50/70 p-5 sm:p-6 dark:border-sky-900/60 dark:bg-sky-950/30 space-y-3\">\n                      <div className=\"flex flex-wrap items-center justify-between gap-2\">\n                        <span className=\"inline-flex items-center gap-1.5 text-xs font-semibold text-sky-800 dark:text-sky-300\">\n                          <Sparkles className=\"h-3.5 w-3.5\" />\n                          <span>Verso \342\200\224 P\303\251rola Cl\303\255nica</span>\n                        </span>\n\n                        {activeCard.questionId && (\n                          <button\n                            type=\"button\"\n                            onClick={() =>\n                              onOpenOriginalQuestion(activeCard.questionId!)\n                            }\n                            className=\"inline-flex items-center gap-1 text-xs font-semibold text-sky-700 hover:text-sky-900 dark:text-sky-400 dark:hover:text-sky-200 cursor-pointer whitespace-nowrap\"\n                          >\n                            <span>Abrir quest\303\243o original</span>\n                            <ArrowUpRight className=\"h-3.5 w-3.5\" />\n                          </button>\n                        )}\n                      </div>\n\n                      <p className=\"max-w-[72ch] text-[15px] sm:text-base font-semibold leading-relaxed text-slate-900 dark:text-white\">\n                        {activeCard.backPearl}\n                      </p>\n\n                      {activeCard.backAnswerSummary && (\n                        <p className=\"max-w-[72ch] text-xs sm:text-sm leading-relaxed text-slate-600 dark:text-slate-300 pt-2 border-t border-sky-200/70 dark:border-sky-900/50\">\n                          {activeCard.backAnswerSummary}\n                        </p>\n                      )}\n                    </div>\n\n                    {/* 4 FSRS Rating Buttons + Live Next-Review Forecast Widget & Hover Tooltips */}\n                    {fsrsOutcomes && (\n                      <div className=\"space-y-3\">\n                        <div className=\"flex flex-wrap items-center justify-between gap-2 text-xs text-slate-500 dark:text-slate-400\">\n                          <span>\n                            Como foi sua recorda\303\247\303\243o? (Atalhos: 1, 2, 3 ou 4)\n                          </span>\n                          <span className=\"font-mono text-[11px] tabular-nums\">\n                            FSRS \302\267 Alvo {Math.round(targetRetention * 100)}%\n                          </span>\n                        </div>\n\n                        {/* Interactive FSRS Decision Preview Widget */}\n                        <div\n                          aria-live=\"polite\"\n                          className=\"rounded-lg border border-slate-200 bg-slate-50/80 px-3.5 py-2.5 dark:border-slate-800 dark:bg-slate-950/60\"\n                        >\n                          {hoveredOutcome && hoveredConfig ? (\n                            <div className=\"flex flex-wrap items-center justify-between gap-2 text-xs\">\n                              <div className=\"flex items-center gap-2 min-w-0\">\n                                <span\n                                  className={cn(\n                                    \'h-2 w-2 shrink-0 rounded-full\',\n                                    hoveredConfig.dotClass\n                                  )}\n                                />\n                                <span className=\"font-semibold text-slate-900 dark:text-slate-100\">\n                                  {hoveredConfig.label}\n                                </span>\n                                <span className=\"text-slate-400\" aria-hidden=\"true\">\n                                  \342\206\222\n                                </span>\n                                <span className=\"text-slate-700 dark:text-slate-300 tabular-nums\">\n                                  {hoveredOutcome.scheduled_days === 0 &&\n                                  hoveredOutcome.previewLabel === \'< 10m\' ? (\n                                    <>\n                                      Reaparece hoje em{\' \'}\n                                      <strong className=\"font-semibold text-slate-900 dark:text-white\">\n                                        {hoveredOutcome.longPreviewLabel}\n                                      </strong>\n                                    </>\n                                  ) : (\n                                    <>\n                                      Pr\303\263xima revis\303\243o em{\' \'}\n                                      <strong className=\"font-semibold text-slate-900 dark:text-white\">\n                                        {hoveredOutcome.longPreviewLabel}\n                                      </strong>{\' \'}\n                                      <span className=\"font-mono text-[11px] text-slate-500 dark:text-slate-400\">\n                                        ({formatOutcomeDate(hoveredOutcome)})\n                                      </span>\n                                    </>\n                                  )}\n                                </span>\n                              </div>\n                              <span className=\"font-mono text-[11px] tabular-nums text-slate-500 dark:text-slate-400\">\n                                Nova S {hoveredOutcome.stability.toFixed(1)}d \302\267 D{\' \'}\n                                {hoveredOutcome.difficulty.toFixed(1)} \302\267{\' \'}\n                                {FSRS_STATE_LABEL[hoveredOutcome.state]}\n                              </span>\n                            </div>\n                          ) : (\n                            <div className=\"flex flex-wrap items-center justify-between gap-2 text-xs\">\n                              <span className=\"inline-flex items-center gap-1.5 font-medium text-slate-600 dark:text-slate-300\">\n                                <CalendarClock className=\"h-3.5 w-3.5 text-sky-600 dark:text-sky-400 shrink-0\" />\n                                <span>Previs\303\243o da pr\303\263xima revis\303\243o:</span>\n                              </span>\n                              <div className=\"flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-[11px] tabular-nums\">\n                                {RATING_CONFIG.map((cfg) => (\n                                  <span\n                                    key={cfg.rating}\n                                    className=\"inline-flex items-center gap-1 text-slate-600 dark:text-slate-300\"\n                                  >\n                                    <span\n                                      className={cn(\n                                        \'h-1.5 w-1.5 rounded-full\',\n                                        cfg.dotClass\n                                      )}\n                                    />\n                                    <span className=\"font-sans text-slate-500 dark:text-slate-400\">\n                                      {cfg.label}:\n                                    </span>\n                                    <strong className=\"font-semibold text-slate-800 dark:text-slate-100\">\n                                      {fsrsOutcomes[cfg.rating].longPreviewLabel}\n                                    </strong>\n                                  </span>\n                                ))}\n                              </div>\n                            </div>\n                          )}\n                        </div>\n\n                        <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-2.5\">\n                          {RATING_CONFIG.map((cfg) => {\n                            const outcome = fsrsOutcomes[cfg.rating];\n                            const dateLabel = formatOutcomeDate(outcome);\n                            const tooltipId = `fsrs-rating-tip-${cfg.rating}`;\n\n                            return (\n                              <div key={cfg.rating} className=\"relative group\">\n                                {/* Hover / Focus Tooltip */}\n                                <div\n                                  id={tooltipId}\n                                  role=\"tooltip\"\n                                  className=\"pointer-events-none invisible opacity-0 translate-y-1 group-hover:visible group-hover:opacity-100 group-hover:translate-y-0 group-focus-within:visible group-focus-within:opacity-100 group-focus-within:translate-y-0 transition-all duration-150 absolute bottom-full left-1/2 -translate-x-1/2 z-30 mb-2 w-max max-w-[200px] rounded-lg border border-slate-700/80 bg-slate-900 px-2.5 py-2 text-center shadow-lg dark:border-slate-700 dark:bg-slate-800\"\n                                >\n                                  <p className=\"text-[11px] font-semibold text-white whitespace-nowrap tabular-nums\">\n                                    {outcome.scheduled_days === 0 &&\n                                    outcome.previewLabel === \'< 10m\'\n                                      ? `Hoje \302\267 ${outcome.longPreviewLabel}`\n                                      : `Em ${outcome.longPreviewLabel} \302\267 ${dateLabel}`}\n                                  </p>\n                                  <p className=\"mt-0.5 font-mono text-[10px] text-slate-300 whitespace-nowrap tabular-nums\">\n                                    S {outcome.stability.toFixed(1)}d \302\267 D{\' \'}\n                                    {outcome.difficulty.toFixed(1)}\n                                  </p>\n                                  <span\n                                    aria-hidden=\"true\"\n                                    className=\"absolute top-full left-1/2 -translate-x-1/2 border-4 border-transparent border-t-slate-900 dark:border-t-slate-800\"\n                                  />\n                                </div>\n\n                                <button\n                                  type=\"button\"\n                                  aria-describedby={tooltipId}\n                                  onMouseEnter={() => setHoveredRating(cfg.rating)}\n                                  onMouseLeave={() =>\n                                    setHoveredRating((cur) =>\n                                      cur === cfg.rating ? null : cur\n                                    )\n                                  }\n                                  onFocus={() => setHoveredRating(cfg.rating)}\n                                  onBlur={() =>\n                                    setHoveredRating((cur) =>\n                                      cur === cfg.rating ? null : cur\n                                    )\n                                  }\n                                  onClick={() => handleRate(cfg.rating)}\n                                  className={cn(\n                                    \'w-full flex flex-col items-center justify-center gap-1 rounded-xl border px-3 py-3 text-center transition-colors cursor-pointer focus-visible:outline-none focus-visible:ring-2\',\n                                    cfg.buttonClass\n                                  )}\n                                >\n                                  <span\n                                    className={cn(\'text-xs font-bold\', cfg.textClass)}\n                                  >\n                                    {cfg.keyHint} \302\267 {cfg.label}\n                                  </span>\n                                  <span\n                                    className={cn(\n                                      \'font-mono text-[11px] tabular-nums\',\n                                      cfg.subTextClass\n                                    )}\n                                  >\n                                    {outcome.longPreviewLabel}\n                                  </span>\n                                </button>\n                              </div>\n                            );\n                          })}\n                        </div>\n                      </div>\n                    )}\n                  </div>\n                )}\n              </div>\n            </article>\n          ) : (\n            <section className=\"rounded-xl border border-slate-200 bg-white p-10 sm:p-12 text-center dark:border-slate-800 dark:bg-slate-900 space-y-4\">\n              <CheckCircle2 className=\"mx-auto h-9 w-9 text-emerald-600 dark:text-emerald-400\" />\n              <div className=\"space-y-1.5\">\n                <h2 className=\"font-display text-lg font-bold text-slate-900 dark:text-white\">\n                  {filteredCards.length === 0\n                    ? \'Nenhum flashcard neste filtro ainda\'\n                    : \'Revis\303\243o de hoje conclu\303\255da!\'}\n                </h2>\n                <p className=\"mx-auto max-w-md text-sm text-slate-500 dark:text-slate-400\">\n                  {filteredCards.length === 0\n                    ? \'Responda quest\303\265es e clique em \"Transformar P\303\251rola em Flashcard\" ou crie um card manual acima.\'\n                    : \'Voc\303\252 revisou todos os flashcards vencidos para hoje nesta sele\303\247\303\243o. Seus pr\303\263ximos intervalos j\303\241 est\303\243o agendados pelo algoritmo SRS.\'}\n                </p>\n              </div>\n\n              <div className=\"flex flex-wrap items-center justify-center gap-3 pt-2\">\n                {filteredCards.length > 0 && !practiceAhead && (\n                  <Button\n                    variant=\"outline\"\n                    size=\"md\"\n                    onClick={() => {\n                      setPracticeAhead(true);\n                      setSessionIndex(0);\n                    }}\n                  >\n                    <Layers className=\"h-4 w-4\" />\n                    <span>Revisar adiantado ({filteredCards.length})</span>\n                  </Button>\n                )}\n                <Button variant=\"primary\" size=\"md\" onClick={onGoToQuestions}>\n                  <BookOpen className=\"h-4 w-4\" />\n                  <span>Ir para o Banco de Quest\303\265es</span>\n                </Button>\n              </div>\n            </section>\n          )}\n        </div>\n      )}\n\n      {/* VIEW 2: FULL DECK MANAGEMENT TABLE */}\n      {viewMode === \'baralho\' && (\n        <section className=\"rounded-xl border border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900 overflow-hidden\">\n          {filteredCards.length === 0 ? (\n            <div className=\"p-12 text-center text-sm text-slate-500 dark:text-slate-400\">\n              Nenhum flashcard encontrado para o filtro selecionado.\n            </div>"
    num_lines: 1048
