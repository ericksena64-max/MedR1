  code_action {
    action_spec {
      create_file {
        instruction: "import React from \'react\';\nimport { Menu, Sun, Moon, Maximize2, Minimize2 } from \'lucide-react\';\nimport type { ActiveTab } from \'../../types/medical\';\nimport { Button } from \'../ui/Button\';\n\ninterface TopBarProps {\n  activeTab: ActiveTab;\n  darkMode: boolean;\n  onToggleDarkMode: () => void;\n  focusMode: boolean;\n  onToggleFocusMode: () => void;\n  onOpenMobileMenu: () => void;\n}\n\nconst TAB_BREADCRUMBS: Record<ActiveTab, { section: string; detail: string }> = {\n  questoes: {\n    section: \'Banco de Quest\303\265es\',\n    detail: \'Resid\303\252ncia M\303\251dica Brasil\',\n  },\n  desempenho: {\n    section: \'Intelig\303\252ncia de Desempenho\',\n    detail: \'Aluno vs. Mediana da Comunidade\',\n  },\n  ranking: {\n    section: \'Ranking Ao Vivo\',\n    detail: \'Top 10+ Online & Privacidade\',\n  },\n  caderno_erros: {\n    section: \'Caderno de Erros\',\n    detail: \'Revis\303\243o Espa\303\247ada e Favoritas\',\n  },\n};\n\nexport function TopBar({\n  activeTab,\n  darkMode,\n  onToggleDarkMode,\n  focusMode,\n  onToggleFocusMode,\n  onOpenMobileMenu,\n}: TopBarProps) {\n  const crumb = TAB_BREADCRUMBS[activeTab];\n\n  return (\n    <header className=\"sticky top-0 z-30 flex h-16 items-center justify-between gap-4 border-b border-slate-200 bg-white/95 px-4 sm:px-6 backdrop-blur-sm dark:border-slate-800 dark:bg-[#0F172A]/95\">\n      {/* Left: Mobile menu button + contextual breadcrumb */}\n      <div className=\"flex items-center gap-3 min-w-0\">\n        {!focusMode && (\n          <button\n            type=\"button\"\n            onClick={onOpenMobileMenu}\n            aria-label=\"Abrir navega\303\247\303\243o\"\n            className=\"lg:hidden rounded-lg p-2 text-slate-600 hover:bg-slate-100 hover:text-slate-900 dark:text-slate-300 dark:hover:bg-slate-800\"\n          >\n            <Menu className=\"h-5 w-5\" />\n          </button>\n        )}\n\n        <div className=\"flex items-center gap-2 text-sm min-w-0\">\n          {focusMode && (\n            <>\n              <span className=\"font-display font-bold text-slate-900 dark:text-white whitespace-nowrap shrink-0\">\n                MedR1\n              </span>\n              <span className=\"text-slate-300 dark:text-slate-700\" aria-hidden=\"true\">\n                /\n              </span>\n            </>\n          )}\n          <h1 className=\"font-display text-sm sm:text-base font-semibold text-slate-900 dark:text-slate-100 truncate\">\n            {crumb.section}\n          </h1>\n          <span\n            className=\"hidden md:inline text-slate-300 dark:text-slate-700\"\n            aria-hidden=\"true\"\n          >\n            /\n          </span>\n          <span className=\"hidden md:inline text-xs sm:text-sm text-slate-500 dark:text-slate-400 truncate\">\n            {crumb.detail}\n          </span>\n        </div>\n      </div>\n\n      {/* Right: Focus Mode (on Questions view) + Light/Dark toggle */}\n      <div className=\"flex items-center gap-2 shrink-0\">\n        {activeTab === \'questoes\' && (\n          <Button\n            variant={focusMode ? \'primary\' : \'outline\'}\n            size=\"sm\"\n            onClick={onToggleFocusMode}\n            title={\n              focusMode\n                ? \'Sair do Modo Foco e exibir pain\303\251is laterais\'\n                : \'Ocultar menus laterais para simular ambiente real de prova\'\n            }\n          >\n            {focusMode ? (\n              <>\n                <Minimize2 className=\"h-3.5 w-3.5\" />\n                <span>Sair do Foco</span>\n              </>\n            ) : (\n              <>\n                <Maximize2 className=\"h-3.5 w-3.5\" />\n                <span className=\"hidden sm:inline\">Modo Foco</span>\n              </>\n            )}\n          </Button>\n        )}\n\n        <Button\n          variant=\"outline\"\n          size=\"icon\"\n          onClick={onToggleDarkMode}\n          aria-label={darkMode ? \'Ativar modo claro\' : \'Ativar modo escuro\'}\n          title={darkMode ? \'Modo claro\' : \'Modo escuro\'}\n        >\n          {darkMode ? (\n            <Sun className=\"h-4 w-4 text-amber-400\" />\n          ) : (\n            <Moon className=\"h-4 w-4 text-slate-600\" />\n          )}\n        </Button>\n      </div>\n    </header>\n  );\n}\n"
        path {
          absolute_uri: "file:///src/components/layout/TopBar.tsx"
        }
        overwrite: true
      }
    }
