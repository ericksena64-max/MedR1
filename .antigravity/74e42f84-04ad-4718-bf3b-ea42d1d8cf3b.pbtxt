          replacement_content: "  Clock,\n  CalendarClock,\n  Sparkles,\n  BookOpen,\n  X,\n} from \'lucide-react\';\nimport type {\n  Flashcard,\n  FsrsState,\n  GrandeAreaId,\n  SrsRating,\n  TargetRetention,\n} from \'../../types/medical\';\nimport { GRANDES_AREAS } from \'../../data/taxonomy\';\nimport {\n  computeAllFsrsOutcomes,\n  formatFsrsInterval,\n  getCardCurrentRetrievabilityPct,\n  isCardDueToday,\n  type FsrsScheduleOutcome,\n} from \'../../lib/srs\';"
