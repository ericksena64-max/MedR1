      name: "multi_replace_file_content"
      arguments_json: "{\"Description\":\"Add compact high-incidence 95% retention days forecast card at the top of FlashcardsView\", \"Instruction\":\"Import Target icon, EXAM_BOARD_LABELS, and estimateDaysToTargetRetention; compute memoized projection reactive to flashcards, targetBoard, userAccuracyByTopic, reviewsTodayStats, and weightsVersion; render compact forecast card at the top of FlashcardsView.\", \"ReplacementChunks\":[{\"AllowMultiple\":false, \"EndLine\":42, \"ReplacementContent\":\"  Sparkles,\\n  BookOpen,\\n  Target,\\n  X,\\n} from \'lucide-react\';\\nimport type {\\n  ExamBoard,\\n  Flashcard,\\n  FsrsState,\\n  GrandeAreaId,\\n  RetentionMode,\\n  SrsRating,\\n} from \'../../types/medical\';\\nimport { GRANDES_AREAS } from \'../../data/taxonomy\';\\nimport {\\n  EXAM_BOARD_LABELS,\\n  getBoardCustomizationCount,\\n  normalizeMedicalText,\\n} from \'../../lib/examWeights\';\\nimport {\\n  computeAllFsrsOutcomes,\\n  estimateDaysToTargetRetention,\\n  formatFsrsInterval,\\n  getCardCurrentRetrievabilityPct,\\n  isCardDueToday,\\n  resolveCardRetention,\\n  type FsrsScheduleOutcome,\\n} from \'../../lib/srs\';\", \"StartLine\":13, \"TargetContent\":\"  Sparkles,\\n  BookOpen,\\n  X,\\n} from \'lucide-react\';\\nimport type {\\n  ExamBoard,\\n  Flashcard,\\n  FsrsState,\\n  GrandeAreaId,\\n  RetentionMode,\\n  SrsRating,\\n} from \'../../types/medical\';\\nimport { GRANDES_AREAS } from \'../../data/taxonomy\';\\nimport {\\n  getBoardCustomizationCount,\\n  normalizeMedicalText,\\n} from \'../../lib/examWeights\';\\nimport {\\n  computeAllFsrsOutcomes,\\n  formatFsrsInterval,\\n  getCardCurrentRetrievabilityPct,\\n  isCardDueToday,\\n  resolveCardRetention,\\n  type FsrsScheduleOutcome,\\n} from \'../../lib/srs\';\"}, {\"AllowMultiple\":false, \"EndLine\":422, \"ReplacementContent\":\"  const highIncidenceProjection = useMemo(\\n    () =>\\n      estimateDaysToTargetRetention(\\n        flashcards,\\n        targetBoard,\\n        userAccuracyByTopic,\\n        reviewsTodayStats,\\n        95\\n      ),\\n    // eslint-disable-next-line react-hooks/exhaustive-deps\\n    [\\n      flashcards,\\n      targetBoard,\\n      userAccuracyByTopic,\\n      reviewsTodayStats,\\n      weightsVersion,\\n    ]\\n  );\\n\\n  const projectionProgressPct = Math.min(\\n    100,\\n    Math.max(\\n      0,\\n      Math.round(\\n        (highIncidenceProjection.currentRetentionPct /\\n          highIncidenceProjection.targetRetentionPct) *\\n          100\\n      )\\n    )\\n  );\\n\\n  return (\\n    <div className=\\\"space-y-5\\\">\\n      {/* Compact High-Incidence 95% Retention Forecast Card */}\\n      <section\\n        aria-label=\\\"Estimativa de dias at\303\251 atingir 95% de reten\303\247\303\243o em temas de alta incid\303\252ncia\\\"\\n        className={cn(\\n          \'rounded-xl border px-4 py-3.5 sm:px-5 flex flex-col lg:flex-row lg:items-center justify-between gap-4\',\\n          highIncidenceProjection.reachedTarget\\n            ? \'border-emerald-200 bg-emerald-50/50 dark:border-emerald-900/60 dark:bg-emerald-950/20\'\\n            : \'border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900\'\\n        )}\\n      >\\n        <div className=\\\"flex items-start sm:items-center gap-3 min-w-0\\\">\\n          <div\\n            className={cn(\\n              \'mt-0.5 sm:mt-0 flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border\',\\n              highIncidenceProjection.reachedTarget\\n                ? \'border-emerald-200 bg-emerald-100/70 text-emerald-700 dark:border-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-400\'\\n                : \'border-sky-200/80 bg-sky-50 text-sky-700 dark:border-sky-900/60 dark:bg-sky-950/40 dark:text-sky-400\'\\n            )}\\n          >\\n            <Target className=\\\"h-4 w-4\\\" />\\n          </div>\\n\\n          <div className=\\\"min-w-0 space-y-0.5\\\">\\n            <div className=\\\"flex flex-wrap items-baseline gap-x-2 gap-y-0.5\\\">\\n              <p className=\\\"text-xs font-semibold text-slate-800 dark:text-slate-100\\\">\\n                Dias at\303\251 atingir 95% de reten\303\247\303\243o\\n              </p>\\n              <span className=\\\"text-[11px] text-slate-500 dark:text-slate-400\\\">\\n                \302\267 Alta incid\303\252ncia ({EXAM_BOARD_LABELS[targetBoard]})\\n              </span>\\n            </div>\\n\\n            {highIncidenceProjection.estimatedDays === null ? (\\n              <p className=\\\"text-xs text-slate-500 dark:text-slate-400\\\">\\n                Adicione flashcards de temas de alta incid\303\252ncia para projetar o prazo.\\n              </p>\\n            ) : (\\n              <div className=\\\"flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-slate-500 dark:text-slate-400 tabular-nums\\\">\\n                <span>\\n                  Acerto atual:{\' \'}\\n                  <strong className=\\\"font-mono font-semibold text-slate-800 dark:text-slate-200\\\">\\n                    {highIncidenceProjection.accuracyPct.toFixed(1).replace(\'.\', \',\')}%\\n                  </strong>\\n                </span>\\n                <span aria-hidden=\\\"true\\\">\302\267</span>\\n                <span>\\n                  Cad\303\252ncia:{\' \'}\\n                  <strong className=\\\"font-mono font-semibold text-slate-800 dark:text-slate-200\\\">\\n                    {Number.isInteger(highIncidenceProjection.dailyCadence)\\n                      ? highIncidenceProjection.dailyCadence\\n                      : highIncidenceProjection.dailyCadence.toFixed(1).replace(\'.\', \',\')}{\' \'}\\n                    cards/dia\\n                  </strong>\\n                  {highIncidenceProjection.isCadenceEstimated && (\\n                    <span className=\\\"text-[11px] text-slate-400 dark:text-slate-500\\\">\\n                      {\' \'}\\n                      (base)\\n                    </span>\\n                  )}\\n                </span>\\n                <span aria-hidden=\\\"true\\\">\302\267</span>\\n                <span>\\n                  <strong className=\\\"font-mono font-semibold text-slate-800 dark:text-slate-200\\\">\\n                    {highIncidenceProjection.consolidatedCount}/\\n                    {highIncidenceProjection.highIncidenceCount}\\n                  </strong>{\' \'}\\n                  consolidados\\n                </span>\\n              </div>\\n            )}\\n          </div>\\n        </div>\\n\\n        {/* Progress toward 95% + Estimated Days Readout */}\\n        <div className=\\\"flex flex-wrap sm:flex-nowrap items-center justify-between lg:justify-end gap-4 shrink-0\\\">\\n          {highIncidenceProjection.estimatedDays !== null && (\\n            <div className=\\\"w-36 sm:w-44 space-y-1\\\">\\n              <div className=\\\"flex items-center justify-between font-mono text-[11px] tabular-nums\\\">\\n                <span className=\\\"text-slate-500 dark:text-slate-400\\\">\\n                  Atual{\' \'}\\n                  <strong className=\\\"text-slate-800 dark:text-slate-200\\\">\\n                    {highIncidenceProjection.currentRetentionPct.toFixed(0)}%\\n                  </strong>\\n                </span>\\n                <span className=\\\"font-semibold text-sky-700 dark:text-sky-400\\\">\\n                  Meta 95%\\n                </span>\\n              </div>\\n              <div className=\\\"h-1.5 w-full overflow-hidden rounded-full bg-slate-100 dark:bg-slate-800\\\">\\n                <div\\n                  className={cn(\\n                    \'h-full rounded-full transition-all duration-300\',\\n                    highIncidenceProjection.reachedTarget\\n                      ? \'bg-emerald-500\'\\n                      : \'bg-sky-500\'\\n                  )}\\n                  style={{ width: `${projectionProgressPct}%` }}\\n                />\\n              </div>\\n            </div>\\n          )}\\n\\n          <div className=\\\"text-right\\\">\\n            <p\\n              className={cn(\\n                \'font-mono text-xl sm:text-2xl font-bold tabular-nums leading-none\',\\n                highIncidenceProjection.reachedTarget\\n                  ? \'text-emerald-600 dark:text-emerald-400\'\\n                  : highIncidenceProjection.estimatedDays === null\\n                  ? \'text-slate-400 dark:text-slate-500\'\\n                  : \'text-sky-600 dark:text-sky-400\'\\n              )}\\n            >\\n              {highIncidenceProjection.estimatedDays === null\\n                ? \'\342\200\224\'\\n                : highIncidenceProjection.reachedTarget\\n                ? \'Meta atingida\'\\n                : highIncidenceProjection.estimatedDays === 1\\n                ? \'~1 dia\'\\n                : `~${highIncidenceProjection.estimatedDays} dias`}\\n            </p>\\n            <p className=\\\"mt-1 text-[11px] text-slate-500 dark:text-slate-400\\\">\\n              {highIncidenceProjection.reachedTarget\\n                ? \'Reten\303\247\303\243o \342\211\24595% consolidada\'\\n                : \'Proje\303\247\303\243o FSRS no ritmo atual\'}\\n            </p>\\n          </div>\\n        </div>\\n      </section>\\n\\n      {/* Top 4-column KPI summary */}\\n      <section\\n        aria-label=\\\"Resumo de flashcards e repeti\303\247\303\243o espa\303\247ada\\\"\\n        className=\\\"grid grid-cols-2 lg:grid-cols-4 gap-4\\\"\\n      >\", \"StartLine\":412, \"TargetContent\":\"  return (\\n    <div className=\\\"space-y-6\\\">\\n      {/* Top 4-column KPI summary */}\\n      <section\\n        aria-label=\\\"Resumo de flashcards e repeti\303\247\303\243o espa\303\247ada\\\"\\n        className=\\\"grid grid-cols-2 lg:grid-cols-4 gap-4\\\"\\n      >\"}], \"TargetFile\":\"/src/components/flashcards/FlashcardsView.tsx\", \"toolAction\":\"Adding 95% retention forecast card to FlashcardsView\", \"toolSummary\":\"Add retention days fore