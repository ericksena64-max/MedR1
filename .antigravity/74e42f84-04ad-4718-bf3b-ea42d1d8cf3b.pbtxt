            lines {
              text: "    boardState.customTopics = boardState.customTopics.map((item) =>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      item.id === topicIdOrName || item.topic === topicIdOrName"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
