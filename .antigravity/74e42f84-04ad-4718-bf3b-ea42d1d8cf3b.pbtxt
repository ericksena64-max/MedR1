  code_action {
    action_spec {
      create_file {
        instruction: "import React from \'react\';\nimport {\n  Clock,\n  Pause,\n  Play,\n  Flag,\n  CheckCircle2,\n  Send,\n  RotateCcw,\n} from \'lucide-react\';\nimport type { AlternativeLetter, MedicalQuestion } from \'../../types/medical\';\nimport { formatTimer, cn } from \'../../lib/utils\';\nimport { Button } from \'../ui/Button\';\n\ninterface SimuladoBarProps {\n  questions: MedicalQuestion[];\n  currentIndex: number;\n  onSelectIndex: (idx: number) => void;\n  draftAnswers: Record<string, AlternativeLetter>;\n  flaggedIds: string[];\n  secondsLeft: number;\n  paused: boolean;\n  onTogglePause: () => void;\n  finished: boolean;\n  onFinish: () => void;\n  onRestart: () => void;\n}\n\nexport function SimuladoBar({\n  questions,\n  currentIndex,\n  onSelectIndex,\n  draftAnswers,\n  flaggedIds,\n  secondsLeft,\n  paused,\n  onTogglePause,\n  finished,\n  onFinish,\n  onRestart,\n}: SimuladoBarProps) {\n  const answeredCount = questions.filter((q) => Boolean(draftAnswers[q.id])).length;\n  const correctCount = finished\n    ? questions.filter((q) => draftAnswers[q.id] === q.gabaritoOficial).length\n    : 0;\n  const accuracyPct =\n    finished && questions.length > 0\n      ? Number(((correctCount / questions.length) * 100).toFixed(1))\n      : 0;\n\n  const isLowTime = !finished && secondsLeft <= 180;\n\n  return (\n    <div className=\"rounded-xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900 space-y-4\">\n      <div className=\"flex flex-wrap items-center justify-between gap-3\">\n        <div className=\"flex items-center gap-4\">\n          {/* Countdown timer */}\n          <div\n            className={cn(\n              \'flex items-center gap-2 font-mono text-base font-semibold tabular-nums\',\n              isLowTime\n                ? \'text-red-600 dark:text-red-400\'\n                : \'text-slate-900 dark:text-white\'\n            )}\n          >\n            <Clock className=\"h-4 w-4 text-sky-600 dark:text-sky-400\" />\n            <span>{finished ? \'Prova encerrada\' : formatTimer(secondsLeft)}</span>\n          </div>\n\n          {!finished && (\n            <button\n              type=\"button\"\n              onClick={onTogglePause}\n              className=\"inline-flex items-center gap-1.5 rounded-lg border border-slate-200 px-2.5 py-1 text-xs font-medium text-slate-600 hover:bg-slate-50 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800 cursor-pointer\"\n            >\n              {paused ? (\n                <>\n                  <Play className=\"h-3.5 w-3.5\" />\n                  <span>Retomar</span>\n                </>\n              ) : (\n                <>\n                  <Pause className=\"h-3.5 w-3.5\" />\n                  <span>Pausar</span>\n                </>\n              )}\n            </button>\n          )}\n\n          <span className=\"text-xs text-slate-500 dark:text-slate-400 tabular-nums\">\n            Respondidas: <strong className=\"text-slate-800 dark:text-slate-200\">{answeredCount}/{questions.length}</strong>\n            {flaggedIds.length > 0 && (\n              <>\n                {\' \302\267 \'}\n                Marcadas p/ revis\303\243o:{\' \'}\n                <strong className=\"text-amber-600 dark:text-amber-400\">\n                  {flaggedIds.length}\n                </strong>\n              </>\n            )}\n          </span>\n        </div>\n\n        <div className=\"flex items-center gap-2\">\n          {!finished ? (\n            <Button variant=\"primary\" size=\"sm\" onClick={onFinish}>\n              <Send className=\"h-3.5 w-3.5\" />\n              <span>Entregar Simulado</span>\n            </Button>\n          ) : (\n            <Button variant=\"outline\" size=\"sm\" onClick={onRestart}>\n              <RotateCcw className=\"h-3.5 w-3.5\" />\n              <span>Novo Simulado</span>\n            </Button>\n          )}\n        </div>\n      </div>\n\n      {/* Post-Exam Summary Strip when finished */}\n      {finished && (\n        <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-3 border-t border-slate-100 pt-3 dark:border-slate-800\">\n          <div>\n            <p className=\"text-xs text-slate-500 dark:text-slate-400\">Aproveitamento</p>\n            <p className=\"mt-0.5 font-mono text-xl font-bold tabular-nums text-slate-900 dark:text-white\">\n              {accuracyPct}%\n            </p>\n          </div>\n          <div>\n            <p className=\"text-xs text-slate-500 dark:text-slate-400\">Acertos</p>\n            <p className=\"mt-0.5 font-mono text-xl font-bold tabular-nums text-emerald-600 dark:text-emerald-400\">\n              {correctCount}/{questions.length}\n            </p>\n          </div>\n          <div>\n            <p className=\"text-xs text-slate-500 dark:text-slate-400\">Em branco / Erradas</p>\n            <p className=\"mt-0.5 font-mono text-xl font-bold tabular-nums text-red-600 dark:text-red-400\">\n              {questions.length - correctCount}\n            </p>\n          </div>\n          <div>\n            <p className=\"text-xs text-slate-500 dark:text-slate-400\">Revis\303\243o liberada</p>\n            <p className=\"mt-1 inline-flex items-center gap-1 text-xs font-medium text-sky-600 dark:text-sky-400\">\n              <CheckCircle2 className=\"h-3.5 w-3.5\" />\n              <span>Estat\303\255sticas e coment\303\241rios ativos</span>\n            </p>\n          </div>\n        </div>\n      )}\n\n      {/* Question Navigator Strip */}\n      <div className=\"flex flex-wrap items-center gap-1.5 border-t border-slate-100 pt-3 dark:border-slate-800\">\n        {questions.map((q, idx) => {\n          const draft = draftAnswers[q.id];\n          const flagged = flaggedIds.includes(q.id);\n          const isCurrent = idx === currentIndex;\n          const isCorrect = finished && draft === q.gabaritoOficial;\n          const isWrong = finished && draft && draft !== q.gabaritoOficial;\n\n          return (\n            <button\n              key={q.id}\n              type=\"button\"\n              onClick={() => onSelectIndex(idx)}\n              className={cn(\n                \'relative flex h-8 w-9 items-center justify-center rounded-md border font-mono text-xs font-medium tabular-nums transition-colors cursor-pointer\',\n                isCurrent && \'ring-2 ring-sky-500 ring-offset-1 dark:ring-offset-slate-900\',\n                finished\n                  ? isCorrect\n                    ? \'border-emerald-300 bg-emerald-50 text-emerald-700 dark:border-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300\'\n                    : isWrong\n                    ? \'border-red-300 bg-red-50 text-red-700 dark:border-red-800 dark:bg-red-950/60 dark:text-red-300\'\n                    : \'border-slate-200 bg-slate-50 text-slate-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-400\'\n                  : draft\n                  ? \'border-sky-300 bg-sky-50 text-sky-700 dark:border-sky-700 dark:bg-sky-950/60 dark:text-sky-300\'\n                  : \'border-slate-200 bg-white text-slate-600 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300\'\n              )}\n              title={`Quest\303\243o ${idx + 1}${flagged ? \' (Marcada para revis\303\243o)\' : \'\'}`}\n            >\n              {idx + 1}\n              {flagged && (\n                <Flag\n                  className=\"absolute -right-1 -top-1 h-3 w-3 fill-amber-500 text-amber-500\"\n                  aria-label=\"D\303\272vida marcada\"\n                />\n              )}\n            </button>\n          );\n        })}\n      </div>\n    </div>\n  );\n}\n"
        path {
          absolute_uri: "file:///src/components/questions/SimuladoBar.tsx"
        }
        overwrite: true
      }
    }
