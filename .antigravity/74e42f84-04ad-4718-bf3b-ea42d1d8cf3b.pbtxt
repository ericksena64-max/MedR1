              text: "  dueAt: string;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "}"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "/**"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: " * Adapted SM-2 Spaced Repetition Algorithm calibrated for Brazilian Medical Residency:"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: " * - Rating 1 (Errei):   0 days (re-queued today), resets repetitions, lowers ease factor"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: " * - Rating 2 (Dif\303\255cil): 1 day initial (or 1.2x current interval)"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: " * - Rating 3 (Bom):     3 days initial (or interval * easeFactor)"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: " * - Rating 4 (F\303\241cil):   5 days initial (or interval * easeFactor * 1.3)"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: " */"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "export function computeNextSrsState("
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  card: Pick<Flashcard, \'intervalDays\' | \'easeFactor\' | \'repetitions\' | \'lapses\'>,"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  previewLabel: string;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "function clampDifficulty(d: number): number {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  return Number(Math.min(10, Math.max(1, d)).toFixed(2));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "function clampStability(s: number): number {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  return Number(Math.max(0.1, s).toFixed(2));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "/**"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * FSRS-4.5 power-law forgetting curve:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * R(t, S) = (1 + (19/81) * (t / S)) ^ (-0.5)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " */"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "export function computeRetrievability(elapsedDays: number, stability: number): number {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (stability <= 0) return 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (elapsedDays <= 0) return 1;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  return Math.pow(1 + (FSRS_FACTOR * elapsedDays) / stability, FSRS_DECAY);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "/**"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * Inverse forgetting curve: exact interval (in fractional days) where"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * predicted retrievability drops to `targetRetention`."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " */"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "export function computeRawIntervalDays("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  stability: number,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  targetRetention: TargetRetention"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "): number {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const raw ="
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    (stability / FSRS_FACTOR) * (Math.pow(targetRetention, 1 / FSRS_DECAY) - 1);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  return Math.min(MAX_INTERVAL_DAYS, Math.max(0, raw));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "function initStability(rating: SrsRating): number {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  return clampStability(W[rating - 1]);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "function initDifficulty(rating: SrsRating): number {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  return clampDifficulty(W[4] - (rating - 3) * W[5]);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "function nextDifficulty(d: number, rating: SrsRating): number {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const deltaD = -W[6] * (rating - 3);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const nextD = d + deltaD;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // Mean reversion toward D0(3)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const meanReverted = W[7] * initDifficulty(3) + (1 - W[7]) * nextD;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  return clampDifficulty(meanReverted);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "function nextRecallStability("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  d: number,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  s: number,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  r: number,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  rating: 2 | 3 | 4"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "): number {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const hardPenalty = rating === 2 ? W[15] : 1;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const easyBonus = rating === 4 ? W[16] : 1;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const growth ="
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    Math.exp(W[8]) *"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    (11 - d) *"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    Math.pow(s, -W[9]) *"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    (Math.exp(W[10] * (1 - r)) - 1) *"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    hardPenalty *"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    easyBonus;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  return clampStability(s * (growth + 1));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "function nextForgetStability(d: number, s: number, r: number): number {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const sNew ="
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    W[11] *"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    Math.pow(d, -W[12]) *"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    (Math.pow(s + 1, W[13]) - 1) *"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    Math.exp(W[14] * (1 - r));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  return clampStability(Math.min(s, sNew));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "export function formatFsrsInterval(days: number, intraDayMinutes?: number): string {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (intraDayMinutes !== undefined && intraDayMinutes < 60) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    return intraDayMinutes <= 10 ? \'< 10m\' : `${Math.round(intraDayMinutes)}m`;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (days < 1 / 24) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    return \'< 10m\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (days < 1) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const hrs = Math.max(1, Math.round(days * 24));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    return `${hrs}h`;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const roundedDays = Math.round(days);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (roundedDays < 30) return `${roundedDays}d`;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (roundedDays < 365) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const months = Number((roundedDays / 30).toFixed(1));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    return months % 1 === 0 ? `${Math.round(months)}m` : `${months}m`;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const years = Number((roundedDays / 365).toFixed(1));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  return `${years}a`;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "function computeElapsedDays(card: Flashcard, now: Date): number {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (card.state === \'New\' || !card.lastReviewedAt) return 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const diffMs = Math.max(0, now.getTime() - new Date(card.lastReviewedAt).getTime());"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  return Number((diffMs / DAY_MS).toFixed(2));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "/**"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * Computes all 4 FSRS scheduling outcomes simultaneously so monotonicity"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * (Again < Hard <= Good < Easy) is strictly guaranteed on every card state."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " */"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "export function computeAllFsrsOutcomes("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  card: Flashcard,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  targetRetention: TargetRetention = DEFAULT_TARGET_RETENTION,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  now: Date = new Date()"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "): Record<SrsRating, FsrsScheduleOutcome> {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const elapsed = computeElapsedDays(card, now);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // CASE 1: New card (first exposure)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (card.state === \'New\') {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const sAgain = initStability(1);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const sHard = initStability(2);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const sGood = initStability(3);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const sEasy = initStability(4);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const rawHardDays = computeRawIntervalDays(sHard, targetRetention);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const rawGoodDays = computeRawIntervalDays(sGood, targetRetention);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const rawEasyDays = computeRawIntervalDays(sEasy, targetRetention);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const hardIsSubDay = rawHardDays < 0.85;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const hardDays = hardIsSubDay ? 0 : Math.max(1, Math.round(rawHardDays));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const goodDays = Math.max(hardDays + 1, Math.round(rawGoodDays));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const easyDays = Math.max(goodDays + 1, Math.round(rawEasyDays));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const hardDueMs = hardIsSubDay"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      ? now.getTime() + Math.max(1, Math.round(rawHardDays * 24)) * 60 * MINUTE_MS"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      : now.getTime() + hardDays * DAY_MS;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    return {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      1: {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        stability: sAgain,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        difficulty: initDifficulty(1),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        elapsed_days: 0,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        scheduled_days: 0,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        reps: card.reps + 1,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        lapses: card.lapses + 1,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        state: \'Learning\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        dueAt: new Date(now.getTime() + 5 * MINUTE_MS).toISOString(),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        previewLabel: \'< 10m\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      2: {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        stability: sHard,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        difficulty: initDifficulty(2),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        elapsed_days: 0,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        scheduled_days: hardDays,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        reps: card.reps + 1,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        lapses: card.lapses,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        state: hardIsSubDay ? \'Learning\' : \'Review\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        dueAt: new Date(hardDueMs).toISOString(),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        previewLabel: hardIsSubDay"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          ? formatFsrsInterval(rawHardDays)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          : formatFsrsInterval(hardDays),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      3: {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        stability: sGood,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        difficulty: initDifficulty(3),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        elapsed_days: 0,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        scheduled_days: goodDays,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        reps: card.reps + 1,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        lapses: card.lapses,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        state: \'Review\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        dueAt: new Date(now.getTime() + goodDays * DAY_MS).toISOString(),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        previewLabel: formatFsrsInterval(goodDays),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      4: {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        stability: sEasy,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        difficulty: initDifficulty(4),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        elapsed_days: 0,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        scheduled_days: easyDays,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        reps: card.reps + 1,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        lapses: card.lapses,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        state: \'Review\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        dueAt: new Date(now.getTime() + easyDays * DAY_MS).toISOString(),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        previewLabel: formatFsrsInterval(easyDays),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    };"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
