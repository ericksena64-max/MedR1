            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "export function formatFsrsIntervalLong(days: number, intraDayMinutes?: number): string {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  if (intraDayMinutes !== undefined && intraDayMinutes < 60) {"
