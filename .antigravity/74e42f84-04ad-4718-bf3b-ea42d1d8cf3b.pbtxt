              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        letter: \'C\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        text: \'Inibidores de SGLT2 (dapagliflozina/empagliflozina) como parte da terapia qu\303\241drupla inicial obrigat\303\263ria.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        explanation:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Correta (Hist\303\263rica \342\200\224 Desatualizada). Hoje, nas diretrizes SBC/ESC/AHA atuais, os iSGLT2 s\303\243o pilar obrigat\303\263rio da terapia qu\303\241drupla da ICFER independentemente da presen\303\247a de diabetes mellitus. Esta quest\303\243o permanece sinalizada como desatualizada para fins de filtro.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        communityPct: 37.8,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        letter: \'D\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        text: \'Inibidores da enzima conversora de angiotensina (IECA).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        explanation: \'Incorreta (Principal distrator). IECAs s\303\243o pilares consagrados desde a d\303\251cada de 1990.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        communityPct: 42.6,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
