            lines {
              text: "  // CASE 3: Review card (long-term FSRS forgetting curve)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const s = Math.max(card.stability, 0.5);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
