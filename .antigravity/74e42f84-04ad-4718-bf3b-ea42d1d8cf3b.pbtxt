            }
            lines {
              text: "    comentarioGeral:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'A Lista Nacional de Notifica\303\247\303\243o Compuls\303\263ria (Portaria de Consolida\303\247\303\243o GM/MS n\302\272 4 e atualiza\303\247\303\265es) \303\251 um cl\303\241ssico da Sa\303\272de Coletiva. Lembre-se da regra mnem\303\264nica: notifica\303\247\303\265es imediatas (\342\211\244 24h) envolvem doen\303\247as com alto potencial epid\303\252mico, gravidade/mortalidade r\303\241pida, doen\303\247as preven\303\255veis em erradica\303\247\303\243o/elimina\303\247\303\243o (sarampo, rub\303\251ola, poliomielite), acidentes por animais pe\303\247onhentos, raiva humana, viol\303\252ncia sexual/tentativa de suic\303\255dio e \303\263bitos por dengue/chikungunya/zika.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    perolaClinica:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Notifica\303\247\303\243o IMEDIATA (\342\211\244 24h): Sarampo, Meningite meningoc\303\263cica, Raiva, Animais pe\303\247onhentos, Viol\303\252ncia sexual, Tentativa de suic\303\255dio, Botulismo, Febre amarela. Tuberculose, Hansen\303\255ase, HIV e S\303\255filis = SEMANAL!\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
