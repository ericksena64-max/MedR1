              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Brasil \342\200\224 Lei n\302\272 8.080/1990 e Pol\303\255tica Nacional de Aten\303\247\303\243o B\303\241sica (PNAB).\',"
