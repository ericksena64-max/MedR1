  view_file {
    absolute_path_uri: "file:///src/lib/srs.ts"
    end_line: 749
    content: "import type {\n  ExamBoard,\n  Flashcard,\n  FsrsState,\n  MedicalQuestion,\n  RetentionMode,\n  SrsRating,\n  TargetRetention,\n} from \'../types/medical\';\nimport {\n  getExamTopicWeight,\n  normalizeMedicalText,\n  type IncidenceTier,\n} from \'./examWeights\';\n\nconst MINUTE_MS = 60 * 1000;\nconst DAY_MS = 24 * 60 * 60 * 1000;\n\n/**\n * Default FSRS-4.5 optimized global parameters (w[0..16]).\n * Forgetting curve: R(t, S) = (1 + FACTOR * t / S)^DECAY\n * where FACTOR = 19/81 and DECAY = -0.5 ensures R(S, S) = 0.90.\n */\nconst W = [\n  0.4872, // w0: Initial stability for Again (1)\n  1.4003, // w1: Initial stability for Hard (2)\n  3.7145, // w2: Initial stability for Good (3)\n  13.8206, // w3: Initial stability for Easy (4)\n  5.1618, // w4: Initial difficulty baseline\n  1.2298, // w5: Initial difficulty rating slope\n  0.8975, // w6: Difficulty delta step\n  0.031, // w7: Mean reversion weight\n  1.6474, // w8: Stability recall growth exponent\n  0.1367, // w9: Stability decay power\n  1.0461, // w10: Retrievability factor on recall\n  2.1072, // w11: Lapse stability multiplier\n  0.0793, // w12: Lapse difficulty power\n  0.3246, // w13: Lapse stability power\n  1.587, // w14: Lapse retrievability exponent\n  0.2272, // w15: Hard penalty\n  2.8755, // w16: Easy bonus\n] as const;\n\nconst FSRS_DECAY = -0.5;\nconst FSRS_FACTOR = 19 / 81; // (0.9^(1/-0.5) - 1) = 19/81\nconst MAX_INTERVAL_DAYS = 3650;\n\nexport const DEFAULT_TARGET_RETENTION: TargetRetention = 0.9;\nexport const BASE_DYNAMIC_RETENTION = 0.89;\nexport const MIN_DYNAMIC_RETENTION = 0.85;\nexport const MAX_DYNAMIC_RETENTION = 0.95;\n\nexport interface DynamicRetentionResult {\n  mode: RetentionMode;\n  retention: number; // Strictly clamped in [0.85, 0.95]\n  retentionPct: number; // Integer 85..95\n  baseRetention: number;\n  deltaBanca: number;\n  deltaIndividual: number;\n  board: ExamBoard;\n  boardTier: IncidenceTier;\n  boardReason: string;\n  individualStatus: \'ponto_atencao\' | \'neutro\' | \'dominio\' | \'sem_dados\';\n  individualReason: string | null;\n  summaryLabel: string;\n  userAccuracyPct: number | null;\n  communityMedianPct: number | null;\n  wasClamped: boolean;\n}\n\nexport interface FsrsScheduleOutcome {\n  stability: number;\n  difficulty: number;\n  elapsed_days: number;\n  scheduled_days: number;\n  reps: number;\n  lapses: number;\n  state: FsrsState;\n  dueAt: string;\n  previewLabel: string;\n  longPreviewLabel: string;\n}\n\nfunction clampDifficulty(d: number): number {\n  return Number(Math.min(10, Math.max(1, d)).toFixed(2));\n}\n\nfunction clampStability(s: number): number {\n  return Number(Math.max(0.1, s).toFixed(2));\n}\n\n/**\n * FSRS-4.5 power-law forgetting curve:\n * R(t, S) = (1 + (19/81) * (t / S)) ^ (-0.5)\n */\nexport function computeRetrievability(elapsedDays: number, stability: number): number {\n  if (stability <= 0) return 0;\n  if (elapsedDays <= 0) return 1;\n  return Math.pow(1 + (FSRS_FACTOR * elapsedDays) / stability, FSRS_DECAY);\n}\n\n/**\n * Inverse forgetting curve: exact interval (in fractional days) where\n * predicted retrievability drops to `targetRetention`.\n */\nexport function computeRawIntervalDays(\n  stability: number,\n  targetRetention: TargetRetention\n): number {\n  const raw =\n    (stability / FSRS_FACTOR) * (Math.pow(targetRetention, 1 / FSRS_DECAY) - 1);\n  return Math.min(MAX_INTERVAL_DAYS, Math.max(0, raw));\n}\n\nfunction initStability(rating: SrsRating): number {\n  return clampStability(W[rating - 1]);\n}\n\nfunction initDifficulty(rating: SrsRating): number {\n  return clampDifficulty(W[4] - (rating - 3) * W[5]);\n}\n\nfunction nextDifficulty(d: number, rating: SrsRating): number {\n  const deltaD = -W[6] * (rating - 3);\n  const nextD = d + deltaD;\n  // Mean reversion toward D0(3)\n  const meanReverted = W[7] * initDifficulty(3) + (1 - W[7]) * nextD;\n  return clampDifficulty(meanReverted);\n}\n\nfunction nextRecallStability(\n  d: number,\n  s: number,\n  r: number,\n  rating: 2 | 3 | 4\n): number {\n  const hardPenalty = rating === 2 ? W[15] : 1;\n  const easyBonus = rating === 4 ? W[16] : 1;\n  const growth =\n    Math.exp(W[8]) *\n    (11 - d) *\n    Math.pow(s, -W[9]) *\n    (Math.exp(W[10] * (1 - r)) - 1) *\n    hardPenalty *\n    easyBonus;\n  return clampStability(s * (growth + 1));\n}\n\nfunction nextForgetStability(d: number, s: number, r: number): number {\n  const sNew =\n    W[11] *\n    Math.pow(d, -W[12]) *\n    (Math.pow(s + 1, W[13]) - 1) *\n    Math.exp(W[14] * (1 - r));\n  return clampStability(Math.min(s, sNew));\n}\n\nexport function formatFsrsInterval(days: number, intraDayMinutes?: number): string {\n  if (intraDayMinutes !== undefined && intraDayMinutes < 60) {\n    return intraDayMinutes <= 10 ? \'< 10m\' : `${Math.round(intraDayMinutes)}m`;\n  }\n  if (days < 1 / 24) {\n    return \'< 10m\';\n  }\n  if (days < 1) {\n    const hrs = Math.max(1, Math.round(days * 24));\n    return `${hrs}h`;\n  }\n  const roundedDays = Math.round(days);\n  if (roundedDays < 30) return `${roundedDays}d`;\n  if (roundedDays < 365) {\n    const months = Number((roundedDays / 30).toFixed(1));\n    return months % 1 === 0 ? `${Math.round(months)}m` : `${months}m`;\n  }\n  const years = Number((roundedDays / 365).toFixed(1));\n  return `${years}a`;\n}\n\nexport function formatFsrsIntervalLong(days: number, intraDayMinutes?: number): string {\n  if (intraDayMinutes !== undefined && intraDayMinutes < 60) {\n    return intraDayMinutes <= 10 ? \'< 10 min\' : `${Math.round(intraDayMinutes)} min`;\n  }\n  if (days < 1 / 24) {\n    return \'< 10 min\';\n  }\n  if (days < 1) {\n    const hrs = Math.max(1, Math.round(days * 24));\n    return hrs === 1 ? \'1 hora\' : `${hrs} horas`;\n  }\n  const roundedDays = Math.round(days);\n  if (roundedDays < 30) {\n    return roundedDays === 1 ? \'1 dia\' : `${roundedDays} dias`;\n  }\n  if (roundedDays < 365) {\n    const months = Number((roundedDays / 30).toFixed(1));\n    if (months === 1) return \'1 m\303\252s\';\n    const formatted =\n      months % 1 === 0 ? String(Math.round(months)) : months.toFixed(1).replace(\'.\', \',\');\n    return `${formatted} meses`;\n  }\n  const years = Number((roundedDays / 365).toFixed(1));\n  if (years === 1) return \'1 ano\';\n  const formatted =\n    years % 1 === 0 ? String(Math.round(years)) : years.toFixed(1).replace(\'.\', \',\');\n  return `${formatted} anos`;\n}\n\nfunction computeElapsedDays(card: Flashcard, now: Date): number {\n  if (card.state === \'New\' || !card.lastReviewedAt) return 0;\n  const diffMs = Math.max(0, now.getTime() - new Date(card.lastReviewedAt).getTime());\n  return Number((diffMs / DAY_MS).toFixed(2));\n}\n\n/**\n * Computes all 4 FSRS scheduling outcomes simultaneously so monotonicity\n * (Again < Hard <= Good < Easy) is strictly guaranteed on every card state.\n */\nexport function computeAllFsrsOutcomes(\n  card: Flashcard,\n  targetRetention: TargetRetention = DEFAULT_TARGET_RETENTION,\n  now: Date = new Date()\n): Record<SrsRating, FsrsScheduleOutcome> {\n  const elapsed = computeElapsedDays(card, now);\n\n  // CASE 1: New card (first exposure)\n  if (card.state === \'New\') {\n    const sAgain = initStability(1);\n    const sHard = initStability(2);\n    const sGood = initStability(3);\n    const sEasy = initStability(4);\n\n    const rawHardDays = computeRawIntervalDays(sHard, targetRetention);\n    const rawGoodDays = computeRawIntervalDays(sGood, targetRetention);\n    const rawEasyDays = computeRawIntervalDays(sEasy, targetRetention);\n\n    const hardIsSubDay = rawHardDays < 0.85;\n    const hardDays = hardIsSubDay ? 0 : Math.max(1, Math.round(rawHardDays));\n    const goodDays = Math.max(hardDays + 1, Math.round(rawGoodDays));\n    const easyDays = Math.max(goodDays + 1, Math.round(rawEasyDays));\n\n    const hardDueMs = hardIsSubDay\n      ? now.getTime() + Math.max(1, Math.round(rawHardDays * 24)) * 60 * MINUTE_MS\n      : now.getTime() + hardDays * DAY_MS;\n\n    return {\n      1: {\n        stability: sAgain,\n        difficulty: initDifficulty(1),\n        elapsed_days: 0,\n        scheduled_days: 0,\n        reps: card.reps + 1,\n        lapses: card.lapses + 1,\n        state: \'Learning\',\n        dueAt: new Date(now.getTime() + 5 * MINUTE_MS).toISOString(),\n        previewLabel: \'< 10m\',\n        longPreviewLabel: \'< 10 min\',\n      },\n      2: {\n        stability: sHard,\n        difficulty: initDifficulty(2),\n        elapsed_days: 0,\n        scheduled_days: hardDays,\n        reps: card.reps + 1,\n        lapses: card.lapses,\n        state: hardIsSubDay ? \'Learning\' : \'Review\',\n        dueAt: new Date(hardDueMs).toISOString(),\n        previewLabel: hardIsSubDay\n          ? formatFsrsInterval(rawHardDays)\n          : formatFsrsInterval(hardDays),\n        longPreviewLabel: hardIsSubDay\n          ? formatFsrsIntervalLong(rawHardDays)\n          : formatFsrsIntervalLong(hardDays),\n      },\n      3: {\n        stability: sGood,\n        difficulty: initDifficulty(3),\n        elapsed_days: 0,\n        scheduled_days: goodDays,\n        reps: card.reps + 1,\n        lapses: card.lapses,\n        state: \'Review\',\n        dueAt: new Date(now.getTime() + goodDays * DAY_MS).toISOString(),\n        previewLabel: formatFsrsInterval(goodDays),\n        longPreviewLabel: formatFsrsIntervalLong(goodDays),\n      },\n      4: {\n        stability: sEasy,\n        difficulty: initDifficulty(4),\n        elapsed_days: 0,\n        scheduled_days: easyDays,\n        reps: card.reps + 1,\n        lapses: card.lapses,\n        state: \'Review\',\n        dueAt: new Date(now.getTime() + easyDays * DAY_MS).toISOString(),\n        previewLabel: formatFsrsInterval(easyDays),\n        longPreviewLabel: formatFsrsIntervalLong(easyDays),\n      },\n    };\n  }\n\n  // CASE 2: Learning or Relearning card (short-term consolidation)\n  if (card.state === \'Learning\' || card.state === \'Relearning\') {\n    const baseS = Math.max(card.stability, initStability(1));\n    const baseD = card.difficulty || initDifficulty(3);\n    const r = computeRetrievability(Math.max(elapsed, 0.01), baseS);\n\n    const sAgain = clampStability(Math.min(baseS, initStability(1)));\n    const sHard = clampStability(Math.max(baseS * 1.15, initStability(2) * 0.85));\n    const sGood = nextRecallStability(baseD, Math.max(baseS, 1.0), r, 3);\n    const sEasy = nextRecallStability(baseD, Math.max(baseS, 1.0), r, 4);\n\n    const rawHardDays = computeRawIntervalDays(sHard, targetRetention);\n    const hardIsSubDay = rawHardDays < 0.75;\n    const hardDays = hardIsSubDay ? 0 : Math.max(1, Math.round(rawHardDays));\n    const goodDays = Math.max(hardDays + 1, Math.round(computeRawIntervalDays(sGood, targetRetention)));\n    const easyDays = Math.max(goodDays + 1, Math.round(computeRawIntervalDays(sEasy, targetRetention)));\n\n    const hardDueMs = hardIsSubDay\n      ? now.getTime() + Math.max(1, Math.round(rawHardDays * 24)) * 60 * MINUTE_MS\n      : now.getTime() + hardDays * DAY_MS;\n\n    return {\n      1: {\n        stability: sAgain,\n        difficulty: nextDifficulty(baseD, 1),\n        elapsed_days: elapsed,\n        scheduled_days: 0,\n        reps: card.reps + 1,\n        lapses: card.lapses + 1,\n        state: card.state,\n        dueAt: new Date(now.getTime() + 5 * MINUTE_MS).toISOString(),\n        previewLabel: \'< 10m\',\n        longPreviewLabel: \'< 10 min\',\n      },\n      2: {\n        stability: sHard,\n        difficulty: nextDifficulty(baseD, 2),\n        elapsed_days: elapsed,\n        scheduled_days: hardDays,\n        reps: card.reps + 1,\n        lapses: card.lapses,\n        state: hardIsSubDay ? card.state : \'Review\',\n        dueAt: new Date(hardDueMs).toISOString(),\n        previewLabel: hardIsSubDay\n          ? formatFsrsInterval(rawHardDays)\n          : formatFsrsInterval(hardDays),\n        longPreviewLabel: hardIsSubDay\n          ? formatFsrsIntervalLong(rawHardDays)\n          : formatFsrsIntervalLong(hardDays),\n      },\n      3: {\n        stability: sGood,\n        difficulty: nextDifficulty(baseD, 3),\n        elapsed_days: elapsed,\n        scheduled_days: goodDays,\n        reps: card.reps + 1,\n        lapses: card.lapses,\n        state: \'Review\',\n        dueAt: new Date(now.getTime() + goodDays * DAY_MS).toISOString(),\n        previewLabel: formatFsrsInterval(goodDays),\n        longPreviewLabel: formatFsrsIntervalLong(goodDays),\n      },\n      4: {\n        stability: sEasy,\n        difficulty: nextDifficulty(baseD, 4),\n        elapsed_days: elapsed,\n        scheduled_days: easyDays,\n        reps: card.reps + 1,\n        lapses: card.lapses,\n        state: \'Review\',\n        dueAt: new Date(now.getTime() + easyDays * DAY_MS).toISOString(),\n        previewLabel: formatFsrsInterval(easyDays),\n        longPreviewLabel: formatFsrsIntervalLong(easyDays),\n      },\n    };\n  }\n\n  // CASE 3: Review card (long-term FSRS forgetting curve)\n  const s = Math.max(card.stability, 0.5);\n  const d = card.difficulty || 5.0;\n  // When reviewing ahead of schedule, ensure at least a small positive elapsed fraction\n  // so FSRS recall stability still advances meaningfully.\n  const effectiveElapsed = Math.max(elapsed, 0.25);\n  const retrievability = computeRetrievability(effectiveElapsed, s);\n\n  const sAgain = nextForgetStability(d, s, retrievability);\n  const sHard = nextRecallStability(d, s, retrievability, 2);\n  const sGood = nextRecallStability(d, s, retrievability, 3);\n  const sEasy = nextRecallStability(d, s, retrievability, 4);\n\n  const hardDays = Math.max(1, Math.round(computeRawIntervalDays(sHard, targetRetention)));\n  const goodDays = Math.max(\n    hardDays + 1,\n    Math.round(computeRawIntervalDays(sGood, targetRetention))\n  );\n  const easyDays = Math.max(\n    goodDays + 1,\n    Math.round(computeRawIntervalDays(sEasy, targetRetention))\n  );\n\n  return {\n    1: {\n      stability: sAgain,\n      difficulty: nextDifficulty(d, 1),\n      elapsed_days: elapsed,\n      scheduled_days: 0,\n      reps: card.reps + 1,\n      lapses: card.lapses + 1,\n      state: \'Relearning\',\n      dueAt: new Date(now.getTime() + 10 * MINUTE_MS).toISOString(),\n      previewLabel: \'< 10m\',\n      longPreviewLabel: \'< 10 min\',\n    },\n    2: {\n      stability: sHard,\n      difficulty: nextDifficulty(d, 2),\n      elapsed_days: elapsed,\n      scheduled_days: hardDays,\n      reps: card.reps + 1,\n      lapses: card.lapses,\n      state: \'Review\',\n      dueAt: new Date(now.getTime() + hardDays * DAY_MS).toISOString(),\n      previewLabel: formatFsrsInterval(hardDays),\n      longPreviewLabel: formatFsrsIntervalLong(hardDays),\n    },\n    3: {\n      stability: sGood,\n      difficulty: nextDifficulty(d, 3),\n      elapsed_days: elapsed,\n      scheduled_days: goodDays,\n      reps: card.reps + 1,\n      lapses: card.lapses,\n      state: \'Review\',\n      dueAt: new Date(now.getTime() + goodDays * DAY_MS).toISOString(),\n      previewLabel: formatFsrsInterval(goodDays),\n      longPreviewLabel: formatFsrsIntervalLong(goodDays),\n    },\n    4: {\n      stability: sEasy,\n      difficulty: nextDifficulty(d, 4),\n      elapsed_days: elapsed,\n      scheduled_days: easyDays,\n      reps: card.reps + 1,\n      lapses: card.lapses,\n      state: \'Review\',\n      dueAt: new Date(now.getTime() + easyDays * DAY_MS).toISOString(),\n      previewLabel: formatFsrsInterval(easyDays),\n      longPreviewLabel: formatFsrsIntervalLong(easyDays),\n    },\n  };\n}\n\nexport function computeNextFsrsState(\n  card: Flashcard,\n  rating: SrsRating,\n  targetRetention: TargetRetention = DEFAULT_TARGET_RETENTION,\n  now: Date = new Date()\n): FsrsScheduleOutcome {\n  return computeAllFsrsOutcomes(card, targetRetention, now)[rating];\n}\n\nexport function getFsrsRatingPreviews(\n  card: Flashcard,\n  targetRetention: TargetRetention = DEFAULT_TARGET_RETENTION\n): Record<SrsRating, string> {\n  const outcomes = computeAllFsrsOutcomes(card, targetRetention, new Date());\n  return {\n    1: outcomes[1].previewLabel,\n    2: outcomes[2].previewLabel,\n    3: outcomes[3].previewLabel,\n    4: outcomes[4].previewLabel,\n  };\n}\n\nfunction lookupTopicMetric(\n  map: Record<string, number>,\n  card: Flashcard\n): number | null {\n  if (typeof map[card.tema] === \'number\') return map[card.tema];\n\n  const normTema = normalizeMedicalText(card.tema);\n  const normSubtema = normalizeMedicalText(card.subtema ?? \'\');\n  const normArea = normalizeMedicalText(card.grandeArea);\n\n  const entries = Object.entries(map);\n\n  // Normalized exact match on tema\n  for (const [key, val] of entries) {\n    if (typeof val !== \'number\') continue;\n    if (normalizeMedicalText(key) === normTema) return val;\n  }\n\n  // Partial topic / subtema match\n  for (const [key, val] of entries) {\n    if (typeof val !== \'number\') continue;\n    const normKey = normalizeMedicalText(key);\n    if (\n      (normKey.length >= 4 && normTema.includes(normKey)) ||\n      (normTema.length >= 4 && normKey.includes(normTema)) ||\n      (normSubtema && normKey.length >= 4 && normSubtema.includes(normKey))\n    ) {\n      return val;\n    }\n  }\n\n  // Fallback to Grande \303\201rea metric if available in the map\n  for (const [key, val] of entries) {\n    if (typeof val !== \'number\') continue;\n    if (normalizeMedicalText(key) === normArea) return val;\n  }\n\n  return null;\n}\n\n/**\n * Dynamic, individualized FSRS retention calibration:\n * R_alvo = clamp(0.89 + deltaBanca + deltaIndividual, 0.85, 0.95)\n *\n * - deltaBanca: board incidence weight (+0.03 alta, 0.00 m\303\251dia, -0.03 baixa)\n * - deltaIndividual:\n *     +0.02 if user accuracy < community median (Ponto de Aten\303\247\303\243o)\n *     -0.01 if user accuracy > community median + 10 percentage points (Dom\303\255nio)\n *      0.00 otherwise\n */\nexport function calculateDynamicRetention(\n  card: Flashcard,\n  selectedBoard: ExamBoard,\n  userAccuracyByTopic: Record<string, number>,\n  communityMedianByTopic: Record<string, number>\n): DynamicRetentionResult {\n  const boardWeight = getExamTopicWeight(\n    selectedBoard,\n    card.tema,\n    card.subtema,\n    card.front\n  );\n\n  const rawUserAcc = lookupTopicMetric(userAccuracyByTopic, card);\n  const rawMedian = lookupTopicMetric(communityMedianByTopic, card);\n\n  // Normalize to 0\342\200\223100 percentage scale if caller passes 0\342\200\2231 ratios\n  const userAccuracyPct =\n    rawUserAcc !== null\n      ? Number((rawUserAcc <= 1 && rawUserAcc >= 0 ? rawUserAcc * 100 : rawUserAcc).toFixed(1))\n      : null;\n  const communityMedianPct =\n    rawMedian !== null\n      ? Number((rawMedian <= 1 && rawMedian >= 0 ? rawMedian * 100 : rawMedian).toFixed(1))\n      : null;\n\n  let deltaIndividual = 0;\n  let individualStatus: DynamicRetentionResult[\'individualStatus\'] = \'sem_dados\';\n  let individualReason: string | null = null;\n\n  if (userAccuracyPct !== null && communityMedianPct !== null) {\n    const diff = userAccuracyPct - communityMedianPct;\n    if (diff < 0) {\n      deltaIndividual = 0.02;\n      individualStatus = \'ponto_atencao\';\n      individualReason = \'Ponto de aten\303\247\303\243o\';\n    } else if (diff > 10) {\n      deltaIndividual = -0.01;\n      individualStatus = \'dominio\';\n      individualReason = \'Dom\303\255nio (+10% da mediana)\';\n    } else {\n      deltaIndividual = 0;\n      individualStatus = \'neutro\';\n      individualReason = null;\n    }\n  }\n\n  const unclamped = Number(\n    (BASE_DYNAMIC_RETENTION + boardWeight.delta + deltaIndividual).toFixed(2)\n  );\n  const clamped = Math.min(\n    MAX_DYNAMIC_RETENTION,\n    Math.max(MIN_DYNAMIC_RETENTION, unclamped)\n  );\n  const retention = Number(clamped.toFixed(2));\n  const retentionPct = Math.round(retention * 100);\n\n  const reasons = [boardWeight.reason];\n  if (individualReason) {\n    reasons.push(individualReason);\n  }\n\n  return {\n    mode: \'dinamica\',\n    retention,\n    retentionPct,\n    baseRetention: BASE_DYNAMIC_RETENTION,\n    deltaBanca: boardWeight.delta,\n    deltaIndividual,\n    board: selectedBoard,\n    boardTier: boardWeight.tier,\n    boardReason: boardWeight.reason,\n    individualStatus,\n    individualReason,\n    summaryLabel: `Reten\303\247\303\243o ${retentionPct}% \302\267 ${reasons.join(\' + \')}`,\n    userAccuracyPct,\n    communityMedianPct,\n    wasClamped: unclamped !== retention,\n  };\n}\n\n/**\n * Resolves the effective retention target for a card depending on whether the user\n * chose Dynamic Calibration or a fixed retention preset (85%, 90%, 95%).\n */\nexport function resolveCardRetention(\n  card: Flashcard,\n  retentionMode: RetentionMode,\n  selectedBoard: ExamBoard,\n  userAccuracyByTopic: Record<string, number>,\n  communityMedianByTopic: Record<string, number>\n): DynamicRetentionResult {\n  const dynamic = calculateDynamicRetention(\n    card,\n    selectedBoard,\n    userAccuracyByTopic,\n    communityMedianByTopic\n  );\n\n  if (retentionMode === \'dinamica\') {\n    return dynamic;\n  }\n\n  const fixedPct = Math.round(retentionMode * 100);\n  return {\n    ...dynamic,\n    mode: retentionMode,\n    retention: retentionMode,\n    retentionPct: fixedPct,\n    summaryLabel: `Reten\303\247\303\243o fixa ${fixedPct}% \302\267 Modo manual`,\n    wasClamped: false,\n  };\n}\n\nexport function isCardDueToday(card: Flashcard, now: Date = new Date()): boolean {\n  const endOfToday = new Date(now);\n  endOfToday.setHours(23, 59, 59, 999);\n  return new Date(card.dueAt).getTime() <= endOfToday.getTime();\n}\n\nexport function getCardCurrentRetrievabilityPct(\n  card: Flashcard,\n  now: Date = new Date()\n): number | null {\n  if (card.state === \'New\' || card.stability <= 0) return null;\n  const elapsed = computeElapsedDays(card, now);\n  return Math.round(computeRetrievability(elapsed, card.stability) * 100);\n}\n\n/**\n * Safely migrates any legacy SM-2 flashcards stored in localStorage into FSRS state.\n */\nexport function migrateCardToFsrs(raw: Record<string, unknown>): Flashcard {\n  const hasFsrs =\n    typeof raw.stability === \'number\' &&\n    typeof raw.difficulty === \'number\' &&\n    typeof raw.state === \'string\';\n\n  if (hasFsrs) {\n    return raw as unknown as Flashcard;\n  }\n\n  const legacyReps = typeof raw.repetitions === \'number\' ? raw.repetitions : 0;\n  const legacyInterval = typeof raw.intervalDays === \'number\' ? raw.intervalDays : 0;\n  const legacyLapses = typeof raw.lapses === \'number\' ? raw.lapses : 0;\n\n  let state: FsrsState = \'New\';\n  if (legacyReps > 0) state = \'Review\';\n  else if (legacyLapses > 0) state = \'Learning\';\n\n  return {\n    ...(raw as unknown as Omit<\n      Flashcard,\n      | \'stability\'\n      | \'difficulty\'\n      | \'elapsed_days\'\n      | \'scheduled_days\'\n      | \'reps\'\n      | \'lapses\'\n      | \'state\'\n    >),\n    stability: legacyInterval > 0 ? legacyInterval : 0,\n    difficulty: legacyReps > 0 ? 5.16 : 0,\n    elapsed_days: 0,\n    scheduled_days: legacyInterval,\n    reps: legacyReps,\n    lapses: legacyLapses,\n    state,\n  };\n}\n\n/**\n * Distills a full medical residency question into a crisp FSRS Flashcard (state: \'New\').\n */\nexport function buildFlashcardFromQuestion(\n  question: MedicalQuestion,\n  source: \'perola\' | \'caderno_erros\'\n): Flashcard {\n  const officialAlt = question.alternativas.find(\n    (a) => a.letter === question.gabaritoOficial\n  );\n\n  const sentences = question.enunciado\n    .split(/(?<=[.?!])\\s+/)\n    .filter(Boolean);\n  const lastSentence = sentences[sentences.length - 1] ?? \'\';\n  let frontPrompt: string;\n  if (question.enunciado.length <= 260) {\n    frontPrompt = question.enunciado;\n  } else {\n    const lead = sentences.slice(0, 2).join(\' \');\n    frontPrompt =\n      lastSentence && !lead.includes(lastSentence)\n        ? `${lead} ${lastSentence}`\n        : `${question.enunciado.slice(0, 240).trim()}\342\200\246`;\n  }\n\n  const nowIso = new Date().toISOString();\n\n  return {\n    id: `fc-${question.id}`,\n    questionId: question.id,\n    questionCode: question.code,\n    institutionLabel: `${question.instituicao} ${question.ano}`,\n    grandeAreaId: question.grandeAreaId,\n    grandeArea: question.grandeArea,\n    tema: question.tema,\n    subtema: question.subtema,\n    front: frontPrompt,\n    backPearl: question.perolaClinica,\n    backAnswerSummary: officialAlt\n      ? `Conduta / Resposta (${officialAlt.letter}): ${officialAlt.text}`\n      : undefined,\n    source,\n    createdAt: nowIso,\n    dueAt: nowIso,\n    stability: 0,\n    difficulty: 0,\n    elapsed_days: 0,\n    scheduled_days: 0,\n    reps: 0,\n    lapses: 0,\n    state: \'New\',\n  };\n}\n"
