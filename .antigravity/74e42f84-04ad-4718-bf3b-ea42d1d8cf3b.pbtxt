            }
            lines {
              text: "    regiao: \'Sudeste\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ano: 2025,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    tipoProva: \'Acesso Direto\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    anulada: false,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    desatualizada: false,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    enunciado:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Homem de 58 anos, tabagista (40 ma\303\247os-ano) e hipertenso irregular, chega \303\240 UPA de um munic\303\255pio sem servi\303\247o de hemodin\303\242mica queixando-se de dor tor\303\241cica retroesternal em aperto de forte intensidade (9/10), com irradia\303\247\303\243o para mand\303\255bula e sudorese fria h\303\241 2 horas e 15 minutos. Ao exame: PA 138/86 mmHg, FC 94 bpm, SpO\342\202\202 97% em ar ambiente, ausculta pulmonar limpa, sem sopros card\303\255acos (Killip I). Realizado ECG de 12 deriva\303\247\303\265es em 6 minutos da admiss\303\243o (imagem abaixo). O hospital de refer\303\252ncia com angioplastia prim\303\241ria dispon\303\255vel encontra-se a 150 minutos de transporte terrestre. N\303\243o h\303\241 contraindica\303\247\303\265es \303\240 fibrin\303\263lise. Qual \303\251 a conduta imediata mais adequada?\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    clinicalImage: {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      url: \'/src/assets/images/clinical_ecg_stemi_1795302152424.jpg\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      modality: \'ECG 12 Deriva\303\247\303\265es\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      caption: \'Eletrocardiograma de admiss\303\243o (25 mm/s, 10 mm/mV) demonstrando supradesnivelamento do segmento ST em parede anterior.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      aspectRatio: \'16:9\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    labTable: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { exame: \'Troponina I ultrassens\303\255vel\', resultado: \'412 ng/L\', referencia: \'< 19 ng/L\', alterado: \'alto\' },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { exame: \'Creatinina s\303\251rica\', resultado: \'1,0 mg/dL\', referencia: \'0,7\342\200\2231,3 mg/dL\', alterado: \'normal\' },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { exame: \'Pot\303\241ssio (K\342\201\272)\', resultado: \'4,2 mEq/L\', referencia: \'3,5\342\200\2235,1 mEq/L\', alterado: \'normal\' },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { exame: \'Hemoglobina\', resultado: \'14,8 g/dL\', referencia: \'13,5\342\200\22317,5 g/dL\', alterado: \'normal\' },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    alternativas: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        letter: \'A\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        text: \'Administrar AAS 300 mg, clopidogrel 300 mg, enoxaparina e iniciar fibrin\303\263lise imediata (tenecteplase ou alteplase), com transfer\303\252ncia subsequente para centro com hemodin\303\242mica em estrat\303\251gia f\303\241rmaco-invasiva.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        explanation:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Correta. O ECG mostra IAMCSST de parede anterior extensa (supra de ST em V1-V4) com delta-T de 2h15 (< 12h). Como o tempo estimado porta-bal\303\243o excede 120 minutos (transporte de 150 min), a Diretriz SBC recomenda fibrin\303\263lise imediata (meta porta-agulha \342\211\244 30 min) associada a dupla antiagrega\303\247\303\243o (AAS + clopidogrel 300 mg em pacientes \342\211\244 75 anos) e anticoagula\303\247\303\243o, seguida de transfer\303\252ncia para cineangiocoronariografia entre 2 e 24h (estrat\303\251gia f\303\241rmaco-invasiva).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        communityPct: 68.4,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        letter: \'B\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        text: \'Administrar AAS 300 mg, ticagrelor 180 mg e transferir imediatamente para angioplastia prim\303\241ria, evitando tromb\303\263lise pelo risco hemorr\303\241gico.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        explanation:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Incorreta (Principal distrator). A angioplastia prim\303\241ria s\303\263 \303\251 prefer\303\255vel \303\240 fibrin\303\263lise quando pode ser realizada em at\303\251 120 minutos a partir do diagn\303\263stico eletrocardiogr\303\241fico em hospitais sem hemodin\303\242mica. Al\303\251m disso, ticagrelor e prasugrel n\303\243o s\303\243o os inibidores P2Y12 de escolha no cen\303\241rio de fibrin\303\263lise imediata.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        communityPct: 19.2,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        letter: \'C\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        text: \'Aguardar nova curva de troponina em 3 horas e realizar nitrato sublingual e morfina antes de definir terapia de reperfus\303\243o.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        explanation:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Incorreta. No IAM com supradesnivelamento do segmento ST, a decis\303\243o de reperfus\303\243o \303\251 estritamente cl\303\255nico-eletrocardiogr\303\241fica; jamais se deve atrasar a reperfus\303\243o aguardando marcadores de necrose mioc\303\241rdica.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        communityPct: 3.1,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        letter: \'D\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        text: \'Administrar AAS 300 mg, prasugrel 60 mg, heparina n\303\243o fracionada e iniciar tenecteplase em dose plena.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        explanation:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Incorreta. O prasugrel \303\251 contraindicado na terapia fibrinol\303\255tica (estudos demonstraram risco elevado de sangramento maior sem benef\303\255cio estabelecido). Com trombol\303\255tico, o inibidor P2Y12 padr\303\243o-ouro \303\251 o clopidogrel.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        communityPct: 7.5,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        letter: \'E\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        text: \'Iniciar oxigenoterapia em m\303\241scara n\303\243o reinalante a 10 L/min, furosemida venosa e aguardar estabilidade hemodin\303\242mica para transfer\303\252ncia.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        explanation:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Incorreta. O paciente tem SpO\342\202\202 97% (oxig\303\252nio suplementar s\303\263 \303\251 indicado se SpO\342\202\202 < 90% ou desconforto respirat\303\263rio) e est\303\241 em Killip I (sem congest\303\243o pulmonar), n\303\243o havendo indica\303\247\303\243o de furosemida.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        communityPct: 1.8,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    gabaritoOficial: \'A\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    totalRespostasComunidade: 4820,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    taxaAcertoGlobal: 68.4,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    comentarioGeral:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Quest\303\243o cl\303\241ssica da USP-SP cobrando o algoritmo de reperfus\303\243o no IAMCSST em servi\303\247os sem hemodin\303\242mica. O ponto decisivo \303\251 a regra dos 120 minutos: se o tempo previsto desde o diagn\303\263stico de IAMCSST at\303\251 a abertura da art\303\251ria (fio-guia) ultrapassar 120 minutos e o paciente estiver dentro da janela de 12 horas do in\303\255cio dos sintomas sem contraindica\303\247\303\265es absolutas, a fibrin\303\263lise imediata seguida de estrat\303\251gia f\303\241rmaco-invasiva salva mais mioc\303\241rdio e reduz mortalidade.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    perolaClinica:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Regra de ouro no IAMCSST sem hemodin\303\242mica: transfer\303\252ncia > 120 min = Fibrin\303\263lise imediata (porta-agulha \342\211\244 30 min) + AAS + Clopidogrel (300 mg se \342\211\244 75 anos; sem ataque se > 75 anos) + Enoxaparina + CATE em 2\342\200\22324h.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    referencias: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Diretriz Brasileira de S\303\255ndromes Coronarianas Agudas \342\200\224 SBC (2021/2023).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Braunwald\342\200\231s Heart Disease: A Textbook of Cardiovascular Medicine, 12\302\252 ed.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Harrison\342\200\231s Principles of Internal Medicine, 21\302\252 ed., Cap. 275.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    id: \'q-unicamp-2025-trauma-02\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    code: \'Q-UNI25-0089\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    grandeAreaId: \'cirurgia_geral\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    grandeArea: \'Cirurgia Geral\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    tema: \'Trauma\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    subtema: \'Atendimento Inicial ao Politraumatizado (ATLS)\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    banca: \'COMVEST\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    instituicao: \'UNICAMP\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    estado: \'SP\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    regiao: \'Sudeste\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ano: 2025,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    tipoProva: \'Acesso Direto\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    anulada: false,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    desatualizada: false,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    enunciado:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Motociclista de 27 anos sofre colis\303\243o lateral contra autom\303\263vel e \303\251 trazido \303\240 sala de trauma pelo SAMU em prancha r\303\255gida e colar cervical. \303\200 avalia\303\247\303\243o prim\303\241ria: via a\303\251rea p\303\251rvia com fala entrecortada, FR 34 irpm, SpO\342\202\202 86% em m\303\241scara com reservat\303\263rio, murm\303\272rio vesicular abolido em hemit\303\263rax direito, hipertimpanismo \303\240 percuss\303\243o \303\240 direita, turg\303\252ncia jugular bilateral, PA 78/46 mmHg e FC 136 bpm. Antes mesmo da radiografia de t\303\263rax (ilustrada apenas para correla\303\247\303\243o diagn\303\263stica did\303\241tica), qual \303\251 a conduta imediata preconizada pela 10\302\252 edi\303\247\303\243o do ATLS para adultos?\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    clinicalImage: {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      url: \'/src/assets/images/clinical_xray_pneumothorax_1795302149327.jpg\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      modality: \'Radiografia de T\303\263rax AP\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      caption: \'Radiografia de t\303\263rax demonstrando pneumot\303\263rax extenso \303\240 direita com linha pleural visceral evidente e desvio mediastinal contralateral (na pr\303\241tica cl\303\255nica, n\303\243o aguardar RX no pneumot\303\263rax hipertensivo).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      aspectRatio: \'4:3\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    alternativas: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        letter: \'A\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        text: \'Descompress\303\243o tor\303\241cica imediata com agulha calibrosa no 4\302\272 ou 5\302\272 espa\303\247o intercostal direito, imediatamente anterior \303\240 linha axilar m\303\251dia, seguida de drenagem pleural em selo d\342\200\231\303\241gua.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        explanation:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Correta. A 10\302\252 edi\303\247\303\243o do ATLS alterou o s\303\255tio preferencial de pun\303\247\303\243o de al\303\255vio em adultos do 2\302\272 EIC na linha hemiclavicular para o 4\302\272 ou 5\302\272 espa\303\247o intercostal, ligeiramente anterior \303\240 linha axilar m\303\251dia (mesmo local anat\303\264mico da drenagem tor\303\241cica), devido \303\240 menor espessura da parede tor\303\241cica e menor taxa de falha.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        communityPct: 54.6,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        letter: \'B\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        text: \'Descompress\303\243o imediata com jelco 14G obrigatoriamente no 2\302\272 espa\303\247o intercostal na linha hemiclavicular direita, \303\272nica topografia recomendada para adultos pelo ATLS 10\302\252 edi\303\247\303\243o.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        explanation:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Incorreta (Principal distrator). O 2\302\272 EIC na linha hemiclavicular permanece como s\303\255tio preferencial em crian\303\247as (e alternativa aceit\303\241vel), mas no adulto a atualiza\303\247\303\243o da 10\302\252 edi\303\247\303\243o do ATLS passou a recomendar o 4\302\272 ou 5\302\272 EIC anterior \303\240 linha axilar m\303\251dia.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        communityPct: 31.4,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        letter: \'C\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        text: \'Realizar radiografia de t\303\263rax no leito e eFAST para confirmar o pneumot\303\263rax hipertensivo antes de qualquer procedimento invasivo.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        explanation:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Incorreta. O diagn\303\263stico do pneumot\303\263rax hipertensivo \303\251 estritamente cl\303\255nico (choque obstrutivo + aus\303\252ncia de MV + hipertimpanismo + turg\303\252ncia jugular). Aguardar imagem atrasa o tratamento e aumenta drasticamente a mortalidade.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        communityPct: 6.2,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        letter: \'D\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        text: \'Intuba\303\247\303\243o orotraqueal imediata com press\303\243o positiva elevada e reposi\303\247\303\243o vol\303\252mica vigorosa com 2 litros de Ringer Lactato aquecido.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        explanation:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Incorreta. Instituir ventila\303\247\303\243o com press\303\243o positiva antes de descomprimir um pneumot\303\263rax hipertensivo agrava o aprisionamento a\303\251reo e precipita parada cardiorrespirat\303\263ria em AESP.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        communityPct: 5.5,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        letter: \'E\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        text: \'Pericardiocentese subxifoidea guiada por ultrassom para tratamento do choque obstrutivo com turg\303\252ncia jugular.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        explanation:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Incorreta. Embora o tamponamento card\303\255aco tamb\303\251m cause choque obstrutivo e turg\303\252ncia jugular, ele n\303\243o cursa com aboli\303\247\303\243o do murm\303\272rio vesicular e hipertimpanismo unilateral.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        communityPct: 2.3,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    gabaritoOficial: \'A\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    totalRespostasComunidade: 5390,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    taxaAcertoGlobal: 54.6,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    comentarioGeral:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'A atualiza\303\247\303\243o do s\303\255tio anat\303\264mico da toracocentese de al\303\255vio em adultos na 10\302\252 edi\303\247\303\243o do ATLS \303\251 um dos temas mais prevalentes nas provas de Cirurgia Geral de S\303\243o Paulo (UNICAMP, USP e SUS-SP). O quadro cl\303\255nico de choque obstrutivo associado a hipertimpanismo e aboli\303\247\303\243o do MV \303\240 direita fecha o diagn\303\263stico cl\303\255nico de pneumot\303\263rax hipertensivo.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    perolaClinica:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'ATLS 10\302\252 edi\303\247\303\243o: Pun\303\247\303\243o de al\303\255vio em ADULTOS \342\206\222 4\302\272 ou 5\302\272 EIC, anterior \303\240 linha axilar m\303\251dia (em crian\303\247as mant\303\251m-se 2\302\272 EIC na linha hemiclavicular). Depois, dreno de t\303\263rax em selo d\342\200\231\303\241gua (28\342\200\22332 Fr).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    referencias: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'ATLS \342\200\224 Advanced Trauma Life Support, Student Course Manual, 10\302\252 ed., Cap. 4.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Sabiston Textbook of Surgery, 21\302\252 ed., Cap. 16 (Management of Acute Trauma).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    id: \'q-psumg-2024-neurotrauma-03\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    code: \'Q-PSU24-0311\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    grandeAreaId: \'cirurgia_geral\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    grandeArea: \'Cirurgia Geral\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    tema: \'Trauma\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    subtema: \'Traumatismo Cranioencef\303\241lico e Hematomas Intracranianos\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    banca: \'AREMG\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    instituicao: \'PSU-MG\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    estado: \'MG\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    regiao: \'Sudeste\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ano: 2024,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    tipoProva: \'Acesso Direto\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    anulada: false,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    desatualizada: false,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    enunciado:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Homem de 31 anos sofre trauma cranioencef\303\241lico ap\303\263s queda de bicicleta sem capacete com impacto em regi\303\243o temporal esquerda. Apresentou perda transit\303\263ria da consci\303\252ncia por 2 minutos, acordou l\303\272cido e orientado (Glasgow 15), mas ap\303\263s 90 minutos na observa\303\247\303\243o evoluiu subitamente com sonol\303\252ncia (Glasgow 10), anisocoria com midr\303\255ase esquerda e hemiparesia direita. Realizada tomografia de cr\303\242nio sem contraste (imagem abaixo). Qual \303\251 o diagn\303\263stico mais prov\303\241vel e o principal vaso acometido?\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    clinicalImage: {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      url: \'/src/assets/images/clinical_ct_epidural_1795302150711.jpg\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      modality: \'TC de Cr\303\242nio sem Contraste\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      caption: \'Corte axial em janela de par\303\252nquima cerebral evidenciando cole\303\247\303\243o extra-axial hiperdensa de morfologia biconvexa em regi\303\243o temporoparietal esquerda.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      aspectRatio: \'1:1\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    alternativas: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        letter: \'A\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        text: \'Hematoma subdural agudo por rotura de veias-ponte corticais.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        explanation:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Incorreta (Principal distrator). O hematoma subdural agudo apresenta aspecto em crescente (c\303\264ncavo-convexo), cruza linhas de sutura, costuma associar-se a les\303\243o parenquimatosa subjacente e tem origem venosa (veias-ponte).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        communityPct: 16.8,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        letter: \'B\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        text: \'Hematoma epidural (extradural) agudo por les\303\243o da art\303\251ria men\303\255ngea m\303\251dia.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        explanation:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Correta. O quadro cl\303\241ssico de \"intervalo l\303\272cido\" seguido de r\303\241pida deteriora\303\247\303\243o neurol\303\263gica com sinais de hernia\303\247\303\243o uncal (midr\303\255ase ipsilateral por compress\303\243o do III par + hemiparesia contralateral) associado \303\240 imagem hiperdensa biconvexa (em lente) que respeita suturas cranianas define o hematoma epidural agudo, classicamente causado por fratura do osso temporal com les\303\243o da art\303\251ria men\303\255ngea m\303\251dia.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        communityPct: 76.2,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        letter: \'C\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        text: \'Hemorragia subaracnoidea traum\303\241tica por ruptura de aneurisma da art\303\251ria comunicante anterior.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        explanation:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Incorreta. A HSA cursa com hiperdensidade preenchendo cisternas da base e sulcos corticais, sem cole\303\247\303\243o biconvexa extra-axial localizada.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        communityPct: 3.1,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        letter: \'D\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        text: \'Les\303\243o axonal difusa grave por cisalhamento da subst\303\242ncia branca subcortical.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        explanation:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Incorreta. A LAD manifesta-se com coma imediato desde o momento do trauma (sem intervalo l\303\272cido) e TC inicialmente normal ou com micro-hemorragias puntiformes no corpo caloso e jun\303\247\303\243o c\303\263rtico-subcortical.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        communityPct: 3.9,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    gabaritoOficial: \'B\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    totalRespostasComunidade: 3910,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    taxaAcertoGlobal: 76.2,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    comentarioGeral:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Quest\303\243o de neurotrauma de alta incid\303\252ncia no PSU-MG e ENARE. Na conven\303\247\303\243o radiol\303\263gica da TC axial, o lado direito da imagem corresponde ao hemisf\303\251rio esquerdo do paciente. A cole\303\247\303\243o hiperdensa biconvexa limitada pelas inser\303\247\303\265es durais nas suturas cranianas, somada ao intervalo l\303\272cido e \303\240 anisocoria ipsilateral (hernia\303\247\303\243o do uncus comprimindo o nervo oculomotor), fecha o diagn\303\263stico de hematoma epidural agudo \342\200\224 emerg\303\252ncia neurocir\303\272rgica com indica\303\247\303\243o de craniotomia descompressiva.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    perolaClinica:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Epidural = Lente Biconvexa + Art\303\251ria Men\303\255ngea M\303\251dia + Intervalo L\303\272cido + N\303\203O cruza suturas. Subdural = Crescente (Lua) + Veias-Ponte + CRUZA suturas.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    referencias: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'ATLS \342\200\224 Advanced Trauma Life Support, 10\302\252 ed., Cap. 6 (Head Trauma).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Sabiston Textbook of Surgery, 21\302\252 ed., Cap. 68 (Neurosurgery).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    id: \'q-enare-2025-nefro-04\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    code: \'Q-ENR25-0204\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    grandeAreaId: \'clinica_medica\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    grandeArea: \'Cl\303\255nica M\303\251dica\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    tema: \'Nefrologia\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    subtema: \'Dist\303\272rbios Hidroeletrol\303\255ticos e Hipercalemia Grave\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    banca: \'FGV\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    instituicao: \'ENARE\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    estado: \'BR\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    regiao: \'Nacional\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ano: 2025,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    tipoProva: \'Acesso Direto\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    anulada: false,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    desatualizada: false,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    enunciado:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Mulher de 67 anos, portadora de doen\303\247a renal cr\303\264nica est\303\241gio 4 secund\303\241ria \303\240 nefropatia diab\303\251tica, d\303\241 entrada no pronto-socorro por fraqueza muscular progressiva ap\303\263s uso de anti-inflamat\303\263rio n\303\243o esteroidal por 5 dias. PA 152/88 mmHg, FC 52 bpm, diurese reduzida. O ECG demonstra ondas T apiculadas em tenda, prolongamento do intervalo PR e alargamento do complexo QRS (138 ms). Os exames laboratoriais est\303\243o apresentados na tabela. Qual deve ser a PRIMEIRA medida farmacol\303\263gica imediata?\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    labTable: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { exame: \'Pot\303\241ssio s\303\251rico (K\342\201\272)\', resultado: \'7,4 mEq/L\', referencia: \'3,5\342\200\2235,1 mEq/L\', alterado: \'alto\' },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { exame: \'Creatinina\', resultado: \'4,8 mg/dL\', referencia: \'0,6\342\200\2231,1 mg/dL\', alterado: \'alto\' },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { exame: \'Ureia\', resultado: \'142 mg/dL\', referencia: \'15\342\200\22340 mg/dL\', alterado: \'alto\' },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { exame: \'pH arterial\', resultado: \'7,29\', referencia: \'7,35\342\200\2237,45\', alterado: \'baixo\' },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { exame: \'Bicarbonato (HCO\342\202\203\342\201\273)\', resultado: \'15 mEq/L\', referencia: \'22\342\200\22326 mEq/L\', alterado: \'baixo\' },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { exame: \'Glicemia capilar\', resultado: \'164 mg/dL\', referencia: \'70\342\200\223140 mg/dL\', alterado: \'alto\' },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    alternativas: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        letter: \'A\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        text: \'Solu\303\247\303\243o polarizante com insulina regular 10 UI IV associada a glicose hipert\303\264nica a 50%.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        explanation:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Incorreta (Principal distrator). A solu\303\247\303\243o polarizante promove o influxo intracelular de pot\303\241ssio com in\303\255cio em 15\342\200\22330 min, sendo a segunda etapa fundamental, mas N\303\203O estabiliza imediatamente a membrana mioc\303\241rdica frente ao alargamento de QRS.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        communityPct: 24.5,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        letter: \'B\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        text: \'Gluconato de c\303\241lcio a 10%, 10 mL por via intravenosa em 2 a 5 minutos, sob monitoriza\303\247\303\243o eletrocardiogr\303\241fica cont\303\255nua.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        explanation:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Correta. Diante de hipercalemia com repercuss\303\243o eletrocardiogr\303\241fica (especialmente alargamento de QRS ou aus\303\252ncia de onda P), a prioridade absoluta \303\251 a estabiliza\303\247\303\243o da membrana do cardiomi\303\263cito com c\303\241lcio intravenoso (gluconato de c\303\241lcio 10%), cujo efeito ocorre em 1 a 3 minutos e previne fibrila\303\247\303\243o ventricular e assistolia.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        communityPct: 64.8,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        letter: \'C\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        text: \'Resina de troca i\303\264nica (poliestirenossulfonato de c\303\241lcio) via oral associada a furosemida IV.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        explanation:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Incorreta. Resinas de troca t\303\252m in\303\255cio de a\303\247\303\243o lento (horas) e nunca constituem a primeira medida na hipercalemia amea\303\247adora \303\240 vida.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        communityPct: 3.4,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        letter: \'D\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        text: \'Bicarbonato de s\303\263dio 8,4% 1 mEq/kg IV em bolus como monoterapia inicial.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        explanation:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Incorreta. O bicarbonato tem efeito discreto e demorado sobre o pot\303\241ssio s\303\251rico e pode auxiliar apenas em acidose metab\303\263lica grave, sem substituir o c\303\241lcio na estabiliza\303\247\303\243o el\303\251trica imediata.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        communityPct: 4.9,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        letter: \'E\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        text: \'Nebuliza\303\247\303\243o isolada com fenoterol 10 gotas e repeti\303\247\303\243o do pot\303\241ssio em 1 hora.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        explanation:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Incorreta. Beta-2 agonistas s\303\243o adjuvantes para redistribui\303\247\303\243o intracelular do pot\303\241ssio, mas n\303\243o protegem o mioc\303\241rdio imediatamente contra arritmias malignas.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        communityPct: 2.4,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    gabaritoOficial: \'B\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    totalRespostasComunidade: 6120,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    taxaAcertoGlobal: 64.8,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    comentarioGeral:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Na emerg\303\252ncia nefrol\303\263gica, o manejo da hipercalemia grave segue 3 pilares sequenciais: (1) Estabilizar a membrana card\303\255aca (Gluconato de c\303\241lcio 10% IV \342\200\224 n\303\243o reduz o K\342\201\272 s\303\251rico, mas salva a vida em minutos); (2) Redistribuir K\342\201\272 para o intracelular (Insulina + Glicose, beta-2 agonista inalat\303\263rio, bicarbonato se acidose); (3) Eliminar K\342\201\272 do organismo (furosemida se diurese preservada, resinas de troca ou hemodi\303\241lise de urg\303\252ncia).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    perolaClinica:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Altera\303\247\303\243o no ECG na hipercalemia = Gluconato de C\303\241lcio 10% IV PRIMEIRO! Ele eleva o potencial de limiar da membrana sem reduzir a calemia s\303\251rica.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    referencias: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'KDIGO Controversies Conference on Potassium Management in Kidney Disease.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Harrison\342\200\231s Principles of Internal Medicine, 21\302\252 ed., Cap. 53 (Fluid and Electrolyte Disturbances).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    id: \'q-usp-2025-go-05\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    code: \'Q-USP25-0418\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    grandeAreaId: \'ginecologia_obstetricia\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    grandeArea: \'Ginecologia e Obstetr\303\255cia\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    tema: \'Obstetr\303\255cia / Pr\303\251-Natal\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    subtema: \'Diabetes Mellitus Gestacional (DMG)\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    banca: \'FUVEST\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    instituicao: \'USP-SP\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    estado: \'SP\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    regiao: \'Sudeste\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ano: 2025,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    tipoProva: \'Acesso Direto\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    anulada: false,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    desatualizada: false,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    enunciado:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Gestante de 29 anos, G2P1A0, IMC pr\303\251-gestacional de 28,4 kg/m\302\262, sem comorbidades pr\303\251vias conhecidas, comparece \303\240 consulta de pr\303\251-natal com 26 semanas trazendo resultado de Teste Oral de Toler\303\242ncia \303\240 Glicose com 75 g (TOTG-75g) realizado conforme rotina em servi\303\247o com viabilidade t\303\251cnica total. A glicemia de jejum do primeiro trimestre havia sido 84 mg/dL. Os valores do TOTG atual s\303\243o: jejum 90 mg/dL, 1\302\252 hora 184 mg/dL e 2\302\252 hora 148 mg/dL. Segundo o Consenso Brasileiro de Diabetes Mellitus Gestacional (FEBRASGO/SBD/OPAS), qual \303\251 o diagn\303\263stico e a conduta inicial?\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    labTable: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { exame: \'TOTG 75g \342\200\224 Jejum\', resultado: \'90 mg/dL\', referencia: \'< 92 mg/dL\', alterado: \'normal\' },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { exame: \'TOTG 75g \342\200\224 1\302\252 hora\', resultado: \'184 mg/dL\', referencia: \'< 180 mg/dL\', alterado: \'alto\' },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { exame: \'TOTG 75g \342\200\224 2\302\252 hora\', resultado: \'148 mg/dL\', referencia: \'< 153 mg/dL\', alterado: \'normal\' },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    alternativas: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        letter: \'A\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        text: \'Exame normal, pois apenas um ponto do TOTG-75g encontra-se alterado; manter pr\303\251-natal de risco habitual.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        explanation:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Incorreta (Principal distrator). Esse era o crit\303\251rio antigo de Carpenter & Coustan (TOTG 100g), que exigia dois valores alterados. Pelo crit\303\251rio atual da IADPSG/FEBRASGO com TOTG-75g, APENAS UM ponto igual ou superior ao ponto de corte j\303\241 confirma o diagn\303\263stico de DMG.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        communityPct: 26.7,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        letter: \'B\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        text: \'Diabetes Mellitus Gestacional (DMG); iniciar terapia nutricional, atividade f\303\255sica orientada e automonitoriza\303\247\303\243o glic\303\252mica capilar antes de indicar farmacoterapia.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        explanation:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Correta. Os pontos de corte do TOTG-75g (24\342\200\22328 semanas) s\303\243o: jejum \342\211\245 92 mg/dL, 1h \342\211\245 180 mg/dL ou 2h \342\211\245 153 mg/dL. Um \303\272nico valor alterado (1h = 184 mg/dL) confirma DMG. A primeira linha terap\303\252utica consiste em orienta\303\247\303\243o diet\303\251tica individualizada, atividade f\303\255sica regular e perfil glic\303\252mico capilar por 1 a 2 semanas; apenas na falha de controle inicia-se insulina.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        communityPct: 58.3,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        letter: \'C\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        text: \'Diabetes Mellitus pr\303\251vio (Overt Diabetes) diagnosticado na gesta\303\247\303\243o; iniciar insulina NPH e regular imediatamente.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        explanation:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Incorreta. Overt Diabetes \303\251 definido por glicemia de jejum \342\211\245 126 mg/dL, 2h no TOTG \342\211\245 200 mg/dL, HbA1c \342\211\245 6,5% ou glicemia ao acaso \342\211\245 200 mg/dL com sintomas.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        communityPct: 5.8,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        letter: \'D\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        text: \'Diabetes Mellitus Gestacional (DMG); iniciar metformina 850 mg duas vezes ao dia como primeira linha padr\303\243o.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        explanation:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Incorreta. Al\303\251m de a mudan\303\247a de estilo de vida preceder a medica\303\247\303\243o em pacientes sem descompensa\303\247\303\243o grave, a terapia farmacol\303\263gica de primeira escolha no DMG no Brasil continua sendo a insulina (a metformina \303\251 alternativa em casos selecionados).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        communityPct: 9.2,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    gabaritoOficial: \'B\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    totalRespostasComunidade: 4415,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    taxaAcertoGlobal: 58.3,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    comentarioGeral:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'A tabela diagn\303\263stica de DMG da OPAS/FEBRASGO/MS \303\251 campe\303\243 absoluta de cobran\303\247a em GO. Memorizar os cortes exatos \342\200\224 92 / 180 / 153 mg/dL \342\200\224 e lembrar que basta UM valor alterado no TOTG-75g evita cair no distrator cl\303\241ssico dos \"dois pontos alterados\".\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    perolaClinica:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'TOTG-75g (24\342\200\22328 sem): basta 1 valor \342\211\245 92 (jejum) | \342\211\245 180 (1h) | \342\211\245 153 (2h) = DMG! Alvos no tratamento: jejum < 95, 1h p\303\263s-prandial < 140, 2h p\303\263s-prandial < 120 mg/dL.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    referencias: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'FEBRASGO / OPAS / SBD \342\200\224 Rastreamento e Diagn\303\263stico de Diabetes Mellitus Gestacional no Brasil.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Williams Obstetrics, 26\302\252 ed., Cap. 60 (Diabetes Mellitus).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    id: \'q-unifesp-2025-neo-06\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    code: \'Q-UNF25-0512\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    grandeAreaId: \'pediatria\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    grandeArea: \'Pediatria\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    tema: \'Neonatologia\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    subtema: \'Reanima\303\247\303\243o Neonatal (Diretriz SBP 2022)\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    banca: \'VUNESP\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    instituicao: \'UNIFESP\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    estado: \'SP\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    regiao: \'Sudeste\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ano: 2025,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    tipoProva: \'Acesso Direto\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    anulada: false,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    desatualizada: false,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    enunciado:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Rec\303\251m-nascido a termo (IG 39 semanas e 2 dias), parto vaginal sem intercorr\303\252ncias maternas, l\303\255quido amni\303\263tico claro, nasce hipot\303\264nico e em apneia. Foi realizado clampeamento imediato do cord\303\243o umbilical e o neonato foi levado \303\240 mesa de reanima\303\247\303\243o sob fonte de calor radiante. Ap\303\263s posicionar a cabe\303\247a em leve extens\303\243o, aspirar vias a\303\251reas se necess\303\241rio, secar e desprezar campos \303\272midos (passos iniciais conclu\303\255dos em 30 segundos), o RN permanece em apneia e com frequ\303\252ncia card\303\255aca de 76 bpm medida por ausculta precordial. De acordo com a Diretriz de Reanima\303\247\303\243o do RN \342\211\245 34 semanas da SBP (2022), qual \303\251 a conduta imediata correta?\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    alternativas: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        letter: \'A\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        text: \'Iniciar ventila\303\247\303\243o com press\303\243o positiva (VPP) com m\303\241scara facial e ar ambiente (FiO\342\202\202 21%), na frequ\303\252ncia de 40 a 60 movimentos por minuto, e instalar monitor card\303\255aco e ox\303\255metro de pulso no membro superior direito.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        explanation:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Correta. Em RN \342\211\245 34 semanas que ap\303\263s os passos iniciais apresenta apneia, respira\303\247\303\243o irregular ou FC < 100 bpm, indica-se VPP imediata (dentro do Minuto de Ouro \342\200\224 primeiros 60 segundos) com m\303\241scara facial em ar ambiente (FiO\342\202\202 21%), ritmo de 40\342\200\22360/min (\"aperta-solta-solta\"), acompanhada da instala\303\247\303\243o do monitor card\303\255aco de 3 deriva\303\247\303\265es e ox\303\255metro pr\303\251-ductal (MSD).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        communityPct: 71.9,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        letter: \'B\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        text: \'Iniciar ventila\303\247\303\243o com press\303\243o positiva (VPP) com FiO\342\202\202 a 30% e massagem card\303\255aca externa coordenada na rela\303\247\303\243o 3:1.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        explanation:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Incorreta (Principal distrator). FiO\342\202\202 a 30% \303\251 utilizada no in\303\255cio da VPP para prematuros < 34 semanas, e a massagem card\303\255aca s\303\263 \303\251 indicada se a FC permanecer < 60 bpm AP\303\223S 30 segundos de VPP efetiva com c\303\242nula traqueal.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        communityPct: 14.3,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        letter: \'C\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        text: \'Realizar intuba\303\247\303\243o orotraqueal imediata e administrar adrenalina endotraqueal antes de iniciar ventila\303\247\303\243o.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        explanation:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Incorreta. A VPP com m\303\241scara facial \303\251 sempre a primeira interven\303\247\303\243o ventilat\303\263ria (exceto situa\303\247\303\265es especiais como h\303\251rnia diafragm\303\241tica cong\303\252nita). Mais de 90% dos RNs respondem adequadamente \303\240 VPP bem executada.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        communityPct: 4.8,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        letter: \'D\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        text: \'Fornecer oxig\303\252nio inalat\303\263rio livre a 5 L/min pr\303\263ximo \303\240 face e aguardar mais 30 segundos para reavaliar a frequ\303\252ncia card\303\255aca.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        explanation:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Incorreta. Oxig\303\252nio inalat\303\263rio n\303\243o substitui a VPP diante de apneia ou FC < 100 bpm e atrasa a abertura alveolar dentro do Minuto de Ouro.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        communityPct: 6.1,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        letter: \'E\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        text: \'Realizar est\303\255mulo t\303\241til vigoroso em dorso e plantas dos p\303\251s por mais 30 segundos antes de indicar suporte ventilat\303\263rio.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        explanation:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Incorreta. O est\303\255mulo t\303\241til delicado (no m\303\241ximo 2 vezes) j\303\241 faz parte dos passos iniciais; persistindo apneia ou FC < 100 bpm, n\303\243o se deve atrasar a VPP.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        communityPct: 2.9,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    gabaritoOficial: \'A\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    totalRespostasComunidade: 5280,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    taxaAcertoGlobal: 71.9,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    comentarioGeral:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'A Reanima\303\247\303\243o Neonatal (SBP 2022) \303\251 o assunto mais cobrado em Pediatria nas provas de resid\303\252ncia do Brasil. O \"Minuto de Ouro\" determina que, se o RN n\303\243o respirar ou mantiver FC < 100 bpm ap\303\263s os passos iniciais, a VPP deve come\303\247ar at\303\251 os 60 segundos de vida: em \342\211\245 34 semanas come\303\247a-se em ar ambiente (21%); em < 34 semanas inicia-se com FiO\342\202\202 30%.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    perolaClinica:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'SBP 2022 \342\200\224 VPP inicial: RN \342\211\245 34 sem \342\206\222 FiO\342\202\202 21% | RN < 34 sem \342\206\222 FiO\342\202\202 30%. Ox\303\255metro SEMPRE pr\303\251-ductal (membro superior direito) + monitor card\303\255aco de 3 eletrodos.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    referencias: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Sociedade Brasileira de Pediatria (SBP) \342\200\224 Diretrizes de Reanima\303\247\303\243o do Rec\303\251m-Nascido \342\211\245 34 semanas em sala de parto (2022).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Tratado de Pediatria SBP, 5\302\252 ed.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    id: \'q-enare-2025-epi-07\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    code: \'Q-ENR25-0673\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    grandeAreaId: \'medicina_preventiva\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    grandeArea: \'Medicina Preventiva e Social\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    tema: \'Epidemiologia\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    subtema: \'Testes Diagn\303\263sticos e Valores Preditivos\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    banca: \'FGV\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    instituicao: \'ENARE\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    estado: \'BR\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    regiao: \'Nacional\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ano: 2025,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    tipoProva: \'Acesso Direto\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    anulada: false,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    desatualizada: false,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    enunciado:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Um novo teste r\303\241pido sorol\303\263gico para diagn\303\263stico de determinada infec\303\247\303\243o apresenta sensibilidade de 90% e especificidade de 90% em estudos de valida\303\247\303\243o hospitalar. A Secretaria Municipal de Sa\303\272de decide aplic\303\241-lo em dois cen\303\241rios distintos: Cen\303\241rio 1 \342\200\224 ambulat\303\263rio de refer\303\252ncia em infectologia, onde a preval\303\252ncia da doen\303\247a \303\251 de 50%; Cen\303\241rio 2 \342\200\224 campanha populacional de rastreamento em assintom\303\241ticos, onde a preval\303\252ncia \303\251 de 1%. Considerando as propriedades dos testes diagn\303\263sticos, assinale a alternativa CORRETA.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    alternativas: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        letter: \'A\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        text: \'A sensibilidade e a especificidade diminuem drasticamente no Cen\303\241rio 2 devido \303\240 queda na preval\303\252ncia da doen\303\247a.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        explanation:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Incorreta. Sensibilidade e especificidade s\303\243o propriedades intr\303\255nsecas do teste e n\303\243o variam diretamente com a preval\303\252ncia da doen\303\247a na popula\303\247\303\243o testada.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        communityPct: 18.4,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        letter: \'B\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        text: \'O Valor Preditivo Positivo (VPP) ser\303\241 substancialmente menor no Cen\303\241rio 2 (pr\303\263ximo a 8,3%), enquanto o Valor Preditivo Negativo (VPN) ser\303\241 muito elevado (> 99%).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        explanation:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Correta. Em 10.000 pessoas com preval\303\252ncia de 1% (100 doentes e 9.900 sadios): VP = 90% de 100 = 90; FP = 10% de 9.900 = 990. Logo, VPP = 90 / (90 + 990) = 90 / 1080 \342\211\210 8,3%! J\303\241 no Cen\303\241rio 1 (preval\303\252ncia 50%), o VPP \303\251 de 90%. Quanto menor a preval\303\252ncia, menor o VPP e maior o VPN.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        communityPct: 47.6,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        letter: \'C\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        text: \'A raz\303\243o de verossimilhan\303\247a positiva (LR+) muda de 9,0 no Cen\303\241rio 1 para 0,9 no Cen\303\241rio 2.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        explanation:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Incorreta (Principal distrator). A raz\303\243o de verossimilhan\303\247a positiva (LR+ = Sensibilidade / [1 - Especificidade] = 0,90 / 0,10 = 9,0) depende apenas de sensibilidade e especificidade, sendo independente da preval\303\252ncia.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        communityPct: 22.1,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        letter: \'D\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        text: \'O Valor Preditivo Positivo permanece em 90% em ambos os cen\303\241rios, pois depende exclusivamente da especificidade do teste.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        explanation:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Incorreta. O VPP depende fortemente da preval\303\252ncia (probabilidade pr\303\251-teste), al\303\251m de especificidade e sensibilidade.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        communityPct: 8.2,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        letter: \'E\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        text: \'Para aumentar a sensibilidade na campanha de rastreamento, deve-se aplicar dois testes em s\303\251rie (s\303\263 considerar positivo se ambos forem reagentes).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        explanation:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Incorreta. Testes em S\303\211RIE aumentam a especificidade (e reduzem falsos-positivos), mas diminuem a sensibilidade. Para aumentar a sensibilidade, usam-se testes em PARALELO.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        communityPct: 3.7,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    gabaritoOficial: \'B\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    totalRespostasComunidade: 4980,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    taxaAcertoGlobal: 47.6,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    comentarioGeral:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Quest\303\243o de n\303\255vel m\303\251dio-dif\303\255cil muito t\303\255pica da FGV/ENARE. Ela exige distinguir propriedades intr\303\255nsecas do teste (Sensibilidade, Especificidade e Raz\303\265es de Verossimilhan\303\247a \342\200\224 independentes da preval\303\252ncia) das propriedades p\303\263s-teste (VPP e VPN \342\200\224 diretamente influenciadas pela preval\303\252ncia). Mesmo um teste excelente (90%/90%) gera mais de 90% de falsos-positivos quando aplicado indiscriminadamente em popula\303\247\303\243o de baix\303\255ssima preval\303\252ncia.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    perolaClinica:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Preval\303\252ncia CAI \342\206\222 VPP CAI e VPN SOBE. Sensibilidade, Especificidade e Raz\303\243o de Verossimilhan\303\247a (LR+/LR-) N\303\203O mudam com a preval\303\252ncia!\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    referencias: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Fletcher RH, Fletcher SW \342\200\224 Epidemiologia Cl\303\255nica: Elementos Essenciais, 6\302\252 ed.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Medronho RA \342\200\224 Epidemiologia, 2\302\252 ed., Cap. 18.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    id: \'q-unifesp-2024-endocrino-08\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    code: \'Q-UNF24-0195\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    grandeAreaId: \'clinica_medica\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    grandeArea: \'Cl\303\255nica M\303\251dica\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    tema: \'Endocrinologia\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    subtema: \'Cetoacidose Diab\303\251tica (CAD)\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    banca: \'VUNESP\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    instituicao: \'UNIFESP\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    estado: \'SP\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    regiao: \'Sudeste\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ano: 2024,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    tipoProva: \'Acesso Direto\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    anulada: false,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    desatualizada: false,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    enunciado:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Adolescente de 19 anos com diabetes mellitus tipo 1 chega \303\240 emerg\303\252ncia com n\303\241useas, dor abdominal difusa, respira\303\247\303\243o de Kussmaul e desidrata\303\247\303\243o moderada ap\303\263s suspender insulina por 48 horas. PA 102/64 mmHg, FC 118 bpm. Ap\303\263s infus\303\243o inicial de 1.000 mL de soro fisiol\303\263gico 0,9% na primeira hora, chegam os exames laboratoriais abaixo. Qual \303\251 a conduta IMEDIATA mais segura em rela\303\247\303\243o \303\240 insulinoterapia e reposi\303\247\303\243o de pot\303\241ssio?\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    labTable: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { exame: \'Glicemia venosa\', resultado: \'468 mg/dL\', referencia: \'70\342\200\22399 mg/dL\', alterado: \'alto\' },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { exame: \'pH arterial\', resultado: \'7,14\', referencia: \'7,35\342\200\2237,45\', alterado: \'baixo\' },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { exame: \'Bicarbonato (HCO\342\202\203\342\201\273)\', resultado: \'8,2 mEq/L\', referencia: \'22\342\200\22326 mEq/L\', alterado: \'baixo\' },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { exame: \'Pot\303\241ssio (K\342\201\272)\', resultado: \'3,0 mEq/L\', referencia: \'3,5\342\200\2235,1 mEq/L\', alterado: \'baixo\' },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { exame: \'S\303\263dio (Na\342\201\272)\', resultado: \'132 mEq/L\', referencia: \'135\342\200\223145 mEq/L\', alterado: \'baixo\' },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { exame: \'Cetonemia (\316\262-hidroxibutirato)\', resultado: \'5,4 mmol/L\', referencia: \'< 0,6 mmol/L\', alterado: \'alto\' },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    alternativas: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        letter: \'A\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        text: \'Iniciar bomba de insulina regular 0,1 UI/kg/h imediatamente e repor pot\303\241ssio apenas se cair abaixo de 2,5 mEq/L.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        explanation:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Incorreta. Iniciar insulina com K\342\201\272 < 3,3 mEq/L induz hipocalemia grave por influxo celular de pot\303\241ssio, com alto risco de arritmias fatais e parada card\303\255aca.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        communityPct: 8.9,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        letter: \'B\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        text: \'Postergar o in\303\255cio da insulina, manter hidrata\303\247\303\243o venosa e repor pot\303\241ssio (20\342\200\22330 mEq/h) at\303\251 atingir K\342\201\272 \342\211\245 3,3\342\200\2233,5 mEq/L antes de iniciar a insulinoterapia.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        explanation:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Correta. Segundo o consenso da ADA/SBD para crises hiperglic\303\252micas, quando o pot\303\241ssio s\303\251rico inicial est\303\241 abaixo de 3,3 mEq/L (ou < 3,5 mEq/L nas diretrizes mais recentes da ADA 2024), a insulina DEVE ser adiada e o pot\303\241ssio reposto vigorosamente primeiro para evitar hipocalemia fatal.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        communityPct: 62.1,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        letter: \'C\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        text: \'Administrar bicarbonato de s\303\263dio 100 mEq IV imediato para corrigir o pH de 7,14 e iniciar insulina em bolus.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        explanation:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Incorreta (Principal distrator). O bicarbonato na CAD s\303\263 \303\251 considerado quando o pH est\303\241 < 6,9 (ou < 7,0 em alguns consensos), pois sua infus\303\243o agrava a hipocalemia e pode precipitar acidose paradoxal do SNC.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        communityPct: 21.6,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        letter: \'D\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        text: \'Iniciar insulina NPH subcut\303\242nea combinada com soro glicosado 5% desde o in\303\255cio para prevenir edema cerebral.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        explanation:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Incorreta. A insulina de escolha na CAD moderada/grave \303\251 a regular em infus\303\243o venosa cont\303\255nua (ap\303\263s corre\303\247\303\243o do K\342\201\272), e o soro glicosado s\303\263 \303\251 associado quando a glicemia cai abaixo de 200\342\200\223250 mg/dL.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        communityPct: 7.4,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    gabaritoOficial: \'B\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    totalRespostasComunidade: 4230,"
