        target_content: "  const filterQuestions = useCallback(\n    (filters: QuestionFilters): MedicalQuestion[] => {\n      const q = filters.search.trim().toLowerCase();\n      return MEDICAL_QUESTIONS.filter((item) => {\n        if (filters.excluirAnuladasDesatualizadas && (item.anulada || item.desatualizada)) {\n          return false;\n        }\n        if (filters.comImagens && !item.clinicalImage) {\n          return false;\n        }\n        if (filters.grandeAreaId && item.grandeAreaId !== filters.grandeAreaId) {"
        replacement_content: "  const filterQuestions = useCallback(\n    (filters: QuestionFilters): MedicalQuestion[] => {\n      const q = filters.search.trim().toLowerCase();\n      const examTokens = filters.examSearch\n        .trim()\n        .toLowerCase()\n        .normalize(\'NFD\')\n        .replace(/[\\u0300-\\u036f]/g, \'\')\n        .split(/[\\s/-]+/)\n        .filter(Boolean);\n\n      return MEDICAL_QUESTIONS.filter((item) => {\n        if (filters.excluirAnuladasDesatualizadas && (item.anulada || item.desatualizada)) {\n          return false;\n        }\n        if (filters.comImagens && !item.clinicalImage) {\n          return false;\n        }\n        if (examTokens.length > 0) {\n          const examHaystack = [\n            item.instituicao,\n            item.instituicao.replace(/-/g, \' \'),\n            String(item.ano),\n            item.banca,\n            item.tipoProva,\n            item.estado,\n            item.code,\n          ]\n            .join(\' \')\n            .toLowerCase()\n            .normalize(\'NFD\')\n            .replace(/[\\u0300-\\u036f]/g, \'\');\n\n          const matchesAllTokens = examTokens.every((token) =>\n            examHaystack.includes(token)\n          );\n          if (!matchesAllTokens) return false;\n        }\n        if (filters.grandeAreaId && item.grandeAreaId !== filters.grandeAreaId) {"
        start_line: 382
        end_line: 422
      }
      use_global_match: true
