              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    gabaritoOficial: \'C\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    totalRespostasComunidade: 2140,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    taxaAcertoGlobal: 37.8,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    comentarioGeral:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Aten\303\247\303\243o: quest\303\243o mantida no banco com a marca\303\247\303\243o de DESATUALIZADA. Atualmente, os quatro pilares fundamentais da ICFER (independentemente de diabetes) s\303\243o: INRA (ou IECA), Betabloqueador, Antagonista Mineralocorticoide e iSGLT2.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    perolaClinica:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Diretriz Atual de ICFER: Terapia Qu\303\241drupla precoce \342\200\224 INRA/IECA + Betabloqueador + Espironolactona + iSGLT2 (dapagliflozina ou empagliflozina), mesmo SEM diabetes!\',"
