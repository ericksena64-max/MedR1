            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "/**"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " * Estimates how many calendar days are required to reach `targetRetentionPct` (default 95%)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " * across high-incidence topics for the selected exam board, combining:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " * - Current FSRS stability/retrievability of high-incidence flashcards"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " * - Individual accuracy rate across high-incidence topics (questions + today\'s SRS pass rate)"
