              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  // so FSRS recall stability still advances meaningfully."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const effectiveElapsed = Math.max(elapsed, 0.25);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const retrievability = computeRetrievability(effectiveElapsed, s);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
