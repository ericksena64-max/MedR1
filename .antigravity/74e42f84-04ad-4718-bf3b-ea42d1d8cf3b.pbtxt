      name: "multi_replace_file_content"
      arguments_json: "{\"Description\":\"Sync LiveRankingPage green pulsing dot with the global ON/OFF toggle\", \"Instruction\":\"Accept rankingPulseOn and onToggleRankingPulse props in LiveRankingPage and control the green dot blink and optional ON/OFF button in the leaderboard header.\", \"ReplacementChunks\":[{\"AllowMultiple\":false, \"EndLine\":33, \"ReplacementContent\":\"interface LiveRankingPageProps {\\n  allEntries: RankedEntry[];\\n  currentUser: RankedEntry;\\n  onlineTotal: number;\\n  profile: UserProfile;\\n  onUpdateProfile: (patch: Partial<UserProfile>) => void;\\n  onGeneratePseudonym: () => void;\\n  rankingPulseOn?: boolean;\\n  onToggleRankingPulse?: (next?: boolean) => void;\\n}\\n\\nexport function LiveRankingPage({\\n  allEntries,\\n  currentUser,\\n  onlineTotal,\\n  profile,\\n  onUpdateProfile,\\n  onGeneratePseudonym,\\n  rankingPulseOn = true,\\n  onToggleRankingPulse,\\n}: LiveRankingPageProps) {\", \"StartLine\":16, \"TargetContent\":\"interface LiveRankingPageProps {\\n  allEntries: RankedEntry[];\\n  currentUser: RankedEntry;\\n  onlineTotal: number;\\n  profile: UserProfile;\\n  onUpdateProfile: (patch: Partial<UserProfile>) => void;\\n  onGeneratePseudonym: () => void;\\n}\\n\\nexport function LiveRankingPage({\\n  allEntries,\\n  currentUser,\\n  onlineTotal,\\n  profile,\\n  onUpdateProfile,\\n  onGeneratePseudonym,\\n}: LiveRankingPageProps) {\"}, {\"AllowMultiple\":false, \"EndLine\":98, \"ReplacementContent\":\"          <div>\\n            <div className=\\\"flex items-center gap-2.5\\\">\\n              <span className=\\\"relative flex h-2.5 w-2.5\\\" aria-hidden=\\\"true\\\">\\n                {rankingPulseOn && (\\n                  <span className=\\\"absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75\\\" />\\n                )}\\n                <span\\n                  className={cn(\\n                    \'relative inline-flex h-2.5 w-2.5 rounded-full transition-colors\',\\n                    rankingPulseOn\\n                      ? \'bg-emerald-500\'\\n                      : \'bg-slate-400 dark:bg-slate-600\'\\n                  )}\\n                />\\n              </span>\\n              <h2 className=\\\"font-display text-base font-bold text-slate-900 dark:text-white\\\">\\n                Ranking Ao Vivo \342\200\224 Online Agora\\n              </h2>\\n            </div>\\n            <p className=\\\"mt-1 text-xs text-slate-500 dark:text-slate-400\\\">\\n              Pontua\303\247\303\243o ponderada combinando volume di\303\241rio, taxa de acertos e sequ\303\252ncia (anti-chute)\\n            </p>\\n          </div>\\n\\n          <div className=\\\"flex flex-wrap items-center gap-3\\\">\\n            <div className=\\\"flex items-center gap-2 text-xs font-medium text-slate-600 dark:text-slate-300 tabular-nums\\\">\\n              <Users className=\\\"h-4 w-4 text-emerald-600 dark:text-emerald-400\\\" />\\n              <span>{onlineTotal} estudantes ativos na sess\303\243o</span>\\n            </div>\\n\\n            {onToggleRankingPulse && (\\n              <div\\n                role=\\\"group\\\"\\n                aria-label=\\\"Indicador piscante do Ranking Ao Vivo\\\"\\n                className=\\\"inline-flex rounded-md bg-slate-100 p-0.5 dark:bg-slate-800\\\"\\n              >\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => onToggleRankingPulse(true)}\\n                  aria-pressed={rankingPulseOn}\\n                  className={cn(\\n                    \'rounded px-2 py-0.5 font-mono text-[10px] font-bold transition-colors cursor-pointer\',\\n                    rankingPulseOn\\n                      ? \'bg-emerald-600 text-white dark:bg-emerald-500 dark:text-slate-950\'\\n                      : \'text-slate-500 hover:text-slate-900 dark:text-slate-400\'\\n                  )}\\n                >\\n                  ON\\n                </button>\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => onToggleRankingPulse(false)}\\n                  aria-pressed={!rankingPulseOn}\\n                  className={cn(\\n                    \'rounded px-2 py-0.5 font-mono text-[10px] font-bold transition-colors cursor-pointer\',\\n                    !rankingPulseOn\\n                      ? \'bg-white text-slate-900 shadow-xs dark:bg-slate-700 dark:text-white\'\\n                      : \'text-slate-500 hover:text-slate-900 dark:text-slate-400\'\\n                  )}\\n                >\\n                  OFF\\n                </button>\\n              </div>\\n            )}\\n          </div>\\n        </div>\", \"StartLine\":77, \"TargetContent\":\"          <div>\\n            <div className=\\\"flex items-center gap-2.5\\\">\\n              <span className=\\\"relative flex h-2.5 w-2.5\\\" aria-hidden=\\\"true\\\">\\n                <span className=\\\"absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75\\\" />\\n                <span className=\\\"relative inline-flex h-2.5 w-2.5 rounded-full bg-emerald-500\\\" />\\n              </span>\\n              <h2 className=\\\"font-display text-base font-bold text-slate-900 dark:text-white\\\">\\n                Ranking Ao Vivo \342\200\224 Online Agora\\n              </h2>\\n            </div>\\n            <p className=\\\"mt-1 text-xs text-slate-500 dark:text-slate-400\\\">\\n              Pontua\303\247\303\243o ponderada combinando volume di\303\241rio, taxa de acertos e sequ\303\252ncia (anti-chute)\\n            </p>\\n          </div>\\n\\n          <div className=\\\"flex items-center gap-2 text-xs font-medium text-slate-600 dark:text-slate-300 tabular-nums\\\">\\n            <Users className=\\\"h-4 w-4 text-emerald-600 dark:text-emerald-400\\\" />\\n            <span>{onlineTotal} estudantes ativos na sess\303\243o</span>\\n          </div>\\n        </div>\"}], \"TargetFile\":\"/src/components/ranking/LiveRankingPage.tsx\", \"toolAction\":\"Syncing green live indicator in LiveRankingPage\", \"toolSummary\":\"Sync ON/OFF live dot in LiveRankingPage\"}"
