            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  // CASE 2: Learning or Relearning card (short-term consolidation)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  if (card.state === \'Learning\' || card.state === \'Relearning\') {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const baseS = Math.max(card.stability, initStability(1));"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const baseD = card.difficulty || initDifficulty(3);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const r = computeRetrievability(Math.max(elapsed, 0.01), baseS);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const sAgain = clampStability(Math.min(baseS, initStability(1)));"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const sHard = clampStability(Math.max(baseS * 1.15, initStability(2) * 0.85));"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const sGood = nextRecallStability(baseD, Math.max(baseS, 1.0), r, 3);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const sEasy = nextRecallStability(baseD, Math.max(baseS, 1.0), r, 4);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const rawHardDays = computeRawIntervalDays(sHard, targetRetention);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const hardIsSubDay = rawHardDays < 0.75;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const hardDays = hardIsSubDay ? 0 : Math.max(1, Math.round(rawHardDays));"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const goodDays = Math.max(hardDays + 1, Math.round(computeRawIntervalDays(sGood, targetRetention)));"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const easyDays = Math.max(goodDays + 1, Math.round(computeRawIntervalDays(sEasy, targetRetention)));"
