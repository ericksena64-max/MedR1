        replacement_chunks {
          target_content: "              {/* Card Body: Front always visible, Back revealed on flip */}\n              <div className=\"px-5 py-8 sm:px-8 sm:py-10 space-y-6\">\n                <div className=\"space-y-2.5\">\n                  <p className=\"text-xs font-semibold text-slate-400 dark:text-slate-500\">\n                    Frente \342\200\224 Recorda\303\247\303\243o Ativa\n                  </p>\n                  <p className=\"max-w-[72ch] text-base sm:text-lg font-medium leading-[1.68] text-slate-900 dark:text-slate-100\">\n                    {activeCard.front}\n                  </p>\n                </div>\n\n                {!flipped ? (\n                  <div className=\"pt-6 border-t border-slate-100 dark:border-slate-800 flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n                    <div className=\"flex flex-wrap items-center gap-x-3 gap-y-1.5\">\n                      <p className=\"text-xs text-slate-500 dark:text-slate-400\">\n                        Tente formular a conduta mentalmente antes de revelar o verso.\n                      </p>\n\n                      {/* Pre-flip FSRS next-review forecast tooltip trigger */}\n                      {fsrsOutcomes && (\n                        <div className=\"relative group inline-flex\">\n                          <button\n                            type=\"button\"\n                            className=\"inline-flex items-center gap-1 text-xs font-medium text-sky-700 hover:text-sky-900 dark:text-sky-400 dark:hover:text-sky-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-500 rounded cursor-help\"\n                            aria-describedby=\"pre-flip-fsrs-tooltip\"\n                          >\n                            <CalendarClock className=\"h-3.5 w-3.5\" />\n                            <span>Previs\303\243o FSRS</span>\n                          </button>\n\n                          <div\n                            id=\"pre-flip-fsrs-tooltip\"\n                            role=\"tooltip\"\n                            className=\"pointer-events-none invisible opacity-0 translate-y-1 group-hover:visible group-hover:opacity-100 group-hover:translate-y-0 group-focus-within:visible group-focus-within:opacity-100 group-focus-within:translate-y-0 transition-all duration-150 absolute bottom-full left-0 z-30 mb-2 w-64 rounded-lg border border-slate-700/80 bg-slate-900 p-3 text-left text-xs text-slate-100 shadow-lg dark:border-slate-700 dark:bg-slate-800\"\n                          >\n                            <div className=\"flex items-center justify-between border-b border-slate-700/80 pb-1.5 mb-2\">\n                              <span className=\"font-semibold text-white\">\n                                Pr\303\263xima revis\303\243o estimada\n                              </span>\n                              <span className=\"font-mono text-[10px] text-slate-400 tabular-nums\">\n                                Alvo {Math.round(targetRetention * 100)}%\n                              </span>\n                            </div>"
          replacement_content: "              {/* Dynamic FSRS Calibration Seal & Justification Strip */}\n              {activeCalibration && (\n                <div\n                  className={cn(\n                    \'flex flex-wrap items-center justify-between gap-2 border-b px-5 py-2.5 sm:px-7 text-xs\',\n                    activeCalibration.mode === \'dinamica\' &&\n                      activeCalibration.individualStatus === \'ponto_atencao\'\n                      ? \'border-amber-200/80 bg-amber-50/50 dark:border-amber-900/50 dark:bg-amber-950/20\'\n                      : activeCalibration.mode === \'dinamica\' &&\n                        activeCalibration.boardTier === \'alta\'\n                      ? \'border-sky-200/70 bg-sky-50/40 dark:border-sky-900/50 dark:bg-sky-950/20\'\n                      : \'border-slate-200/80 bg-slate-50/60 dark:border-slate-800 dark:bg-slate-950/40\'\n                  )}\n                >\n                  <div className=\"flex flex-wrap items-center gap-2 min-w-0\">\n                    <SlidersHorizontal\n                      className={cn(\n                        \'h-3.5 w-3.5 shrink-0\',\n                        activeCalibration.mode === \'dinamica\' &&\n                          activeCalibration.individualStatus === \'ponto_atencao\'\n                          ? \'text-amber-600 dark:text-amber-400\'\n                          : activeCalibration.mode === \'dinamica\'\n                          ? \'text-sky-600 dark:text-sky-400\'\n                          : \'text-slate-500 dark:text-slate-400\'\n                      )}\n                    />\n                    <span\n                      className={cn(\n                        \'font-semibold tabular-nums\',\n                        activeCalibration.mode === \'dinamica\' &&\n                          activeCalibration.individualStatus === \'ponto_atencao\'\n                          ? \'text-amber-900 dark:text-amber-200\'\n                          : activeCalibration.mode === \'dinamica\'\n                          ? \'text-slate-900 dark:text-slate-100\'\n                          : \'text-slate-700 dark:text-slate-300\'\n                      )}\n                    >\n                      {activeCalibration.summaryLabel}\n                    </span>\n                  </div>\n\n                  {activeCalibration.mode === \'dinamica\' ? (\n                    <span className=\"font-mono text-[11px] tabular-nums text-slate-500 dark:text-slate-400\">\n                      Base 89% \302\267 Banca {formatDeltaPct(activeCalibration.deltaBanca)} \302\267\n                      Desempenho {formatDeltaPct(activeCalibration.deltaIndividual)}\n                      {activeCalibration.userAccuracyPct !== null &&\n                        activeCalibration.communityMedianPct !== null && (\n                          <>\n                            {\' \'}\n                            ({activeCalibration.userAccuracyPct.toFixed(0)}% vs{\' \'}\n                            {activeCalibration.communityMedianPct.toFixed(0)}%)\n                          </>\n                        )}\n                    </span>\n                  ) : (\n                    <button\n                      type=\"button\"\n                      onClick={() => onChangeRetentionMode(\'dinamica\')}\n                      className=\"text-[11px] font-semibold text-sky-700 hover:text-sky-900 dark:text-sky-400 dark:hover:text-sky-200 cursor-pointer whitespace-nowrap\"\n                    >\n                      Ativar Calibra\303\247\303\243o Din\303\242mica\n                    </button>\n                  )}\n                </div>\n              )}\n\n              {/* Card Body: Front always visible, Back revealed on flip */}\n              <div className=\"px-5 py-8 sm:px-8 sm:py-10 space-y-6\">\n                <div className=\"space-y-2.5\">\n                  <p className=\"text-xs font-semibold text-slate-400 dark:text-slate-500\">\n                    Frente \342\200\224 Recorda\303\247\303\243o Ativa\n                  </p>\n                  <p className=\"max-w-[72ch] text-base sm:text-lg font-medium leading-[1.68] text-slate-900 dark:text-slate-100\">\n                    {activeCard.front}\n                  </p>\n                </div>\n\n                {!flipped ? (\n                  <div className=\"pt-6 border-t border-slate-100 dark:border-slate-800 flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n                    <div className=\"flex flex-wrap items-center gap-x-3 gap-y-1.5\">\n                      <p className=\"text-xs text-slate-500 dark:text-slate-400\">\n                        Tente formular a conduta mentalmente antes de revelar o verso.\n                      </p>\n\n                      {/* Pre-flip FSRS next-review forecast tooltip trigger */}\n                      {fsrsOutcomes && activeCalibration && (\n                        <div className=\"relative group inline-flex\">\n                          <button\n                            type=\"button\"\n                            className=\"inline-flex items-center gap-1 text-xs font-medium text-sky-700 hover:text-sky-900 dark:text-sky-400 dark:hover:text-sky-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-500 rounded cursor-help\"\n                            aria-describedby=\"pre-flip-fsrs-tooltip\"\n                          >\n                            <CalendarClock className=\"h-3.5 w-3.5\" />\n                            <span>Previs\303\243o FSRS</span>\n                          </button>\n\n                          <div\n                            id=\"pre-flip-fsrs-tooltip\"\n                            role=\"tooltip\"\n                            className=\"pointer-events-none invisible opacity-0 translate-y-1 group-hover:visible group-hover:opacity-100 group-hover:translate-y-0 group-focus-within:visible group-focus-within:opacity-100 group-focus-within:translate-y-0 transition-all duration-150 absolute bottom-full left-0 z-30 mb-2 w-72 rounded-lg border border-slate-700/80 bg-slate-900 p-3 text-left text-xs text-slate-100 shadow-lg dark:border-slate-700 dark:bg-slate-800\"\n                          >\n                            <div className=\"border-b border-slate-700/80 pb-2 mb-2 space-y-0.5\">\n                              <div className=\"flex items-center justify-between gap-2\">\n                                <span className=\"font-semibold text-white\">\n                                  Pr\303\263xima revis\303\243o estimada\n                                </span>\n                                <span className=\"font-mono text-[10px] text-sky-300 tabular-nums\">\n                                  Alvo {activeCalibration.retentionPct}%\n                                </span>\n                              </div>\n                              <p className=\"text-[11px] text-slate-300 leading-snug\">\n                                {activeCalibration.summaryLabel}\n                              </p>\n                            </div>"
