            }
            lines {
              text: "    backPearl:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'TOTG-75g (24\342\200\22328 sem): basta 1 valor \342\211\245 92 (jejum) | \342\211\245 180 (1h) | \342\211\245 153 (2h) = DMG! Alvos no tratamento: jejum < 95, 1h p\303\263s-prandial < 140, 2h p\303\263s-prandial < 120 mg/dL.\',"
