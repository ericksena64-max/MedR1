steps {
  type: CORTEX_STEP_TYPE_VIEW_FILE
  status: CORTEX_STEP_STATUS_DONE
  metadata {
    created_at {
      seconds: 1795305279
      nanos: 999522474
    }
    source: CORTEX_STEP_SOURCE_MODEL
    tool_call {
      id: "call_12737248521915341826"
      name: "view_file"
      thinking_signature: "\022\234\003\n\231\003\001i\024}\023_\032A\276\317>\205\205\361\'T\350\036\204\005\357\322\203.\377S>\252\327J\nm\001y#4\306\350&3\202N>\305\344\333 H(\366\374v\245(n\004DyZ+::\020:Xf\275\351\334\265B\350\036X\003\374UQ\337nn\376a\254Fi8\327\fA%\356\353}\2759HcM[\376\343\274/\276\215\275\247\314\27010\337 \360{c7\r\255\357I\2364!\006\366P\035\2534\022\342(iN\264\026 \027\212\266\313\227\364\327\325\275\0202\177@\224Q\357\370/\2210Q\323\233\233\361\217\211\345\335\f\342\224sS(\333\343\206\302N3*r w\276d\316Mee\027\223B\'\335\336\003\366`\2418\025\3715\271N\030\277PZL\342\336\351\363\031\230\3206\265E\026\276:HB\b@\243P\243-\347\235\2156\367\251\312\330s\232t\317;\360\25508\241\355\206\"\364P\2558x\257K\032\334+xp\360\341\367\026^0\322\306\"\237Gh\2065\020\355\016\355\306\227(Y\315N\261\353\345\264\035s\001=\346\205\031^Z\265L\027O\326\003\357\314\352\3528\r\301\333\f\r\371\314sE\265\354\306id\004\035\312{\3216\323\337\211x|ah\342\344\034z)]\301XS\262F:{\020\340>\337-t~u\005\337\361Il\t,\201\n\252-\305-\3110\341\375C\240\255y=y\200\\?T\240gO\342\365ak\254\211\273 \325\2565\272\204\034@\f\274\312"
