              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Escore de Alvarado (MANTRELS \342\200\224 10 pontos): apenas Dor em FID (2 pts) e Leucocitose (2 pts) valem 2 pontos; todos os outros 6 itens valem 1 ponto cada.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
