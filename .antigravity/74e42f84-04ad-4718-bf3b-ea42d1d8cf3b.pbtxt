    content: "import React, { useMemo, useState, useEffect } from \'react\';\nimport {\n  Bookmark,\n  CheckCircle2,\n  XCircle,\n  AlertTriangle,\n  Strikethrough,\n  Flag,\n  ChevronLeft,\n  ChevronRight,\n  BookOpen,\n  Sparkles,\n  FileText,\n  Users,\n  ArrowUp,\n  ArrowDown,\n  Layers,\n  Check,\n} from \'lucide-react\';\nimport type {\n  AlternativeLetter,\n  MedicalQuestion,\n  StudyMode,\n  UserAnswerRecord,\n} from \'../../types/medical\';\nimport { computeDifficulty, cn } from \'../../lib/utils\';\nimport { ClinicalImageViewer } from \'./ClinicalImageViewer\';\nimport {\n  StudentVsMedianBar,\n  type BenchmarkSlice,\n} from \'./StudentVsMedianBar\';\nimport { Button } from \'../ui/Button\';\n\ninterface QuestionCardProps {\n  question: MedicalQuestion;\n  index: number;\n  total: number;\n  mode: StudyMode;\n  existingAnswer?: UserAnswerRecord;\n  simuladoDraft?: AlternativeLetter;\n  simuladoFinished: boolean;\n  isBookmarked: boolean;\n  isFlagged: boolean;\n  onToggleBookmark: () => void;\n  onToggleFlag: () => void;\n  onSubmitStudyAnswer: (letter: AlternativeLetter) => void;\n  onSelectSimuladoDraft: (letter: AlternativeLetter) => void;\n  onPrev: () => void;\n  onNext: () => void;\n  benchmarks?: {\n    topic: BenchmarkSlice;\n    area: BenchmarkSlice;\n    overall: BenchmarkSlice;\n  };\n  hasFlashcard?: boolean;\n  onCreateFlashcard?: () => void;\n  onOpenFlashcards?: () => void;\n}\n\ntype CommentaryTab = \'alternativas\' | \'perola\' | \'referencias\';\n\nexport function QuestionCard({\n  question,\n  index,\n  total,\n  mode,\n  existingAnswer,\n  simuladoDraft,\n  simuladoFinished,\n  isBookmarked,\n  isFlagged,\n  onToggleBookmark,\n  onToggleFlag,\n  onSubmitStudyAnswer,\n  onSelectSimuladoDraft,"
    num_lines: 768
