      thinking_signature: "\022\271\025\n\266\025\001i\024}\023Te/v\321\"\236Zw=\245\374\225;\"\223 EP\247\257tK\377\337\252\031\343\037&\030\363!\211\335\202\22322I9\347<\352\343\212\332\216\362!\303\323\275e=\\k\'\224\370J\377\264\250yf\203\357\001m\304u\232\2103\242\230H:\031:8\346\243\r\211\300\177\303\201:\026\352n\350\026\347T_\347\214p\272GR\342\f\306|kN\031\313\201\257\357\336\0246e\2029\221x\026He\224\335L\332w}\2312\264\305\300\302l\366\336\020\331\'\a\334\022\274\261\317\215Up\310\006\a\253\317y\005\'\027<`$\231\205\261\356\264\r\025\355\024\bo\025*H\023S\000{N^\027iK\364\322\tV\037\266\274\232d\261\362Q\217\303sQ{\325\337\224!\002G\230=A\272!K\034\253\254MT\236\342E\364\022^X\310\305\274\240=\034\331\t\337Y?\240\t\034\215\2426\266\316\f\345\'\210\250\333\245\354\206\337.p\021/\305\352\031`\221\001\276\346\210\261\023\372\302\2003\313\242\226)\354 :\364\233rUb\206\227\343\322\252\327\240\031\336\247\205\313\343\330x\256g\327\242\270$\207\002e\322\030\364\273\026\244\253n\325Bt\227#\321\005\033\325\001>\r\027\231Z\355K`\305\302&\270\375\200\267x\231\262\026\240C\354O\220\244\257[P\350\240t\333\005\237C\257H\362*O\226\030{\2479\273\253\367\214e\312\227\027\021\006)8\000\336\255\273\366\305z\273\325\370\263\031\274\thO\300\231\366\366\331\214\316\365\276t\000,k\245K\032\213\352Z\260\257\231\025b4\303|\325\206\327\322GP\2505\365,cC\r]iS\270\370\216\315\256\354yH\340\301\350\242\200\033\200\244\222\r\241\023M\377\202\313k\322\021\350\321\345:\265\261\215-d\v\307Q\247\321\"}U\231:\351\022\274\260\332\206\246\330e\32648\2165\263\033\037;6\213\vQ2\234\372s\3704D\260\035\200\2651\034\275\3134\251\017\217\302\003$r\254\342\023\313\207\366\224\204\bgc-6S\327\n@3;\330\324\362\375_\340\310wsY\025\200\366\312ZY\266l\274\272\026tR\344\342\022\244\314\241\261\245\341\t\016S\235\026\220;\"\254\320nZT\276\244\3326[\324S\344\207\353\355E\330\213m\275A\301\343\363=YU\n\364v\210\301\310AS3\347\202\300\361s\241)fJ\263\377\355[V\020\377\340k8d\222\331\235m\215.\023\276\372,\315\024G\340/\204\215\024r\226\017=\207\234r\235X\v\313\253T#xp\002\v\243R\235\"\017\2577\354\255\242\3328`4\354\360\306j\3563_\374k\257\363y \211\331\343\216k\202\373\316Ze\313\034\005j\270\207\355\337\237V:\"\274\3230\336\aF\236\020w\217:^\344\"\017\264\3463Y\036\330\303 \350\365\311Dx\343\026\304\203\222\235\356\367\233\223\265.\271\273\f\336!\3655\276/\264v\213\023\362\'T\032P\0210\305P\360\017\021\033\347\210d\216\'\270\'U.\033\3242\3374\371\177\v\371\323\036\003\323?PM\375\'\203\210\033n\204Y\310j\304\347\277\267\033\210u\3057\370\301\363\375\335\337\003\231\336\034 \252qy\v\001\221{pPR\303\223\257X\207h\353a\314\267S#e\367\211\203:\000\374^\2072C\325\213j\265\a\213I\252\331\302\302\200\n\207\315\373\350\362.\226\343J\017\375\345\310\331+\201MR\357\251\037\313\371#7e\2338\343Z\250s\201d*\026\241O\b\ti\255Q\234TK\321\261\001X\321\2159[9-x\035\032\222k_\307\337\245\337\363E\r;5\323\267x\351\"pL\203\242\345\370\000&\225l\307=v\212r\206\273\377\016o\034\365\360\024\3662\376\252\2458\r\022;J\366xw=\376\341\3558\366R\033\346r\032\324\272P\311\202\203\233\361#`\035\300\305\264\032V\2135\267\227\fX7\r\032B.\223TQ\020\343\234\363\250(4\224\301\252\322\"\206\370zj\037\367\346}\016\303\203\267YS\300\362\253\325\256#(\236\340\023\241\344\273\004]\367\177,J\342\216D\233<\377\311\221W\230\315C\371{{\036n\024p!\361j0\306\353\'K\244\374A\r9\251\277\305Eh~\261\\\226\221\2738\v2-\"\222a\344\373W\247\301\216\263\346l\030f\342\350\231C\027\240A\320A\363\236\021\264\337]\336\a\270@)\a\0314\027\255\221\366\340\272Ev\322\205\264\274\354\22333+\2210\254\202q]u\a\371\'\242n\037\263*r\230\335\035N\"\204\273(\375p+\206[\222\312wh\036\304\272\315\346] \350C\022\347{z\027\030\217;\230*:\222\005\025\267{\224{\313\363\307_\314m\231\032i\3749\354\aU/\277M#Q\254\177\341s\033\327(\017\f\006\377g\311\031\027\304\226H\026/\262\027/\r\232\366x\255O\025\210\214\206\373\245Ul\234\376I\307\022\024\363\256{\316n\362\033E\320\017\335\335\034.uF4P\372\366?r\230\030\000\240\200/\350\276\024\265n(:\300\004\