            }
            lines {
              text: "  } else {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const defaultRule = BOARD_INCIDENCE_MATRIX[board].find("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      (r) => r.topic === topicIdOrName"
