  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState } from \'react\';\nimport { ZoomIn, ZoomOut, X, Contrast, RotateCcw, ImageOff } from \'lucide-react\';\nimport type { ClinicalImage } from \'../../types/medical\';\nimport { cn } from \'../../lib/utils\';\n\ninterface ClinicalImageViewerProps {\n  image: ClinicalImage;\n}\n\nexport function ClinicalImageViewer({ image }: ClinicalImageViewerProps) {\n  const [lightboxOpen, setLightboxOpen] = useState(false);\n  const [zoom, setZoom] = useState<number>(1);\n  const [highContrast, setHighContrast] = useState(false);\n  const [loadError, setLoadError] = useState(false);\n\n  const handleOpen = () => {\n    setZoom(1);\n    setHighContrast(false);\n    setLightboxOpen(true);\n  };\n\n  if (loadError) {\n    return (\n      <div className=\"my-5 rounded-xl border border-slate-200 bg-slate-50 p-6 text-center dark:border-slate-800 dark:bg-slate-900\">\n        <ImageOff className=\"mx-auto mb-2 h-6 w-6 text-slate-400\" />\n        <p className=\"text-sm font-medium text-slate-700 dark:text-slate-300\">\n          {image.modality}\n        </p>\n        <p className=\"mt-1 text-xs text-slate-500 dark:text-slate-400\">\n          {image.caption}\n        </p>\n      </div>\n    );\n  }\n\n  return (\n    <>\n      <figure className=\"my-5 overflow-hidden rounded-xl border border-slate-200 bg-slate-950 dark:border-slate-800\">\n        <div className=\"flex items-center justify-between border-b border-slate-800 bg-slate-900 px-3.5 py-2 text-xs text-slate-300\">\n          <span className=\"font-medium\">{image.modality}</span>\n          <button\n            type=\"button\"\n            onClick={handleOpen}\n            className=\"inline-flex items-center gap-1.5 rounded-md px-2 py-1 text-xs font-medium text-sky-300 transition-colors hover:bg-slate-800 hover:text-sky-200 cursor-pointer\"\n          >\n            <ZoomIn className=\"h-3.5 w-3.5\" />\n            <span>Ampliar exame</span>\n          </button>\n        </div>\n\n        <button\n          type=\"button\"\n          onClick={handleOpen}\n          className=\"group relative block w-full overflow-hidden bg-slate-950 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-500 cursor-zoom-in\"\n          aria-label={`Ampliar ${image.modality}`}\n        >\n          <img\n            src={image.url}\n            alt={image.caption}\n            referrerPolicy=\"no-referrer\"\n            onError={() => setLoadError(true)}\n            className={cn(\n              \'mx-auto w-full object-contain transition-transform duration-200 group-hover:scale-[1.01]\',\n              image.aspectRatio === \'1:1\' ? \'max-h-[360px]\' : \'max-h-[380px]\'\n            )}\n          />\n        </button>\n\n        <figcaption className=\"border-t border-slate-200 bg-slate-50 px-3.5 py-2.5 text-xs leading-relaxed text-slate-600 dark:border-slate-800 dark:bg-slate-900/90 dark:text-slate-400\">\n          {image.caption}\n        </figcaption>\n      </figure>\n\n      {/* Fullscreen PACS-style Zoom Lightbox */}\n      {lightboxOpen && (\n        <div\n          className=\"fixed inset-0 z-50 flex flex-col bg-slate-950/95 text-slate-100\"\n          role=\"dialog\"\n          aria-modal=\"true\"\n          aria-label={`Visualizador ampliado: ${image.modality}`}\n        >\n          <div className=\"flex items-center justify-between gap-4 border-b border-slate-800 px-4 sm:px-6 py-3\">\n            <div className=\"min-w-0\">\n              <p className=\"text-sm font-semibold text-white truncate\">{image.modality}</p>\n              <p className=\"text-xs text-slate-400 truncate\">{image.caption}</p>\n            </div>\n\n            <div className=\"flex items-center gap-2 shrink-0\">\n              <button\n                type=\"button\"\n                onClick={() => setZoom((z) => Math.max(1, Number((z - 0.5).toFixed(2))))}\n                disabled={zoom <= 1}\n                aria-label=\"Reduzir zoom\"\n                className=\"rounded-lg border border-slate-700 p-2 text-slate-200 hover:bg-slate-800 disabled:opacity-40 cursor-pointer\"\n              >\n                <ZoomOut className=\"h-4 w-4\" />\n              </button>\n              <span className=\"min-w-[48px] text-center font-mono text-xs tabular-nums text-slate-200\">\n                {Math.round(zoom * 100)}%\n              </span>\n              <button\n                type=\"button\"\n                onClick={() => setZoom((z) => Math.min(3, Number((z + 0.5).toFixed(2))))}\n                disabled={zoom >= 3}\n                aria-label=\"Aumentar zoom\"\n                className=\"rounded-lg border border-slate-700 p-2 text-slate-200 hover:bg-slate-800 disabled:opacity-40 cursor-pointer\"\n              >\n                <ZoomIn className=\"h-4 w-4\" />\n              </button>\n              <button\n                type=\"button\"\n                onClick={() => setHighContrast((c) => !c)}\n                title=\"Ajustar contraste radiol\303\263gico\"\n                className={cn(\n                  \'inline-flex items-center gap-1.5 rounded-lg border px-2.5 py-2 text-xs font-medium cursor-pointer\',\n                  highContrast\n                    ? \'border-sky-500 bg-sky-500/20 text-sky-300\'\n                    : \'border-slate-700 text-slate-200 hover:bg-slate-800\'\n                )}\n              >\n                <Contrast className=\"h-4 w-4\" />\n                <span className=\"hidden sm:inline\">Contraste</span>\n              </button>\n              <button\n                type=\"button\"\n                onClick={() => {\n                  setZoom(1);\n                  setHighContrast(false);\n                }}\n                aria-label=\"Resetar visualiza\303\247\303\243o\"\n                className=\"rounded-lg border border-slate-700 p-2 text-slate-200 hover:bg-slate-800 cursor-pointer\"\n              >\n                <RotateCcw className=\"h-4 w-4\" />\n              </button>\n              <button\n                type=\"button\"\n                onClick={() => setLightboxOpen(false)}\n                aria-label=\"Fechar visualizador\"\n                className=\"rounded-lg bg-slate-800 p-2 text-white hover:bg-slate-700 cursor-pointer\"\n              >\n                <X className=\"h-4 w-4\" />\n              </button>\n            </div>\n          </div>\n\n          <div className=\"flex-1 overflow-auto p-6 flex items-center justify-center\">\n            <img\n              src={image.url}\n              alt={image.caption}\n              referrerPolicy=\"no-referrer\"\n              style={{\n                transform: `scale(${zoom})`,\n                filter: highContrast ? \'contrast(1.35) brightness(1.05)\' : undefined,\n              }}\n              className=\"max-h-[82vh] max-w-full rounded-lg object-contain transition-transform duration-150 origin-center\"\n            />\n          </div>\n        </div>\n      )}\n    </>\n  );\n}\n"
        path {
          absolute_uri: "file:///src/components/questions/ClinicalImageViewer.tsx"
        }
        overwrite: true
      }
    }
