            lines {
              text: "    front:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Politraumatizado adulto com choque obstrutivo, turg\303\252ncia jugular, hipertimpanismo e MV abolido \303\240 direita: qual \303\251 o s\303\255tio anat\303\264mico preferencial para pun\303\247\303\243o de al\303\255vio segundo a 10\302\252 edi\303\247\303\243o do ATLS?\',"
