  code_action {
    action_spec {
      create_file {
        instruction: "import type { ExamBoard } from \'../types/medical\';\n\nexport type IncidenceTier = \'alta\' | \'media\' | \'baixa\';\n\nexport interface BoardIncidenceRule {\n  topic: string;\n  tier: IncidenceTier;\n  delta: number;\n  keywords: string[];\n}\n\nexport interface BoardWeightResolution {\n  board: ExamBoard;\n  tier: IncidenceTier;\n  delta: number;\n  matchedTopic: string | null;\n  reason: string;\n}\n\nexport const EXAM_BOARD_LABELS: Record<ExamBoard, string> = {\n  UEPA: \'UEPA\',\n  ENARE: \'ENARE\',\n  GERAL: \'Geral\',\n};\n\n/**\n * Normalizes Brazilian Portuguese medical strings for resilient partial matching\n * (strips diacritics, lowercases, replaces separators with single spaces).\n */\nexport function normalizeMedicalText(value: string): string {\n  return value\n    .toLowerCase()\n    .normalize(\'NFD\')\n    .replace(/[\\u0300-\\u036f]/g, \'\')\n    .replace(/[/\\-_,.;:()]+/g, \' \')\n    .replace(/\\s+/g, \' \')\n    .trim();\n}\n\n/**\n * Incidence matrices calibrated to Brazilian medical residency exam blueprints.\n * Priority within each board checks specific \"baixa\" subspecialties first when matching\n * partial strings so niche topics (e.g., \"Oncologia Pedi\303\241trica\", \"Reumatologia Rara\")\n * do not get misclassified under broad parent areas.\n */\nexport const BOARD_INCIDENCE_MATRIX: Record<ExamBoard, BoardIncidenceRule[]> = {\n  UEPA: [\n    // Baixa incid\303\252ncia (-0.03) \342\200\224 checked first for high-specificity subspecialties\n    {\n      topic: \'Reumatologia Rara\',\n      tier: \'baixa\',\n      delta: -0.03,\n      keywords: [\n        \'reumatologia rara\',\n        \'esclerose sistemica\',\n        \'dermatomiosite\',\n        \'polimiosite\',\n        \'sjogren\',\n        \'vasculite rara\',\n        \'doenca mista do tecido conjuntivo\',\n        \'policondrite\',\n      ],\n    },\n    {\n      topic: \'Subespecialidades Cir\303\272rgicas\',\n      tier: \'baixa\',\n      delta: -0.03,\n      keywords: [\n        \'subespecialidades cirurgicas\',\n        \'cirurgia plastica\',\n        \'cirurgia cardiaca\',\n        \'cirurgia toracica eletiva\',\n        \'neurocirurgia eletiva\',\n        \'cirurgia de cabeca e pescoco\',\n        \'microcirurgia\',\n      ],\n    },\n    {\n      topic: \'Gen\303\251tica\',\n      tier: \'baixa\',\n      delta: -0.03,\n      keywords: [\n        \'genetica\',\n        \'genetica medica\',\n        \'cromossomopatia\',\n        \'doenca genetica\',\n        \'erro inato\',\n      ],\n    },\n    {\n      topic: \'Oftalmologia / Otorrino\',\n      tier: \'baixa\',\n      delta: -0.03,\n      keywords: [\n        \'oftalmologia\',\n        \'oftalmo\',\n        \'otorrino\',\n        \'otorrinolaringologia\',\n        \'orl\',\n        \'glaucoma\',\n        \'catarata\',\n      ],\n    },\n\n    // Alta incid\303\252ncia (+0.03)\n    {\n      topic: \'Infectologia\',\n      tier: \'alta\',\n      delta: 0.03,\n      keywords: [\n        \'infectologia\',\n        \'infectopediatria\',\n        \'infeccao\',\n        \'sepse\',\n        \'hiv\',\n        \'aids\',\n        \'meningite\',\n        \'endocardite\',\n        \'sifilis\',\n        \'hepatite viral\',\n      ],\n    },\n    {\n      topic: \'Doen\303\247as End\303\252micas\',\n      tier: \'alta\',\n      delta: 0.03,\n      keywords: [\n        \'doencas endemicas\',\n        \'endemicas\',\n        \'malaria\',\n        \'dengue\',\n        \'chagas\',\n        \'hanseniase\',\n        \'tuberculose\',\n        \'leishmaniose\',\n        \'arbovirose\',\n        \'febre amarela\',\n        \'leptospirose\',\n        \'esquistossomose\',\n        \'vigilancia em saude\',\n      ],\n    },\n    {\n      topic: \'Neonatologia\',\n      tier: \'alta\',\n      delta: 0.03,\n      keywords: [\n        \'neonatologia\',\n        \'reanimacao neonatal\',\n        \'ictericia neonatal\',\n        \'sepse neonatal\',\n        \'recem nascido\',\n      ],\n    },\n    {\n      topic: \'Imuniza\303\247\303\265es\',\n      tier: \'alta\',\n      delta: 0.03,\n      keywords: [\n        \'imunizacoes\',\n        \'imunizacao\',\n        \'vacinas\',\n        \'vacinacao\',\n        \'pni\',\n        \'calendario vacinal\',\n        \'puericultura imunizacoes\',\n      ],\n    },\n    {\n      topic: \'Pr\303\251-Natal e Alto Risco\',\n      tier: \'alta\',\n      delta: 0.03,\n      keywords: [\n        \'pre natal\',\n        \'prenatal\',\n        \'alto risco\',\n        \'obstetricia pre natal\',\n        \'diabetes mellitus gestacional\',\n        \'diabetes gestacional\',\n        \'dmg\',\n        \'infeccoes congenitas\',\n        \'isoimunizacao\',\n      ],\n    },\n    {\n      topic: \'S\303\255ndromes Hipertensivas\',\n      tier: \'alta\',\n      delta: 0.03,\n      keywords: [\n        \'sindromes hipertensivas\',\n        \'pre eclampsia\',\n        \'eclampsia\',\n        \'hellp\',\n        \'dheg\',\n        \'hipertensao gestacional\',\n        \'obstetricia urgencias\',\n      ],\n    },\n    {\n      topic: \'Aten\303\247\303\243o Prim\303\241ria e SUS\',\n      tier: \'alta\',\n      delta: 0.03,\n      keywords: [\n        \'atencao primaria\',\n        \'aps\',\n        \'sus\',\n        \'politicas de saude\',\n        \'saude da familia\',\n        \'esf\',\n        \'saude coletiva\',\n        \'medicina preventiva\',\n      ],\n    },\n    {\n      topic: \'Epidemiologia\',\n      tier: \'alta\',\n      delta: 0.03,\n      keywords: [\n        \'epidemiologia\',\n        \'bioestatistica\',\n        \'testes diagnosticos\',\n        \'valores preditivos\',\n        \'estudos epidemiologicos\',\n        \'indicadores de saude\',\n      ],\n    },\n    {\n      topic: \'Trauma e Abdome Agudo\',\n      tier: \'alta\',\n      delta: 0.03,\n      keywords: [\n        \'trauma\',\n        \'politraumatizado\',\n        \'atls\',\n        \'abdome agudo\',\n        \'pneumotorax\',\n        \'apendicite\',\n        \'obstrucao intestinal\',\n        \'colecistite\',\n        \'pancreatite aguda\',\n      ],\n    },\n    {\n      topic: \'Cardiologia\',\n      tier: \'alta\',\n      delta: 0.03,\n      keywords: [\n        \'cardiologia\',\n        \'sindrome coronariana\',\n        \'iam\',\n        \'iamcsst\',\n        \'insuficiencia cardiaca\',\n        \'hipertensao arterial\',\n        \'arritmia\',\n        \'fibrilacao atrial\',\n      ],\n    },\n    {\n      topic: \'Endocrinologia\',\n      tier: \'alta\',\n      delta: 0.03,\n      keywords: [\n        \'endocrinologia\',\n        \'diabetes mellitus\',\n        \'cetoacidose\',\n        \'tireoide\',\n        \'hipotireoidismo\',\n        \'hipertireoidismo\',\n        \'adrenal\',\n      ],\n    },\n\n    // M\303\251dia incid\303\252ncia (0.00)\n    {\n      topic: \'Pneumologia\',\n      tier: \'media\',\n      delta: 0.0,\n      keywords: [\'pneumologia\', \'asma\', \'dpoc\', \'pneumonia\', \'derrame pleural\', \'tep\'],\n    },\n    {\n      topic: \'Nefrologia\',\n      tier: \'media\',\n      delta: 0.0,\n      keywords: [\n        \'nefrologia\',\n        \'injuria renal\',\n        \'doenca renal cronica\',\n        \'glomerulopatia\',\n        \'disturbios hidroeletroliticos\',\n        \'hipercalemia\',\n      ],\n    },\n    {\n      topic: \'Hematologia\',\n      tier: \'media\',\n      delta: 0.0,\n      keywords: [\'hematologia\', \'anemia\', \'leucemia\', \'linfoma\', \'coagulopatia\'],\n    },\n    {\n      topic: \'Psiquiatria\',\n      tier: \'media\',\n      delta: 0.0,\n      keywords: [\'psiquiatria\', \'depressao\', \'esquizofrenia\', \'transtorno bipolar\', \'ansiedade\'],\n    },\n    {\n      topic: \'Gastroenterologia\',\n      tier: \'media\',\n      delta: 0.0,\n      keywords: [\n        \'gastroenterologia\',\n        \'cirrose\',\n        \'hemorragia digestiva\',\n        \'drge\',\n        \'ulcera peptica\',\n        \'doenca inflamatoria intestinal\',\n      ],\n    },\n  ],\n\n  ENARE: [\n    // Baixa incid\303\252ncia (-0.03) \342\200\224 checked first for high-specificity subspecialties\n    {\n      topic: \'Oncologia Pedi\303\241trica\',\n      tier: \'baixa\',\n      delta: -0.03,\n      keywords: [\n        \'oncologia pediatrica\',\n        \'oncopediatria\',\n        \'neuroblastoma\',\n        \'tumor de wilms\',\n        \'retinoblastoma\',\n      ],\n    },\n    {\n      topic: \'Doen\303\247as Metab\303\263licas Raras\',\n      tier: \'baixa\',\n      delta: -0.03,\n      keywords: [\n        \'doencas metabolicas raras\',\n        \'erros inatos do metabolismo\',\n        \'erro inato\',\n        \'mucopolissacaridose\',\n        \'doenca metabolica rara\',\n      ],\n    },\n    {\n      topic: \'Oftalmologia e Otorrino\',\n      tier: \'baixa\',\n      delta: -0.03,\n      keywords: [\n        \'oftalmologia\',\n        \'oftalmo\',\n        \'otorrino\',\n        \'otorrinolaringologia\',\n        \'orl\',\n        \'glaucoma\',\n        \'catarata\',\n      ],\n    },\n    {\n      topic: \'Cirurgia Pl\303\241stica\',\n      tier: \'baixa\',\n      delta: -0.03,\n      keywords: [\'cirurgia plastica\', \'enxerto cutaneo\', \'retalho cirurgico\'],\n    },\n\n    // Alta incid\303\252ncia (+0.03)\n    {\n      topic: \'Cardiologia\',\n      tier: \'alta\',\n      delta: 0.03,\n      keywords: [\n        \'cardiologia\',\n        \'sindrome coronariana\',\n        \'iam\',\n        \'iamcsst\',\n        \'insuficiencia cardiaca\',\n        \'hipertensao arterial\',\n        \'arritmia\',\n      ],\n    },\n    {\n      topic: \'Pneumologia\',\n      tier: \'alta\',\n      delta: 0.03,\n      keywords: [\'pneumologia\', \'asma\', \'dpoc\', \'pneumonia\', \'derrame pleural\', \'tep\'],\n    },\n    {\n      topic: \'Endocrinologia\',\n      tier: \'alta\',\n      delta: 0.03,\n      keywords: [\n        \'endocrinologia\',\n        \'diabetes mellitus\',\n        \'cetoacidose\',\n        \'tireoide\',\n        \'hipotireoidismo\',\n        \'hipertireoidismo\',\n      ],\n    },\n    {\n      topic: \'Infectologia\',\n      tier: \'alta\',\n      delta: 0.03,\n      keywords: [\n        \'infectologia\',\n        \'infectopediatria\',\n        \'sepse\',\n        \'tuberculose\',\n        \'hiv\',\n        \'dengue\',\n        \'meningite\',\n        \'sifilis\',\n        \'endocardite\',\n      ],\n    },\n    {\n      topic: \'Trauma e Abdome Agudo\',\n      tier: \'alta\',\n      delta: 0.03,\n      keywords: [\n        \'trauma\',\n        \'politraumatizado\',\n        \'atls\',\n        \'abdome agudo\',\n        \'pneumotorax\',\n        \'apendicite\',\n        \'obstrucao intestinal\',\n        \'colecistite\',\n      ],\n    },\n    {\n      topic: \'Assist\303\252ncia ao Parto\',\n      tier: \'alta\',\n      delta: 0.03,\n      keywords: [\n        \'assistencia ao parto\',\n        \'trabalho de parto\',\n        \'partograma\',\n        \'distocia\',\n        \'hemorragia pos parto\',\n        \'obstetricia urgencias\',\n        \'parto\',\n      ],\n    },\n    {\n      topic: \'S\303\255ndromes Hipertensivas\',\n      tier: \'alta\',\n      delta: 0.03,\n      keywords: [\n        \'sindromes hipertensivas\',\n        \'pre eclampsia\',\n        \'eclampsia\',\n        \'hellp\',\n        \'dheg\',\n        \'hipertensao gestacional\',\n      ],\n    },\n    {\n      topic: \'Anticoncep\303\247\303\243o e SUA\',\n      tier: \'alta\',\n      delta: 0.03,\n      keywords: [\n        \'anticoncepcao\',\n        \'contracepcao\',\n        \'sua\',\n        \'sangramento uterino anormal\',\n        \'ginecologia\',\n        \'mioma\',\n        \'endometriose\',\n        \'diu\',\n      ],\n    },\n    {\n      topic: \'Neonatologia\',\n      tier: \'alta\',\n      delta: 0.03,\n      keywords: [\n        \'neonatologia\',\n        \'reanimacao neonatal\',\n        \'ictericia neonatal\',\n        \'sepse neonatal\',\n        \'recem nascido\',\n      ],\n    },\n    {\n      topic: \'Puericultura e Vacinas\',\n      tier: \'alta\',\n      delta: 0.03,\n      keywords: [\n        \'puericultura\',\n        \'vacinas\',\n        \'imunizacoes\',\n        \'imunizacao\',\n        \'pni\',\n        \'aleitamento materno\',\n        \'crescimento e desenvolvimento\',\n      ],\n    },\n    {\n      topic: \'Epidemiologia e Bioestat\303\255stica\',\n      tier: \'alta\',\n      delta: 0.03,\n      keywords: [\n        \'epidemiologia\',\n        \'bioestatistica\',\n        \'testes diagnosticos\',\n        \'valores preditivos\',\n        \'estudos epidemiologicos\',\n        \'vigilancia em saude\',\n      ],\n    },\n    {\n      topic: \'Aten\303\247\303\243o Prim\303\241ria e SUS\',\n      tier: \'alta\',\n      delta: 0.03,\n      keywords: [\n        \'atencao primaria\',\n        \'aps\',\n        \'sus\',\n        \'politicas de saude\',\n        \'saude da familia\',\n        \'esf\',\n        \'medicina preventiva\',\n      ],\n    },\n\n    // M\303\251dia incid\303\252ncia (0.00)\n    {\n      topic: \'Neurologia\',\n      tier: \'media\',\n      delta: 0.0,\n      keywords: [\'neurologia\', \'avc\', \'epilepsia\', \'cefaleia\', \'parkinson\', \'neuropatia\'],\n    },\n    {\n      topic: \'Nefrologia\',\n      tier: \'media\',\n      delta: 0.0,\n      keywords: [\n        \'nefrologia\',\n        \'injuria renal\',\n        \'doenca renal cronica\',\n        \'glomerulopatia\',\n        \'disturbios hidroeletroliticos\',\n      ],\n    },\n    {\n      topic: \'Psiquiatria\',\n      tier: \'media\',\n      delta: 0.0,\n      keywords: [\'psiquiatria\', \'depressao\', \'esquizofrenia\', \'transtorno bipolar\', \'ansiedade\'],\n    },\n    {\n      topic: \'Gastroenterologia\',\n      tier: \'media\',\n      delta: 0.0,\n      keywords: [\'gastroenterologia\', \'cirrose\', \'hemorragia digestiva\', \'drge\', \'ulcera peptica\'],\n    },\n    {\n      topic: \'Ortopedia\',\n      tier: \'media\',\n      delta: 0.0,\n      keywords: [\'ortopedia\', \'fratura\', \'luxacao\', \'osteomielite\'],\n    },\n    {\n      topic: \'Urologia\',\n      tier: \'media\',\n      delta: 0.0,\n      keywords: [\'urologia\', \'litiase urinaria\', \'hpb\', \'prostata\', \'nefrolitiase\'],\n    },\n  ],\n\n  GERAL: [\n    // Baixa incid\303\252ncia nacional (-0.03)\n    {\n      topic: \'Subespecialidades e Doen\303\247as Raras\',\n      tier: \'baixa\',\n      delta: -0.03,\n      keywords: [\n        \'oftalmologia\',\n        \'oftalmo\',\n        \'otorrino\',\n        \'otorrinolaringologia\',\n        \'orl\',\n        \'genetica\',\n        \'cirurgia plastica\',\n        \'reumatologia rara\',\n        \'oncologia pediatrica\',\n        \'doencas metabolicas raras\',\n        \'subespecialidades cirurgicas\',\n      ],\n    },\n    // Alta incid\303\252ncia nacional (+0.02 \342\200\224 perfil equilibrado entre grandes bancas do Brasil)\n    {\n      topic: \'N\303\272cleo de Alta Incid\303\252ncia Nacional\',\n      tier: \'alta\',\n      delta: 0.02,\n      keywords: [\n        \'cardiologia\',\n        \'trauma\',\n        \'abdome agudo\',\n        \'infectologia\',\n        \'endocrinologia\',\n        \'neonatologia\',\n        \'imunizacoes\',\n        \'vacinas\',\n        \'puericultura\',\n        \'pre natal\',\n        \'sindromes hipertensivas\',\n        \'assistencia ao parto\',\n        \'epidemiologia\',\n        \'bioestatistica\',\n        \'atencao primaria\',\n        \'politicas de saude\',\n        \'sus\',\n      ],\n    },\n    // M\303\251dia incid\303\252ncia nacional (0.00)\n    {\n      topic: \'Especialidades Cl\303\255nico-Cir\303\272rgicas Intermedi\303\241rias\',\n      tier: \'media\',\n      delta: 0.0,\n      keywords: [\n        \'pneumologia\',\n        \'nefrologia\',\n        \'hematologia\',\n        \'neurologia\',\n        \'psiquiatria\',\n        \'gastroenterologia\',\n        \'ginecologia\',\n        \'ortopedia\',\n        \'urologia\',\n      ],\n    },\n  ],\n};\n\nfunction formatBoardReason(board: ExamBoard, tier: IncidenceTier): string {\n  const boardName = EXAM_BOARD_LABELS[board];\n  if (tier === \'alta\') {\n    return board === \'GERAL\'\n      ? \'Alta incid\303\252ncia nacional\'\n      : `Alta incid\303\252ncia ${boardName}`;\n  }\n  if (tier === \'baixa\') {\n    return board === \'GERAL\'\n      ? \'Baixa incid\303\252ncia nacional\'\n      : `Baixa incid\303\252ncia ${boardName}`;\n  }\n  return board === \'GERAL\'\n    ? \'Incid\303\252ncia padr\303\243o (Geral)\'\n    : `Incid\303\252ncia m\303\251dia ${boardName}`;\n}\n\nfunction matchesKeyword(haystack: string, normalizedKeyword: string): boolean {\n  if (!haystack || !normalizedKeyword) return false;\n  if (haystack.includes(normalizedKeyword)) return true;\n\n  // Token-level partial fallback for multi-word clinical terms\n  const kwTokens = normalizedKeyword.split(\' \').filter((t) => t.length >= 4);\n  if (kwTokens.length >= 2) {\n    return kwTokens.every((token) => haystack.includes(token));\n  }\n  return false;\n}\n\n/**\n * Resolves the FSRS retention weight delta for a given board and topic/subtopic,\n * with resilient partial-text fallback across subtema, tema, and optional clinical stem.\n */\nexport function getExamTopicWeight(\n  board: ExamBoard,\n  tema: string,\n  subtema?: string,\n  contextText?: string\n): BoardWeightResolution {\n  const rules = BOARD_INCIDENCE_MATRIX[board] ?? BOARD_INCIDENCE_MATRIX.GERAL;\n\n  const normTema = normalizeMedicalText(tema);\n  const normSubtema = normalizeMedicalText(subtema ?? \'\');\n  const primaryText = [normSubtema, normTema].filter(Boolean).join(\' \');\n  const extendedText = [primaryText, normalizeMedicalText(contextText ?? \'\')]\n    .filter(Boolean)\n    .join(\' \');\n\n  // Pass 1: Exact match against normalized rule topic name or exact keyword\n  for (const rule of rules) {\n    const normRuleTopic = normalizeMedicalText(rule.topic);\n    if (\n      normTema === normRuleTopic ||\n      (normSubtema && normSubtema === normRuleTopic) ||\n      rule.keywords.some((kw) => kw === normTema || (normSubtema && kw === normSubtema))\n    ) {\n      return {\n        board,\n        tier: rule.tier,\n        delta: rule.delta,\n        matchedTopic: rule.topic,\n        reason: formatBoardReason(board, rule.tier),\n      };\n    }\n  }\n\n  // Pass 2: Partial / token match against tema + subtema (ordered with specific baixa rules first)\n  for (const rule of rules) {\n    if (\n      matchesKeyword(primaryText, normalizeMedicalText(rule.topic)) ||\n      rule.keywords.some((kw) => matchesKeyword(primaryText, kw))\n    ) {\n      return {\n        board,\n        tier: rule.tier,\n        delta: rule.delta,\n        matchedTopic: rule.topic,\n        reason: formatBoardReason(board, rule.tier),\n      };\n    }\n  }\n\n  // Pass 3: Contextual fallback against front prompt text (e.g., manual flashcards whose tema is \"Revis\303\243o Geral\")\n  if (contextText) {\n    for (const rule of rules) {\n      if (rule.keywords.some((kw) => kw.length >= 5 && matchesKeyword(extendedText, kw))) {\n        return {\n          board,\n          tier: rule.tier,\n          delta: rule.delta,\n          matchedTopic: rule.topic,\n          reason: formatBoardReason(board, rule.tier),\n        };\n      }\n    }\n  }\n\n  return {\n    board,\n    tier: \'media\',\n    delta: 0.0,\n    matchedTopic: null,\n    reason: formatBoardReason(board, \'media\'),\n  };\n}\n"
        path {
