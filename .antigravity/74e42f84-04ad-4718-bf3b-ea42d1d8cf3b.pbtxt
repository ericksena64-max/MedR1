      thinking_signature: "\022\311\n\n\306\n\001i\024}\023\242\235\3221\306\366Z!Q\"\315rB\226\242\254\025\\\271>\333n\tg]\277\315\363Da\301\276\360\'\b\234J7\270X\260\212\".z8\036\325\227Y,j\322s\366\346\253m\341\211]\217\237\207\t\020\366\230f\302f`\317\346\265\006t\372\212C\360\324\362a<cu\324tCpQl\350H=\034c\336n\257>\316\327\350 \245\2639],\310\ne\247\223\t\371zK\244\v*\002\026\321L\331\343\036\352\341\364\016\347\351\275r\372\0236\302\016\250\365@8\310\324\261C;A\321C\377\323\310\342MI\000u\211\3763C\231K]*\\\341\300\345\211\242\t\\+f%\032;\216:Z$\226V*\371\f\330\020L\021H\314\fJ\343\331\277\002h|\331\246(Y\"-\313{\375\031\002\305\b~\a\354\203\177`vS{\323\fy\021[\360\322\314\017=\314`JN\023\235\365\215\364\323\370\243l^\331\352M\225\372\372]N\035\026\327\026\v\031\003a\272\322\300\036^\207A\361 \255R\301{\2046\372\377#\207\352Y4O\303\327\250}y]P`o\346\032X\340\271\230\277:.lh\323\005\255\241q\301\351\301r\257\177\336m\033<?\371gA\374t7\333B(\251,\n\224\002_\241SEnS$\227\227\030\bHol\200\262zV\311\364\\\337fs|\321[g\371\2637I#\335I\307 \347\355\315\245\344\270\023\317-N\345\236H>u\"\212\311\242\301+\026B\fD\214N@29.\315\260\\&\337v\201\315\264\201\026E\005\222\177d{\370}C\\\266\321\351\264W\fO\317_d_\357\031\347\251V\374\370\267\315\0005\307\333H(\024u\244\t\316\333{\020Q\265\340\251\322\223\230L\0255\364\226\225\205\332T\\7\256\263\376\262\214\374\317\200\364C\022\310\231v\231I\327lA\264\317f<W{\004\333\262{\275\367\n\332\346\361\327C\344\315\330[\200\365\356\252a\207\232\376ca\256W2-\254\017\035\036w\337\3151o\207\267\306\232N\204pz\232\2770\352\247A.9\222\241\361\241\2066j7=\242\362\376\274\323w\"\022\222\246bzb#\003\311V\317\27484\271\213\307d\247,\230uEL;\267\267LF\005h\003\215\361\033\327\370eqBM\320\354\016\n\303\035\360e\235\'{F4&&\r_c\341v\n\336\017$j\333\r#\267_7\226x\t`Q\f\'\244\212x\003\034\337\017\210\376N\312\214@\204@f6e\r\323U\346\221\344\016\276\250\237]\265\036\245\024R\253\324h\211{\303}N\300T\001\375\301=ye\34235\340\000\242\021T)w\024\343\030{\236?k\277f\004\rzf:\to\243\325@n.\234\357\035\275\370mI\032\300\037\345\326\247\2643L<,\v\342=\304\214\267\252\234\305.e\354\030\210\266\323\362\361\377#U\000\024z\307u\032P\371]vw\375\267]\242\002\365\t9OQ\353\301\211\324\300\231\251\342\301R\356\363s\377=\247]\034\003\301\335\227\026o\034\3616\370>R\022tm\0303R\222Z\373;\236v\376\025\330\026\216S\333\374\222\315\036\314\323\206\030\367\272\271t\356%!D\317\310\000\265\215\022\3400\237Wn\252\305vz8\223#G\210o\360&\325\372\346B\321\3547\341\203q~\352\313R\337&\032%pX\003\220F\201\254\2419\363\350q\200\350\017Q~n!\321\203G\341V\372\336\320\321\226\271\2121y\311\311\037\330\307\212\314(\000\240\224\250J\301\247\231\201\2177\216V\220\203\367;\002\231C\220\026\204e\275\273\340,\017i\346\026`\257\nT?Ml\213\027\241\367D\027\253\\\371Qy\235\214\f\227\267\316\367L\252\272\224$B\235L\022o\\f\nK\377\305\343\300\352\333hWN\2359\262\225\245~gg\177\247Q\300\357\313\310\316\006\364\354F\365\254D\346\354\220P\237\036\2415=,\325\322|\233\2433\225*\210x\257u\300T~1\376\364\265|\326\274\201\027\n\307P\025\351\2624Z\021:\353o\333\350.\243QB\212\267\314\265\357\201\245\326\365\2707\323\212\322\022\027\324\272J\205\260\304\201\257\b\370\351\205C3\217\302\354V%a\375\235v\230\217\252$\214Y\340\321\272\304s\351L\276\305\354\214\035\232\200\232\2622xmNX\244\224\215\231\335\022=\354\224\2639\0248\033\037\203\221\345j\367#h\250\231sJib@r\315M\357\aF\301\311\301\3633W\372?4_\364\301\tmj\032[:rX\331\032\354o\273\310\327\t8W5\264m\324\346\334\361C\016v\034\017\016\210\261x\223Qbv\214\374pQ\344\017\230\231\222p#\337XO\021\243M\311\310\314T\255\365M\3226-N\341\305\325UM\321\022\f\355Y\326\320\v\276Q\332%\'\343\334\210\372u\311\231\224xf\251\266>\025\315]e\235\353\275}v{[\341\016\031\213T\256\254\220\232\210\177rx\204\027\b?r\320\217\240t\326"
