    tool_calls {
      id: "call_7995679941768899312"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import type { MedicalQuestion } from \'../types/medical\';\\n\\nexport const MEDICAL_QUESTIONS: MedicalQuestion[] = [\\n  {\\n    id: \'q-usp-2025-cardio-01\',\\n    code: \'Q-USP25-0142\',\\n    grandeAreaId: \'clinica_medica\',\\n    grandeArea: \'Cl\303\255nica M\303\251dica\',\\n    tema: \'Cardiologia\',\\n    subtema: \'S\303\255ndrome Coronariana Aguda com Supra de ST\',\\n    banca: \'FUVEST\',\\n    instituicao: \'USP-SP\',\\n    estado: \'SP\',\\n    regiao: \'Sudeste\',\\n    ano: 2025,\\n    tipoProva: \'Acesso Direto\',\\n    anulada: false,\\n    desatualizada: false,\\n    enunciado:\\n      \'Homem de 58 anos, tabagista (40 ma\303\247os-ano) e hipertenso irregular, chega \303\240 UPA de um munic\303\255pio sem servi\303\247o de hemodin\303\242mica queixando-se de dor tor\303\241cica retroesternal em aperto de forte intensidade (9/10), com irradia\303\247\303\243o para mand\303\255bula e sudorese fria h\303\241 2 horas e 15 minutos. Ao exame: PA 138/86 mmHg, FC 94 bpm, SpO\342\202\202 97% em ar ambiente, ausculta pulmonar limpa, sem sopros card\303\255acos (Killip I). Realizado ECG de 12 deriva\303\247\303\265es em 6 minutos da admiss\303\243o (imagem abaixo). O hospital de refer\303\252ncia com angioplastia prim\303\241ria dispon\303\255vel encontra-se a 150 minutos de transporte terrestre. N\303\243o h\303\241 contraindica\303\247\303\265es \303\240 fibrin\303\263lise. Qual \303\251 a conduta imediata mais adequada?\',\\n    clinicalImage: {\\n      url: \'/src/assets/images/clinical_ecg_stemi_1795302152424.jpg\',\\n      modality: \'ECG 12 Deriva\303\247\303\265es\',\\n      caption: \'Eletrocardiograma de admiss\303\243o (25 mm/s, 10 mm/mV) demonstrando supradesnivelamento do segmento ST em parede anterior.\',\\n      aspectRatio: \'16:9\',\\n    },\\n    labTable: [\\n      { exame: \'Troponina I ultrassens\303\255vel\', resultado: \'412 ng/L\', referencia: \'< 19 ng/L\', alterado: \'alto\' },\\n      { exame: \'Creatinina s\303\251rica\', resultado: \'1,0 mg/dL\', referencia: \'0,7\342\200\2231,3 mg/dL\', alterado: \'normal\' },\\n      { exame: \'Pot\303\241ssio (K\342\201\272)\', resultado: \'4,2 mEq/L\', referencia: \'3,5\342\200\2235,1 mEq/L\', alterado: \'normal\' },\\n      { exame: \'Hemoglobina\', resultado: \'14,8 g/dL\', referencia: \'13,5\342\200\22317,5 g/dL\', alterado: \'normal\' },\\n    ],\\n    alternativas: [\\n      {\\n        letter: \'A\',\\n        text: \'Administrar AAS 300 mg, clopidogrel 300 mg, enoxaparina e iniciar fibrin\303\263lise imediata (tenecteplase ou alteplase), com transfer\303\252ncia subsequente para centro com hemodin\303\242mica em estrat\303\251gia f\303\241rmaco-invasiva.\',\\n        explanation:\\n          \'Correta. O ECG mostra IAMCSST de parede anterior extensa (supra de ST em V1-V4) com delta-T de 2h15 (< 12h). Como o tempo estimado porta-bal\303\243o excede 120 minutos (transporte de 150 min), a Diretriz SBC recomenda fibrin\303\263lise imediata (meta porta-agulha \342\211\244 30 min) associada a dupla antiagrega\303\247\303\243o (AAS + clopidogrel 300 mg em pacientes \342\211\244 75 anos) e anticoagula\303\247\303\243o, seguida de transfer\303\252ncia para cineangiocoronariografia entre 2 e 24h (estrat\303\251gia f\303\241rmaco-invasiva).\',\\n        communityPct: 68.4,\\n      },\\n      {\\n        letter: \'B\',\\n        text: \'Administrar AAS 300 mg, ticagrelor 180 mg e transferir imediatamente para angioplastia prim\303\241ria, evitando tromb\303\263lise pelo risco hemorr\303\241gico.\',\\n        explanation:\\n          \'Incorreta (Principal distrator). A angioplastia prim\303\241ria s\303\263 \303\251 prefer\303\255vel \303\240 fibrin\303\263lise quando pode ser realizada em at\303\251 120 minutos a partir do diagn\303\263stico eletrocardiogr\303\241fico em hospitais sem hemodin\303\242mica. Al\303\251m disso, ticagrelor e prasugrel n\303\243o s\303\243o os inibidores P2Y12 de escolha no cen\303\241rio de fibrin\303\263lise imediata.\',\\n        communityPct: 19.2,\\n      },\\n      {\\n        letter: \'C\',\\n        text: \'Aguardar nova curva de troponina em 3 horas e realizar nitrato sublingual e morfina antes de definir terapia de reperfus\303\243o.\',\\n        explanation:\\n          \'Incorreta. No IAM com supradesnivelamento do segmento ST, a decis\303\243o de reperfus\303\243o \303\251 estritamente cl\303\255nico-eletrocardiogr\303\241fica; jamais se deve atrasar a reperfus\303\243o aguardando marcadores de necrose mioc\303\241rdica.\',\\n        communityPct: 3.1,\\n      },\\n      {\\n        letter: \'D\',\\n        text: \'Administrar AAS 300 mg, prasugrel 60 mg, heparina n\303\243o fracionada e iniciar tenecteplase em dose plena.\',\\n        explanation:\\n          \'Incorreta. O prasugrel \303\251 contraindicado na terapia fibrinol\303\255tica (estudos demonstraram risco elevado de sangramento maior sem benef\303\255cio estabelecido). Com trombol\303\255tico, o inibidor P2Y12 padr\303\243o-ouro \303\251 o clopidogrel.\',\\n        communityPct: 7.5,\\n      },\\n      {\\n        letter: \'E\',\\n        text: \'Iniciar oxigenoterapia em m\303\241scara n\303\243o reinalante a 10 L/min, furosemida venosa e aguardar estabilidade hemodin\303\242mica para transfer\303\252ncia.\',\\n        explanation:\\n          \'Incorreta. O paciente tem SpO\342\202\202 97% (oxig\303\252nio suplementar s\303\263 \303\251 indicado se SpO\342\202\202 < 90% ou desconforto respirat\303\263rio) e est\303\241 em Killip I (sem congest\303\243o pulmonar), n\303\243o havendo indica\303\247\303\243o de furosemida.\',\\n        communityPct: 1.8,\\n      },\\n    ],\\n    gabaritoOficial: \'A\',\\n    totalRespostasComunidade: 4820,\\n    taxaAcertoGlobal: 68.4,\\n    comentarioGeral:\\n      \'Quest\303\243o cl\303\241ssica da USP-SP cobrando o algoritmo de reperfus\303\243o no IAMCSST em servi\303\247os sem hemodin\303\242mica. O ponto decisivo \303\251 a regra dos 120 minutos: se o tempo previsto desde o diagn\303\263stico de IAMCSST at\303\251 a abertura da art\303\251ria (fio-guia) ultrapassar 120 minutos e o paciente estiver dentro da janela de 12 horas do in\303\255cio dos sintomas sem contraindica\303\247\303\265es absolutas, a fibrin\303\263lise imediata seguida de estrat\303\251gia f\303\241rmaco-invasiva salva mais mioc\303\241rdio e reduz mortalidade.\',\\n    perolaClinica:\\n      \'Regra de ouro no IAMCSST sem hemodin\303\242mica: transfer\303\252ncia > 120 min = Fibrin\303\263lise imediata (porta-agulha \342\211\244 30 min) + AAS + Clopidogrel (300 mg se \342\211\244 75 anos; sem ataque se > 75 anos) + Enoxaparina + CATE em 2\342\200\22324h.\',\\n    referencias: [\\n      \'Diretriz Brasileira de S\303\255ndromes Coronarianas Agudas \342\200\224 SBC (2021/2023).\',\\n      \'Braunwald\342\200\231s Heart Disease: A Textbook of Cardiovascular Medicine, 12\302\252 ed.\',\\n      \'Harrison\342\200\231s Principles of Internal Medicine, 21\302\252 ed., Cap. 275.\',\\n    ],\\n  },\\n  {\\n    id: \'q-unicamp-2025-trauma-02\',\\n    code: \'Q-UNI25-0089\',\\n    grandeAreaId: \'cirurgia_geral\',\\n    grandeArea: \'Cirurgia Geral\',\\n    tema: \'Trauma\',\\n    subtema: \'Atendimento Inicial ao Politraumatizado (ATLS)\',\\n    banca: \'COMVEST\',\\n    instituicao: \'UNICAMP\',\\n    estado: \'SP\',\\n    regiao: \'Sudeste\',\\n    ano: 2025,\\n    tipoProva: \'Acesso Direto\',\\n    anulada: false,\\n    desatualizada: false,\\n    enunciado:\\n      \'Motociclista de 27 anos sofre colis\303\243o lateral contra autom\303\263vel e \303\251 trazido \303\240 sala de trauma pelo SAMU em prancha r\303\255gida e colar cervical. \303\200 avalia\303\247\303\243o prim\303\241ria: via a\303\251rea p\303\251rvia com fala entrecortada, FR 34 irpm, SpO\342\202\202 86% em m\303\241scara com reservat\303\263rio, murm\303\272rio vesicular abolido em hemit\303\263rax direito, hipertimpanismo \303\240 percuss\303\243o \303\240 direita, turg\303\252ncia jugular bilateral, PA 78/46 mmHg e FC 136 bpm. Antes mesmo da radiografia de t\303\263rax (ilustrada apenas para correla\303\247\303\243o diagn\303\263stica did\303\241tica), qual \303\251 a conduta imediata preconizada pela 10\302\252 edi\303\247\303\243o do ATLS para adultos?\',\\n    clinicalImage: {\\n      url: \'/src/assets/images/clinical_xray_pneumothorax_1795302149327.jpg\',\\n      modality: \'Radiografia de T\303\263rax AP\',\\n      caption: \'Radiografia de t\303\263rax demonstrando pneumot\303\263rax extenso \303\240 direita com linha pleural visceral evidente e desvio mediastinal contralateral (na pr\303\241tica cl\303\255nica, n\303\243o aguardar RX no pneumot\303\263rax hipertensivo).\',\\n      aspectRatio: \'4:3\',\\n    },\\n    alternativas: [\\n      {\\n        letter: \'A\',\\n        text: \'Descompress\303\243o tor\303\241cica imediata com agulha calibrosa no 4\302\272 ou 5\302\272 espa\303\247o intercostal direito, imediatamente anterior \303\240 linha axilar m\303\251dia, seguida de drenagem pleural em selo d\342\200\231\303\241gua.\',\\n        explanation:\\n          \'Correta. A 10\302\252 edi\303\247\303\243o do ATLS alterou o s\303\255tio preferencial de pun\303\247\303\243o de al\303\255vio em adultos do 2\302\272 EIC na linha hemiclavicular para o 4\302\272 ou 5\302\272 espa\303\247o intercostal, ligeiramente anterior \303\240 linha axilar m\303\251dia (mesmo local anat\303\264mico da drenagem tor\303\241cica), devido \303\240 menor espessura da parede tor\303\241cica e menor taxa de falha.\',\\n        communityPct: 54.6,\\n      },\\n      {\\n        letter: \'B\',\\n        text: \'Descompress\303\243o imediata com jelco 14G obrigatoriamente no 2\302\272 espa\303\247o intercostal na linha hemiclavicular direita, \303\272nica topografia recomendada para adultos pelo ATLS 10\302\252 edi\303\247\303\243o.\',\\n        explanation:\\n          \'Incorreta (Principal distrator). O 2\302\272 EIC na linha hemiclavicular permanece como s\303\255tio preferencial em crian\303\247as (e alternativa aceit\303\241vel), mas no adulto a atualiza\303\247\303\243o da 10\302\252 edi\303\247\303\243o do ATLS passou a recomendar o 4\302\272 ou 5\302\272 EIC anterior \303\240 linha axilar m\303\251dia.\',\\n        communityPct: 31.4,\\n      },\\n      {\\n        letter: \'C\',\\n        text: \'Realizar radiografia de t\303\263rax no leito e eFAST para confirmar o pneumot\303\263rax hipertensivo antes de qualquer procedimento invasivo.\',\\n        explanation:\\n          \'Incorreta. O diagn\303\263stico do pneumot\303\263rax hipertensivo \303\251 estritamente cl\303\255nico (choque obstrutivo + aus\303\252ncia de MV + hipertimpanismo + turg\303\252ncia jugular). Aguardar imagem atrasa o tratamento e aumenta drasticamente a mortalidade.\',\\n        communityPct: 6.2,\\n      },\\n      {\\n        letter: \'D\',\\n        text: \'Intuba\303\247\303\243o orotraqueal imediata com press\303\243o positiva elevada e reposi\303\247\303\243o vol\303\252mica vigorosa com 2 litros de Ringer Lactato aquecido.\',\\n        explanation:\\n          \'Incorreta. Instituir ventila\303\247\303\243o com press\303\243o positiva antes de descomprimir um pneumot\303\263rax hipertensivo agrava o aprisionamento a\303\251reo e precipita parada cardiorrespirat\303\263ria em AESP.\',\\n        communityPct: 5.5,\\n      },\\n      {\\n        letter: \'E\',\\n        text: \'Pericardiocentese subxifoidea guiada por ultrassom para tratamento do choque obstrutivo com turg\303\252ncia jugular.\',\\n        explanation:\\n          \'Incorreta. Embora o tamponamento card\303\255aco tamb\303\251m cause choque obstrutivo e turg\303\252ncia jugular, ele n\303\243o cursa com aboli\303\247\303\243o do murm\303\272rio vesicular e hipertimpanismo unilateral.\',\\n        communityPct: 2.3,\\n      },\\n    ],\\n    gabaritoOficial: \'A\',\\n    totalRespostasComunidade: 5390,\\n    taxaAcertoGlobal: 54.6,\\n    comentarioGeral:\\n      \'A atualiza\303\247\303\243o do s\303\255tio anat\303\264mico da toracocentese de al\303\255vio em adultos na 10\302\252 edi\303\247\303\243o do ATLS \303\251 um dos temas mais prevalentes nas provas de Cirurgia Geral de S\303\243o Paulo (UNICAMP, USP e SUS-SP). O quadro cl\303\255nico de choque obstrutivo associado a hipertimpanismo e aboli\303\247\303\243o do MV \303\240 direita fecha o diagn\303\263stico cl\303\255nico de pneumot\303\263rax hipertensivo.\',\\n    perolaClinica:\\n      \'ATLS 10\302\252 edi\303\247\303\243o: Pun\303\247\303\243o de al\303\255vio em ADULTOS \342\206\222 4\302\272 ou 5\302\272 EIC, anterior \303\240 linha axilar m\303\251dia (em crian\303\247as mant\303\251m-se 2\302\272 EIC na linha hemiclavicular). Depois, dreno de t\303\263rax em selo d\342\200\231\303\241gua (28\342\200\22332 Fr).\',\\n    referencias: [\\n      \'ATLS \342\200\224 Advanced Trauma Life Support, Student Course Manual, 10\302\252 ed., Cap. 4.\',\\n      \'Sabiston Textbook of Surgery, 21\302\252 ed., Cap. 16 (Management of Acute Trauma).\',\\n    ],\\n  },\\n  {\\n    id: \'q-psumg-2024-neurotrauma-03\',\\n    code: \'Q-PSU24-0311\',\\n    grandeAreaId: \'cirurgia_geral\',\\n    grandeArea: \'Cirurgia Geral\',\\n    tema: \'Trauma\',\\n    subtema: \'Traumatismo Cranioencef\303\241lico e Hematomas Intracranianos\',\\n    banca: \'AREMG\',\\n    instituicao: \'PSU-MG\',\\n    estado: \'MG\',\\n    regiao: \'Sudeste\',\\n    ano: 2024,\\n    tipoProva: \'Acesso Direto\',\\n    anulada: false,\\n    desatualizada: false,\\n    enunciado:\\n      \'Homem de 31 anos sofre trauma cranioencef\303\241lico ap\303\263s queda de bicicleta sem capacete com impacto em regi\303\243o temporal esquerda. Apresentou perda transit\303\263ria da consci\303\252ncia por 2 minutos, acordou l\303\272cido e orientado (Glasgow 15), mas ap\303\263s 90 minutos na observa\303\247\303\243o evoluiu subitamente com sonol\303\252ncia (Glasgow 10), anisocoria com midr\303\255ase esquerda e hemiparesia direita. Realizada tomografia de cr\303\242nio sem contraste (imagem abaixo). Qual \303\251 o diagn\303\263stico mais prov\303\241vel e o principal vaso acometido?\',\\n    clinicalImage: {\\n      url: \'/src/assets/images/clinical_ct_epidural_1795302150711.jpg\',\\n      modality: \'TC de Cr\303\242nio sem Contraste\',\\n      caption: \'Corte axial em janela de par\303\252nquima cerebral evidenciando cole\303\247\303\243o extra-axial hiperdensa de morfologia biconvexa em regi\303\243o temporoparietal esquerda.\',\\n      aspectRatio: \'1:1\',\\n    },\\n    alternativas: [\\n      {\\n        letter: \'A\',\\n        text: \'Hematoma subdural agudo por rotura de veias-ponte corticais.\',\\n        explanation:\\n          \'Incorreta (Principal distrator). O hematoma subdural agudo apresenta aspecto em crescente (c\303\264ncavo-convexo), cruza linhas de sutura, costuma associar-se a les\303\243o parenquimatosa subjacente e tem origem venosa (veias-ponte).\',\\n        communityPct: 16.8,\\n      },\\n      {\\n        letter: \'B\',\\n        text: \'Hematoma epidural (extradural) agudo por les\303\243o da art\303\251ria men\303\255ngea m\303\251dia.\',\\n        explanation:\\n          \'Correta. O quadro cl\303\241ssico de \\\"intervalo l\303\272cido\\\" seguido de r\303\241pida deteriora\303\247\303\243o neurol\303\263gica com sinais de hernia\303\247\303\243o uncal (midr\303\255ase ipsilateral por compress\303\243o do III par + hemiparesia contralateral) associado \303\240 imagem hiperdensa biconvexa (em lente) que respeita suturas cranianas define o hematoma epidural agudo, classicamente causado por fratura do osso temporal com les\303\243o da art\303\251ria men\303\255ngea m\303\251dia.\',\\n        communityPct: 76.2,\\n      },\\n      {\\n        letter: \'C\',\\n        text: \'Hemorragia subaracnoidea traum\303\241tica por ruptura de aneurisma da art\303\251ria comunicante anterior.\',\\n        explanation:\\n          \'Incorreta. A HSA cursa com hiperdensidade preenchendo cisternas da base e sulcos corticais, sem cole\303\247\303\243o biconvexa extra-axial localizada.\',\\n        communityPct: 3.1,\\n      },\\n      {\\n        letter: \'D\',\\n        text: \'Les\303\243o axonal difusa grave por cisalhamento da subst\303\242ncia branca subcortical.\',\\n        explanation:\\n          \'Incorreta. A LAD manifesta-se com coma imediato desde o momento do trauma (sem intervalo l\303\272cido) e TC inicialmente normal ou com micro-hemorragias puntiformes no corpo caloso e jun\303\247\303\243o c\303\263rtico-subcortical.\',\\n        communityPct: 3.9,\\n      },\\n    ],\\n    gabaritoOficial: \'B\',\\n    totalRespostasComunidade: 3910,\\n    taxaAcertoGlobal: 76.2,\\n    comentarioGeral:\\n      \'Quest\303\243o de neurotrauma de alta incid\303\252ncia no PSU-MG e ENARE. Na conven\303\247\303\243o radiol\303\263gica da TC axial, o lado direito da imagem corresponde ao hemisf\303\251rio esquerdo do paciente. A cole\303\247\303\243o hiperdensa biconvexa limitada pelas inser\303\247\303\265es durais nas suturas cranianas, somada ao intervalo l\303\272cido e \303\240 anisocoria ipsilateral (hernia\303\247\303\243o do uncus comprimindo o nervo oculomotor), fecha o diagn\303\263stico de hematoma epidural agudo \342\200\224 emerg\303\252ncia neurocir\303\272rgica com indica\303\247\303\243o de craniotomia descompressiva.\',\\n    perolaClinica:\\n      \'Epidural = Lente Biconvexa + Art\303\251ria Men\303\255ngea M\303\251dia + Intervalo L\303\272cido + N\303\203O cruza suturas. Subdural = Crescente (Lua) + Veias-Ponte + CRUZA suturas.\',\\n    referencias: [\\n      \'ATLS \342\200\224 Advanced Trauma Life Support, 10\302\252 ed., Cap. 6 (Head Trauma).\',\\n      \'Sabiston Textbook of Surgery, 21\302\252 ed., Cap. 68 (Neurosurgery).\',\\n    ],\\n  },\\n  {\\n    id: \'q-enare-2025-nefro-04\',\\n    code: \'Q-ENR25-0204\',\\n    grandeAreaId: \'clinica_medica\',\\n    grandeArea: \'Cl\303\255nica M\303\251dica\',\\n    tema: \'Nefrologia\',\\n    subtema: \'Dist\303\272rbios Hidroeletrol\303\255ticos e Hipercalemia Grave\',\\n    banca: \'FGV\',\\n    instituicao: \'ENARE\',\\n    estado: \'BR\',\\n    regiao: \'Nacional\',\\n    ano: 2025,\\n    tipoProva: \'Acesso Direto\',\\n    anulada: false,\\n    desatualizada: false,\\n    enunciado:\\n      \'Mulher de 67 anos, portadora de doen\303\247a renal cr\303\264nica est\303\241gio 4 secund\303\241ria \303\240 nefropatia diab\303\251tica, d\303\241 entrada no pronto-socorro por fraqueza muscular progressiva ap\303\263s uso de anti-inflamat\303\263rio n\303\243o esteroidal por 5 dias. PA 152/88 mmHg, FC 52 bpm, diurese reduzida. O ECG demonstra ondas T apiculadas em tenda, prolongamento do intervalo PR e alargamento do complexo QRS (138 ms). Os exames laboratoriais est\303\243o apresentados na tabela. Qual deve ser a PRIMEIRA medida farmacol\303\263gica imediata?\',\\n    labTable: [\\n      { exame: \'Pot\303\241ssio s\303\251rico (K\342\201\272)\', resultado: \'7,4 mEq/L\', referencia: \'3,5\342\200\2235,1 mEq/L\', alterado: \'alto\' },\\n      { exame: \'Creatinina\', resultado: \'4,8 mg/dL\', referencia: \'0,6\342\200\2231,1 mg/dL\', alterado: \'alto\' },\\n      { exame: \'Ureia\', resultado: \'142 mg/dL\', referencia: \'15\342\200\22340 mg/dL\', alterado: \'alto\' },\\n      { exame: \'pH arterial\', resultado: \'7,29\', referencia: \'7,35\342\200\2237,45\', alterado: \'baixo\' },\\n      { exame: \'Bicarbonato (HCO\342\202\203\342\201\273)\', resultado: \'15 mEq/L\', referencia: \'22\342\200\22326 mEq/L\', alterado: \'baixo\' },\\n      { exame: \'Glicemia capilar\', resultado: \'164 mg/dL\', referencia: \'70\342\200\223140 mg/dL\', alterado: \'alto\' },\\n    ],\\n    alternativas: [\\n      {\\n        letter: \'A\',\\n        text: \'Solu\303\247\303\243o polarizante com insulina regular 10 UI IV associada a glicose hipert\303\264nica a 50%.\',\\n        explanation:\\n          \'Incorreta (Principal distrator). A solu\303\247\303\243o polarizante promove o influxo intracelular de pot\303\241ssio com in\303\255cio em 15\342\200\22330 min, sendo a segunda etapa fundamental, mas N\303\203O estabiliza imediatamente a membrana mioc\303\241rdica frente ao alargamento de QRS.\',\\n        communityPct: 24.5,\\n      },\\n      {\\n        letter: \'B\',\\n        text: \'Gluconato de c\303\241lcio a 10%, 10 mL por via intravenosa em 2 a 5 minutos, sob monitoriza\303\247\303\243o eletrocardiogr\303\241fica cont\303\255nua.\',\\n        explanation:\\n          \'Correta. Diante de hipercalemia com repercuss\303\243o eletrocardiogr\303\241fica (especialmente alargamento de QRS ou aus\303\252ncia de onda P), a prioridade absoluta \303\251 a estabiliza\303\247\303\243o da membrana do cardiomi\303\263cito com c\303\241lcio intravenoso (gluconato de c\303\241lcio 10%), cujo efeito ocorre em 1 a 3 minutos e previne fibrila\303\247\303\243o ventricular e assistolia.\',\\n        communityPct: 64.8,\\n      },\\n      {\\n        letter: \'C\',\\n        text: \'Resina de troca i\303\264nica (poliestirenossulfonato de c\303\241lcio) via oral associada a furosemida IV.\',\\n        explanation:\\n          \'Incorreta. Resinas de troca t\303\252m in\303\255cio de a\303\247\303\243o lento (horas) e nunca constituem a primeira medida na hipercalemia amea\303\247adora \303\240 vida.\',\\n        communityPct: 3.4,\\n      },\\n      {\\n        letter: \'D\',\\n        text: \'Bicarbonato de s\303\263dio 8,4% 1 mEq/kg IV em bolus como monoterapia inicial.\',\\n        explanation:\\n          \'Incorreta. O bicarbonato tem efeito discreto e demorado sobre o pot\303\241ssio s\303\251rico e pode auxiliar apenas em acidose metab\303\263lica grave, sem substituir o c\303\241lcio na estabiliza\303\247\303\243o el\303\251trica imediata.\',\\n        communityPct: 4.9,\\n      },\\n      {\\n        letter: \'E\',\\n        text: \'Nebuliza\303\247\303\243o isolada com fenoterol 10 gotas e repeti\303\247\303\243o do pot\303\241ssio em 1 hora.\',\\n        explanation:\\n          \'Incorreta. Beta-2 agonistas s\303\243o adjuvantes para redistribui\303\247\303\243o intracelular do pot\303\241ssio, mas n\303\243o protegem o mioc\303\241rdio imediatamente contra arritmias malignas.\',\\n        communityPct: 2.4,\\n      },\\n    ],\\n    gabaritoOficial: \'B\',\\n    totalRespostasComunidade: 6120,\\n    taxaAcertoGlobal: 64.8,\\n    comentarioGeral:\\n      \'Na emerg\303\252ncia nefrol\303\263gica, o manejo da hipercalemia grave segue 3 pilares sequenciais: (1) Estabilizar a membrana card\303\255aca (Gluconato de c\303\241lcio 10% IV \342\200\224 n\303\243o reduz o K\342\201\272 s\303\251rico, mas salva a vida em minutos); (2) Redistribuir K\342\201\272 para o intracelular (Insulina + Glicose, beta-2 agonista inalat\303\263rio, bicarbonato se acidose); (3) Eliminar K\342\201\272 do organismo (furosemida se diurese preservada, resinas de troca ou hemodi\303\241lise de urg\303\252ncia).\',\\n    perolaClinica:\\n      \'Altera\303\247\303\243o no ECG na hipercalemia = Gluconato de C\303\241lcio 10% IV PRIMEIRO! Ele eleva o potencial de limiar da membrana sem reduzir a calemia s\303\251rica.\',\\n    referencias: [\\n      \'KDIGO Controversies Conference on Potassium Management in Kidney Disease.\',\\n      \'Harrison\342\200\231s Principles of Internal Medicine, 21\302\252 ed., Cap. 53 (Fluid and Electrolyte Disturbances).\',\\n    ],\\n  },\\n  {\\n    id: \'q-usp-2025-go-05\',\\n    code: \'Q-USP25-0418\',\\n    grandeAreaId: \'ginecologia_obstetricia\',\\n    grandeArea: \'Ginecologia e Obstetr\303\255cia\',\\n    tema: \'Obstetr\303\255cia / Pr\303\251-Natal\',\\n    subtema: \'Diabetes Mellitus Gestacional (DMG)\',\\n    banca: \'FUVEST\',\\n    instituicao: \'USP-SP\',\\n    estado: \'SP\',\\n    regiao: \'Sudeste\',\\n    ano: 2025,\\n    tipoProva: \'Acesso Direto\',\\n    anulada: false,\\n    desatualizada: false,\\n    enunciado:\\n      \'Gestante de 29 anos, G2P1A0, IMC pr\303\251-gestacional de 28,4 kg/m\302\262, sem comorbidades pr\303\251vias conhecidas, comparece \303\240 consulta de pr\303\251-natal com 26 semanas trazendo resultado de Teste Oral de Toler\303\242ncia \303\240 Glicose com 75 g (TOTG-75g) realizado conforme rotina em servi\303\247o com viabilidade t\303\251cnica total. A glicemia de jejum do primeiro trimestre havia sido 84 mg/dL. Os valores do TOTG atual s\303\243o: jejum 90 mg/dL, 1\302\252 hora 184 mg/dL e 2\302\252 hora 148 mg/dL. Segundo o Consenso Brasileiro de Diabetes Mellitus Gestacional (FEBRASGO/SBD/OPAS), qual \303\251 o diagn\303\263stico e a conduta inicial?\',\\n    labTable: [\\n      { exame: \'TOTG 75g \342\200\224 Jejum\', resultado: \'90 mg/dL\', referencia: \'< 92 mg/dL\', alterado: \'normal\' },\\n      { exame: \'TOTG 75g \342\200\224 1\302\252 hora\', resultado: \'184 mg/dL\', referencia: \'< 180 mg/dL\', alterado: \'alto\' },\\n      { exame: \'TOTG 75g \342\200\224 2\302\252 hora\', resultado: \'148 mg/dL\', referencia: \'< 153 mg/dL\', alterado: \'normal\' },\\n    ],\\n    alternativas: [\\n      {\\n        letter: \'A\',\\n        text: \'Exame normal, pois apenas um ponto do TOTG-75g encontra-se alterado; manter pr\303\251-natal de risco habitual.\',\\n        explanation:\\n          \'Incorreta (Principal distrator). Esse era o crit\303\251rio antigo de Carpenter & Coustan (TOTG 100g), que exigia dois valores alterados. Pelo crit\303\251rio atual da IADPSG/FEBRASGO com TOTG-75g, APENAS UM ponto igual ou superior ao ponto de corte j\303\241 confirma o diagn\303\263stico de DMG.\',\\n        communityPct: 26.7,\\n      },\\n      {\\n        letter: \'B\',\\n        text: \'Diabetes Mellitus Gestacional (DMG); iniciar terapia nutricional, atividade f\303\255sica orientada e automonitoriza\303\247\303\243o glic\303\252mica capilar antes de indicar farmacoterapia.\',\\n        explanation:\\n          \'Correta. Os pontos de corte do TOTG-75g (24\342\200\22328 semanas) s\303\243o: jejum \342\211\245 92 mg/dL, 1h \342\211\245 180 mg/dL ou 2h \342\211\245 153 mg/dL. Um \303\272nico valor alterado (1h = 184 mg/dL) confirma DMG. A primeira linha terap\303\252utica consiste em orienta\303\247\303\243o diet\303\251tica individualizada, atividade f\303\255sica regular e perfil glic\303\252mico capilar por 1 a 2 semanas; apenas na falha de controle inicia-se insulina.\',\\n        communityPct: 58.3,\\n      },\\n      {\\n        letter: \'C\',\\n        text: \'Diabetes Mellitus pr\303\251vio (Overt Diabetes) diagnosticado na gesta\303\247\303\243o; iniciar insulina NPH e regular imediatamente.\',\\n        explanation:\\n          \'Incorreta. Overt Diabetes \303\251 definido por glicemia de jejum \342\211\245 126 mg/dL, 2h no TOTG \342\211\245 200 mg/dL, HbA1c \342\211\245 6,5% ou glicemia ao acaso \342\211\245 200 mg/dL com sintomas.\',\\n        communityPct: 5.8,\\n      },\\n      {\\n        letter: \'D\',\\n        text: \'Diabetes Mellitus Gestacional (DMG); iniciar metformina 850 mg duas vezes ao dia como primeira linha padr\303\243o.\',\\n        explanation:\\n          \'Incorreta. Al\303\251m de a mudan\303\247a de estilo de vida preceder a medica\303\247\303\243o em pacientes sem descompensa\303\247\303\243o grave, a terapia farmacol\303\263gica de primeira escolha no DMG no Brasil continua sendo a insulina (a metformina \303\251 alternativa em casos selecionados).\',\\n        communityPct: 9.2,\\n      },\\n    ],\\n    gabaritoOficial: \'B\',\\n    totalRespostasComunidade: 4415,\\n    taxaAcertoGlobal: 58.3,\\n    comentarioGeral:\\n      \'A tabela diagn\303\263stica de DMG da OPAS/FEBRASGO/MS \303\251 campe\303\243 absoluta de cobran\303\247a em GO. Memorizar os cortes exatos \342\200\224 92 / 180 / 153 mg/dL \342\200\224 e lembrar que basta UM valor alterado no TOTG-75g evita cair no distrator cl\303\241ssico dos \\\"dois pontos alterados\\\".\',\\n    perolaClinica:\\n      \'TOTG-75g (24\342\200\22328 sem): basta 1 valor \342\211\245 92 (jejum) | \342\211\245 180 (1h) | \342\211\245 153 (2h) = DMG! Alvos no tratamento: jejum < 95, 1h p\303\263s-prandial < 140, 2h p\303\263s-prandial < 120 mg/dL.\',\\n    referencias: [\\n      \'FEBRASGO / OPAS / SBD \342\200\224 Rastreamento e Diagn\303\263stico de Diabetes Mellitus Gestacional no Brasil.\',\\n      \'Williams Obstetrics, 26\302\252 ed., Cap. 60 (Diabetes Mellitus).\',\\n    ],\\n  },\\n  {\\n    id: \'q-unifesp-2025-neo-06\',\\n    code: \'Q-UNF25-0512\',\\n    grandeAreaId: \'pediatria\',\\n    grandeArea: \'Pediatria\',\\n    tema: \'Neonatologia\',\\n    subtema: \'Reanima\303\247\303\243o Neonatal (Diretriz SBP 2022)\',\\n    banca: \'VUNESP\',\\n    instituicao: \'UNIFESP\',\\n    estado: \'SP\',\\n    regiao: \'Sudeste\',\\n    ano: 2025,\\n    tipoProva: \'Acesso Direto\',\\n    anulada: false,\\n    desatualizada: false,\\n    enunciado:\\n      \'Rec\303\251m-nascido a termo (IG 39 semanas e 2 dias), parto vaginal sem intercorr\303\252ncias maternas, l\303\255quido amni\303\263tico claro, nasce hipot\303\264nico e em apneia. Foi realizado clampeamento imediato do cord\303\243o umbilical e o neonato foi levado \303\240 mesa de reanima\303\247\303\243o sob fonte de calor radiante. Ap\303\263s posicionar a cabe\303\247a em leve extens\303\243o, aspirar vias a\303\251reas se necess\303\241rio, secar e desprezar campos \303\272midos (passos iniciais conclu\303\255dos em 30 segundos), o RN permanece em apneia e com frequ\303\252ncia card\303\255aca de 76 bpm medida por ausculta precordial. De acordo com a Diretriz de Reanima\303\247\303\243o do RN \342\211\245 34 semanas da SBP (2022), qual \303\251 a conduta imediata correta?\',\\n    alternativas: [\\n      {\\n        letter: \'A\',\\n        text: \'Iniciar ventila\303\247\303\243o com press\303\243o positiva (VPP) com m\303\241scara facial e ar ambiente (FiO\342\202\202 21%), na frequ\303\252ncia de 40 a 60 movimentos por minuto, e instalar monitor card\303\255aco e ox\303\255metro de pulso no membro superior direito.\',\\n        explanation:\\n          \'Correta. Em RN \342\211\245 34 semanas que ap\303\263s os passos iniciais apresenta apneia, respira\303\247\303\243o irregular ou FC < 100 bpm, indica-se VPP imediata (dentro do Minuto de Ouro \342\200\224 primeiros 60 segundos) com m\303\241scara facial em ar ambiente (FiO\342\202\202 21%), ritmo de 40\342\200\22360/min (\\\"aperta-solta-solta\\\"), acompanhada da instala\303\247\303\243o do monitor card\303\255aco de 3 deriva\303\247\303\265es e ox\303\255metro pr\303\251-ductal (MSD).\',\\n        communityPct: 71.9,\\n      },\\n      {\\n        letter: \'B\',\\n        text: \'Iniciar ventila\303\247\303\243o com press\303\243o positiva (VPP) com FiO\342\202\202 a 30% e massagem card\303\255aca externa coordenada na rela\303\247\303\243o 3:1.\',\\n        explanation:\\n          \'Incorreta (Principal distrator). FiO\342\202\202 a 30% \303\251 utilizada no in\303\255cio da VPP para prematuros < 34 semanas, e a massagem card\303\255aca s\303\263 \303\251 indicada se a FC permanecer < 60 bpm AP\303\223S 30 segundos de VPP efetiva com c\303\242nula traqueal.\',\\n        communityPct: 14.3,\\n      },\\n      {\\n        letter: \'C\',\\n        text: \'Realizar intuba\303\247\303\243o orotraqueal imediata e administrar adrenalina endotraqueal antes de iniciar ventila\303\247\303\243o.\',\\n        explanation:\\n          \'Incorreta. A VPP com m\303\241scara facial \303\251 sempre a primeira interven\303\247\303\243o ventilat\303\263ria (exceto situa\303\247\303\265es especiais como h\303\251rnia diafragm\303\241tica cong\303\252nita). Mais de 90% dos RNs respondem adequadamente \303\240 VPP bem executada.\',\\n        communityPct: 4.8,\\n      },\\n      {\\n        letter: \'D\',\\n        text: \'Fornecer oxig\303\252nio inalat\303\263rio livre a 5 L/min pr\303\263ximo \303\240 face e aguardar mais 30 segundos para reavaliar a frequ\303\252ncia card\303\255aca.\',\\n        explanation:\\n          \'Incorreta. Oxig\303\252nio inalat\303\263rio n\303\243o substitui a VPP diante de apneia ou FC < 100 bpm e atrasa a abertura alveolar dentro do Minuto de Ouro.\',\\n        communityPct: 6.1,\\n      },\\n      {\\n        letter: \'E\',\\n        text: \'Realizar est\303\255mulo t\303\241til vigoroso em dorso e plantas dos p\303\251s por mais 30 segundos antes de indicar suporte ventilat\303\263rio.\',\\n        explanation:\\n          \'Incorreta. O est\303\255mulo t\303\241til delicado (no m\303\241ximo 2 vezes) j\303\241 faz parte dos passos iniciais; persistindo apneia ou FC < 100 bpm, n\303\243o se deve atrasar a VPP.\',\\n        communityPct: 2.9,\\n      },\\n    ],\\n    gabaritoOficial: \'A\',\\n    totalRespostasComunidade: 5280,\\n    taxaAcertoGlobal: 71.9,\\n    comentarioGeral:\\n      \'A Reanima\303\247\303\243o Neonatal (SBP 2022) \303\251 o assunto mais cobrado em Pediatria nas provas de resid\303\252ncia do Brasil. O \\\"Minuto de Ouro\\\" determina que, se o RN n\303\243o respirar ou mantiver FC < 100 bpm ap\303\263s os passos iniciais, a VPP deve come\303\247ar at\303\251 os 60 segundos de vida: em \342\211\245 34 semanas come\303\247a-se em ar ambiente (21%); em < 34 semanas inicia-se com FiO\342\202\202 30%.\',\\n    perolaClinica:\\n      \'SBP 2022 \342\200\224 VPP inicial: RN \342\211\245 34 sem \342\206\222 FiO\342\202\202 21% | RN < 34 sem \342\206\222 FiO\342\202\202 30%. Ox\303\255metro SEMPRE pr\303\251-ductal (membro superior direito) + monitor card\303\255aco de 3 eletrodos.\',\\n    referencias: [\\n      \'Sociedade Brasileira de Pediatria (SBP) \342\200\224 Diretrizes de Reanima\303\247\303\243o do Rec\303\251m-Nascido \342\211\245 34 semanas em sala de parto (2022).\',\\n      \'Tratado de Pediatria SBP, 5\302\252 ed.\',\\n    ],\\n  },\\n  {\\n    id: \'q-enare-2025-epi-07\',\\n    code: \'Q-ENR25-0673\',\\n    grandeAreaId: \'medicina_preventiva\',\\n    grandeArea: \'Medicina Preventiva e Social\',\\n    tema: \'Epidemiologia\',\\n    subtema: \'Testes Diagn\303\263sticos e Valores Preditivos\',\\n    banca: \'FGV\',\\n    instituicao: \'ENARE\',\\n    estado: \'BR\',\\n    regiao: \'Nacional\',\\n    ano: 2025,\\n    tipoProva: \'Acesso Direto\',\\n    anulada: false,\\n    desatualizada: false,\\n    enunciado:\\n      \'Um novo teste r\303\241pido sorol\303\263gico para diagn\303\263stico de determinada infec\303\247\303\243o apresenta sensibilidade de 90% e especificidade de 90% em estudos de valida\303\247\303\243o hospitalar. A Secretaria Municipal de Sa\303\272de decide aplic\303\241-lo em dois cen\303\241rios distintos: Cen\303\241rio 1 \342\200\224 ambulat\303\263rio de refer\303\252ncia em infectologia, onde a preval\303\252ncia da doen\303\247a \303\251 de 50%; Cen\303\241rio 2 \342\200\224 campanha populacional de rastreamento em assintom\303\241ticos, onde a preval\303\252ncia \303\251 de 1%. Considerando as propriedades dos testes diagn\303\263sticos, assinale a alternativa CORRETA.\',\\n    alternativas: [\\n      {\\n        letter: \'A\',\\n        text: \'A sensibilidade e a especificidade diminuem drasticamente no Cen\303\241rio 2 devido \303\240 queda na preval\303\252ncia da doen\303\247a.\',\\n        explanation:\\n          \'Incorreta. Sensibilidade e especificidade s\303\243o propriedades intr\303\255nsecas do teste e n\303\243o variam diretamente com a preval\303\252ncia da doen\303\247a na popula\303\247\303\243o testada.\',\\n        communityPct: 18.4,\\n      },\\n      {\\n        letter: \'B\',\\n        text: \'O Valor Preditivo Positivo (VPP) ser\303\241 substancialmente menor no Cen\303\241rio 2 (pr\303\263ximo a 8,3%), enquanto o Valor Preditivo Negativo (VPN) ser\303\241 muito elevado (> 99%).\',\\n        explanation:\\n          \'Correta. Em 10.000 pessoas com preval\303\252ncia de 1% (100 doentes e 9.900 sadios): VP = 90% de 100 = 90; FP = 10% de 9.900 = 990. Logo, VPP = 90 / (90 + 990) = 90 / 1080 \342\211\210 8,3%! J\303\241 no Cen\303\241rio 1 (preval\303\252ncia 50%), o VPP \303\251 de 90%. Quanto menor a preval\303\252ncia, menor o VPP e maior o VPN.\',\\n        communityPct: 47.6,\\n      },\\n      {\\n        letter: \'C\',\\n        text: \'A raz\303\243o de verossimilhan\303\247a positiva (LR+) muda de 9,0 no Cen\303\241rio 1 para 0,9 no Cen\303\241rio 2.\',\\n        explanation:\\n          \'Incorreta (Principal distrator). A raz\303\243o de verossimilhan\303\247a positiva (LR+ = Sensibilidade / [1 - Especificidade] = 0,90 / 0,10 = 9,0) depende apenas de sensibilidade e especificidade, sendo independente da preval\303\252ncia.\',\\n        communityPct: 22.1,\\n      },\\n      {\\n        letter: \'D\',\\n        text: \'O Valor Preditivo Positivo permanece em 90% em ambos os cen\303\241rios, pois depende exclusivamente da especificidade do teste.\',\\n        explanation:\\n          \'Incorreta. O VPP depende fortemente da preval\303\252ncia (probabilidade pr\303\251-teste), al\303\251m de especificidade e sensibilidade.\',\\n        communityPct: 8.2,\\n      },\\n      {\\n        letter: \'E\',\\n        text: \'Para aumentar a sensibilidade na campanha de rastreamento, deve-se aplicar dois testes em s\303\251rie (s\303\263 considerar positivo se ambos forem reagentes).\',\\n        explanation:\\n          \'Incorreta. Testes em S\303\211RIE aumentam a especificidade (e reduzem falsos-positivos), mas diminuem a sensibilidade. Para aumentar a sensibilidade, usam-se testes em PARALELO.\',\\n        communityPct: 3.7,\\n      },\\n    ],\\n    gabaritoOficial: \'B\',\\n    totalRespostasComunidade: 4980,\\n    taxaAcertoGlobal: 47.6,\\n    comentarioGeral:\\n      \'Quest\303\243o de n\303\255vel m\303\251dio-dif\303\255cil muito t\303\255pica da FGV/ENARE. Ela exige distinguir propriedades intr\303\255nsecas do teste (Sensibilidade, Especificidade e Raz\303\265es de Verossimilhan\303\247a \342\200\224 independentes da preval\303\252ncia) das propriedades p\303\263s-teste (VPP e VPN \342\200\224 diretamente influenciadas pela preval\303\252ncia). Mesmo um teste excelente (90%/90%) gera mais de 90% de falsos-positivos quando aplicado indiscriminadamente em popula\303\247\303\243o de baix\303\255ssima preval\303\252ncia.\',\\n    perolaClinica:\\n      \'Preval\303\252ncia CAI \342\206\222 VPP CAI e VPN SOBE. Sensibilidade, Especificidade e Raz\303\243o de Verossimilhan\303\247a (LR+/LR-) N\303\203O mudam com a preval\303\252ncia!\',\\n    referencias: [\\n      \'Fletcher RH, Fletcher SW \342\200\224 Epidemiologia Cl\303\255nica: Elementos Essenciais, 6\302\252 ed.\',\\n      \'Medronho RA \342\200\224 Epidemiologia, 2\302\252 ed., Cap. 18.\',\\n    ],\\n  },\\n  {\\n    id: \'q-unifesp-2024-endocrino-08\',\\n    code: \'Q-UNF24-0195\',\\n    grandeAreaId: \'clinica_medica\',\\n    grandeArea: \'Cl\303\255nica M\303\251dica\',\\n    tema: \'Endocrinologia\',\\n    subtema: \'Cetoacidose Diab\303\251tica (CAD)\',\\n    banca: \'VUNESP\',\\n    instituicao: \'UNIFESP\',\\n    estado: \'SP\',\\n    regiao: \'Sudeste\',\\n    ano: 2024,\\n    tipoProva: \'Acesso Direto\',\\n    anulada: false,\\n    desatualizada: false,\\n    enunciado:\\n      \'Adolescente de 19 anos com diabetes mellitus tipo 1 chega \303\240 emerg\303\252ncia com n\303\241useas, dor abdominal difusa, respira\303\247\303\243o de Kussmaul e desidrata\303\247\303\243o moderada ap\303\263s suspender insulina por 48 horas. PA 102/64 mmHg, FC 118 bpm. Ap\303\263s infus\303\243o inicial de 1.000 mL de soro fisiol\303\263gico 0,9% na primeira hora, chegam os exames laboratoriais abaixo. Qual \303\251 a conduta IMEDIATA mais segura em rela\303\247\303\243o \303\240 insulinoterapia e reposi\303\247\303\243o de pot\303\241ssio?\',\\n    labTable: [\\n      { exame: \'Glicemia venosa\', resultado: \'468 mg/dL\', referencia: \'70\342\200\22399 mg/dL\', alterado: \'alto\' },\\n      { exame: \'pH arterial\', resultado: \'7,14\', referencia: \'7,35\342\200\2237,45\', alterado: \'baixo\' },\\n      { exame: \'Bicarbonato (HCO\342\202\203\342\201\273)\', resultado: \'8,2 mEq/L\', referencia: \'22\342\200\22326 mEq/L\', alterado: \'baixo\' },\\n      { exame: \'Pot\303\241ssio (K\342\201\272)\', resultado: \'3,0 mEq/L\', referencia: \'3,5\342\200\2235,1 mEq/L\', alterado: \'baixo\' },\\n      { exame: \'S\303\263dio (Na\342\201\272)\', resultado: \'132 mEq/L\', referencia: \'135\342\200\223145 mEq/L\', alterado: \'baixo\' },\\n      { exame: \'Cetonemia (\316\262-hidroxibutirato)\', resultado: \'5,4 mmol/L\', referencia: \'< 0,6 mmol/L\', alterado: \'alto\' },\\n    ],\\n    alternativas: [\\n      {\\n        letter: \'A\',\\n        text: \'Iniciar bomba de insulina regular 0,1 UI/kg/h imediatamente e repor pot\303\241ssio apenas se cair abaixo de 2,5 mEq/L.\',\\n        explanation:\\n          \'Incorreta. Iniciar insulina com K\342\201\272 < 3,3 mEq/L induz hipocalemia grave por influxo celular de pot\303\241ssio, com alto risco de arritmias fatais e parada card\303\255aca.\',\\n        communityPct: 8.9,\\n      },\\n      {\\n        letter: \'B\',\\n        text: \'Postergar o in\303\255cio da insulina, manter hidrata\303\247\303\243o venosa e repor pot\303\241ssio (20\342\200\22330 mEq/h) at\303\251 atingir K\342\201\272 \342\211\245 3,3\342\200\2233,5 mEq/L antes de iniciar a insulinoterapia.\',\\n        explanation:\\n          \'Correta. Segundo o consenso da ADA/SBD para crises hiperglic\303\252micas, quando o pot\303\241ssio s\303\251rico inicial est\303\241 abaixo de 3,3 mEq/L (ou < 3,5 mEq/L nas diretrizes mais recentes da ADA 2024), a insulina DEVE ser adiada e o pot\303\241ssio reposto vigorosamente primeiro para evitar hipocalemia fatal.\',\\n        communityPct: 62.1,\\n      },\\n      {\\n        letter: \'C\',\\n        text: \'Administrar bicarbonato de s\303\263dio 100 mEq IV imediato para corrigir o pH de 7,14 e iniciar insulina em bolus.\',\\n        explanation:\\n          \'Incorreta (Principal distrator). O bicarbonato na CAD s\303\263 \303\251 considerado quando o pH est\303\241 < 6,9 (ou < 7,0 em alguns consensos), pois sua infus\303\243o agrava a hipocalemia e pode precipitar acidose paradoxal do SNC.\',\\n        communityPct: 21.6,\\n      },\\n      {\\n        letter: \'D\',\\n        text: \'Iniciar insulina NPH subcut\303\242nea combinada com soro glicosado 5% desde o in\303\255cio para prevenir edema cerebral.\',\\n        explanation:\\n          \'Incorreta. A insulina de escolha na CAD moderada/grave \303\251 a regular em infus\303\243o venosa cont\303\255nua (ap\303\263s corre\303\247\303\243o do K\342\201\272), e o soro glicosado s\303\263 \303\251 associado quando a glicemia cai abaixo de 200\342\200\223250 mg/dL.\',\\n        communityPct: 7.4,\\n      },\\n    ],\\n    gabaritoOficial: \'B\',\\n    totalRespostasComunidade: 4230,\\n    taxaAcertoGlobal: 62.1,\\n    comentarioGeral:\\n      \'A pegadinha cl\303\241ssica da Cetoacidose Diab\303\251tica est\303\241 no pot\303\241ssio! Apesar de o paciente com CAD ter sempre d\303\251ficit corporal total de pot\303\241ssio, o valor s\303\251rico inicial pode estar alto, normal ou baixo. Se K\342\201\272 < 3,3 mEq/L (ADA 2024 sugere < 3,5 mEq/L), NUNCA inicie insulina antes de repor K\342\201\272.\',\\n    perolaClinica:\\n      \'Regra do K\342\201\272 na CAD: K\342\201\272 < 3,3 \342\206\222 SEGURA a insulina e rep\303\265e K\342\201\272! K\342\201\272 entre 3,3 e 5,2 \342\206\222 Insulina + rep\303\265e K\342\201\272 no soro. K\342\201\272 > 5,2 \342\206\222 Insulina sem repor K\342\201\272 e reavalia em 2h. Bicarbonato s\303\263 se pH < 6,9!\',\\n    referencias: [\\n      \'ADA / EASD / JBDS Consensus Report: Hyperglycemic Crises in Adults With Diabetes (Diabetes Care, 2024).\',\\n      \'Sociedade Brasileira de Diabetes \342\200\224 Diretriz Oficial 2024.\',\\n    ],\\n  },\\n  {\\n    id: \'q-unicamp-2025-go-09\',\\n    code: \'Q-UNI25-0741\',\\n    grandeAreaId: \'ginecologia_obstetricia\',\\n    grandeArea: \'Ginecologia e Obstetr\303\255cia\',\\n    tema: \'Obstetr\303\255cia / Urg\303\252ncias\',\\n    subtema: \'Pr\303\251-Ecl\303\242mpsia com Sinais de Gravidade e S\303\255ndrome HELLP\',\\n    banca: \'COMVEST\',\\n    instituicao: \'UNICAMP\',\\n    estado: \'SP\',\\n    regiao: \'Sudeste\',\\n    ano: 2025,\\n    tipoProva: \'Acesso Direto\',\\n    anulada: false,\\n    desatualizada: false,\\n    enunciado:\\n      \'Primigesta de 24 anos, com 33 semanas e 4 dias de idade gestacional, procura o pronto-socorro obst\303\251trico queixando-se de cefaleia fronto-occipital intensa, escotomas cintilantes e dor epig\303\241strica em barra h\303\241 4 horas. Ao exame: PA 174/112 mmHg (confirmada ap\303\263s 15 min), reflexos patelares exaltados (+++/4+), batimentos card\303\255acos fetais 144 bpm, din\303\242mica uterina ausente. Os exames laboratoriais colhidos mostram o perfil abaixo. Qual conjunto de medidas representa a conduta imediata priorit\303\241ria?\',\\n    labTable: [\\n      { exame: \'Plaquetas\', resultado: \'82.000 /mm\302\263\', referencia: \'150.000\342\200\223400.000 /mm\302\263\', alterado: \'baixo\' },\\n      { exame: \'TGO (AST)\', resultado: \'138 U/L\', referencia: \'< 32 U/L\', alterado: \'alto\' },\\n      { exame: \'DHL\', resultado: \'740 U/L\', referencia: \'< 250 U/L\', alterado: \'alto\' },\\n      { exame: \'Creatinina\', resultado: \'1,3 mg/dL\', referencia: \'< 0,9 mg/dL\', alterado: \'alto\' },\\n      { exame: \'Rela\303\247\303\243o Ptn/Cr urin\303\241ria\', resultado: \'0,68\', referencia: \'< 0,30\', alterado: \'alto\' },\\n    ],\\n    alternativas: [\\n      {\\n        letter: \'A\',\\n        text: \'Sulfato de magn\303\251sio IV (esquema de Zuspan ou Pritchard) para profilaxia de ecl\303\242mpsia, anti-hipertensivo de a\303\247\303\243o r\303\241pida (hidralazina IV ou nifedipino VO) e programa\303\247\303\243o de resolu\303\247\303\243o da gesta\303\247\303\243o ap\303\263s estabiliza\303\247\303\243o materna.\',\\n        explanation:\\n          \'Correta. A paciente apresenta imin\303\252ncia de ecl\303\242mpsia, emerg\303\252ncia hipertensiva (PA \342\211\245 160/110) e s\303\255ndrome HELLP (hem\303\263lise com DHL > 600, AST \342\211\245 2x LSN e plaquetas < 100.000). A prioridade \303\251 prevenir convuls\303\265es com sulfato de magn\303\251sio, reduzir a PA com seguran\303\247a (alvo 140\342\200\223155 / 90\342\200\223100 mmHg com hidralazina IV ou nifedipino VO) e resolver a gesta\303\247\303\243o ap\303\263s estabiliza\303\247\303\243o materna, independentemente da idade gestacional na s\303\255ndrome HELLP.\',\\n        communityPct: 74.5,\\n      },\\n      {\\n        letter: \'B\',\\n        text: \'Conduta expectante rigorosa at\303\251 completar 34 semanas ap\303\263s dois dias completos de betametasona, utilizando apenas metildopa oral para controle press\303\263rico.\',\\n        explanation:\\n          \'Incorreta (Principal distrator). Embora a corticoide antenatal possa ser iniciada se o parto n\303\243o for imediato, a s\303\255ndrome HELLP e a imin\303\252ncia de ecl\303\242mpsia contraindicam conduta expectante prolongada; al\303\251m disso, metildopa n\303\243o serve para crise hipertensiva aguda.\',\\n        communityPct: 14.9,\\n      },\\n      {\\n        letter: \'C\',\\n        text: \'Fenito\303\255na venosa como primeira escolha para neuroprote\303\247\303\243o materna, nitroprussiato de s\303\263dio IV e cesariana imediata em sala de emerg\303\252ncia sem aguardar estabiliza\303\247\303\243o.\',\\n        explanation:\\n          \'Incorreta. O sulfato de magn\303\251sio \303\251 amplamente superior \303\240 fenito\303\255na e benzodiazep\303\255nicos na preven\303\247\303\243o/tratamento de ecl\303\242mpsia; nitroprussiato \303\251 evitado pelo risco de intoxica\303\247\303\243o fetal por cianeto; a estabiliza\303\247\303\243o materna sempre precede o parto.\',\\n        communityPct: 5.1,\\n      },\\n      {\\n        letter: \'D\',\\n        text: \'Transfus\303\243o imediata de concentrado de plaquetas (pois < 100.000/mm\302\263) seguida de indu\303\247\303\243o com misoprostol sem sulfato de magn\303\251sio.\',\\n        explanation:\\n          \'Incorreta. A transfus\303\243o profil\303\241tica de plaquetas na s\303\255ndrome HELLP \303\251 indicada geralmente se plaquetas < 50.000/mm\302\263 para cesariana ou < 20.000/mm\302\263 para parto vaginal (ou sangramento ativo), e o sulfato de magn\303\251sio \303\251 mandat\303\263rio.\',\\n        communityPct: 5.5,\\n      },\\n    ],\\n    gabaritoOficial: \'A\',\\n    totalRespostasComunidade: 5110,\\n    taxaAcertoGlobal: 74.5,\\n    comentarioGeral:\\n      \'Tr\303\255ade cl\303\241ssica de prova em Obstetr\303\255cia: PA \342\211\245 160/110 + sintomas de imin\303\252ncia de ecl\303\242mpsia (cefaleia, escotomas, epigastralgia) + s\303\255ndrome HELLP. Lembre-se de monitorar a intoxica\303\247\303\243o pelo sulfato de magn\303\251sio avaliando reflexo patelar, frequ\303\252ncia respirat\303\263ria (\342\211\245 16 irpm) e diurese (\342\211\245 25\342\200\22330 mL/h), mantendo gluconato de c\303\241lcio 10% como ant\303\255doto \303\240 beira-leito.\',\\n    perolaClinica:\\n      \'Esquema de Zuspan (IV): ataque 4 g em 15\342\200\22320 min + manuten\303\247\303\243o 1\342\200\2232 g/h em BIC. Ant\303\255doto da intoxica\303\247\303\243o por MgSO\342\202\204: Gluconato de c\303\241lcio 10% (10 mL IV lento).\',\\n    referencias: [\\n      \'FEBRASGO \342\200\224 Protocolo de Pr\303\251-Ecl\303\242mpsia (2023).\',\\n      \'ACOG Practice Bulletin No. 222 \342\200\224 Gestational Hypertension and Preeclampsia.\',\\n    ],\\n  },\\n  {\\n    id: \'q-sussp-2025-infecto-10\',\\n    code: \'Q-SUS25-0309\',\\n    grandeAreaId: \'clinica_medica\',\\n    grandeArea: \'Cl\303\255nica M\303\251dica\',\\n    tema: \'Infectologia\',\\n    subtema: \'Dengue: Classifica\303\247\303\243o de Risco e Manejo Vol\303\252mico\',\\n    banca: \'VUNESP\',\\n    instituicao: \'SUS-SP\',\\n    estado: \'SP\',\\n    regiao: \'Sudeste\',\\n    ano: 2025,\\n    tipoProva: \'Acesso Direto\',\\n    anulada: false,\\n    desatualizada: false,\\n    enunciado:\\n      \'Homem de 36 anos, 70 kg, no 4\302\272 dia de quadro febril agudo com diagn\303\263stico confirmado de dengue (NS1 reagente), evoluiu com defervesc\303\252ncia hoje pela manh\303\243, por\303\251m refere dor abdominal intensa e cont\303\255nua, dois epis\303\263dios de v\303\264mitos persistentes e tontura ao levantar. Ao exame: consciente, PA 112/76 mmHg em dec\303\272bito (98/68 mmHg em ortostase), FC 104 bpm, extremidades aquecidas, tempo de enchimento capilar 2 segundos, hepatomegalia dolorosa a 3 cm do rebordo costal direito. Hemograma: Hb 16,2 g/dL, Ht 49% (basal pr\303\251vio 42%), plaquetas 58.000/mm\302\263. De acordo com o Manual de Manejo Cl\303\255nico da Dengue do Minist\303\251rio da Sa\303\272de (2024), qual \303\251 a classifica\303\247\303\243o do paciente e a reposi\303\247\303\243o vol\303\252mica inicial indicada?\',\\n    alternativas: [\\n      {\\n        letter: \'A\',\\n        text: \'Grupo B; hidrata\303\247\303\243o oral supervisionada de 60 mL/kg/dia e libera\303\247\303\243o com retorno di\303\241rio.\',\\n        explanation:\\n          \'Incorreta. A presen\303\247a de dor abdominal intensa e cont\303\255nua, v\303\264mitos persistentes, hipotens\303\243o postural, hepatomegalia > 2 cm e hemoconcentra\303\247\303\243o configura SINAIS DE ALARME, enquadrando o paciente no Grupo C (n\303\243o B).\',\\n        communityPct: 7.3,\\n      },\\n      {\\n        letter: \'B\',\\n        text: \'Grupo C; interna\303\247\303\243o em leito de observa\303\247\303\243o/hospitalar com reposi\303\247\303\243o imediata de soro fisiol\303\263gico 0,9% 10 mL/kg na primeira hora, reavaliando cl\303\255nica e hemat\303\263crito.\',\\n        explanation:\\n          \'Correta. Sinais de alarme sem choque instalado definem o Grupo C. O protocolo do Minist\303\251rio da Sa\303\272de (2024) preconiza reposi\303\247\303\243o imediata de 10 mL/kg de soro fisiol\303\263gico 0,9% na 1\302\252 hora (podendo repetir at\303\251 3 vezes se necess\303\241rio), seguida de fase de manuten\303\247\303\243o e monitoramento rigoroso de hemat\303\263crito e diurese.\',\\n        communityPct: 51.4,\\n      },\\n      {\\n        letter: \'C\',\\n        text: \'Grupo D; expans\303\243o r\303\241pida com 20 mL/kg de solu\303\247\303\243o cristaloide em 20 minutos e transfus\303\243o profil\303\241tica de plaquetas.\',\\n        explanation:\\n          \'Incorreta (Principal distrator). O esquema de 20 mL/kg em 20 minutos \303\251 destinado ao Grupo D (choque com hipotens\303\243o, press\303\243o arterial convergente \342\211\244 20 mmHg, TEC > 2s, extremidades frias ou sangramento grave/disfun\303\247\303\243o org\303\242nica). Al\303\251m disso, plaquetopenia de 58.000/mm\302\263 sem sangramento grave n\303\243o indica transfus\303\243o.\',\\n        communityPct: 33.8,\\n      },\\n      {\\n        letter: \'D\',\\n        text: \'Grupo C; iniciar albumina humana 5% imediatamente devido ao extravasamento plasm\303\241tico evidenciado pelo hemat\303\263crito de 49%.\',\\n        explanation:\\n          \'Incorreta. Coloides (como albumina) s\303\243o reservados para casos refrat\303\241rios de choque (Grupo D) que n\303\243o respondem \303\240s fases iniciais de cristaloide com hemat\303\263crito em ascens\303\243o.\',\\n        communityPct: 4.9,\\n      },\\n      {\\n        letter: \'E\',\\n        text: \'Grupo B; transfus\303\243o de concentrado de plaquetas e observa\303\247\303\243o ambulatorial por 12 horas.\',\\n        explanation:\\n          \'Incorreta. Classifica\303\247\303\243o equivocada e conduta contraindicada (transfus\303\243o desnecess\303\241ria aumenta risco de sobrecarga vol\303\252mica).\',\\n        communityPct: 2.6,\\n      },\\n    ],\\n    gabaritoOficial: \'B\',\\n    totalRespostasComunidade: 5890,\\n    taxaAcertoGlobal: 51.4,\\n    comentarioGeral:\\n      \'A edi\303\247\303\243o de 2024 do Manual de Dengue do Minist\303\251rio da Sa\303\272de unificou e refinou o protocolo de hidrata\303\247\303\243o do Grupo C: reposi\303\247\303\243o inicial de 10 mL/kg na 1\302\252 hora (antes era 20 mL/kg em 2 horas \342\200\224 o que equivalia \303\240 mesma taxa hor\303\241ria, mas agora padronizado como 10 mL/kg/h!). Diferenciar Grupo C (sinais de alarme, hemodinamicamente est\303\241vel sem choque) de Grupo D (choque / sangramento grave / disfun\303\247\303\243o org\303\242nica) \303\251 crucial.\',\\n    perolaClinica:\\n      \'Dengue MS 2024: Grupo C (sinais de alarme) \342\206\222 10 mL/kg na 1\302\252 hora (SF 0,9%). Grupo D (choque/grave) \342\206\222 20 mL/kg em at\303\251 20 minutos. Plaquetopenia isolada N\303\203O indica transfus\303\243o!\',\\n    referencias: [\\n      \'Minist\303\251rio da Sa\303\272de \342\200\224 Dengue: Diagn\303\263stico e Manejo Cl\303\255nico (Adulto e Crian\303\247a), 6\302\252 edi\303\247\303\243o (2024).\',\\n    ],\\n  },\\n  {\\n    id: \'q-enare-2024-cir-11\',\\n    code: \'Q-ENR24-0815\',\\n    grandeAreaId: \'cirurgia_geral\',\\n    grandeArea: \'Cirurgia Geral\',\\n    tema: \'Abdome Agudo\',\\n    subtema: \'Colecistite Aguda Calculosa (Crit\303\251rios de T\303\263quio)\',\\n    banca: \'INSTITUTO AOCP\',\\n    instituicao: \'ENARE\',\\n    estado: \'BR\',\\n    regiao: \'Nacional\',\\n    ano: 2024,\\n    tipoProva: \'R+\',\\n    anulada: false,\\n    desatualizada: false,\\n    enunciado:\\n      \'Mulher de 54 anos apresenta dor em hipoc\303\264ndrio direito h\303\241 84 horas, febre de 38,4 \302\260C e sinal de Murphy positivo. Ao exame: consciente, PA 124/78 mmHg, FC 96 bpm, sem icter\303\255cia. Hemograma mostra leucocitose de 19.600/mm\302\263 com desvio \303\240 esquerda, bilirrubinas normais, creatinina 0,9 mg/dL, RNI 1,0. Ultrassonografia abdominal evidencia ves\303\255cula biliar distendida com c\303\241lculo impactado no infund\303\255bulo, espessamento parietal de 6 mm e l\303\255quido pericolec\303\255stico. Segundo os Crit\303\251rios de T\303\263quio (TG18), qual \303\251 a gravidade dessa colecistite aguda?\',\\n    alternativas: [\\n      {\\n        letter: \'A\',\\n        text: \'Grau I (Leve), pois n\303\243o h\303\241 disfun\303\247\303\243o org\303\242nica ou icter\303\255cia associada.\',\\n        explanation:\\n          \'Incorreta (Principal distrator). Embora n\303\243o haja disfun\303\247\303\243o org\303\242nica (que definiria Grau III), a paciente apresenta dois crit\303\251rios claros de Grau II (Moderada): leucocitose > 18.000/mm\302\263 e dura\303\247\303\243o dos sintomas > 72 horas.\',\\n        communityPct: 29.4,\\n      },\\n      {\\n        letter: \'B\',\\n        text: \'Grau II (Moderada), caracterizada por leucocitose > 18.000/mm\302\263 e dura\303\247\303\243o dos sintomas superior a 72 horas.\',\\n        explanation:\\n          \'Correta. Pelo Tokyo Guidelines 2018 (TG18), a colecistite aguda Grau II (moderada) \303\251 definida por qualquer um dos crit\303\251rios: leuc\303\263citos > 18.000/mm\302\263, massa palp\303\241vel dolorosa em QSD, dura\303\247\303\243o dos sintomas > 72h ou inflama\303\247\303\243o local acentuada (colecistite gangrenosa, enfisematosa, abscesso pericolec\303\255stico/hep\303\241tico ou peritonite biliar).\',\\n        communityPct: 58.7,\\n      },\\n      {\\n        letter: \'C\',\\n        text: \'Grau III (Grave), devido \303\240 presen\303\247a de l\303\255quido pericolec\303\255stico e espessamento parietal > 4 mm.\',\\n        explanation:\\n          \'Incorreta. Grau III exige disfun\303\247\303\243o org\303\242nica (cardiovascular com droga vasoativa, neurol\303\263gica, respirat\303\263ria PaO\342\202\202/FiO\342\202\202 < 300, renal com Cr > 2,0, hep\303\241tica com RNI > 1,5 ou hematol\303\263gica com plaquetas < 100.000).\',\\n        communityPct: 8.6,\\n      },\\n      {\\n        letter: \'D\',\\n        text: \'Diagn\303\263stico apenas suspeito, necessitando de colangiorresson\303\242ncia para confirma\303\247\303\243o antes da estratifica\303\247\303\243o.\',\\n        explanation:\\n          \'Incorreta. O diagn\303\263stico definitivo pelos Crit\303\251rios de T\303\263quio \303\251 fechado com 1 crit\303\251rio A (Murphy + dor QSD) + 1 crit\303\251rio B (febre/leucocitose/PCR) + 1 crit\303\251rio C (achado ultrassonogr\303\241fico t\303\255pico).\',\\n        communityPct: 3.3,\\n      },\\n    ],\\n    gabaritoOficial: \'B\',\\n    totalRespostasComunidade: 3420,\\n    taxaAcertoGlobal: 58.7,\\n    comentarioGeral:\\n      \'Os Crit\303\251rios de T\303\263quio 2018 (TG18) s\303\243o cobrados tanto no Acesso Direto quanto no R+ de Cirurgia Geral. Para classificar rapidamente: primeiro procure disfun\303\247\303\243o org\303\242nica (Grau III); se ausente, procure sinais de gravidade local/temporal (Leuco > 18.000, > 72h, massa palp\303\241vel, gangrena/abscesso = Grau II); se nenhum estiver presente, \303\251 Grau I (Leve).\',\\n    perolaClinica:\\n      \'TG18 Grau II (Moderada): Leuco > 18.000 | > 72h de evolu\303\247\303\243o | Massa palp\303\241vel em QSD | Inflama\303\247\303\243o local grave (abscesso, gangrena, enfisematosa). Grau III = Disfun\303\247\303\243o org\303\242nica!\',\\n    referencias: [\\n      \'Yokoe M et al. Tokyo Guidelines 2018 (TG18): diagnostic criteria and severity grading of acute cholecystitis.\',\\n      \'Sabiston Textbook of Surgery, 21\302\252 ed., Cap. 55 (Biliary System).\',\\n    ],\\n  },\\n  {\\n    id: \'q-amrigs-2024-gineco-12\',\\n    code: \'Q-AMR24-0440\',\\n    grandeAreaId: \'ginecologia_obstetricia\',\\n    grandeArea: \'Ginecologia e Obstetr\303\255cia\',\\n    tema: \'Ginecologia\',\\n    subtema: \'Rastreamento de C\303\242ncer de Colo Uterino (INCA/MS)\',\\n    banca: \'FUNDATEC\',\\n    instituicao: \'AMRIGS\',\\n    estado: \'RS\',\\n    regiao: \'Sul\',\\n    ano: 2024,\\n    tipoProva: \'Acesso Direto\',\\n    anulada: false,\\n    desatualizada: false,\\n    enunciado:\\n      \'Mulher de 28 anos, imunocompetente, assintom\303\241tica, realiza exame citopatol\303\263gico do colo uterino de rotina cujo resultado retorna como \\\"C\303\251lulas escamosas at\303\255picas de significado indeterminado, possivelmente n\303\243o neopl\303\241sicas (ASC-US)\\\", amostra satisfat\303\263ria com epit\303\251lios escamoso, glandular e metapl\303\241sico representados. Qual \303\251 a conduta recomendada pelas Diretrizes Brasileiras para o Rastreamento do C\303\242ncer do Colo do \303\232tero (INCA/MS)?\',\\n    alternativas: [\\n      {\\n        letter: \'A\',\\n        text: \'Encaminhar imediatamente para colposcopia com bi\303\263psia dirigida.\',\\n        explanation:\\n          \'Incorreta (Principal distrator). O encaminhamento imediato para colposcopia ocorre em ASC-H, HSIL, AGC ou em pacientes imunossuprimidas com qualquer altera\303\247\303\243o. No ASC-US em imunocompetentes, repete-se a citologia.\',\\n        communityPct: 22.8,\\n      },\\n      {\\n        letter: \'B\',\\n        text: \'Repetir o exame citopatol\303\263gico em 12 meses.\',\\n        explanation:\\n          \'Correta. Nas Diretrizes do INCA/MS, a conduta frente ao resultado de ASC-US depende da faixa et\303\241ria: em mulheres < 25 anos, repetir em 3 anos; entre 25 e 29 anos, repetir em 12 meses; e em \342\211\245 30 anos, repetir em 6 meses.\',\\n        communityPct: 41.2,\\n      },\\n      {\\n        letter: \'C\',\\n        text: \'Repetir o exame citopatol\303\263gico em 6 meses.\',\\n        explanation:\\n          \'Incorreta. A repeti\303\247\303\243o em 6 meses para ASC-US aplica-se a mulheres com 30 anos ou mais. Entre 25 e 29 anos, o intervalo de repeti\303\247\303\243o \303\251 de 12 meses.\',\\n        communityPct: 30.1,\\n      },\\n      {\\n        letter: \'D\',\\n        text: \'Realizar ex\303\251rese da zona de transforma\303\247\303\243o (EZT) ambulatorial (\\\"ver e tratar\\\").\',\\n        explanation:\\n          \'Incorreta. O m\303\251todo \\\"ver e tratar\\\" aplica-se em cen\303\241rios selecionados de HSIL com colposcopia satisfat\303\263ria e achados maiores concordantes em mulheres \342\211\245 25 anos, nunca em ASC-US.\',\\n        communityPct: 5.9,\\n      },\\n    ],\\n    gabaritoOficial: \'B\',\\n    totalRespostasComunidade: 4650,\\n    taxaAcertoGlobal: 41.2,\\n    comentarioGeral:\\n      \'Esta \303\251 uma das pegadinhas de faixa et\303\241ria mais tradicionais das bancas brasileiras (especialmente AMRIGS, USP e ENARE). Em ASC-US (imunocompetente), a conduta \303\251 estratificada exatamente nos cortes de 25 e 30 anos devido \303\240 alta taxa de clareamento espont\303\242neo do HPV em mulheres jovens.\',\\n    perolaClinica:\\n      \'ASC-US (INCA/MS): < 25 anos \342\206\222 repetir em 3 anos | 25 a 29 anos \342\206\222 repetir em 12 meses | \342\211\245 30 anos \342\206\222 repetir em 6 meses. Se persistir na repeti\303\247\303\243o \342\206\222 Colposcopia!\',\\n    referencias: [\\n      \'INCA / Minist\303\251rio da Sa\303\272de \342\200\224 Diretrizes Brasileiras para o Rastreamento do C\303\242ncer do Colo do \303\232tero, 2\302\252 ed.\',\\n      \'FEBRASGO \342\200\224 Tratado de Ginecologia.\',\\n    ],\\n  },\\n  {\\n    id: \'q-uepa-2024-ped-13\',\\n    code: \'Q-UEP24-0227\',\\n    grandeAreaId: \'pediatria\',\\n    grandeArea: \'Pediatria\',\\n    tema: \'Infectopediatria\',\\n    subtema: \'Bronquiolite Viral Aguda\',\\n    banca: \'UEPA\',\\n    instituicao: \'UEPA\',\\n    estado: \'PA\',\\n    regiao: \'Norte\',\\n    ano: 2024,\\n    tipoProva: \'Acesso Direto\',\\n    anulada: false,\\n    desatualizada: false,\\n    enunciado:\\n      \'Lactente de 5 meses, previamente h\303\255gido e nascido a termo, \303\251 levado \303\240 emerg\303\252ncia com hist\303\263ria de coriza hialina e febre baixa h\303\241 3 dias, evoluindo hoje com tosse, taquipneia e dificuldade para mamar. Ao exame f\303\255sico: ativo, hidratado, FR 58 irpm, tiragem subcostal leve, SpO\342\202\202 94% em ar ambiente, ausculta pulmonar com sibilos expirat\303\263rios difusos e crepita\303\247\303\265es finas bilaterais. \303\211 o primeiro epis\303\263dio de sibil\303\242ncia. Qual \303\251 a conduta terap\303\252utica baseada nas melhores evid\303\252ncias atuais (AAP/SBP)?\',\\n    alternativas: [\\n      {\\n        letter: \'A\',\\n        text: \'Prednisolona oral 1 mg/kg/dia por 5 dias associada a salbutamol inalat\303\263rio de 4/4h.\',\\n        explanation:\\n          \'Incorreta (Principal distrator). Corticosteroides sist\303\252micos e broncodilatadores de rotina N\303\203O demonstram benef\303\255cio na redu\303\247\303\243o de interna\303\247\303\243o ou tempo de doen\303\247a na bronquiolite viral aguda t\303\255pica.\',\\n        communityPct: 20.5,\\n      },\\n      {\\n        letter: \'B\',\\n        text: \'Medidas de suporte: lavagem nasal com solu\303\247\303\243o salina, manuten\303\247\303\243o da hidrata\303\247\303\243o/oferta nutricional fracionada e orienta\303\247\303\265es de sinais de alarme (sem broncodilatador ou corticoide de rotina).\',\\n        explanation:\\n          \'Correta. O quadro cl\303\255nico \303\251 cl\303\241ssico de Bronquiolite Viral Aguda (VSR como principal agente): primeiro epis\303\263dio de sibil\303\242ncia em lactente < 2 anos ap\303\263s pr\303\263dromos catarrais. Com SpO\342\202\202 94% (\342\211\245 90\342\200\22392%), bom estado geral e sem desconforto grave, o manejo \303\251 exclusivamente de suporte (desobstru\303\247\303\243o nasal, hidrata\303\247\303\243o e vigil\303\242ncia).\',\\n        communityPct: 70.3,\\n      },\\n      {\\n        letter: \'C\',\\n        text: \'Iniciar amoxicilina 50 mg/kg/dia devido \303\240 presen\303\247a de crepita\303\247\303\265es finas bilaterais sugestivas de pneumonia bacteriana.\',\\n        explanation:\\n          \'Incorreta. Crepita\303\247\303\265es finas difusas associadas a sibilos s\303\243o achados auscultat\303\263rios habituais da pr\303\263pria bronquiolite viral e n\303\243o indicam antibi\303\263tico.\',\\n        communityPct: 4.8,\\n      },\\n      {\\n        letter: \'D\',\\n        text: \'Oxigenoterapia em cateter nasal imediata para manter SpO\342\202\202 \342\211\245 98% e fisioterapia respirat\303\263ria com tapotagem.\',\\n        explanation:\\n          \'Incorreta. Oxig\303\252nio suplementar \303\251 indicado geralmente quando SpO\342\202\202 < 90\342\200\22392%, e manobras convencionais de fisioterapia (tapotagem/vibra\303\247\303\243o) n\303\243o s\303\243o recomendadas na fase aguda da BVA.\',\\n        communityPct: 4.4,\\n      },\\n    ],\\n    gabaritoOficial: \'B\',\\n    totalRespostasComunidade: 3780,\\n    taxaAcertoGlobal: 70.3,\\n    comentarioGeral:\\n      \'Na Bronquiolite Viral Aguda, a prova avalia se o candidato sabe \\\"o que N\303\203O fazer\\\". Evitar prescri\303\247\303\265es desnecess\303\241rias (corticoide, beta-2 agonista de rotina, antibi\303\263tico, radiografia de t\303\263rax em casos t\303\255picos leves) \303\251 o foco central das diretrizes da SBP e da Academia Americana de Pediatria.\',\\n    perolaClinica:\\n      \'Bronquiolite Viral Aguda (VSR): diagn\303\263stico CL\303\215NICO! Tratamento = Suporte (lavagem nasal + hidrata\303\247\303\243o + O\342\202\202 apenas se SpO\342\202\202 < 90\342\200\22392%). N\303\203O fazer corticoide, broncodilatador ou ATB de rotina.\',\\n    referencias: [\\n      \'Sociedade Brasileira de Pediatria \342\200\224 Diretrizes para o Manejo da Infec\303\247\303\243o Causada pelo V\303\255rus Sincicial Respirat\303\263rio.\',\\n      \'Ralston SL et al. Clinical Practice Guideline: The Diagnosis, Management, and Prevention of Bronchiolitis (AAP).\',\\n    ],\\n  },\\n  {\\n    id: \'q-revalida-2025-ped-14\',\\n    code: \'Q-REV25-0108\',\\n    grandeAreaId: \'pediatria\',\\n    grandeArea: \'Pediatria\',\\n    tema: \'Puericultura / Imuniza\303\247\303\265es\',\\n    subtema: \'Calend\303\241rio Vacinal PNI e Contraindica\303\247\303\265es\',\\n    banca: \'INEP\',\\n    instituicao: \'Revalida\',\\n    estado: \'BR\',\\n    regiao: \'Nacional\',\\n    ano: 2025,\\n    tipoProva: \'Revalida\',\\n    anulada: false,\\n    desatualizada: false,\\n    enunciado:\\n      \'Lactente de 4 meses \303\251 trazido \303\240 Unidade B\303\241sica de Sa\303\272de para atualiza\303\247\303\243o vacinal. A m\303\243e relata que, 18 horas ap\303\263s receber a primeira dose das vacinas de rotina aos 2 meses, a crian\303\247a apresentou epis\303\263dio s\303\272bito de palidez cut\303\242nea, hipotonia generalizada e diminui\303\247\303\243o da responsividade com dura\303\247\303\243o de 15 minutos, evoluindo com recupera\303\247\303\243o espont\303\242nea e completa ap\303\263s avalia\303\247\303\243o no pronto-socorro. Sem outras comorbidades. Qual \303\251 a orienta\303\247\303\243o correta quanto \303\240 vacina pentavalente (DTP + Hib + Hepatite B) nesta consulta?\',\\n    alternativas: [\\n      {\\n        letter: \'A\',\\n        text: \'Contraindicar definitivamente qualquer vacina contra difteria, t\303\251tano e coqueluche pelo risco de encefalopatia p\303\263s-vacinal.\',\\n        explanation:\\n          \'Incorreta. O quadro descrito \303\251 um Epis\303\263dio Hipot\303\264nico-Hiporresponsivo (EHH), e n\303\243o encefalopatia. N\303\243o contraindica vacina\303\247\303\243o contra difteria/t\303\251tano e permite esquema acelular (DTPa).\',\\n        communityPct: 11.2,\\n      },\\n      {\\n        letter: \'B\',\\n        text: \'Substituir o componente pertussis de c\303\251lulas inteiras pela vacina DTP acelular (DTPa), dispon\303\255vel via CRIE, mantendo o esquema para Hib e Hepatite B.\',\\n        explanation:\\n          \'Correta. A crian\303\247a apresentou Epis\303\263dio Hipot\303\264nico-Hiporresponsivo (EHH) dentro de 48h ap\303\263s a vacina pentavalente (atribu\303\255do principalmente ao componente pertussis de c\303\251lulas inteiras). Segundo o Manual de Vigil\303\242ncia Epidemiol\303\263gica de Eventos Supostamente Atribu\303\255veis \303\240 Vacina\303\247\303\243o (ESAVI/PNI), a conduta \303\251 substituir DTP por DTPa (acelular) via CRIE nas doses subsequentes (ou penta/hexa acelular conforme disponibilidade do CRIE).\',\\n        communityPct: 63.5,\\n      },\\n      {\\n        letter: \'C\',\\n        text: \'Administrar normalmente a vacina pentavalente de c\303\251lulas inteiras associada a paracetamol profil\303\241tico 1 hora antes.\',\\n        explanation:\\n          \'Incorreta (Principal distrator). Embora febre alta ou choro persistente n\303\243o contraindiquem a DTP de c\303\251lulas inteiras, o EHH e a convuls\303\243o febril/afebril p\303\263s-DTP s\303\243o indica\303\247\303\265es formais de troca para DTPa no CRIE.\',\\n        communityPct: 17.8,\\n      },\\n      {\\n        letter: \'D\',\\n        text: \'Substituir pela vacina dupla infantil (DT \342\200\224 sem componente pertussis), pois a DTPa tamb\303\251m \303\251 contraindicada no EHH.\',\\n        explanation:\\n          \'Incorreta. A DT (remo\303\247\303\243o total do componente pertussis) \303\251 reservada para ENCEFALOPATIA aguda ocorrida at\303\251 7 dias ap\303\263s a dose anterior de DTP/pentavalente.\',\\n        communityPct: 7.5,\\n      },\\n    ],\\n    gabaritoOficial: \'B\',\\n    totalRespostasComunidade: 4120,\\n    taxaAcertoGlobal: 63.5,\\n    comentarioGeral:\\n      \'Tema cl\303\241ssico e recorrente tanto no Revalida INEP quanto no ENARE e SUS-SP. Saber diferenciar quando trocar DTP por DTPa (acelular) versus quando trocar por DT (sem pertussis) garante acertos certos em imuniza\303\247\303\265es.\',\\n    perolaClinica:\\n      \'ESAVI p\303\263s-Pentavalente: EHH (at\303\251 48h) ou Convuls\303\243o (at\303\251 72h) \342\206\222 trocar para DTPa (CRIE). Encefalopatia (at\303\251 7 dias) \342\206\222 trocar para DT (retira pertussis).\',\\n    referencias: [\\n      \'Minist\303\251rio da Sa\303\272de \342\200\224 Manual dos Centros de Refer\303\252ncia para Imunobiol\303\263gicos Especiais (CRIE), 6\302\252 ed. (2023).\',\\n      \'Minist\303\251rio da Sa\303\272de \342\200\224 Manual de Vigil\303\242ncia Epidemiol\303\263gica de Eventos Adversos P\303\263s-Vacina\303\247\303\243o.\',\\n    ],\\n  },\\n  {\\n    id: \'q-sussp-2024-sus-15\',\\n    code: \'Q-SUS24-0901\',\\n    grandeAreaId: \'medicina_preventiva\',\\n    grandeArea: \'Medicina Preventiva e Social\',\\n    tema: \'Pol\303\255ticas de Sa\303\272de / SUS\',\\n    subtema: \'Princ\303\255pios Doutrin\303\241rios, Organizativos e Aten\303\247\303\243o Prim\303\241ria\',\\n    banca: \'VUNESP\',\\n    instituicao: \'SUS-SP\',\\n    estado: \'SP\',\\n    regiao: \'Sudeste\',\\n    ano: 2024,\\n    tipoProva: \'Acesso Direto\',\\n    anulada: false,\\n    desatualizada: false,\\n    enunciado:\\n      \'Uma equipe da Estrat\303\251gia Sa\303\272de da Fam\303\255lia (ESF) identifica em seu territ\303\263rio adscrito um aumento expressivo de casos de hipertens\303\243o descompensada entre trabalhadores rurais com baixa escolaridade. Para enfrentar o problema, a equipe reorganiza a agenda criando um turno estendido noturno para esse grupo espec\303\255fico, promove visitas domiciliares com agentes comunit\303\241rios e articula o encaminhamento regulado dos casos com les\303\243o de \303\263rg\303\243o-alvo para o ambulat\303\263rio de cardiologia regional, mantendo o v\303\255nculo cont\303\255nuo na UBS. Quais princ\303\255pios do SUS e atributos da Aten\303\247\303\243o Prim\303\241ria \303\240 Sa\303\272de (Starfield) est\303\243o mais diretamente exemplificados nessa a\303\247\303\243o?\',\\n    alternativas: [\\n      {\\n        letter: \'A\',\\n        text: \'Universalidade como princ\303\255pio organizativo e focaliza\303\247\303\243o seletiva como atributo essencial da APS.\',\\n        explanation:\\n          \'Incorreta. Universalidade \303\251 princ\303\255pio doutrin\303\241rio (n\303\243o organizativo), e focaliza\303\247\303\243o seletiva n\303\243o faz parte dos atributos essenciais de Starfield.\',\\n        communityPct: 6.4,\\n      },\\n      {\\n        letter: \'B\',\\n        text: \'Equidade, integralidade e regionaliza\303\247\303\243o/hierarquiza\303\247\303\243o do SUS; acesso de primeiro contato, longitudinalidade e coordena\303\247\303\243o do cuidado na APS.\',\\n        explanation:\\n          \'Correta. Oferecer hor\303\241rio diferenciado a um grupo vulner\303\241vel exemplifica a EQUIDADE (tratar desigualmente os desiguais na medida de suas necessidades); articular aten\303\247\303\243o b\303\241sica e especializada demonstra INTEGRALIDADE e HIERARQUIZA\303\207\303\203O; ampliar o turno facilita o ACESSO; manter o v\303\255nculo cont\303\255nuo traduz LONGITUDINALIDADE; e regular o cuidado junto ao especialista representa COORDENA\303\207\303\203O DO CUIDADO.\',\\n        communityPct: 78.6,\\n      },\\n      {\\n        letter: \'C\',\\n        text: \'Descentraliza\303\247\303\243o administrativa exclusivamente, com \303\252nfase no atributo derivado de orienta\303\247\303\243o hospitaloc\303\252ntrica.\',\\n        explanation:\\n          \'Incorreta. A APS op\303\265e-se ao modelo hospitaloc\303\252ntrico, e os atributos derivados de Starfield s\303\243o orienta\303\247\303\243o familiar, orienta\303\247\303\243o comunit\303\241ria e compet\303\252ncia cultural.\',\\n        communityPct: 3.2,\\n      },\\n      {\\n        letter: \'D\',\\n        text: \'Igualdade estrita (mesma oferta de hor\303\241rio para todos) e desvincula\303\247\303\243o da UBS ap\303\263s encaminhamento \303\240 cardiologia.\',\\n        explanation:\\n          \'Incorreta (Principal distrator). Tratar todos de forma id\303\252ntica ignorando barreiras de acesso fere a equidade, e perder o v\303\255nculo ao encaminhar rompe a coordena\303\247\303\243o do cuidado e a longitudinalidade.\',\\n        communityPct: 11.8,\\n      },\\n    ],\\n    gabaritoOficial: \'B\',\\n    totalRespostasComunidade: 5640,\\n    taxaAcertoGlobal: 78.6,\\n    comentarioGeral:\\n      \'Os atributos da Aten\303\247\303\243o Prim\303\241ria descritos por B\303\241rbara Starfield (4 essenciais: Acesso de primeiro contato, Longitudinalidade, Integralidade, Coordena\303\247\303\243o do cuidado; 3 derivados: Orienta\303\247\303\243o familiar, Orienta\303\247\303\243o comunit\303\241ria, Compet\303\252ncia cultural) integrados aos princ\303\255pios da Lei 8.080/90 s\303\243o presen\303\247a garantida em praticamente todas as provas de Medicina Preventiva.\',\\n    perolaClinica:\\n      \'4 Atributos Essenciais da APS (Starfield): Acesso \302\267 Longitudinalidade \302\267 Integralidade \302\267 Coordena\303\247\303\243o. 3 Derivados: Orienta\303\247\303\243o Familiar \302\267 Orienta\303\247\303\243o Comunit\303\241ria \302\267 Compet\303\252ncia Cultural.\',\\n    referencias: [\\n      \'Starfield B. Aten\303\247\303\243o Prim\303\241ria: equil\303\255brio entre necessidades de sa\303\272de, servi\303\247os e tecnologia (UNESCO/MS).\',\\n      \'Brasil \342\200\224 Lei n\302\272 8.080/1990 e Pol\303\255tica Nacional de Aten\303\247\303\243o B\303\241sica (PNAB).\',\\n    ],\\n  },\\n  {\\n    id: \'q-psumg-2023-vigilancia-16\',\\n    code: \'Q-PSU23-0551\',\\n    grandeAreaId: \'medicina_preventiva\',\\n    grandeArea: \'Medicina Preventiva e Social\',\\n    tema: \'Vigil\303\242ncia em Sa\303\272de\',\\n    subtema: \'Doen\303\247as de Notifica\303\247\303\243o Compuls\303\263ria Imediata (SINAN)\',\\n    banca: \'AREMG\',\\n    instituicao: \'PSU-MG\',\\n    estado: \'MG\',\\n    regiao: \'Sudeste\',\\n    ano: 2023,\\n    tipoProva: \'Acesso Direto\',\\n    anulada: false,\\n    desatualizada: false,\\n    enunciado:\\n      \'Durante plant\303\243o em unidade de pronto atendimento, o m\303\251dico atende quatro pacientes distintos: (1) Suspeita de sarampo em crian\303\247a n\303\243o vacinada; (2) Caso confirmado de tuberculose pulmonar bacil\303\255fera; (3) Suspeita de meningite meningoc\303\263cica em universit\303\241rio; (4) Diagn\303\263stico de s\303\255filis adquirida em adulto assintom\303\241tico. Segundo a Lista Nacional de Notifica\303\247\303\243o Compuls\303\263ria do Minist\303\251rio da Sa\303\272de, quais casos exigem notifica\303\247\303\243o IMEDIATA (em at\303\251 24 horas)?\',\\n    alternativas: [\\n      {\\n        letter: \'A\',\\n        text: \'Apenas os casos 1 (sarampo) e 3 (meningite meningoc\303\263cica).\',\\n        explanation:\\n          \'Correta. Sarampo (doen\303\247a exantem\303\241tica em plano de elimina\303\247\303\243o/erradica\303\247\303\243o) e doen\303\247a meningoc\303\263cica (risco de surtos e necessidade imediata de quimioprofilaxia de contatos) exigem notifica\303\247\303\243o compuls\303\263ria IMEDIATA em at\303\251 24h. Tuberculose e s\303\255filis adquirida s\303\243o de notifica\303\247\303\243o semanal.\',\\n        communityPct: 66.9,\\n      },\\n      {\\n        letter: \'B\',\\n        text: \'Os casos 1 (sarampo), 2 (tuberculose) e 3 (meningite meningoc\303\263cica).\',\\n        explanation:\\n          \'Incorreta (Principal distrator). Embora a tuberculose seja uma doen\303\247a de enorme relev\303\242ncia em sa\303\272de p\303\272blica e de notifica\303\247\303\243o obrigat\303\263ria, sua periodicidade na Lista Nacional \303\251 SEMANAL, e n\303\243o imediata.\',\\n        communityPct: 24.1,\\n      },\\n      {\\n        letter: \'C\',\\n        text: \'Todos os quatro casos exigem notifica\303\247\303\243o imediata em at\303\251 24 horas.\',\\n        explanation:\\n          \'Incorreta. Tanto a tuberculose quanto a s\303\255filis adquirida possuem periodicidade semanal.\',\\n        communityPct: 5.8,\\n      },\\n      {\\n        letter: \'D\',\\n        text: \'Apenas o caso 3 (meningite meningoc\303\263cica), pois os demais aguardam confirma\303\247\303\243o laboratorial.\',\\n        explanation:\\n          \'Incorreta. A notifica\303\247\303\243o imediata de doen\303\247as como sarampo e doen\303\247a meningoc\303\263cica deve ser feita j\303\241 na SUSPEITA cl\303\255nica, sem aguardar confirma\303\247\303\243o laboratorial.\',\\n        communityPct: 3.2,\\n      },\\n    ],\\n    gabaritoOficial: \'A\',\\n    totalRespostasComunidade: 3890,\\n    taxaAcertoGlobal: 66.9,\\n    comentarioGeral:\\n      \'A Lista Nacional de Notifica\303\247\303\243o Compuls\303\263ria (Portaria de Consolida\303\247\303\243o GM/MS n\302\272 4 e atualiza\303\247\303\265es) \303\251 um cl\303\241ssico da Sa\303\272de Coletiva. Lembre-se da regra mnem\303\264nica: notifica\303\247\303\265es imediatas (\342\211\244 24h) envolvem doen\303\247as com alto potencial epid\303\252mico, gravidade/mortalidade r\303\241pida, doen\303\247as preven\303\255veis em erradica\303\247\303\243o/elimina\303\247\303\243o (sarampo, rub\303\251ola, poliomielite), acidentes por animais pe\303\247onhentos, raiva humana, viol\303\252ncia sexual/tentativa de suic\303\255dio e \303\263bitos por dengue/chikungunya/zika.\',\\n    perolaClinica:\\n      \'Notifica\303\247\303\243o IMEDIATA (\342\211\244 24h): Sarampo, Meningite meningoc\303\263cica, Raiva, Animais pe\303\247onhentos, Viol\303\252ncia sexual, Tentativa de suic\303\255dio, Botulismo, Febre amarela. Tuberculose, Hansen\303\255ase, HIV e S\303\255filis = SEMANAL!\',\\n    referencias: [\\n      \'Minist\303\251rio da Sa\303\272de \342\200\224 Lista Nacional de Notifica\303\247\303\243o Compuls\303\263ria de Doen\303\247as, Agravos e Eventos de Sa\303\272de P\303\272blica (Portaria GM/MS atualizada).\',\\n    ],\\n  },\\n  {\\n    id: \'q-usp-2021-desatualizada-17\',\\n    code: \'Q-USP21-0114\',\\n    grandeAreaId: \'clinica_medica\',\\n    grandeArea: \'Cl\303\255nica M\303\251dica\',\\n    tema: \'Cardiologia\',\\n    subtema: \'Insufici\303\252ncia Card\303\255aca com Fra\303\247\303\243o de Eje\303\247\303\243o Reduzida\',\\n    banca: \'FUVEST\',\\n    instituicao: \'USP-SP\',\\n    estado: \'SP\',\\n    regiao: \'Sudeste\',\\n    ano: 2021,\\n    tipoProva: \'Acesso Direto\',\\n    anulada: false,\\n    desatualizada: true,\\n    enunciado:\\n      \'[Quest\303\243o marcada como Desatualizada pela mudan\303\247a nas diretrizes de IC] Paciente de 64 anos com ICFER (FEVE 30%), classe funcional NYHA II, sem diabetes mellitus, j\303\241 em uso otimizado de enalapril, carvedilol e espironolactona. Segundo o protocolo vigente \303\240 \303\251poca da prova (2021), qual classe n\303\243o era considerada terapia modificadora de mortalidade obrigat\303\263ria de primeira linha para pacientes n\303\243o diab\303\251ticos?\',\\n    alternativas: [\\n      {\\n        letter: \'A\',\\n        text: \'Betabloqueadores cardiosseletivos (bisoprolol ou succinato de metoprolol).\',\\n        explanation: \'Incorreta. Betabloqueadores j\303\241 constitu\303\255am pilar cl\303\241ssico de redu\303\247\303\243o de mortalidade na ICFER.\',\\n        communityPct: 8.4,\\n      },\\n      {\\n        letter: \'B\',\\n        text: \'Antagonistas do receptor mineralocorticoide (espironolactona).\',\\n        explanation: \'Incorreta. A espironolactona j\303\241 era recomendada em NYHA II-IV com FEVE \342\211\244 35%.\',\\n        communityPct: 11.2,\\n      },\\n      {\\n        letter: \'C\',\\n        text: \'Inibidores de SGLT2 (dapagliflozina/empagliflozina) como parte da terapia qu\303\241drupla inicial obrigat\303\263ria.\',\\n        explanation:\\n          \'Correta (Hist\303\263rica \342\200\224 Desatualizada). Hoje, nas diretrizes SBC/ESC/AHA atuais, os iSGLT2 s\303\243o pilar obrigat\303\263rio da terapia qu\303\241drupla da ICFER independentemente da presen\303\247a de diabetes mellitus. Esta quest\303\243o permanece sinalizada como desatualizada para fins de filtro.\',\\n        communityPct: 37.8,\\n      },\\n      {\\n        letter: \'D\',\\n        text: \'Inibidores da enzima conversora de angiotensina (IECA).\',\\n        explanation: \'Incorreta (Principal distrator). IECAs s\303\243o pilares consagrados desde a d\303\251cada de 1990.\',\\n        communityPct: 42.6,\\n      },\\n    ],\\n    gabaritoOficial: \'C\',\\n    totalRespostasComunidade: 2140,\\n    taxaAcertoGlobal: 37.8,\\n    comentarioGeral:\\n      \'Aten\303\247\303\243o: quest\303\243o mantida no banco com a marca\303\247\303\243o de DESATUALIZADA. Atualmente, os quatro pilares fundamentais da ICFER (independentemente de diabetes) s\303\243o: INRA (ou IECA), Betabloqueador, Antagonista Mineralocorticoide e iSGLT2.\',\\n    perolaClinica:\\n      \'Diretriz Atual de ICFER: Terapia Qu\303\241drupla precoce \342\200\224 INRA/IECA + Betabloqueador + Espironolactona + iSGLT2 (dapagliflozina ou empagliflozina), mesmo SEM diabetes!\',\\n    referencias: [\\n      \'Atualiza\303\247\303\243o de T\303\263picos Emergentes da Diretriz Brasileira de Insufici\303\252ncia Card\303\255aca \342\200\224 SBC.\',\\n    ],\\n  },\\n  {\\n    id: \'q-enare-2023-anulada-18\',\\n    code: \'Q-ENR23-0774\',\\n    grandeAreaId: \'cirurgia_geral\',\\n    grandeArea: \'Cirurgia Geral\',\\n    tema: \'Abdome Agudo\',\\n    subtema: \'Apendicite Aguda e Escore de Alvarado\',\\n    banca: \'INSTITUTO AOCP\',\\n    instituicao: \'ENARE\',\\n    estado: \'BR\',\\n    regiao: \'Nacional\',\\n    ano: 2023,\\n    tipoProva: \'Acesso Direto\',\\n    anulada: true,\\n    desatualizada: false,\\n    enunciado:\\n      \'[Quest\303\243o Anulada pela Banca Oficial] Paciente masculino de 22 anos apresenta dor periumbilical com migra\303\247\303\243o para fossa il\303\255aca direita h\303\241 18 horas, n\303\241useas, febre de 37,8 \302\260C, dor \303\240 descompress\303\243o brusca em ponto de McBurney e leucocitose de 13.400/mm\302\263 com neutrofilia. Sobre o escore de Alvarado e a indica\303\247\303\243o de exames de imagem, assinale a alternativa correta.\',\\n    alternativas: [\\n      {\\n        letter: \'A\',\\n        text: \'O paciente soma 8 pontos no escore de Alvarado, indicando alta probabilidade de apendicite aguda.\',\\n        explanation:\\n          \'Gabarito preliminar. A quest\303\243o foi posteriormente anulada pela banca devido \303\240 ambiguidade na descri\303\247\303\243o do crit\303\251rio de desvio \303\240 esquerda versus neutrofilia (>75%) no enunciado.\',\\n        communityPct: 39.5,\\n      },\\n      {\\n        letter: \'B\',\\n        text: \'A tomografia computadorizada de abdome \303\251 formalmente contraindicada em homens jovens com suspeita de apendicite.\',\\n        explanation:\\n          \'Incorreta. A TC tem elevada acur\303\241cia (>95%) e pode ser utilizada em casos duvidosos.\',\\n        communityPct: 27.1,\\n      },\\n      {\\n        letter: \'C\',\\n        text: \'A migra\303\247\303\243o da dor e a febre valem 2 pontos cada no escore de Alvarado.\',\\n        explanation:\\n          \'Incorreta (Principal distrator). Os \303\272nicos itens que valem 2 pontos no escore de Alvarado (MANTRELS) s\303\243o dor em FID (Tenderness) e Leucocitose > 10.000.\',\\n        communityPct: 28.4,\\n      },\\n      {\\n        letter: \'D\',\\n        text: \'A antibioticoterapia exclusiva substitui a apendicectomia em todos os casos n\303\243o perfurados no Brasil.\',\\n        explanation:\\n          \'Incorreta. A apendicectomia laparosc\303\263pica permanece como tratamento padr\303\243o-ouro na maioria dos casos.\',\\n        communityPct: 5.0,\\n      },\\n    ],\\n    gabaritoOficial: \'A\',\\n    totalRespostasComunidade: 1950,\\n    taxaAcertoGlobal: 39.5,\\n    comentarioGeral:\\n      \'Quest\303\243o oficialmente anulada pela banca organizadora por imprecis\303\243o na pontua\303\247\303\243o do desvio \303\240 esquerda no escore MANTRELS. Utilize o filtro \\\"Excluir anuladas/desatualizadas\\\" no painel superior quando desejar treinar apenas quest\303\265es v\303\241lidas.\',\\n    perolaClinica:\\n      \'Escore de Alvarado (MANTRELS \342\200\224 10 pontos): apenas Dor em FID (2 pts) e Leucocitose (2 pts) valem 2 pontos; todos os outros 6 itens valem 1 ponto cada.\',\\n    referencias: [\\n      \'Sabiston Textbook of Surgery, 21\302\252 ed., Cap. 51 (The Appendix).\',\\n    ],\\n  },\\n];\\n\", \"Description\":\"Create 14 deeply authentic Brazilian Medical Residency questions across all 5 Grandes \303\201reas with clinical images, lab tables, option-level community stats, and structured didactic commentaries\", \"Overwrite\":true, \"TargetFile\":\"/src/data/questions.ts\", \"toolAction\":\"Creating medical question dataset\", \"toolSummary\":\"Create medical question bank data\"}"
      original_name: "write_to_file"
    }
