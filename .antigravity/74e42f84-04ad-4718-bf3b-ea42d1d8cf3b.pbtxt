            }
            lines {
              text: "    ano: 2023,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    tipoProva: \'Acesso Direto\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    anulada: false,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    desatualizada: false,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    enunciado:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Durante plant\303\243o em unidade de pronto atendimento, o m\303\251dico atende quatro pacientes distintos: (1) Suspeita de sarampo em crian\303\247a n\303\243o vacinada; (2) Caso confirmado de tuberculose pulmonar bacil\303\255fera; (3) Suspeita de meningite meningoc\303\263cica em universit\303\241rio; (4) Diagn\303\263stico de s\303\255filis adquirida em adulto assintom\303\241tico. Segundo a Lista Nacional de Notifica\303\247\303\243o Compuls\303\263ria do Minist\303\251rio da Sa\303\272de, quais casos exigem notifica\303\247\303\243o IMEDIATA (em at\303\251 24 horas)?\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    alternativas: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        letter: \'A\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        text: \'Apenas os casos 1 (sarampo) e 3 (meningite meningoc\303\263cica).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        explanation:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Correta. Sarampo (doen\303\247a exantem\303\241tica em plano de elimina\303\247\303\243o/erradica\303\247\303\243o) e doen\303\247a meningoc\303\263cica (risco de surtos e necessidade imediata de quimioprofilaxia de contatos) exigem notifica\303\247\303\243o compuls\303\263ria IMEDIATA em at\303\251 24h. Tuberculose e s\303\255filis adquirida s\303\243o de notifica\303\247\303\243o semanal.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        communityPct: 66.9,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        letter: \'B\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        text: \'Os casos 1 (sarampo), 2 (tuberculose) e 3 (meningite meningoc\303\263cica).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        explanation:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Incorreta (Principal distrator). Embora a tuberculose seja uma doen\303\247a de enorme relev\303\242ncia em sa\303\272de p\303\272blica e de notifica\303\247\303\243o obrigat\303\263ria, sua periodicidade na Lista Nacional \303\251 SEMANAL, e n\303\243o imediata.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        communityPct: 24.1,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        letter: \'C\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        text: \'Todos os quatro casos exigem notifica\303\247\303\243o imediata em at\303\251 24 horas.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        explanation:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Incorreta. Tanto a tuberculose quanto a s\303\255filis adquirida possuem periodicidade semanal.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        communityPct: 5.8,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        letter: \'D\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        text: \'Apenas o caso 3 (meningite meningoc\303\263cica), pois os demais aguardam confirma\303\247\303\243o laboratorial.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        explanation:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Incorreta. A notifica\303\247\303\243o imediata de doen\303\247as como sarampo e doen\303\247a meningoc\303\263cica deve ser feita j\303\241 na SUSPEITA cl\303\255nica, sem aguardar confirma\303\247\303\243o laboratorial.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        communityPct: 3.2,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
