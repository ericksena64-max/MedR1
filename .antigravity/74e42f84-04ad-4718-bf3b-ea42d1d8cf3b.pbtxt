        replacement_content: "  const handleResetBoard = () => {\n    resetBoardWeights(activeBoard);\n    notifyUpdate(`Padr\303\243o da banca ${EXAM_BOARD_LABELS[activeBoard]} restaurado.`);\n  };\n\n  const handleRecalculatePareto = () => {\n    const result = recalculateBoardWeightsFromPareto(activeBoard);\n    const boardLabel = EXAM_BOARD_LABELS[activeBoard];\n    if (result.usedFallback) {\n      notifyUpdate(\n        `${boardLabel}: ${result.totalQuestions}/${PARETO_MIN_QUESTIONS} quest\303\265es no banco \342\200\224 mantida a matriz padr\303\243o (fallback).`\n      );\n    } else {\n      notifyUpdate(\n        `Pareto 80/20 recalculado com ${result.totalQuestions} quest\303\265es do banco (${boardLabel}).`\n      );\n    }\n  };\n\n  const activeCustomCount = boardCustomCounts[activeBoard];"
