  code_action {
    action_spec {
      create_file {
        instruction: "import React from \'react\';\nimport {\n  BookOpenCheck,\n  BarChart3,\n  Trophy,\n  BookmarkCheck,\n  Layers,\n  X,\n  Stethoscope,\n  ShieldCheck,\n  PanelLeftClose,\n  PanelLeftOpen,\n} from \'lucide-react\';\nimport type { ActiveTab, UserProfile } from \'../../types/medical\';\nimport { cn } from \'../../lib/utils\';\n\ninterface SidebarProps {\n  activeTab: ActiveTab;\n  onSelectTab: (tab: ActiveTab) => void;\n  profile: UserProfile;\n  errorNotebookCount: number;\n  dueFlashcardsCount: number;\n  onlineTotal: number;\n  currentUserRank: number;\n  collapsed: boolean;\n  onToggleCollapse: () => void;\n  rankingPulseOn: boolean;\n  onToggleRankingPulse: (next?: boolean) => void;\n  mobileOpen: boolean;\n  onCloseMobile: () => void;\n}\n\nexport function Sidebar({\n  activeTab,\n  onSelectTab,\n  profile,\n  errorNotebookCount,\n  dueFlashcardsCount,\n  onlineTotal,\n  currentUserRank,\n  collapsed,\n  onToggleCollapse,\n  rankingPulseOn,\n  onToggleRankingPulse,\n  mobileOpen,\n  onCloseMobile,\n}: SidebarProps) {\n  const navItems: Array<{\n    id: ActiveTab;\n    label: string;\n    icon: React.ComponentType<{ className?: string }>;\n    meta?: string;\n    highlightMeta?: boolean;\n  }> = [\n    {\n      id: \'questoes\',\n      label: \'Banco de Quest\303\265es\',\n      icon: BookOpenCheck,\n    },\n    {\n      id: \'desempenho\',\n      label: \'Desempenho & Mediana\',\n      icon: BarChart3,\n    },\n    {\n      id: \'ranking\',\n      label: \'Ranking Ao Vivo\',\n      icon: Trophy,\n      meta: `#${currentUserRank}`,\n    },\n    {\n      id: \'caderno_erros\',\n      label: \'Caderno de Erros\',\n      icon: BookmarkCheck,\n      meta: String(errorNotebookCount),\n    },\n    {\n      id: \'flashcards\',\n      label: \'Flashcards\',\n      icon: Layers,\n      meta: dueFlashcardsCount > 0 ? `${dueFlashcardsCount} hoje` : \'0\',\n      highlightMeta: dueFlashcardsCount > 0,\n    },\n  ];\n\n  const displayName = profile.usePseudonym ? profile.pseudonym : profile.realName;\n\n  const renderSidebarContent = (isCompact: boolean) => (\n    <div className=\"flex h-full flex-col bg-white dark:bg-[#0B1220] border-r border-slate-200 dark:border-slate-800\">\n      {/* Brand mark + Retractable Collapse Toggle */}\n      <div\n        className={cn(\n          \'flex h-16 items-center border-b border-slate-200 dark:border-slate-800\',\n          isCompact ? \'justify-center px-2\' : \'justify-between px-4\'\n        )}\n      >\n        {!isCompact && (\n          <button\n            type=\"button\"\n            onClick={() => {\n              onSelectTab(\'questoes\');\n              onCloseMobile();\n            }}\n            className=\"flex items-center gap-2.5 text-left focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-500 rounded-md cursor-pointer\"\n          >\n            <div className=\"flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-sky-600 text-white dark:bg-sky-500 dark:text-slate-950\">\n              <Stethoscope className=\"h-4 w-4\" aria-hidden=\"true\" />\n            </div>\n            <span className=\"font-display text-lg font-bold tracking-tight text-slate-900 dark:text-white whitespace-nowrap\">\n              MedR1\n            </span>\n          </button>\n        )}\n\n        {/* Desktop collapse/expand toggle */}\n        <button\n          type=\"button\"\n          onClick={onToggleCollapse}\n          aria-label={isCompact ? \'Expandir aba lateral\' : \'Recolher aba lateral\'}\n          title={isCompact ? \'Expandir aba lateral\' : \'Recolher aba lateral\'}\n          className=\"hidden lg:inline-flex items-center justify-center rounded-lg p-1.5 text-slate-500 hover:bg-slate-100 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-slate-100 transition-colors cursor-pointer\"\n        >\n          {isCompact ? (\n            <PanelLeftOpen className=\"h-4 w-4\" />\n          ) : (\n            <PanelLeftClose className=\"h-4 w-4\" />\n          )}\n        </button>\n\n        {/* Mobile close drawer button */}\n        <button\n          type=\"button\"\n          onClick={onCloseMobile}\n          aria-label=\"Fechar menu\"\n          className=\"lg:hidden rounded-lg p-1.5 text-slate-500 hover:bg-slate-100 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-slate-100 cursor-pointer\"\n        >\n          <X className=\"h-5 w-5\" />\n        </button>\n      </div>\n\n      {/* Navigation */}\n      <nav\n        className={cn(\n          \'flex-1 py-5 space-y-1.5 overflow-y-auto\',\n          isCompact ? \'px-2\' : \'px-3\'\n        )}\n        aria-label=\"Navega\303\247\303\243o principal\"\n      >\n        {navItems.map((item) => {\n          const Icon = item.icon;\n          const isActive = activeTab === item.id;\n          const isRanking = item.id === \'ranking\';\n\n          if (isRanking) {\n            return (\n              <div\n                key={item.id}\n                className={cn(\n                  \'rounded-lg border transition-colors\',\n                  isActive\n                    ? \'border-sky-200/80 bg-sky-50/70 dark:border-sky-900/60 dark:bg-sky-500/15\'\n                    : \'border-slate-200/70 bg-slate-50/50 dark:border-slate-800/80 dark:bg-slate-900/40\'\n                )}\n              >\n                {/* Clickable Ranking Ao Vivo Area */}\n                <button\n                  type=\"button\"\n                  onClick={() => {\n                    onSelectTab(\'ranking\');\n                    onCloseMobile();\n                  }}\n                  title={\n                    isCompact\n                      ? `Ranking Ao Vivo (#${currentUserRank} \302\267 ${onlineTotal} online)`\n                      : undefined\n                  }\n                  className={cn(\n                    \'flex w-full items-center transition-colors duration-150 cursor-pointer rounded-t-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-500\',\n                    isCompact\n                      ? \'justify-center px-2 py-2.5 relative\'\n                      : \'justify-between gap-2 px-3 py-2.5 text-sm font-medium\',\n                    isActive\n                      ? \'text-sky-700 dark:text-sky-300\'\n                      : \'text-slate-700 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white\'\n                  )}\n                >\n                  {isCompact ? (\n                    <span className=\"relative inline-flex items-center justify-center\">\n                      <Icon\n                        className={cn(\n                          \'h-4 w-4 shrink-0\',\n                          isActive\n                            ? \'text-sky-600 dark:text-sky-400\'\n                            : \'text-slate-500 dark:text-slate-400\'\n                        )}\n                      />\n                      {/* Live green dot overlay on icon */}\n                      <span\n                        className=\"absolute -top-1 -right-1.5 flex h-2.5 w-2.5\"\n                        aria-hidden=\"true\"\n                      >\n                        {rankingPulseOn && (\n                          <span className=\"absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-80\" />\n                        )}\n                        <span\n                          className={cn(\n                            \'relative inline-flex h-2.5 w-2.5 rounded-full ring-2 ring-white dark:ring-[#0B1220]\',\n                            rankingPulseOn\n                              ? \'bg-emerald-500\'\n                              : \'bg-emerald-700/45 dark:bg-emerald-500/40\'\n                          )}\n                        />\n                      </span>\n                    </span>\n                  ) : (\n                    <>\n                      <span className=\"flex items-center gap-2.5 min-w-0\">\n                        <Icon\n                          className={cn(\n                            \'h-4 w-4 shrink-0\',\n                            isActive\n                              ? \'text-sky-600 dark:text-sky-400\'\n                              : \'text-slate-400 dark:text-slate-500\'\n                          )}\n                        />\n                        <span className=\"truncate whitespace-nowrap\">\n                          {item.label}\n                        </span>\n                        {/* Blinking green live dot */}\n                        <span\n                          className=\"relative flex h-2.5 w-2.5 shrink-0\"\n                          aria-label={\n                            rankingPulseOn\n                              ? \'Indicador ao vivo piscando\'\n                              : \'Indicador ao vivo pausado\'\n                          }\n                        >\n                          {rankingPulseOn && (\n                            <span className=\"absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-80\" />\n                          )}\n                          <span\n                            className={cn(\n                              \'relative inline-flex h-2.5 w-2.5 rounded-full transition-colors\',\n                              rankingPulseOn\n                                ? \'bg-emerald-500\'\n                                : \'bg-slate-400 dark:bg-slate-600\'\n                            )}\n                          />\n                        </span>\n                      </span>\n\n                      <span className=\"font-mono text-xs tabular-nums whitespace-nowrap text-slate-500 dark:text-slate-400\">\n                        #{currentUserRank}\n                      </span>\n                    </>\n                  )}\n                </button>\n\n                {/* ON / OFF Control for Blinking Green Dot */}\n                {isCompact ? (\n                  <div className=\"border-t border-slate-200/70 dark:border-slate-800/80 px-1 py-1.5 flex justify-center\">\n                    <button\n                      type=\"button\"\n                      onClick={() => onToggleRankingPulse()}\n                      aria-pressed={rankingPulseOn}\n                      title={\n                        rankingPulseOn\n                          ? \'Pausar bolinha verde piscando (OFF)\'\n                          : \'Ativar bolinha verde piscando (ON)\'\n                      }\n                      className={cn(\n                        \'rounded px-1.5 py-0.5 font-mono text-[10px] font-bold transition-colors cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-500\',\n                        rankingPulseOn\n                          ? \'bg-emerald-100 text-emerald-800 hover:bg-emerald-200 dark:bg-emerald-950/70 dark:text-emerald-300\'\n                          : \'bg-slate-200/80 text-slate-600 hover:bg-slate-300/70 dark:bg-slate-800 dark:text-slate-400\'\n                      )}\n                    >\n                      {rankingPulseOn ? \'ON\' : \'OFF\'}\n                    </button>\n                  </div>\n                ) : (\n                  <div className=\"flex items-center justify-between gap-2 border-t border-slate-200/70 dark:border-slate-800/80 px-3 py-1.5\">\n                    <span className=\"text-[11px] text-slate-500 dark:text-slate-400 tabular-nums truncate\">\n                      {onlineTotal} online \302\267 piscar\n                    </span>\n                    <div\n                      role=\"group\"\n                      aria-label=\"Ligar ou desligar indicador piscante do Ranking Ao Vivo\"\n                      className=\"inline-flex rounded-md bg-slate-200/70 p-0.5 dark:bg-slate-800 shrink-0\"\n                    >\n                      <button\n                        type=\"button\"\n                        onClick={() => onToggleRankingPulse(true)}\n                        aria-pressed={rankingPulseOn}\n                        className={cn(\n                          \'rounded px-2 py-0.5 font-mono text-[10px] font-bold transition-colors cursor-pointer\',\n                          rankingPulseOn\n                            ? \'bg-emerald-600 text-white shadow-xs dark:bg-emerald-500 dark:text-slate-950\'\n                            : \'text-slate-500 hover:text-slate-800 dark:text-slate-400 dark:hover:text-slate-200\'\n                        )}\n                      >\n                        ON\n                      </button>\n                      <button\n                        type=\"button\"\n                        onClick={() => onToggleRankingPulse(false)}\n                        aria-pressed={!rankingPulseOn}\n                        className={cn(\n                          \'rounded px-2 py-0.5 font-mono text-[10px] font-bold transition-colors cursor-pointer\',\n                          !rankingPulseOn\n                            ? \'bg-white text-slate-800 shadow-xs dark:bg-slate-700 dark:text-white\'\n                            : \'text-slate-500 hover:text-slate-800 dark:text-slate-400 dark:hover:text-slate-200\'\n                        )}\n                      >\n                        OFF\n                      </button>\n                    </div>\n                  </div>\n                )}\n              </div>\n            );\n          }\n\n          return (\n            <button\n              key={item.id}\n              type=\"button\"\n              title={isCompact ? item.label : undefined}\n              onClick={() => {\n                onSelectTab(item.id);\n                onCloseMobile();\n              }}\n              className={cn(\n                \'flex w-full items-center rounded-lg text-sm font-medium transition-colors duration-150 cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-500\',\n                isCompact\n                  ? \'justify-center px-2 py-2.5 relative\'\n                  : \'justify-between gap-3 px-3 py-2.5\',\n                isActive\n                  ? \'bg-sky-50 text-sky-700 dark:bg-sky-500/15 dark:text-sky-300\'\n                  : \'text-slate-600 hover:bg-slate-100 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-slate-800/70 dark:hover:text-slate-100\'\n              )}\n            >\n              <span\n                className={cn(\n                  \'flex items-center min-w-0\',\n                  !isCompact && \'gap-3\'\n                )}\n              >\n                <Icon\n                  className={cn(\n                    \'h-4 w-4 shrink-0\',\n                    isActive\n                      ? \'text-sky-600 dark:text-sky-400\'\n                      : \'text-slate-400 dark:text-slate-500\'\n                  )}\n                />\n                {!isCompact && (\n                  <span className=\"truncate whitespace-nowrap\">{item.label}</span>\n                )}\n              </span>\n\n              {!isCompact && item.meta && (\n                <span\n                  className={cn(\n                    \'font-mono text-xs tabular-nums whitespace-nowrap\',\n                    item.highlightMeta\n                      ? \'font-semibold text-sky-600 dark:text-sky-400\'\n                      : \'text-slate-500 dark:text-slate-400\'\n                  )}\n                >\n                  {item.meta}\n                </span>\n              )}\n            </button>\n          );\n        })}\n      </nav>\n\n      {/* Bottom student profile summary (also opens Ranking Ao Vivo when clicked) */}\n      <div\n        className={cn(\n          \'border-t border-slate-200 dark:border-slate-800\',\n          isCompact ? \'p-2.5 flex justify-center\' : \'p-4\'\n        )}\n      >\n        <button\n          type=\"button\"\n          title={\n            isCompact\n              ? `${displayName} \302\267 Alvo: ${profile.targetInstitution}`\n              : undefined\n          }\n          onClick={() => {\n            onSelectTab(\'ranking\');\n            onCloseMobile();\n          }}\n          className={cn(\n            \'flex items-center rounded-lg text-left transition-colors hover:bg-slate-50 dark:hover:bg-slate-800/60 cursor-pointer\',\n            isCompact ? \'justify-center p-1.5\' : \'w-full gap-3 p-2\'\n          )}\n        >\n          <div className=\"flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-slate-900 text-xs font-semibold text-white dark:bg-slate-700 dark:text-slate-100\">\n            {profile.usePseudonym\n              ? profile.pseudonym.slice(0, 2).toUpperCase()\n              : profile.avatarInitials}\n          </div>\n          {!isCompact && (\n            <div className=\"min-w-0 flex-1\">\n              <div className=\"flex items-center gap-1.5\">\n                <p className=\"truncate text-sm font-semibold text-slate-900 dark:text-slate-100\">\n                  {displayName}\n                </p>\n                {profile.usePseudonym && (\n                  <ShieldCheck\n                    className=\"h-3.5 w-3.5 shrink-0 text-sky-600 dark:text-sky-400\"\n                    aria-label=\"Modo Pseud\303\264nimo ativo\"\n                  />\n                )}\n              </div>\n              <p className=\"truncate text-xs text-slate-500 dark:text-slate-400\">\n                Alvo: {profile.targetInstitution} \302\267 {onlineTotal} online\n              </p>\n            </div>\n          )}\n        </button>\n      </div>\n    </div>\n  );\n\n  return (\n    <>\n      {/* Desktop retractable persistent sidebar */}\n      <aside\n        className={cn(\n          \'hidden lg:block lg:shrink-0 h-screen sticky top-0 transition-[width] duration-200 ease-out\',\n          collapsed ? \'lg:w-[76px]\' : \'lg:w-64\'\n        )}\n      >\n        {renderSidebarContent(collapsed)}\n      </aside>\n\n      {/* Mobile retractable drawer */}\n      {mobileOpen && (\n        <div className=\"fixed inset-0 z-50 lg:hidden flex\">\n          <div\n            className=\"fixed inset-0 bg-slate-950/50 backdrop-blur-[1px]\"\n            onClick={onCloseMobile}\n            aria-hidden=\"true\"\n          />\n          <aside className=\"relative z-10 w-72 max-w-[82vw] h-full shadow-xl\">\n            {renderSidebarContent(false)}\n          </aside>\n        </div>\n      )}\n    </>\n  );\n}\n"
