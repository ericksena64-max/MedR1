              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    id: \'q-sussp-2025-infecto-10\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    code: \'Q-SUS25-0309\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    grandeAreaId: \'clinica_medica\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    grandeArea: \'Cl\303\255nica M\303\251dica\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    tema: \'Infectologia\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    subtema: \'Dengue: Classifica\303\247\303\243o de Risco e Manejo Vol\303\252mico\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    banca: \'VUNESP\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    instituicao: \'SUS-SP\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    estado: \'SP\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    regiao: \'Sudeste\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ano: 2025,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    tipoProva: \'Acesso Direto\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    anulada: false,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    desatualizada: false,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    enunciado:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Homem de 36 anos, 70 kg, no 4\302\272 dia de quadro febril agudo com diagn\303\263stico confirmado de dengue (NS1 reagente), evoluiu com defervesc\303\252ncia hoje pela manh\303\243, por\303\251m refere dor abdominal intensa e cont\303\255nua, dois epis\303\263dios de v\303\264mitos persistentes e tontura ao levantar. Ao exame: consciente, PA 112/76 mmHg em dec\303\272bito (98/68 mmHg em ortostase), FC 104 bpm, extremidades aquecidas, tempo de enchimento capilar 2 segundos, hepatomegalia dolorosa a 3 cm do rebordo costal direito. Hemograma: Hb 16,2 g/dL, Ht 49% (basal pr\303\251vio 42%), plaquetas 58.000/mm\302\263. De acordo com o Manual de Manejo Cl\303\255nico da Dengue do Minist\303\251rio da Sa\303\272de (2024), qual \303\251 a classifica\303\247\303\243o do paciente e a reposi\303\247\303\243o vol\303\252mica inicial indicada?\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    alternativas: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        letter: \'A\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        text: \'Grupo B; hidrata\303\247\303\243o oral supervisionada de 60 mL/kg/dia e libera\303\247\303\243o com retorno di\303\241rio.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        explanation:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Incorreta. A presen\303\247a de dor abdominal intensa e cont\303\255nua, v\303\264mitos persistentes, hipotens\303\243o postural, hepatomegalia > 2 cm e hemoconcentra\303\247\303\243o configura SINAIS DE ALARME, enquadrando o paciente no Grupo C (n\303\243o B).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        communityPct: 7.3,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        letter: \'B\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        text: \'Grupo C; interna\303\247\303\243o em leito de observa\303\247\303\243o/hospitalar com reposi\303\247\303\243o imediata de soro fisiol\303\263gico 0,9% 10 mL/kg na primeira hora, reavaliando cl\303\255nica e hemat\303\263crito.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        explanation:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Correta. Sinais de alarme sem choque instalado definem o Grupo C. O protocolo do Minist\303\251rio da Sa\303\272de (2024) preconiza reposi\303\247\303\243o imediata de 10 mL/kg de soro fisiol\303\263gico 0,9% na 1\302\252 hora (podendo repetir at\303\251 3 vezes se necess\303\241rio), seguida de fase de manuten\303\247\303\243o e monitoramento rigoroso de hemat\303\263crito e diurese.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        communityPct: 51.4,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        letter: \'C\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        text: \'Grupo D; expans\303\243o r\303\241pida com 20 mL/kg de solu\303\247\303\243o cristaloide em 20 minutos e transfus\303\243o profil\303\241tica de plaquetas.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        explanation:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Incorreta (Principal distrator). O esquema de 20 mL/kg em 20 minutos \303\251 destinado ao Grupo D (choque com hipotens\303\243o, press\303\243o arterial convergente \342\211\244 20 mmHg, TEC > 2s, extremidades frias ou sangramento grave/disfun\303\247\303\243o org\303\242nica). Al\303\251m disso, plaquetopenia de 58.000/mm\302\263 sem sangramento grave n\303\243o indica transfus\303\243o.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        communityPct: 33.8,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        letter: \'D\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        text: \'Grupo C; iniciar albumina humana 5% imediatamente devido ao extravasamento plasm\303\241tico evidenciado pelo hemat\303\263crito de 49%.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        explanation:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Incorreta. Coloides (como albumina) s\303\243o reservados para casos refrat\303\241rios de choque (Grupo D) que n\303\243o respondem \303\240s fases iniciais de cristaloide com hemat\303\263crito em ascens\303\243o.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        communityPct: 4.9,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        letter: \'E\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        text: \'Grupo B; transfus\303\243o de concentrado de plaquetas e observa\303\247\303\243o ambulatorial por 12 horas.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        explanation:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Incorreta. Classifica\303\247\303\243o equivocada e conduta contraindicada (transfus\303\243o desnecess\303\241ria aumenta risco de sobrecarga vol\303\252mica).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        communityPct: 2.6,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    gabaritoOficial: \'B\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    totalRespostasComunidade: 5890,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    taxaAcertoGlobal: 51.4,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    comentarioGeral:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'A edi\303\247\303\243o de 2024 do Manual de Dengue do Minist\303\251rio da Sa\303\272de unificou e refinou o protocolo de hidrata\303\247\303\243o do Grupo C: reposi\303\247\303\243o inicial de 10 mL/kg na 1\302\252 hora (antes era 20 mL/kg em 2 horas \342\200\224 o que equivalia \303\240 mesma taxa hor\303\241ria, mas agora padronizado como 10 mL/kg/h!). Diferenciar Grupo C (sinais de alarme, hemodinamicamente est\303\241vel sem choque) de Grupo D (choque / sangramento grave / disfun\303\247\303\243o org\303\242nica) \303\251 crucial.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    perolaClinica:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Dengue MS 2024: Grupo C (sinais de alarme) \342\206\222 10 mL/kg na 1\302\252 hora (SF 0,9%). Grupo D (choque/grave) \342\206\222 20 mL/kg em at\303\251 20 minutos. Plaquetopenia isolada N\303\203O indica transfus\303\243o!\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    referencias: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Minist\303\251rio da Sa\303\272de \342\200\224 Dengue: Diagn\303\263stico e Manejo Cl\303\255nico (Adulto e Crian\303\247a), 6\302\252 edi\303\247\303\243o (2024).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    id: \'q-enare-2024-cir-11\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    code: \'Q-ENR24-0815\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    grandeAreaId: \'cirurgia_geral\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    grandeArea: \'Cirurgia Geral\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    tema: \'Abdome Agudo\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    subtema: \'Colecistite Aguda Calculosa (Crit\303\251rios de T\303\263quio)\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    banca: \'INSTITUTO AOCP\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    instituicao: \'ENARE\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    estado: \'BR\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    regiao: \'Nacional\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ano: 2024,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    tipoProva: \'R+\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    anulada: false,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    desatualizada: false,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    enunciado:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Mulher de 54 anos apresenta dor em hipoc\303\264ndrio direito h\303\241 84 horas, febre de 38,4 \302\260C e sinal de Murphy positivo. Ao exame: consciente, PA 124/78 mmHg, FC 96 bpm, sem icter\303\255cia. Hemograma mostra leucocitose de 19.600/mm\302\263 com desvio \303\240 esquerda, bilirrubinas normais, creatinina 0,9 mg/dL, RNI 1,0. Ultrassonografia abdominal evidencia ves\303\255cula biliar distendida com c\303\241lculo impactado no infund\303\255bulo, espessamento parietal de 6 mm e l\303\255quido pericolec\303\255stico. Segundo os Crit\303\251rios de T\303\263quio (TG18), qual \303\251 a gravidade dessa colecistite aguda?\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    alternativas: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        letter: \'A\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        text: \'Grau I (Leve), pois n\303\243o h\303\241 disfun\303\247\303\243o org\303\242nica ou icter\303\255cia associada.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        explanation:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Incorreta (Principal distrator). Embora n\303\243o haja disfun\303\247\303\243o org\303\242nica (que definiria Grau III), a paciente apresenta dois crit\303\251rios claros de Grau II (Moderada): leucocitose > 18.000/mm\302\263 e dura\303\247\303\243o dos sintomas > 72 horas.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        communityPct: 29.4,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        letter: \'B\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        text: \'Grau II (Moderada), caracterizada por leucocitose > 18.000/mm\302\263 e dura\303\247\303\243o dos sintomas superior a 72 horas.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        explanation:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Correta. Pelo Tokyo Guidelines 2018 (TG18), a colecistite aguda Grau II (moderada) \303\251 definida por qualquer um dos crit\303\251rios: leuc\303\263citos > 18.000/mm\302\263, massa palp\303\241vel dolorosa em QSD, dura\303\247\303\243o dos sintomas > 72h ou inflama\303\247\303\243o local acentuada (colecistite gangrenosa, enfisematosa, abscesso pericolec\303\255stico/hep\303\241tico ou peritonite biliar).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        communityPct: 58.7,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        letter: \'C\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        text: \'Grau III (Grave), devido \303\240 presen\303\247a de l\303\255quido pericolec\303\255stico e espessamento parietal > 4 mm.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        explanation:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Incorreta. Grau III exige disfun\303\247\303\243o org\303\242nica (cardiovascular com droga vasoativa, neurol\303\263gica, respirat\303\263ria PaO\342\202\202/FiO\342\202\202 < 300, renal com Cr > 2,0, hep\303\241tica com RNI > 1,5 ou hematol\303\263gica com plaquetas < 100.000).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        communityPct: 8.6,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        letter: \'D\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        text: \'Diagn\303\263stico apenas suspeito, necessitando de colangiorresson\303\242ncia para confirma\303\247\303\243o antes da estratifica\303\247\303\243o.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        explanation:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Incorreta. O diagn\303\263stico definitivo pelos Crit\303\251rios de T\303\263quio \303\251 fechado com 1 crit\303\251rio A (Murphy + dor QSD) + 1 crit\303\251rio B (febre/leucocitose/PCR) + 1 crit\303\251rio C (achado ultrassonogr\303\241fico t\303\255pico).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        communityPct: 3.3,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    gabaritoOficial: \'B\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    totalRespostasComunidade: 3420,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    taxaAcertoGlobal: 58.7,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    comentarioGeral:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Os Crit\303\251rios de T\303\263quio 2018 (TG18) s\303\243o cobrados tanto no Acesso Direto quanto no R+ de Cirurgia Geral. Para classificar rapidamente: primeiro procure disfun\303\247\303\243o org\303\242nica (Grau III); se ausente, procure sinais de gravidade local/temporal (Leuco > 18.000, > 72h, massa palp\303\241vel, gangrena/abscesso = Grau II); se nenhum estiver presente, \303\251 Grau I (Leve).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    perolaClinica:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'TG18 Grau II (Moderada): Leuco > 18.000 | > 72h de evolu\303\247\303\243o | Massa palp\303\241vel em QSD | Inflama\303\247\303\243o local grave (abscesso, gangrena, enfisematosa). Grau III = Disfun\303\247\303\243o org\303\242nica!\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    referencias: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Yokoe M et al. Tokyo Guidelines 2018 (TG18): diagnostic criteria and severity grading of acute cholecystitis.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Sabiston Textbook of Surgery, 21\302\252 ed., Cap. 55 (Biliary System).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    id: \'q-amrigs-2024-gineco-12\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    code: \'Q-AMR24-0440\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    grandeAreaId: \'ginecologia_obstetricia\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    grandeArea: \'Ginecologia e Obstetr\303\255cia\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    tema: \'Ginecologia\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    subtema: \'Rastreamento de C\303\242ncer de Colo Uterino (INCA/MS)\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    banca: \'FUNDATEC\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    instituicao: \'AMRIGS\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    estado: \'RS\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    regiao: \'Sul\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ano: 2024,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    tipoProva: \'Acesso Direto\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    anulada: false,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    desatualizada: false,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    enunciado:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Mulher de 28 anos, imunocompetente, assintom\303\241tica, realiza exame citopatol\303\263gico do colo uterino de rotina cujo resultado retorna como \"C\303\251lulas escamosas at\303\255picas de significado indeterminado, possivelmente n\303\243o neopl\303\241sicas (ASC-US)\", amostra satisfat\303\263ria com epit\303\251lios escamoso, glandular e metapl\303\241sico representados. Qual \303\251 a conduta recomendada pelas Diretrizes Brasileiras para o Rastreamento do C\303\242ncer do Colo do \303\232tero (INCA/MS)?\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    alternativas: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        letter: \'A\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        text: \'Encaminhar imediatamente para colposcopia com bi\303\263psia dirigida.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        explanation:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Incorreta (Principal distrator). O encaminhamento imediato para colposcopia ocorre em ASC-H, HSIL, AGC ou em pacientes imunossuprimidas com qualquer altera\303\247\303\243o. No ASC-US em imunocompetentes, repete-se a citologia.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        communityPct: 22.8,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        letter: \'B\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        text: \'Repetir o exame citopatol\303\263gico em 12 meses.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        explanation:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Correta. Nas Diretrizes do INCA/MS, a conduta frente ao resultado de ASC-US depende da faixa et\303\241ria: em mulheres < 25 anos, repetir em 3 anos; entre 25 e 29 anos, repetir em 12 meses; e em \342\211\245 30 anos, repetir em 6 meses.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        communityPct: 41.2,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        letter: \'C\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        text: \'Repetir o exame citopatol\303\263gico em 6 meses.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        explanation:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Incorreta. A repeti\303\247\303\243o em 6 meses para ASC-US aplica-se a mulheres com 30 anos ou mais. Entre 25 e 29 anos, o intervalo de repeti\303\247\303\243o \303\251 de 12 meses.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        communityPct: 30.1,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        letter: \'D\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        text: \'Realizar ex\303\251rese da zona de transforma\303\247\303\243o (EZT) ambulatorial (\"ver e tratar\").\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        explanation:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Incorreta. O m\303\251todo \"ver e tratar\" aplica-se em cen\303\241rios selecionados de HSIL com colposcopia satisfat\303\263ria e achados maiores concordantes em mulheres \342\211\245 25 anos, nunca em ASC-US.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        communityPct: 5.9,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    gabaritoOficial: \'B\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    totalRespostasComunidade: 4650,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    taxaAcertoGlobal: 41.2,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    comentarioGeral:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Esta \303\251 uma das pegadinhas de faixa et\303\241ria mais tradicionais das bancas brasileiras (especialmente AMRIGS, USP e ENARE). Em ASC-US (imunocompetente), a conduta \303\251 estratificada exatamente nos cortes de 25 e 30 anos devido \303\240 alta taxa de clareamento espont\303\242neo do HPV em mulheres jovens.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    perolaClinica:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'ASC-US (INCA/MS): < 25 anos \342\206\222 repetir em 3 anos | 25 a 29 anos \342\206\222 repetir em 12 meses | \342\211\245 30 anos \342\206\222 repetir em 6 meses. Se persistir na repeti\303\247\303\243o \342\206\222 Colposcopia!\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    referencias: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'INCA / Minist\303\251rio da Sa\303\272de \342\200\224 Diretrizes Brasileiras para o Rastreamento do C\303\242ncer do Colo do \303\232tero, 2\302\252 ed.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'FEBRASGO \342\200\224 Tratado de Ginecologia.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
