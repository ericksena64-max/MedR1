  view_file {
    absolute_path_uri: "file:///src/types/medical.ts"
    end_line: 196
    content: "export type GrandeAreaId =\n  | \'clinica_medica\'\n  | \'cirurgia_geral\'\n  | \'ginecologia_obstetricia\'\n  | \'pediatria\'\n  | \'medicina_preventiva\';\n\nexport type AlternativeLetter = \'A\' | \'B\' | \'C\' | \'D\' | \'E\';\n\nexport type ExamType = \'Acesso Direto\' | \'R+\' | \'Revalida\';\n\nexport type DifficultyLevel = \'F\303\241cil\' | \'M\303\251dio\' | \'Dif\303\255cil\';\n\nexport type StudyMode = \'estudo\' | \'simulado\';\n\nexport type StudentFilterStatus =\n  | \'todas\'\n  | \'nao_resolvidas\'\n  | \'erradas\'\n  | \'acertadas\'\n  | \'favoritadas\';\n\nexport type ActiveTab =\n  | \'questoes\'\n  | \'desempenho\'\n  | \'ranking\'\n  | \'caderno_erros\'\n  | \'flashcards\';\n\nexport type PerformanceStatus =\n  | \'Acima da Mediana\'\n  | \'Na Mediana\'\n  | \'Ponto de Aten\303\247\303\243o\';\n\nexport interface LabRow {\n  exame: string;\n  resultado: string;\n  referencia: string;\n  alterado?: \'alto\' | \'baixo\' | \'normal\';\n}\n\nexport interface ClinicalImage {\n  url: string;\n  modality: string;\n  caption: string;\n  aspectRatio: \'16:9\' | \'4:3\' | \'1:1\';\n}\n\nexport interface QuestionAlternative {\n  letter: AlternativeLetter;\n  text: string;\n  explanation: string;\n  communityPct: number; // Percentage of platform students who selected this alternative\n}\n\nexport interface MedicalQuestion {\n  id: string;\n  code: string;\n  grandeAreaId: GrandeAreaId;\n  grandeArea: string;\n  tema: string;\n  subtema: string;\n  banca: string;\n  instituicao: string;\n  estado: string;\n  regiao: string;\n  ano: number;\n  tipoProva: ExamType;\n  anulada: boolean;\n  desatualizada: boolean;\n  enunciado: string;\n  labTable?: LabRow[];\n  clinicalImage?: ClinicalImage;\n  alternativas: QuestionAlternative[];\n  gabaritoOficial: AlternativeLetter;\n  totalRespostasComunidade: number;\n  taxaAcertoGlobal: number; // 0-100\n  comentarioGeral: string;\n  perolaClinica: string;\n  referencias: string[];\n}\n\nexport interface UserAnswerRecord {\n  questionId: string;\n  selectedLetter: AlternativeLetter;\n  isCorrect: boolean;\n  answeredAt: string;\n  mode: StudyMode;\n  timeSpentSec: number;\n}\n\nexport interface QuestionFilters {\n  search: string;\n  examSearch: string;\n  grandeAreaId: string;\n  tema: string;\n  subtema: string;\n  banca: string;\n  instituicao: string;\n  regiao: string;\n  ano: string;\n  dificuldade: string;\n  status: StudentFilterStatus;\n  comImagens: boolean;\n  excluirAnuladasDesatualizadas: boolean;\n}\n\nexport interface UserProfile {\n  id: string;\n  realName: string;\n  pseudonym: string;\n  usePseudonym: boolean;\n  targetSpecialty: string;\n  targetInstitution: string;\n  avatarInitials: string;\n}\n\nexport interface LiveRankingUser {\n  id: string;\n  realName: string;\n  pseudonym: string;\n  usePseudonym: boolean;\n  targetInstitution: string;\n  avatarInitials: string;\n  questionsToday: number;\n  correctToday: number;\n  streak: number;\n  currentArea: string;\n  isOnline: boolean;\n  isCurrentUser?: boolean;\n  lastActiveSecondsAgo: number;\n}\n\nexport interface HistoricalAreaPerformance {\n  grandeAreaId: GrandeAreaId;\n  grandeArea: string;\n  shortName: string;\n  baseAnswered: number;\n  baseCorrect: number;\n  communityMedianPct: number;\n  communityP75Pct: number;\n}\n\nexport interface HistoricalTopicPerformance {\n  grandeAreaId: GrandeAreaId;\n  grandeArea: string;\n  tema: string;\n  baseAnswered: number;\n  baseCorrect: number;\n  communityMedianPct: number;\n  communityP75Pct: number;\n}\n\nexport interface TemporalPoint {\n  period: string;\n  alunoPct: number;\n  medianaPct: number;\n  p75Pct: number;\n  questoes: number;\n}\n\nexport type SrsRating = 1 | 2 | 3 | 4;\n\nexport type FsrsState = \'New\' | \'Learning\' | \'Review\' | \'Relearning\';\n\nexport type TargetRetention = 0.85 | 0.9 | 0.95;\n\nexport type FlashcardSource = \'perola\' | \'caderno_erros\' | \'manual\';\n\nexport interface Flashcard {\n  id: string;\n  questionId?: string;\n  questionCode?: string;\n  institutionLabel?: string;\n  grandeAreaId: GrandeAreaId;\n  grandeArea: string;\n  tema: string;\n  subtema?: string;\n  front: string;\n  backPearl: string;\n  backAnswerSummary?: string;\n  source: FlashcardSource;\n  createdAt: string;\n  dueAt: string;\n  lastReviewedAt?: string;\n  // FSRS (Free Spaced Repetition Scheduler) core state parameters\n  stability: number;      // S: interval in days at which Retrievability = 90%\n  difficulty: number;     // D: item complexity on [1, 10]\n  elapsed_days: number;   // Days elapsed since last review\n  scheduled_days: number; // Scheduled interval in days for next review\n  reps: number;           // Total successful review count\n  lapses: number;         // Number of times forgotten (Again / Errei)\n  state: FsrsState;       // New | Learning | Review | Relearning\n}\n\n\n"
    num_lines: 197
    num_bytes: 4552
    line_range_bytes: 4552
  }
}
