            }
            lines {
              text: "    id: \'q-usp-2025-cardio-01\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    code: \'Q-USP25-0142\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    grandeAreaId: \'clinica_medica\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    grandeArea: \'Cl\303\255nica M\303\251dica\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    tema: \'Cardiologia\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    subtema: \'S\303\255ndrome Coronariana Aguda com Supra de ST\',"
