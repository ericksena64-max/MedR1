  view_file {
    absolute_path_uri: "file:///src/components/flashcards/FlashcardsView.tsx"
    end_line: 1294
    content: "import React, { useEffect, useMemo, useState, useCallback } from \'react\';\nimport {\n  RotateCw,\n  ArrowUpRight,\n  Plus,\n  Trash2,\n  CheckCircle2,\n  Layers,\n  Clock,\n  CalendarClock,\n  SlidersHorizontal,\n  Settings,\n  Sparkles,\n  BookOpen,\n  X,\n} from \'lucide-react\';\nimport type {\n  ExamBoard,\n  Flashcard,\n  FsrsState,\n  GrandeAreaId,\n  RetentionMode,\n  SrsRating,\n} from \'../../types/medical\';\nimport { GRANDES_AREAS } from \'../../data/taxonomy\';\nimport { getBoardCustomizationCount } from \'../../lib/examWeights\';\nimport {\n  computeAllFsrsOutcomes,\n  formatFsrsInterval,\n  getCardCurrentRetrievabilityPct,\n  isCardDueToday,\n  resolveCardRetention,\n  type FsrsScheduleOutcome,\n} from \'../../lib/srs\';\nimport { ExamWeightsModal } from \'./ExamWeightsModal\';\nimport { Button } from \'../ui/Button\';\nimport { Select } from \'../ui/Select\';\nimport { cn } from \'../../lib/utils\';\n\ninterface FlashcardsViewProps {\n  flashcards: Flashcard[];\n  reviewsTodayStats: { date: string; total: number; passed: number };\n  retentionMode: RetentionMode;\n  onChangeRetentionMode: (mode: RetentionMode) => void;\n  targetBoard: ExamBoard;\n  onChangeTargetBoard: (board: ExamBoard) => void;\n  userAccuracyByTopic: Record<string, number>;\n  communityMedianByTopic: Record<string, number>;\n  onReviewCard: (cardId: string, rating: SrsRating) => void;\n  onCreateCustomCard: (payload: {\n    grandeAreaId: GrandeAreaId;\n    tema: string;\n    front: string;\n    backPearl: string;\n  }) => void;\n  onDeleteCard: (cardId: string) => void;\n  onOpenOriginalQuestion: (questionId: string) => void;\n  onGoToQuestions: () => void;\n}\n\ntype DeckViewMode = \'revisao\' | \'baralho\';\n\nconst BOARD_OPTIONS: Array<{ value: ExamBoard; label: string }> = [\n  { value: \'UEPA\', label: \'UEPA\' },\n  { value: \'ENARE\', label: \'ENARE\' },\n  { value: \'GERAL\', label: \'Geral\' },\n];\n\nconst RETENTION_OPTIONS: Array<{ value: RetentionMode; label: string }> = [\n  { value: \'dinamica\', label: \'Din\303\242mica\' },\n  { value: 0.85, label: \'85%\' },\n  { value: 0.9, label: \'90%\' },\n  { value: 0.95, label: \'95%\' },\n];\n\nfunction formatDeltaPct(delta: number): string {\n  const pct = Math.round(delta * 100);\n  if (pct > 0) return `+${pct}%`;\n  if (pct < 0) return `${pct}%`;\n  return \'0%\';\n}\n\nconst FSRS_STATE_LABEL: Record<FsrsState, string> = {\n  New: \'Novo\',\n  Learning: \'Aprendendo\',\n  Review: \'Revis\303\243o\',\n  Relearning: \'Reaprendendo\',\n};\n\nconst RATING_CONFIG: Array<{\n  rating: SrsRating;\n  keyHint: string;\n  label: string;\n  dotClass: string;\n  textClass: string;\n  subTextClass: string;\n  buttonClass: string;\n}> = [\n  {\n    rating: 1,\n    keyHint: \'1\',\n    label: \'Errei\',\n    dotClass: \'bg-red-500\',\n    textClass: \'text-red-700 dark:text-red-400\',\n    subTextClass: \'text-red-600/85 dark:text-red-300/85\',\n    buttonClass:\n      \'border-red-200 bg-red-50/70 hover:bg-red-100/80 dark:border-red-900/60 dark:bg-red-950/30 dark:hover:bg-red-950/60 focus-visible:ring-red-500\',\n  },\n  {\n    rating: 2,\n    keyHint: \'2\',\n    label: \'Dif\303\255cil\',\n    dotClass: \'bg-amber-500\',\n    textClass: \'text-amber-800 dark:text-amber-400\',\n    subTextClass: \'text-amber-700/85 dark:text-amber-300/85\',\n    buttonClass:\n      \'border-amber-200 bg-amber-50/70 hover:bg-amber-100/80 dark:border-amber-900/60 dark:bg-amber-950/30 dark:hover:bg-amber-950/60 focus-visible:ring-amber-500\',\n  },\n  {\n    rating: 3,\n    keyHint: \'3\',\n    label: \'Bom\',\n    dotClass: \'bg-sky-500\',\n    textClass: \'text-sky-800 dark:text-sky-300\',\n    subTextClass: \'text-sky-700/85 dark:text-sky-300/85\',\n    buttonClass:\n      \'border-sky-200 bg-sky-50/70 hover:bg-sky-100/80 dark:border-sky-900/60 dark:bg-sky-950/30 dark:hover:bg-sky-950/60 focus-visible:ring-sky-500\',\n  },\n  {\n    rating: 4,\n    keyHint: \'4\',\n    label: \'F\303\241cil\',\n    dotClass: \'bg-emerald-500\',\n    textClass: \'text-emerald-800 dark:text-emerald-400\',\n    subTextClass: \'text-emerald-700/85 dark:text-emerald-300/85\',\n    buttonClass:\n      \'border-emerald-200 bg-emerald-50/70 hover:bg-emerald-100/80 dark:border-emerald-900/60 dark:bg-emerald-950/30 dark:hover:bg-emerald-950/60 focus-visible:ring-emerald-500\',\n  },\n];\n\nfunction formatOutcomeDate(outcome: FsrsScheduleOutcome): string {\n  if (outcome.scheduled_days === 0) return \'Hoje\';\n  return new Date(outcome.dueAt).toLocaleDateString(\'pt-BR\', {\n    day: \'2-digit\',\n    month: \'2-digit\',\n  });\n}\n\nexport function FlashcardsView({\n  flashcards,\n  reviewsTodayStats,\n  retentionMode,\n  onChangeRetentionMode,\n  targetBoard,\n  onChangeTargetBoard,\n  userAccuracyByTopic,\n  communityMedianByTopic,\n  onReviewCard,\n  onCreateCustomCard,\n  onDeleteCard,\n  onOpenOriginalQuestion,\n  onGoToQuestions,\n}: FlashcardsViewProps) {\n  const [selectedArea, setSelectedArea] = useState<string>(\'all\');\n  const [selectedTema, setSelectedTema] = useState<string>(\'\');\n  const [viewMode, setViewMode] = useState<DeckViewMode>(\'revisao\');\n  const [practiceAhead, setPracticeAhead] = useState(false);\n  const [flipped, setFlipped] = useState(false);\n  const [hoveredRating, setHoveredRating] = useState<SrsRating | null>(null);\n  const [sessionIndex, setSessionIndex] = useState(0);\n  const [showCreateForm, setShowCreateForm] = useState(false);\n  const [weightsModalOpen, setWeightsModalOpen] = useState(false);\n  const [weightsVersion, setWeightsVersion] = useState(0);\n\n  // Manual flashcard form state\n  const [newArea, setNewArea] = useState<GrandeAreaId>(\'clinica_medica\');\n  const [newTema, setNewTema] = useState(\'\');\n  const [newFront, setNewFront] = useState(\'\');\n  const [newBack, setNewBack] = useState(\'\');\n\n  // Available specialties (temas) inside current area filter\n  const availableTemas = useMemo(() => {\n    const subset =\n      selectedArea === \'all\'\n        ? flashcards\n        : flashcards.filter((fc) => fc.grandeAreaId === selectedArea);\n    return Array.from(new Set(subset.map((fc) => fc.tema))).sort();\n  }, [flashcards, selectedArea]);\n\n  // Cards matching selected Grande \303\201rea + Especialidade/Tema\n  const filteredCards = useMemo(() => {\n    return flashcards.filter((fc) => {\n      if (selectedArea !== \'all\' && fc.grandeAreaId !== selectedArea) return false;\n      if (selectedTema && fc.tema !== selectedTema) return false;\n      return true;\n    });\n  }, [flashcards, selectedArea, selectedTema]);\n\n  // Cards due today sorted oldest-due first (newly failed cards rotate to end of queue)\n  const dueQueue = useMemo(() => {\n    const list = practiceAhead\n      ? [...filteredCards]\n      : filteredCards.filter((fc) => isCardDueToday(fc));\n    return list.sort(\n      (a, b) => new Date(a.dueAt).getTime() - new Date(b.dueAt).getTime()\n    );\n  }, [filteredCards, practiceAhead]);\n\n  const totalDueFiltered = useMemo(\n    () => filteredCards.filter((fc) => isCardDueToday(fc)).length,\n    [filteredCards]\n  );\n\n  // Reset flip & clamp index when queue changes\n  useEffect(() => {\n    setFlipped(false);\n    setHoveredRating(null);\n    if (sessionIndex >= dueQueue.length) {\n      setSessionIndex(0);\n    }\n  }, [dueQueue.length, selectedArea, selectedTema, practiceAhead, sessionIndex]);\n\n  const activeCard = dueQueue[sessionIndex] ?? dueQueue[0];\n\n  const handleRate = useCallback(\n    (rating: SrsRating) => {\n      if (!activeCard) return;\n      onReviewCard(activeCard.id, rating);\n      setFlipped(false);\n      setHoveredRating(null);\n      // If practicing ahead (not just due-only), advance pointer to next card\n      if (practiceAhead) {\n        setSessionIndex((prev) =>\n          dueQueue.length > 1 ? (prev + 1) % dueQueue.length : 0\n        );\n      } else if (rating === 1 && dueQueue.length > 1) {\n        // Card stays due today; dueAt updated to now so sort moves it after older cards\n        setSessionIndex(0);\n      }\n    },\n    [activeCard, onReviewCard, practiceAhead, dueQueue.length]\n  );\n\n  // Keyboard shortcuts: Space to flip, 1-4 to rate when flipped\n  useEffect(() => {\n    if (viewMode !== \'revisao\' || !activeCard || showCreateForm || weightsModalOpen) {\n      return;\n    }\n\n    const handleKeyDown = (e: KeyboardEvent) => {\n      const target = e.target as HTMLElement | null;\n      if (\n        target &&\n        (target.tagName === \'INPUT\' ||\n          target.tagName === \'TEXTAREA\' ||\n          target.tagName === \'SELECT\' ||\n          target.isContentEditable)\n      ) {\n        return;\n      }\n\n      if (e.code === \'Space\') {\n        e.preventDefault();\n        setFlipped((f) => !f);\n        return;\n      }\n\n      if (flipped) {\n        if (e.key === \'1\') {\n          e.preventDefault();\n          handleRate(1);\n        } else if (e.key === \'2\') {\n          e.preventDefault();\n          handleRate(2);\n        } else if (e.key === \'3\') {\n          e.preventDefault();\n          handleRate(3);\n        } else if (e.key === \'4\') {\n          e.preventDefault();\n          handleRate(4);\n        }\n      }\n    };\n\n    window.addEventListener(\'keydown\', handleKeyDown);\n    return () => window.removeEventListener(\'keydown\', handleKeyDown);\n  }, [viewMode, activeCard, flipped, handleRate, showCreateForm, weightsModalOpen]);\n\n  const handleCreateSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!newFront.trim() || !newBack.trim()) return;\n    onCreateCustomCard({\n      grandeAreaId: newArea,\n      tema: newTema.trim() || \'Revis\303\243o Geral\',\n      front: newFront,\n      backPearl: newBack,\n    });\n    setNewTema(\'\');\n    setNewFront(\'\');\n    setNewBack(\'\');\n    setShowCreateForm(false);\n  };\n\n  const retentionPct =\n    reviewsTodayStats.total > 0\n      ? Math.round((reviewsTodayStats.passed / reviewsTodayStats.total) * 100)\n      : null;\n\n  const activeBoardCustomCount = useMemo(\n    () => getBoardCustomizationCount(targetBoard),\n    // eslint-disable-next-line react-hooks/exhaustive-deps\n    [targetBoard, weightsVersion]\n  );\n\n  const activeCalibration = useMemo(\n    () =>\n      activeCard\n        ? resolveCardRetention(\n            activeCard,\n            retentionMode,\n            targetBoard,\n            userAccuracyByTopic,\n            communityMedianByTopic\n          )\n        : null,\n    // eslint-disable-next-line react-hooks/exhaustive-deps\n    [\n      activeCard,\n      retentionMode,\n      targetBoard,\n      userAccuracyByTopic,\n      communityMedianByTopic,\n      weightsVersion,\n    ]\n  );\n\n  const fsrsOutcomes = useMemo(\n    () =>\n      activeCard && activeCalibration\n        ? computeAllFsrsOutcomes(activeCard, activeCalibration.retention)\n        : null,\n    [activeCard, activeCalibration]\n  );\n\n  const activeRetrievabilityPct = activeCard\n    ? getCardCurrentRetrievabilityPct(activeCard)\n    : null;\n\n  const hoveredOutcome =\n    hoveredRating && fsrsOutcomes ? fsrsOutcomes[hoveredRating] : null;\n  const hoveredConfig = hoveredRating\n    ? RATING_CONFIG.find((c) => c.rating === hoveredRating) ?? null\n    : null;\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Top 4-column KPI summary */}\n      <section\n        aria-label=\"Resumo de flashcards e repeti\303\247\303\243o espa\303\247ada\"\n        className=\"grid grid-cols-2 lg:grid-cols-4 gap-4\"\n      >\n        <div className=\"rounded-xl border border-slate-200 bg-white p-4 sm:p-5 dark:border-slate-800 dark:bg-slate-900\">\n          <p className=\"text-xs font-medium text-slate-500 dark:text-slate-400\">\n            Vencidos para Hoje\n          </p>\n          <p className=\"mt-1.5 font-mono text-2xl sm:text-3xl font-bold tabular-nums text-sky-600 dark:text-sky-400\">\n            {totalDueFiltered}\n          </p>\n          <p className=\"mt-1 text-xs text-slate-500 dark:text-slate-400\">\n            Fila ativa de revis\303\243o\n          </p>\n        </div>\n\n        <div className=\"rounded-xl border border-slate-200 bg-white p-4 sm:p-5 dark:border-slate-800 dark:bg-slate-900\">\n          <p className=\"text-xs font-medium text-slate-500 dark:text-slate-400\">\n            Revisados Hoje\n          </p>\n          <p className=\"mt-1.5 font-mono text-2xl sm:text-3xl font-bold tabular-nums text-slate-900 dark:text-white\">\n            {reviewsTodayStats.total}\n          </p>\n          <p className=\"mt-1 text-xs text-slate-500 dark:text-slate-400\">\n            Sess\303\243o atual salva\n          </p>\n        </div>\n\n        <div className=\"rounded-xl border border-slate-200 bg-white p-4 sm:p-5 dark:border-slate-800 dark:bg-slate-900\">\n          <p className=\"text-xs font-medium text-slate-500 dark:text-slate-400\">\n            Total no Baralho\n          </p>\n          <p className=\"mt-1.5 font-mono text-2xl sm:text-3xl font-bold tabular-nums text-slate-900 dark:text-white\">\n            {filteredCards.length}\n          </p>\n          <p className=\"mt-1 text-xs text-slate-500 dark:text-slate-400 tabular-nums\">\n            {flashcards.length} no total geral\n          </p>\n        </div>\n\n        <div className=\"rounded-xl border border-slate-200 bg-white p-4 sm:p-5 dark:border-slate-800 dark:bg-slate-900\">\n          <p className=\"text-xs font-medium text-slate-500 dark:text-slate-400\">\n            Reten\303\247\303\243o Hoje\n          </p>\n          <p className=\"mt-1.5 font-mono text-2xl sm:text-3xl font-bold tabular-nums text-emerald-600 dark:text-emerald-400\">\n            {retentionPct !== null ? `${retentionPct}%` : \'\342\200\224\'}\n          </p>\n          <p className=\"mt-1 text-xs text-slate-500 dark:text-slate-400\">\n            Dif\303\255cil, Bom ou F\303\241cil\n          </p>\n        </div>\n      </section>\n\n      {/* Filter, Retention Target & View Mode Toolbar */}\n      <section className=\"rounded-xl border border-slate-200 bg-white p-4 sm:p-5 dark:border-slate-800 dark:bg-slate-900 space-y-4\">\n        <div className=\"flex flex-col xl:flex-row xl:items-center justify-between gap-3\">\n          {/* Mode segmented tabs + discrete FSRS Desired Retention selector */}\n          <div className=\"flex flex-wrap items-center gap-3\">\n            <div className=\"inline-flex rounded-lg bg-slate-100 p-1 dark:bg-slate-800\">\n              <button\n                type=\"button\"\n                onClick={() => setViewMode(\'revisao\')}\n                className={cn(\n                  \'rounded-md px-3.5 py-1.5 text-xs font-semibold transition-colors cursor-pointer whitespace-nowrap\',\n                  viewMode === \'revisao\'\n                    ? \'bg-white text-slate-900 shadow-sm dark:bg-slate-950 dark:text-white\'\n                    : \'text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-200\'\n                )}\n              >\n                Sess\303\243o de Revis\303\243o ({totalDueFiltered})\n              </button>\n              <button\n                type=\"button\"\n                onClick={() => setViewMode(\'baralho\')}\n                className={cn(\n                  \'rounded-md px-3.5 py-1.5 text-xs font-semibold transition-colors cursor-pointer whitespace-nowrap\',\n                  viewMode === \'baralho\'\n                    ? \'bg-white text-slate-900 shadow-sm dark:bg-slate-950 dark:text-white\'\n                    : \'text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-200\'\n                )}\n              >\n                Todos os Cards ({filteredCards.length})\n              </button>\n            </div>\n\n            {/* Banca-Alvo Selector (UEPA, ENARE, Geral) + Calibrar Matriz Modal Trigger */}\n            <div className=\"flex flex-wrap items-center gap-2\">\n              <span className=\"text-xs text-slate-500 dark:text-slate-400 whitespace-nowrap\">\n                Banca-Alvo:\n              </span>\n              <div\n                role=\"group\"\n                aria-label=\"Selecionar banca-alvo para calibra\303\247\303\243o FSRS\"\n                className=\"inline-flex rounded-lg border border-slate-200 bg-slate-50 p-0.5 dark:border-slate-700 dark:bg-slate-950/60\"\n              >\n                {BOARD_OPTIONS.map((opt) => {\n                  const active = targetBoard === opt.value;\n                  return (\n                    <button\n                      key={opt.value}\n                      type=\"button\"\n                      onClick={() => onChangeTargetBoard(opt.value)}\n                      aria-pressed={active}\n                      className={cn(\n                        \'rounded-md px-2.5 py-1 text-[11px] font-semibold transition-colors cursor-pointer whitespace-nowrap\',\n                        active\n                          ? retentionMode === \'dinamica\'\n                            ? \'bg-white text-sky-700 shadow-sm dark:bg-slate-800 dark:text-sky-300\'\n                            : \'bg-white text-slate-800 shadow-sm dark:bg-slate-800 dark:text-slate-200\'\n                          : \'text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-200\'\n                      )}\n                    >\n                      {opt.label}\n                    </button>\n                  );\n                })}\n              </div>\n\n              <button\n                type=\"button\"\n                onClick={() => setWeightsModalOpen(true)}\n                className=\"inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-2.5 py-1.5 text-[11px] font-semibold text-slate-700 hover:border-sky-300 hover:bg-sky-50/70 hover:text-sky-800 dark:border-slate-700 dark:bg-slate-950/60 dark:text-slate-200 dark:hover:border-sky-700 dark:hover:bg-sky-950/40 dark:hover:text-sky-300 transition-colors cursor-pointer whitespace-nowrap focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-500\"\n                title=\"Configurar matriz de incid\303\252ncia por banca (UEPA, ENARE, Geral)\"\n              >\n                <Settings className=\"h-3.5 w-3.5 text-slate-500 dark:text-slate-400\" />\n                <span>Calibrar Matriz</span>\n                {activeBoardCustomCount > 0 && (\n                  <span className=\"font-mono text-[10px] font-bold text-sky-600 dark:text-sky-400 tabular-nums\">\n                    ({activeBoardCustomCount})\n                  </span>\n                )}\n              </button>\n            </div>\n\n            {/* FSRS Target Retention Control (Dynamic + Fixed 85/90/95%) */}\n            <div className=\"flex items-center gap-2\">\n              <span className=\"text-xs text-slate-500 dark:text-slate-400 whitespace-nowrap\">\n                Reten\303\247\303\243o FSRS:\n              </span>\n              <div\n                role=\"group\"\n                aria-label=\"Modo de reten\303\247\303\243o desejada do algoritmo FSRS\"\n                className=\"inline-flex rounded-lg border border-slate-200 bg-slate-50 p-0.5 dark:border-slate-700 dark:bg-slate-950/60\"\n              >\n                {RETENTION_OPTIONS.map((opt) => {\n                  const active = retentionMode === opt.value;\n                  const isDynamicOpt = opt.value === \'dinamica\';\n                  return (\n                    <button\n                      key={String(opt.value)}\n                      type=\"button\"\n                      onClick={() => onChangeRetentionMode(opt.value)}\n                      aria-pressed={active}\n                      className={cn(\n                        \'inline-flex items-center gap-1 rounded-md px-2 py-1 text-[11px] font-semibold tabular-nums transition-colors cursor-pointer whitespace-nowrap\',\n                        !isDynamicOpt && \'font-mono\',\n                        active\n                          ? \'bg-white text-sky-700 shadow-sm dark:bg-slate-800 dark:text-sky-300\'\n                          : \'text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-200\'\n                      )}\n                    >\n                      {isDynamicOpt && <SlidersHorizontal className=\"h-3 w-3\" />}\n                      <span>{opt.label}</span>\n                    </button>\n                  );\n                })}\n              </div>\n            </div>\n          </div>\n\n          <div className=\"flex flex-wrap items-center gap-2.5\">\n            <Select\n              id=\"fc-filter-tema\"\n              placeholder=\"Todas as especialidades\"\n              value={selectedTema}\n              options={availableTemas.map((t) => ({ value: t, label: t }))}\n              onChange={(val) => {\n                setSelectedTema(val);\n                setSessionIndex(0);\n              }}\n              className=\"w-52\"\n            />\n            <Button\n              variant={showCreateForm ? \'secondary\' : \'primary\'}\n              size=\"md\"\n              onClick={() => setShowCreateForm((s) => !s)}\n            >\n              {showCreateForm ? (\n                <>\n                  <X className=\"h-4 w-4\" />\n                  <span>Fechar</span>\n                </>\n              ) : (\n                <>\n                  <Plus className=\"h-4 w-4\" />\n                  <span>Novo Flashcard</span>\n                </>\n              )}\n            </Button>\n          </div>\n        </div>\n\n        {/* Grande \303\201rea filter buttons */}\n        <div className=\"flex flex-wrap items-center gap-1.5 pt-2 border-t border-slate-100 dark:border-slate-800/80\">\n          <button\n            type=\"button\"\n            onClick={() => {\n              setSelectedArea(\'all\');\n              setSelectedTema(\'\');\n              setSessionIndex(0);\n            }}\n            className={cn(\n              \'rounded-lg px-3 py-1.5 text-xs font-medium transition-colors cursor-pointer whitespace-nowrap\',\n              selectedArea === \'all\'\n                ? \'bg-slate-900 text-white dark:bg-sky-500 dark:text-slate-950\'\n                : \'bg-slate-100 text-slate-600 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-300\'\n            )}\n          >\n            Todas as \303\201reas\n          </button>\n          {GRANDES_AREAS.map((area) => {\n            const dueInArea = flashcards.filter(\n              (fc) => fc.grandeAreaId === area.id && isCardDueToday(fc)\n            ).length;\n            const active = selectedArea === area.id;\n            return (\n              <button\n                key={area.id}\n                type=\"button\"\n                onClick={() => {\n                  setSelectedArea(area.id);\n                  setSelectedTema(\'\');\n                  setSessionIndex(0);\n                }}\n                className={cn(\n                  \'rounded-lg px-3 py-1.5 text-xs font-medium transition-colors cursor-pointer whitespace-nowrap tabular-nums\',\n                  active\n                    ? \'bg-slate-900 text-white dark:bg-sky-500 dark:text-slate-950\'\n                    : \'bg-slate-100 text-slate-600 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-300\'\n                )}\n              >\n                {area.shortName}\n                {dueInArea > 0 ? ` (${dueInArea})` : \'\'}\n              </button>\n            );\n          })}\n        </div>\n\n        {/* Collapsible Custom Flashcard Creator */}\n        {showCreateForm && (\n          <form\n            onSubmit={handleCreateSubmit}\n            className=\"border-t border-slate-200 pt-4 dark:border-slate-800 space-y-3\"\n          >\n            <h3 className=\"font-display text-sm font-bold text-slate-900 dark:text-white\">\n              Criar Flashcard Manual\n            </h3>\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3\">\n              <Select\n                id=\"new-fc-area\"\n                label=\"Grande \303\201rea\"\n                value={newArea}\n                options={GRANDES_AREAS.map((a) => ({ value: a.id, label: a.name }))}\n                onChange={(val) => setNewArea(val as GrandeAreaId)}\n              />\n              <div className=\"flex flex-col gap-1.5\">\n                <label\n                  htmlFor=\"new-fc-tema\"\n                  className=\"text-xs font-medium text-slate-600 dark:text-slate-400\"\n                >\n                  Especialidade / Tema\n                </label>\n                <input\n                  id=\"new-fc-tema\"\n                  type=\"text\"\n                  value={newTema}\n                  onChange={(e) => setNewTema(e.target.value)}\n                  placeholder=\"Ex.: Cardiologia, Trauma, Neonatologia\"\n                  className=\"h-10 rounded-lg border border-slate-200 bg-white px-3 text-sm text-slate-900 focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-500/20 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100\"\n                />\n              </div>\n            </div>\n\n            <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-3\">\n              <div className=\"flex flex-col gap-1.5\">\n                <label\n                  htmlFor=\"new-fc-front\"\n                  className=\"text-xs font-medium text-slate-600 dark:text-slate-400\"\n                >\n                  Frente (Pergunta objetiva ou mini-caso cl\303\255nico)\n                </label>\n                <textarea\n                  id=\"new-fc-front\"\n                  rows={3}\n                  required\n                  value={newFront}\n                  onChange={(e) => setNewFront(e.target.value)}\n                  placeholder=\"Ex.: Qual a conduta imediata na hipercalemia grave com alargamento de QRS?\"\n                  className=\"rounded-lg border border-slate-200 bg-white p-3 text-sm text-slate-900 focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-500/20 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100\"\n                />\n              </div>\n              <div className=\"flex flex-col gap-1.5\">\n                <label\n                  htmlFor=\"new-fc-back\"\n                  className=\"text-xs font-medium text-slate-600 dark:text-slate-400\"\n                >\n                  Verso (P\303\251rola Cl\303\255nica / Resposta direta)\n                </label>\n                <textarea\n                  id=\"new-fc-back\"\n                  rows={3}\n                  required\n                  value={newBack}\n                  onChange={(e) => setNewBack(e.target.value)}\n                  placeholder=\"Ex.: Gluconato de c\303\241lcio 10% (10 mL IV em 2\342\200\2235 min) para estabiliza\303\247\303\243o imediata da membrana mioc\303\241rdica.\"\n                  className=\"rounded-lg border border-slate-200 bg-white p-3 text-sm text-slate-900 focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-500/20 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100\"\n                />\n              </div>\n            </div>\n\n            <div className=\"flex justify-end gap-2\">\n              <Button\n                variant=\"outline\"\n                size=\"sm\"\n                onClick={() => setShowCreateForm(false)}\n              >\n                Cancelar\n              </Button>\n              <Button type=\"submit\" variant=\"primary\" size=\"sm\">\n                Salvar no baralho\n              </Button>\n            </div>\n          </form>\n        )}\n      </section>\n\n      {/* VIEW 1: ACTIVE SRS REVIEW STAGE */}\n      {viewMode === \'revisao\' && (\n        <div className=\"mx-auto max-w-3xl\">\n          {activeCard ? (\n            <article className=\"rounded-xl border border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900\">\n              {/* Card Metadata Header */}\n              <div className=\"flex flex-wrap items-center justify-between gap-2 border-b border-slate-200 px-5 py-3.5 sm:px-7 dark:border-slate-800\">\n                <div className=\"flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-slate-500 dark:text-slate-400\">\n                  <span className=\"font-semibold text-sky-700 dark:text-sky-400\">\n                    {activeCard.grandeArea}\n                  </span>\n                  <span aria-hidden=\"true\">/</span>\n                  <span className=\"font-medium text-slate-800 dark:text-slate-200\">\n                    {activeCard.tema}\n                  </span>\n                  {activeCard.institutionLabel && (\n                    <>\n                      <span aria-hidden=\"true\">\302\267</span>\n                      <span className=\"font-mono\">{activeCard.institutionLabel}</span>\n                    </>\n                  )}\n                  <span aria-hidden=\"true\">\302\267</span>\n                  <span className=\"font-medium text-slate-700 dark:text-slate-300\">\n                    {FSRS_STATE_LABEL[activeCard.state]}\n                  </span>\n                  {activeCard.state !== \'New\' && (\n                    <>\n                      <span aria-hidden=\"true\">\302\267</span>\n                      <span className=\"font-mono tabular-nums\">\n                        S {activeCard.stability.toFixed(1)}d \302\267 D{\' \'}\n                        {activeCard.difficulty.toFixed(1)}\n                        {activeRetrievabilityPct !== null\n                          ? ` \302\267 R ${activeRetrievabilityPct}%`\n                          : \'\'}\n                      </span>\n                    </>\n                  )}\n                </div>\n\n                <span className=\"font-mono text-xs tabular-nums text-slate-500 dark:text-slate-400\">\n                  {practiceAhead\n                    ? `Pr\303\241tica livre \302\267 ${sessionIndex + 1}/${dueQueue.length}`\n                    : `Restam ${dueQueue.length} hoje`}\n                </span>\n              </div>\n\n              {/* Dynamic FSRS Calibration Seal & Justification Strip */}\n              {activeCalibration && (\n                <div\n                  className={cn(\n                    \'flex flex-wrap items-center justify-between gap-2 border-b px-5 py-2.5 sm:px-7 text-xs\',\n                    activeCalibration.mode === \'dinamica\' &&\n                      activeCalibration.individualStatus === \'ponto_atencao\'\n                      ? \'border-amber-200/80 bg-amber-50/50 dark:border-amber-900/50 dark:bg-amber-950/20\'\n                      : activeCalibration.mode === \'dinamica\' &&\n                        activeCalibration.boardTier === \'alta\'\n                      ? \'border-sky-200/70 bg-sky-50/40 dark:border-sky-900/50 dark:bg-sky-950/20\'\n                      : \'border-slate-200/80 bg-slate-50/60 dark:border-slate-800 dark:bg-slate-950/40\'\n                  )}\n                >\n                  <div className=\"flex flex-wrap items-center gap-2 min-w-0\">\n                    <SlidersHorizontal\n                      className={cn(\n                        \'h-3.5 w-3.5 shrink-0\',\n                        activeCalibration.mode === \'dinamica\' &&\n                          activeCalibration.individualStatus === \'ponto_atencao\'\n                          ? \'text-amber-600 dark:text-amber-400\'\n                          : activeCalibration.mode === \'dinamica\'\n                          ? \'text-sky-600 dark:text-sky-400\'\n                          : \'text-slate-500 dark:text-slate-400\'\n                      )}\n                    />\n                    <span\n                      className={cn(\n                        \'font-semibold tabular-nums\',\n                        activeCalibration.mode === \'dinamica\' &&\n                          activeCalibration.individualStatus === \'ponto_atencao\'\n                          ? \'text-amber-900 dark:text-amber-200\'\n                          : activeCalibration.mode === \'dinamica\'\n                          ? \'text-slate-900 dark:text-slate-100\'\n                          : \'text-slate-700 dark:text-slate-300\'\n                      )}\n                    >\n                      {activeCalibration.summaryLabel}\n                    </span>\n                  </div>\n\n                  {activeCalibration.mode === \'dinamica\' ? (\n                    <span className=\"font-mono text-[11px] tabular-nums text-slate-500 dark:text-slate-400\">\n                      Base 89% \302\267 Banca {formatDeltaPct(activeCalibration.deltaBanca)} \302\267\n                      Desempenho {formatDeltaPct(activeCalibration.deltaIndividual)}\n                      {activeCalibration.userAccuracyPct !== null &&\n                        activeCalibration.communityMedianPct !== null && (\n                          <>\n                            {\' \'}\n                            ({activeCalibration.userAccuracyPct.toFixed(0)}% vs{\' \'}\n                            {activeCalibration.communityMedianPct.toFixed(0)}%)\n                          </>\n                        )}\n                    </span>\n                  ) : (\n                    <button\n                      type=\"button\"\n                      onClick={() => onChangeRetentionMode(\'dinamica\')}\n                      className=\"text-[11px] font-semibold text-sky-700 hover:text-sky-900 dark:text-sky-400 dark:hover:text-sky-200 cursor-pointer whitespace-nowrap\"\n                    >\n                      Ativar Calibra\303\247\303\243o Din\303\242mica\n                    </button>\n                  )}\n                </div>\n              )}\n\n              {/* Card Body: Front always visible, Back revealed on flip */}\n              <div className=\"px-5 py-8 sm:px-8 sm:py-10 space-y-6\">\n                <div className=\"space-y-2.5\">\n                  <p className=\"text-xs font-semibold text-slate-400 dark:text-slate-500\">\n                    Frente \342\200\224 Recorda\303\247\303\243o Ativa\n                  </p>\n                  <p className=\"max-w-[72ch] text-base sm:text-lg font-medium leading-[1.68] text-slate-900 dark:text-slate-100\">\n                    {activeCard.front}\n                  </p>\n                </div>\n\n                {!flipped ? (\n                  <div className=\"pt-6 border-t border-slate-100 dark:border-slate-800 flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n                    <div className=\"flex flex-wrap items-center gap-x-3 gap-y-1.5\">\n                      <p className=\"text-xs text-slate-500 dark:text-slate-400\">\n                        Tente formular a conduta mentalmente antes de revelar o verso.\n                      </p>\n\n                      {/* Pre-flip FSRS next-review forecast tooltip trigger */}\n                      {fsrsOutcomes && activeCalibration && (\n                        <div className=\"relative group inline-flex\">\n                          <button\n                            type=\"button\"\n                            className=\"inline-flex items-center gap-1 text-xs font-medium text-sky-700 hover:text-sky-900 dark:text-sky-400 dark:hover:text-sky-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-500 rounded cursor-help\"\n                            aria-describedby=\"pre-flip-fsrs-tooltip\"\n                          >\n                            <CalendarClock className=\"h-3.5 w-3.5\" />\n                            <span>Previs\303\243o FSRS</span>\n                          </button>\n\n                          <div\n                            id=\"pre-flip-fsrs-tooltip\"\n                            role=\"tooltip\"\n                            className=\"pointer-events-none invisible opacity-0 translate-y-1 group-hover:visible group-hover:opacity-100 group-hover:translate-y-0 group-focus-within:visible group-focus-within:opacity-100 group-focus-within:translate-y-0 transition-all duration-150 absolute bottom-full left-0 z-30 mb-2 w-72 rounded-lg border border-slate-700/80 bg-slate-900 p-3 text-left text-xs text-slate-100 shadow-lg dark:border-slate-700 dark:bg-slate-800\"\n                          >\n                            <div className=\"border-b border-slate-700/80 pb-2 mb-2 space-y-0.5\">\n                              <div className=\"flex items-center justify-between gap-2\">\n                                <span className=\"font-semibold text-white\">\n                                  Pr\303\263xima revis\303\243o estimada\n                                </span>\n                                <span className=\"font-mono text-[10px] text-sky-300 tabular-nums\">\n                                  Alvo {activeCalibration.retentionPct}%\n                                </span>\n                              </div>\n                              <p className=\"text-[11px] text-slate-300 leading-snug\">\n                                {activeCalibration.summaryLabel}\n                              </p>\n                            </div>\n                            <dl className=\"space-y-1\">\n                              {RATING_CONFIG.map((cfg) => {\n                                const outcome = fsrsOutcomes[cfg.rating];\n                                return (\n                                  <div\n                                    key={cfg.rating}\n                                    className=\"flex items-center justify-between gap-2\"\n                                  >\n                                    <dt className=\"flex items-center gap-1.5 text-slate-300\">\n                                      <span\n                                        className={cn(\n                                          \'h-1.5 w-1.5 rounded-full\',\n                                          cfg.dotClass\n                                        )}\n                                      />\n                                      <span>{cfg.label}</span>\n                                    </dt>\n                                    <dd className=\"font-mono tabular-nums text-white\">\n                                      {outcome.longPreviewLabel}\n                                      <span className=\"text-slate-400\">\n                                        {\' \'}\n                                        \302\267 {formatOutcomeDate(outcome)}\n                                      </span>\n                                    </dd>\n                                  </div>\n                                );\n                              })}\n                            </dl>\n                          </div>\n                        </div>\n                      )}\n                    </div>\n\n                    <Button\n                      variant=\"primary\"\n                      size=\"lg\"\n                      onClick={() => setFlipped(true)}\n                    >\n                      <RotateCw className=\"h-4 w-4\" />\n                      <span>Virar card</span>\n                      <kbd className=\"ml-1 rounded bg-white/20 px-1.5 py-0.5 font-mono text-[11px] dark:bg-slate-950/20\">\n                        Espa\303\247o\n                      </kbd>\n                    </Button>\n                  </div>\n                ) : (\n                  <div className=\"space-y-6 pt-6 border-t border-slate-200 dark:border-slate-800\">\n                    {/* Verso: Clinical Pearl + Optional Answer Summary */}\n                    <div className=\"rounded-xl border border-sky-200 bg-sky-50/70 p-5 sm:p-6 dark:border-sky-900/60 dark:bg-sky-950/30 space-y-3\">\n                      <div className=\"flex flex-wrap items-center justify-between gap-2\">\n                        <span className=\"inline-flex items-center gap-1.5 text-xs font-semibold text-sky-800 dark:text-sky-300\">\n                          <Sparkles className=\"h-3.5 w-3.5\" />\n                          <span>Verso \342\200\224 P\303\251rola Cl\303\255nica</span>\n                        </span>\n\n                        {activeCard.questionId && (\n                          <button\n                            type=\"button\"\n                            onClick={() =>\n                              onOpenOriginalQuestion(activeCard.questionId!)\n                            }\n                            className=\"inline-flex items-center gap-1 text-xs font-semibold text-sky-700 hover:text-sky-900 dark:text-sky-400 dark:hover:text-sky-200 cursor-pointer whitespace-nowrap\"\n                          >\n                            <span>Abrir quest\303\243o original</span>\n                            <ArrowUpRight className=\"h-3.5 w-3.5\" />\n                          </button>\n                        )}\n                      </div>\n\n                      <p className=\"max-w-[72ch] text-[15px] sm:text-base font-semibold leading-relaxed text-slate-900 dark:text-white\">\n                        {activeCard.backPearl}\n                      </p>\n\n                      {activeCard.backAnswerSummary && (\n                        <p className=\"max-w-[72ch] text-xs sm:text-sm leading-relaxed text-slate-600 dark:text-slate-300 pt-2 border-t border-sky-200/70 dark:border-sky-900/50\">\n                          {activeCard.backAnswerSummary}\n                        </p>\n                      )}\n                    </div>\n\n                    {/* 4 FSRS Rating Buttons + Live Next-Review Forecast Widget & Hover Tooltips */}\n                    {fsrsOutcomes && activeCalibration && (\n                      <div className=\"space-y-3\">\n                        <div className=\"flex flex-wrap items-center justify-between gap-2 text-xs text-slate-500 dark:text-slate-400\">\n                          <span>\n                            Como foi sua recorda\303\247\303\243o? (Atalhos: 1, 2, 3 ou 4)\n                          </span>\n                          <span\n                            className={cn(\n                              \'inline-flex items-center gap-1.5 text-[11px] font-semibold tabular-nums\',\n                              activeCalibration.mode === \'dinamica\' &&\n                                activeCalibration.individualStatus === \'ponto_atencao\'\n                                ? \'text-amber-700 dark:text-amber-400\'\n                                : \'text-sky-700 dark:text-sky-400\'\n                            )}\n                          >\n                            <SlidersHorizontal className=\"h-3 w-3 shrink-0\" />\n                            <span>{activeCalibration.summaryLabel}</span>\n                          </span>\n                        </div>\n\n                        {/* Interactive FSRS Decision Preview Widget */}\n                        <div\n                          aria-live=\"polite\"\n                          className=\"rounded-lg border border-slate-200 bg-slate-50/80 px-3.5 py-2.5 dark:border-slate-800 dark:bg-slate-950/60 space-y-2\"\n                        >\n                          {hoveredOutcome && hoveredConfig ? (\n                            <div className=\"flex flex-wrap items-center justify-between gap-2 text-xs\">\n                              <div className=\"flex items-center gap-2 min-w-0\">\n                                <span\n                                  className={cn(\n                                    \'h-2 w-2 shrink-0 rounded-full\',\n                                    hoveredConfig.dotClass\n                                  )}\n                                />\n                                <span className=\"font-semibold text-slate-900 dark:text-slate-100\">\n                                  {hoveredConfig.label}\n                                </span>\n                                <span className=\"text-slate-400\" aria-hidden=\"true\">\n                                  \342\206\222\n                                </span>\n                                <span className=\"text-slate-700 dark:text-slate-300 tabular-nums\">\n                                  {hoveredOutcome.scheduled_days === 0 &&\n                                  hoveredOutcome.previewLabel === \'< 10m\' ? (\n                                    <>\n                                      Reaparece hoje em{\' \'}\n                                      <strong className=\"font-semibold text-slate-900 dark:text-white\">\n                                        {hoveredOutcome.longPreviewLabel}\n                                      </strong>\n                                    </>\n                                  ) : (\n                                    <>\n                                      Pr\303\263xima revis\303\243o em{\' \'}\n                                      <strong className=\"font-semibold text-slate-900 dark:text-white\">\n                                        {hoveredOutcome.longPreviewLabel}\n                                      </strong>{\' \'}\n                                      <span className=\"font-mono text-[11px] text-slate-500 dark:text-slate-400\">\n                                        ({formatOutcomeDate(hoveredOutcome)})\n                                      </span>\n                                    </>\n                                  )}\n                                </span>\n                              </div>\n                              <span className=\"font-mono text-[11px] tabular-nums text-slate-500 dark:text-slate-400\">\n                                Nova S {hoveredOutcome.stability.toFixed(1)}d \302\267 D{\' \'}\n                                {hoveredOutcome.difficulty.toFixed(1)} \302\267{\' \'}\n                                {FSRS_STATE_LABEL[hoveredOutcome.state]}\n                              </span>\n                            </div>\n                          ) : (\n                            <div className=\"flex flex-wrap items-center justify-between gap-2 text-xs\">\n                              <span className=\"inline-flex items-center gap-1.5 font-medium text-slate-600 dark:text-slate-300\">\n                                <CalendarClock className=\"h-3.5 w-3.5 text-sky-600 dark:text-sky-400 shrink-0\" />\n                                <span>Previs\303\243o da pr\303\263xima revis\303\243o:</span>\n                              </span>\n                              <div className=\"flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-[11px] tabular-nums\">\n                                {RATING_CONFIG.map((cfg) => (\n                                  <span\n                                    key={cfg.rating}\n                                    className=\"inline-flex items-center gap-1 text-slate-600 dark:text-slate-300\"\n                                  >\n                                    <span\n                                      className={cn(\n                                        \'h-1.5 w-1.5 rounded-full\',\n                                        cfg.dotClass\n                                      )}\n                                    />\n                                    <span className=\"font-sans text-slate-500 dark:text-slate-400\">\n                                      {cfg.label}:\n                                    </span>\n                                    <strong className=\"font-semibold text-slate-800 dark:text-slate-100\">\n                                      {fsrsOutcomes[cfg.rating].longPreviewLabel}\n                                    </strong>\n                                  </span>\n                                ))}\n                              </div>\n                            </div>\n                          )}\n\n                          {/* Dynamic calibration justification footer inside FSRS Forecast Panel */}\n                          <div className=\"flex flex-wra"
    num_lines: 1295
    num_bytes: 59494
    line_range_bytes: 59494
  }
