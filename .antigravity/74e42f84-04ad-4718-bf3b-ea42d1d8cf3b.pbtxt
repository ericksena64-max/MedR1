    tool_calls {
      id: "call_6772595147617030762"
      name: "multi_replace_file_content"
      arguments_json: "{\"Description\":\"Add human-readable Portuguese interval formatter and longPreviewLabel to FSRS outcomes\", \"Instruction\":\"Add longPreviewLabel to FsrsScheduleOutcome and formatFsrsIntervalLong helper in src/lib/srs.ts\", \"ReplacementChunks\":[{\"AllowMultiple\":false, \"EndLine\":54, \"ReplacementContent\":\"  dueAt: string;\\n  previewLabel: string;\\n  longPreviewLabel: string;\\n}\", \"StartLine\":50, \"TargetContent\":\"  dueAt: string;\\n  previewLabel: string;\\n}\"}, {\"AllowMultiple\":false, \"EndLine\":149, \"ReplacementContent\":\"export function formatFsrsInterval(days: number, intraDayMinutes?: number): string {\\n  if (intraDayMinutes !== undefined && intraDayMinutes < 60) {\\n    return intraDayMinutes <= 10 ? \'< 10m\' : `${Math.round(intraDayMinutes)}m`;\\n  }\\n  if (days < 1 / 24) {\\n    return \'< 10m\';\\n  }\\n  if (days < 1) {\\n    const hrs = Math.max(1, Math.round(days * 24));\\n    return `${hrs}h`;\\n  }\\n  const roundedDays = Math.round(days);\\n  if (roundedDays < 30) return `${roundedDays}d`;\\n  if (roundedDays < 365) {\\n    const months = Number((roundedDays / 30).toFixed(1));\\n    return months % 1 === 0 ? `${Math.round(months)}m` : `${months}m`;\\n  }\\n  const years = Number((roundedDays / 365).toFixed(1));\\n  return `${years}a`;\\n}\\n\\nexport function formatFsrsIntervalLong(days: number, intraDayMinutes?: number): string {\\n  if (intraDayMinutes !== undefined && intraDayMinutes < 60) {\\n    return intraDayMinutes <= 10 ? \'< 10 min\' : `${Math.round(intraDayMinutes)} min`;\\n  }\\n  if (days < 1 / 24) {\\n    return \'< 10 min\';\\n  }\\n  if (days < 1) {\\n    const hrs = Math.max(1, Math.round(days * 24));\\n    return hrs === 1 ? \'1 hora\' : `${hrs} horas`;\\n  }\\n  const roundedDays = Math.round(days);\\n  if (roundedDays < 30) {\\n    return roundedDays === 1 ? \'1 dia\' : `${roundedDays} dias`;\\n  }\\n  if (roundedDays < 365) {\\n    const months = Number((roundedDays / 30).toFixed(1));\\n    if (months === 1) return \'1 m\303\252s\';\\n    const formatted =\\n      months % 1 === 0 ? String(Math.round(months)) : months.toFixed(1).replace(\'.\', \',\');\\n    return `${formatted} meses`;\\n  }\\n  const years = Number((roundedDays / 365).toFixed(1));\\n  if (years === 1) return \'1 ano\';\\n  const formatted =\\n    years % 1 === 0 ? String(Math.round(years)) : years.toFixed(1).replace(\'.\', \',\');\\n  return `${formatted} anos`;\\n}\", \"StartLine\":129, \"TargetContent\":\"export function formatFsrsInterval(days: number, intraDayMinutes?: number): string {\\n  if (intraDayMinutes !== undefined && intraDayMinutes < 60) {\\n    return intraDayMinutes <= 10 ? \'< 10m\' : `${Math.round(intraDayMinutes)}m`;\\n  }\\n  if (days < 1 / 24) {\\n    return \'< 10m\';\\n  }\\n  if (days < 1) {\\n    const hrs = Math.max(1, Math.round(days * 24));\\n    return `${hrs}h`;\\n  }\\n  const roundedDays = Math.round(days);\\n  if (roundedDays < 30) return `${roundedDays}d`;\\n  if (roundedDays < 365) {\\n    const months = Number((roundedDays / 30).toFixed(1));\\n    return months % 1 === 0 ? `${Math.round(months)}m` : `${months}m`;\\n  }\\n  const years = Number((roundedDays / 365).toFixed(1));\\n  return `${years}a`;\\n}\"}, {\"AllowMultiple\":false, \"EndLine\":235, \"ReplacementContent\":\"    return {\\n      1: {\\n        stability: sAgain,\\n        difficulty: initDifficulty(1),\\n        elapsed_days: 0,\\n        scheduled_days: 0,\\n        reps: card.reps + 1,\\n        lapses: card.lapses + 1,\\n        state: \'Learning\',\\n        dueAt: new Date(now.getTime() + 5 * MINUTE_MS).toISOString(),\\n        previewLabel: \'< 10m\',\\n        longPreviewLabel: \'< 10 min\',\\n      },\\n      2: {\\n        stability: sHard,\\n        difficulty: initDifficulty(2),\\n        elapsed_days: 0,\\n        scheduled_days: hardDays,\\n        reps: card.reps + 1,\\n        lapses: card.lapses,\\n        state: hardIsSubDay ? \'Learning\' : \'Review\',\\n        dueAt: new Date(hardDueMs).toISOString(),\\n        previewLabel: hardIsSubDay\\n          ? formatFsrsInterval(rawHardDays)\\n          : formatFsrsInterval(hardDays),\\n        longPreviewLabel: hardIsSubDay\\n          ? formatFsrsIntervalLong(rawHardDays)\\n          : formatFsrsIntervalLong(hardDays),\\n      },\\n      3: {\\n        stability: sGood,\\n        difficulty: initDifficulty(3),\\n        elapsed_days: 0,\\n        scheduled_days: goodDays,\\n        reps: card.reps + 1,\\n        lapses: card.lapses,\\n        state: \'Review\',\\n        dueAt: new Date(now.getTime() + goodDays * DAY_MS).toISOString(),\\n        previewLabel: formatFsrsInterval(goodDays),\\n        longPreviewLabel: formatFsrsIntervalLong(goodDays),\\n      },\\n      4: {\\n        stability: sEasy,\\n        difficulty: initDifficulty(4),\\n        elapsed_days: 0,\\n        scheduled_days: easyDays,\\n        reps: card.reps + 1,\\n        lapses: card.lapses,\\n        state: \'Review\',\\n        dueAt: new Date(now.getTime() + easyDays * DAY_MS).toISOString(),\\n        previewLabel: formatFsrsInterval(easyDays),\\n        longPreviewLabel: formatFsrsIntervalLong(easyDays),\\n      },\\n    };\", \"StartLine\":187, \"TargetContent\":\"    return {\\n      1: {\\n        stability: sAgain,\\n        difficulty: initDifficulty(1),\\n        elapsed_days: 0,\\n        scheduled_days: 0,\\n        reps: card.reps + 1,\\n        lapses: card.lapses + 1,\\n        state: \'Learning\',\\n        dueAt: new Date(now.getTime() + 5 * MINUTE_MS).toISOString(),\\n        previewLabel: \'< 10m\',\\n      },\\n      2: {\\n        stability: sHard,\\n        difficulty: initDifficulty(2),\\n        elapsed_days: 0,\\n        scheduled_days: hardDays,\\n        reps: card.reps + 1,\\n        lapses: card.lapses,\\n        state: hardIsSubDay ? \'Learning\' : \'Review\',\\n        dueAt: new Date(hardDueMs).toISOString(),\\n        previewLabel: hardIsSubDay\\n          ? formatFsrsInterval(rawHardDays)\\n          : formatFsrsInterval(hardDays),\\n      },\\n      3: {\\n        stability: sGood,\\n        difficulty: initDifficulty(3),\\n        elapsed_days: 0,\\n        scheduled_days: goodDays,\\n        reps: card.reps + 1,\\n        lapses: card.lapses,\\n        state: \'Review\',\\n        dueAt: new Date(now.getTime() + goodDays * DAY_MS).toISOString(),\\n        previewLabel: formatFsrsInterval(goodDays),\\n      },\\n      4: {\\n        stability: sEasy,\\n        difficulty: initDifficulty(4),\\n        elapsed_days: 0,\\n        scheduled_days: easyDays,\\n        reps: card.reps + 1,\\n        lapses: card.lapses,\\n        state: \'Review\',\\n        dueAt: new Date(now.getTime() + easyDays * DAY_MS).toISOString(),\\n        previewLabel: formatFsrsInterval(easyDays),\\n      },\\n    };\"}, {\"AllowMultiple\":false, \"EndLine\":306, \"ReplacementContent\":\"    return {\\n      1: {\\n        stability: sAgain,\\n        difficulty: nextDifficulty(baseD, 1),\\n        elapsed_days: elapsed,\\n        scheduled_days: 0,\\n        reps: card.reps + 1,\\n        lapses: card.lapses + 1,\\n        state: card.state,\\n        dueAt: new Date(now.getTime() + 5 * MINUTE_MS).toISOString(),\\n        previewLabel: \'< 10m\',\\n        longPreviewLabel: \'< 10 min\',\\n      },\\n      2: {\\n        stability: sHard,\\n        difficulty: nextDifficulty(baseD, 2),\\n        elapsed_days: elapsed,\\n        scheduled_days: hardDays,\\n        reps: card.reps + 1,\\n        lapses: card.lapses,\\n        state: hardIsSubDay ? card.state : \'Review\',\\n        dueAt: new Date(hardDueMs).toISOString(),\\n        previewLabel: hardIsSubDay\\n          ? formatFsrsInterval(rawHardDays)\\n          : formatFsrsInterval(hardDays),\\n        longPreviewLabel: hardIsSubDay\\n          ? formatFsrsIntervalLong(rawHardDays)\\n          : formatFsrsIntervalLong(hardDays),\\n      },\\n      3: {\\n        stability: sGood,\\n        difficulty: nextDifficulty(baseD, 3),\\n        elapsed_days: elapsed,\\n        scheduled_days: goodDays,\\n        reps: card.reps + 1,\\n        lapses: card.lapses,\\n        state: \'Review\',\\n        dueAt: new Date(now.getTime() + goodDays * DAY_MS).toISOString(),\\n        previewLabel: formatFsrsInterval(goodDays),\\n        longPreviewLabel: formatFsrsIntervalLong(goodDays),\\n      },\\n      4: {\\n        stability: sEasy,\\n        difficulty: nextDifficulty(baseD, 4),\\n        elapsed_days: elapsed,\\n        scheduled_days: easyDays,\\n        reps: card.reps + 1,\\n        lapses: card.lapses,\\n        state: \'Review\',\\n        dueAt: new Date(now.getTime() + easyDays * DAY_MS).toISOString(),\\n        previewLabel: formatFsrsInterval(easyDays),\\n        longPreviewLabel: formatFsrsIntervalLong(easyDays),\\n      },\\n    };\", \"StartLine\":258, \"TargetContent\":\"    return {\\n      1: {\\n        stability: sAgain,\\n        difficulty: nextDifficulty(baseD, 1),\\n        elapsed_days: elapsed,\\n        scheduled_days: 0,\\n        reps: card.reps + 1,\\n        lapses: card.lapses + 1,\\n        state: card.state,\\n        dueAt: new Date(now.getTime() + 5 * MINUTE_MS).toISOString(),\\n        previewLabel: \'< 10m\',\\n      },\\n      2: {\\n        stability: sHard,\\n        difficulty: nextDifficulty(baseD, 2),\\n        elapsed_days: elapsed,\\n        scheduled_days: hardDays,\\n        reps: card.reps + 1,\\n        lapses: card.lapses,\\n        state: hardIsSubDay ? card.state : \'Review\',\\n        dueAt: new Date(hardDueMs).toISOString(),\\n        previewLabel: hardIsSubDay\\n          ? formatFsrsInterval(rawHardDays)\\n          : formatFsrsInterval(hardDays),\\n      },\\n      3: {\\n        stability: sGood,\\n        difficulty: nextDifficulty(baseD, 3),\\n        elapsed_days: elapsed,\\n        scheduled_days: goodDays,\\n        reps: card.reps + 1,\\n        lapses: card.lapses,\\n        state: \'Review\',\\n        dueAt: new Date(now.getTime() + goodDays * DAY_MS).toISOString(),\\n        previewLabel: formatFsrsInterval(goodDays),\\n      },\\n      4: {\\n        stability: sEasy,\\n        difficulty: nextDifficulty(baseD, 4),\\n        elapsed_days: elapsed,\\n        scheduled_days: easyDays,\\n        reps: card.reps + 1,\\n        lapses: card.lapses,\\n        state: \'Review\',\\n        dueAt: new Date(now.getTime() + easyDays * DAY_MS).toISOString(),\\n        previewLabel: formatFsrsInterval(easyDays),\\n      },\\n    };\"}, {\"AllowMultiple\":false, \"EndLine\":377, \"ReplacementContent\":\"  return {\\n    1: {\\n      stability: sAgain,\\n      difficulty: nextDifficulty(d, 1),\\n      elapsed_days: elapsed,\\n      scheduled_days: 0,\\n      reps: card.reps + 1,\\n      lapses: card.lapses + 1,\\n      state: \'Relearning\',\\n      dueAt: new Date(now.getTime() + 10 * MINUTE_MS).toISOString(),\\n      previewLabel: \'< 10m\',\\n      longPreviewLabel: \'< 10 min\',\\n    },\\n    2: {\\n      stability: sHard,\\n      difficulty: nextDifficulty(d, 2),\\n      elapsed_days: elapsed,\\n      scheduled_days: hardDays,\\n      reps: card.reps + 1,\\n      lapses: card.lapses,\\n      state: \'Review\',\\n      dueAt: new Date(now.getTime() + hardDays * DAY_MS).toISOString(),\\n      previewLabel: formatFsrsInterval(hardDays),\\n      longPreviewLabel: formatFsrsIntervalLong(hardDays),\\n    },\\n    3: {\\n      stability: sGood,\\n      difficulty: nextDifficulty(d, 3),\\n      elapsed_days: elapsed,\\n      scheduled_days: goodDays,\\n      reps: card.reps + 1,\\n      lapses: card.lapses,\\n      state: \'Review\',\\n      dueAt: new Date(now.getTime() + goodDays * DAY_MS).toISOString(),\\n      previewLabel: formatFsrsInterval(goodDays),\\n      longPreviewLabel: formatFsrsIntervalLong(goodDays),\\n    },\\n    4: {\\n      stability: sEasy,\\n      difficulty: nextDifficulty(d, 4),\\n      elapsed_days: elapsed,\\n      scheduled_days: easyDays,\\n      reps: