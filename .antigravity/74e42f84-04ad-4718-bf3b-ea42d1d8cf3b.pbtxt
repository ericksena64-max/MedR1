            }
            lines {
              text: " *"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " * - deltaBanca: board incidence weight (+0.03 alta, 0.00 m\303\251dia, -0.03 baixa)"
