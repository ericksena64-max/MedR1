    content: "import type {\n  HistoricalAreaPerformance,\n  HistoricalTopicPerformance,\n  TemporalPoint,\n} from \'../types/medical\';\n\n// Baseline history so the student immediately sees a realistic longitudinal dashboard,\n// and every new question answered in the session dynamically recalculates these numbers!\nexport const HISTORICAL_AREA_PERFORMANCE: HistoricalAreaPerformance[] = [\n  {\n    grandeAreaId: \'clinica_medica\',\n    grandeArea: \'Cl\303\255nica M\303\251dica\',\n    shortName: \'Cl\303\255nica M\303\251dica\',\n    baseAnswered: 44,\n    baseCorrect: 33,\n    communityMedianPct: 64.5,\n    communityP75Pct: 76.0,\n  },\n  {\n    grandeAreaId: \'cirurgia_geral\',\n    grandeArea: \'Cirurgia Geral\',\n    shortName: \'Cirurgia Geral\',\n    baseAnswered: 32,\n    baseCorrect: 21,\n    communityMedianPct: 62.0,\n    communityP75Pct: 74.5,\n  },\n  {\n    grandeAreaId: \'ginecologia_obstetricia\',\n    grandeArea: \'Ginecologia e Obstetr\303\255cia\',\n    shortName: \'GO\',\n    baseAnswered: 28,\n    baseCorrect: 16,\n    communityMedianPct: 66.2,\n    communityP75Pct: 77.5,\n  },\n  {\n    grandeAreaId: \'pediatria\',\n    grandeArea: \'Pediatria\',\n    shortName: \'Pediatria\',\n    baseAnswered: 26,\n    baseCorrect: 20,\n    communityMedianPct: 68.0,\n    communityP75Pct: 79.0,\n  },\n  {\n    grandeAreaId: \'medicina_preventiva\',\n    grandeArea: \'Medicina Preventiva e Social\',\n    shortName: \'Preventiva\',\n    baseAnswered: 22,\n    baseCorrect: 14,\n    communityMedianPct: 69.5,\n    communityP75Pct: 81.0,\n  },\n];\n\nexport const HISTORICAL_TOPIC_PERFORMANCE: HistoricalTopicPerformance[] = [\n  {\n    grandeAreaId: \'clinica_medica\',\n    grandeArea: \'Cl\303\255nica M\303\251dica\',\n    tema: \'Cardiologia\',\n    baseAnswered: 16,\n    baseCorrect: 13,\n    communityMedianPct: 65.0,\n    communityP75Pct: 78.0,\n  },\n  {\n    grandeAreaId: \'clinica_medica\',\n    grandeArea: \'Cl\303\255nica M\303\251dica\',\n    tema: \'Nefrologia\',\n    baseAnswered: 10,\n    baseCorrect: 7,\n    communityMedianPct: 61.5,\n    communityP75Pct: 73.0,\n  },\n  {\n    grandeAreaId: \'clinica_medica\',\n    grandeArea: \'Cl\303\255nica M\303\251dica\',\n    tema: \'Endocrinologia\',\n    baseAnswered: 9,\n    baseCorrect: 6,\n    communityMedianPct: 63.0,\n    communityP75Pct: 75.0,\n  },\n  {\n    grandeAreaId: \'clinica_medica\',\n    grandeArea: \'Cl\303\255nica M\303\251dica\',\n    tema: \'Infectologia\',\n    baseAnswered: 9,\n    baseCorrect: 7,\n    communityMedianPct: 66.0,\n    communityP75Pct: 77.0,\n  },\n  {\n    grandeAreaId: \'cirurgia_geral\',\n    grandeArea: \'Cirurgia Geral\',\n    tema: \'Trauma\',\n    baseAnswered: 18,\n    baseCorrect: 13,\n    communityMedianPct: 64.0,\n    communityP75Pct: 76.5,\n  },\n  {\n    grandeAreaId: \'cirurgia_geral\',\n    grandeArea: \'Cirurgia Geral\',\n    tema: \'Abdome Agudo\',\n    baseAnswered: 14,\n    baseCorrect: 8,\n    communityMedianPct: 60.5,\n    communityP75Pct: 73.0,\n  },\n  {\n    grandeAreaId: \'ginecologia_obstetricia\',\n    grandeArea: \'Ginecologia e Obstetr\303\255cia\',\n    tema: \'Obstetr\303\255cia / Pr\303\251-Natal\',\n    baseAnswered: 11,\n    baseCorrect: 7,\n    communityMedianPct: 67.0,\n    communityP75Pct: 78.0,\n  },\n  {\n    grandeAreaId: \'ginecologia_obstetricia\',\n    grandeArea: \'Ginecologia e Obstetr\303\255cia\',\n    tema: \'Obstetr\303\255cia / Urg\303\252ncias\',\n    baseAnswered: 9,\n    baseCorrect: 6,\n    communityMedianPct: 69.0,\n    communityP75Pct: 80.5,\n  },\n  {\n    grandeAreaId: \'ginecologia_obstetricia\',\n    grandeArea: \'Ginecologia e Obstetr\303\255cia\',\n    tema: \'Ginecologia\',\n    baseAnswered: 8,\n    baseCorrect: 3,\n    communityMedianPct: 62.5,\n    communityP75Pct: 74.0,\n  },\n  {\n    grandeAreaId: \'pediatria\',\n    grandeArea: \'Pediatria\',\n    tema: \'Neonatologia\',\n    baseAnswered: 10,\n    baseCorrect: 8,\n    communityMedianPct: 69.5,\n    communityP75Pct: 81.0,\n  },\n  {\n    grandeAreaId: \'pediatria\',\n    grandeArea: \'Pediatria\',\n    tema: \'Infectopediatria\',\n    baseAnswered: 8,\n    baseCorrect: 6,\n    communityMedianPct: 68.0,\n    communityP75Pct: 78.5,\n  },\n  {\n    grandeAreaId: \'pediatria\',\n    grandeArea: \'Pediatria\',\n    tema: \'Puericultura / Imuniza\303\247\303\265es\',\n    baseAnswered: 8,\n    baseCorrect: 6,\n    communityMedianPct: 66.0,\n    communityP75Pct: 77.0,\n  },\n  {\n    grandeAreaId: \'medicina_preventiva\',\n    grandeArea: \'Medicina Preventiva e Social\',\n    tema: \'Epidemiologia\',\n    baseAnswered: 9,\n    baseCorrect: 4,\n    communityMedianPct: 58.0,\n    communityP75Pct: 71.0,\n  },\n  {\n    grandeAreaId: \'medicina_preventiva\',\n    grandeArea: \'Medicina Preventiva e Social\',\n    tema: \'Pol\303\255ticas de Sa\303\272de / SUS\',\n    baseAnswered: 7,\n    baseCorrect: 6,\n    communityMedianPct: 74.0,\n    communityP75Pct: 84.5,\n  },\n  {\n    grandeAreaId: \'medicina_preventiva\',\n    grandeArea: \'Medicina Preventiva e Social\',\n    tema: \'Vigil\303\242ncia em Sa\303\272de\',\n    baseAnswered: 6,\n    baseCorrect: 4,\n    communityMedianPct: 68.0,\n    communityP75Pct: 79.0,\n  },\n];\n\nexport const TEMPORAL_EVOLUTION_WEEKLY: TemporalPoint[] = [\n  { period: \'Sem 1\', alunoPct: 58.0, medianaPct: 64.5, p75Pct: 76.0, questoes: 24 },\n  { period: \'Sem 2\', alunoPct: 61.5, medianaPct: 64.8, p75Pct: 76.2, questoes: 31 },\n  { period: \'Sem 3\', alunoPct: 64.2, medianaPct: 65.0, p75Pct: 76.5, questoes: 28 },\n  { period: \'Sem 4\', alunoPct: 66.8, medianaPct: 65.2, p75Pct: 76.8, questoes: 35 },\n  { period: \'Sem 5\', alunoPct: 69.4, medianaPct: 65.5, p75Pct: 77.0, questoes: 34 },\n  { period: \'Atual\', alunoPct: 68.4, medianaPct: 65.8, p75Pct: 77.2, questoes: 42 },\n];\n\nexport const TEMPORAL_EVOLUTION_MONTHLY: TemporalPoint[] = [\n  { period: \'Jun\', alunoPct: 54.5, medianaPct: 63.0, p75Pct: 74.5, questoes: 88 },\n  { period: \'Jul\', alunoPct: 59.2, medianaPct: 63.8, p75Pct: 75.2, questoes: 112 },\n  { period: \'Ago\', alunoPct: 63.6, medianaPct: 64.5, p75Pct: 76.0, questoes: 134 },\n  { period: \'Set\', alunoPct: 66.1, medianaPct: 65.1, p75Pct: 76.6, questoes: 148 },\n  { period: \'Out\', alunoPct: 69.8, medianaPct: 65.5, p75Pct: 77.0, questoes: 162 },\n  { period: \'Nov\', alunoPct: 68.4, medianaPct: 65.8, p75Pct: 77.2, questoes: 152 },\n];\n"
