      arguments_json: "{\"Description\":\"Show ranking only on click via retractable Sidebar and remove permanent LiveRankingWidget from Questions tab\", \"Instruction\":\"Remove LiveRankingWidget import and right-side widget in Questions tab, add sidebarCollapsed and persisted rankingPulseOn state, and pass props to Sidebar and LiveRankingPage.\", \"ReplacementChunks\":[{\"AllowMultiple\":false, \"EndLine\":26, \"ReplacementContent\":\"import { PerformanceDashboard } from \'./components/analytics/PerformanceDashboard\';\\nimport { LiveRankingPage } from \'./components/ranking/LiveRankingPage\';\\nimport { ErrorNotebookView } from \'./components/notebook/ErrorNotebookView\';\", \"StartLine\":20, \"TargetContent\":\"import { PerformanceDashboard } from \'./components/analytics/PerformanceDashboard\';\\nimport { LiveRankingWidget } from \'./components/ranking/LiveRankingWidget\';\\nimport { LiveRankingPage } from \'./components/ranking/LiveRankingPage\';\\nimport { ErrorNotebookView } from \'./components/notebook/ErrorNotebookView\';\"}, {\"AllowMultiple\":false, \"EndLine\":39, \"ReplacementContent\":\"  const [activeTab, setActiveTab] = useState<ActiveTab>(\'questoes\');\\n  const [mobileMenuOpen, setMobileMenuOpen] = useState(false);\\n  const [sidebarCollapsed, setSidebarCollapsed] = useState(false);\\n  const [focusMode, setFocusMode] = useState(false);\\n  const [rankingPulseOn, setRankingPulseOn] = useState<boolean>(() => {\\n    try {\\n      const saved = window.localStorage.getItem(\'medr1_ranking_pulse_v1\');\\n      return saved === null ? true : saved === \'true\';\\n    } catch {\\n      return true;\\n    }\\n  });\\n\\n  const handleToggleRankingPulse = useCallback((next?: boolean) => {\\n    setRankingPulseOn((prev) => {\\n      const resolved = typeof next === \'boolean\' ? next : !prev;\\n      try {\\n        window.localStorage.setItem(\'medr1_ranking_pulse_v1\', String(resolved));\\n      } catch {\\n        // ignore storage quota errors\\n      }\\n      return resolved;\\n    });\\n  }, []);\", \"StartLine\":31, \"TargetContent\":\"  const [activeTab, setActiveTab] = useState<ActiveTab>(\'questoes\');\\n  const [mobileMenuOpen, setMobileMenuOpen] = useState(false);\\n  const [focusMode, setFocusMode] = useState(false);\"}, {\"AllowMultiple\":false, \"EndLine\":305, \"ReplacementContent\":\"      {/* Persistent Retractable Navigation Sidebar (hidden cleanly in Focus Mode) */}\\n      {!focusMode && (\\n        <Sidebar\\n          activeTab={activeTab}\\n          onSelectTab={setActiveTab}\\n          profile={store.profile}\\n          errorNotebookCount={store.errorNotebookQuestions.length}\\n          dueFlashcardsCount={store.dueFlashcardsCount}\\n          onlineTotal={store.liveRanking.onlineTotal}\\n          currentUserRank={store.liveRanking.currentUser.rank}\\n          collapsed={sidebarCollapsed}\\n          onToggleCollapse={() => setSidebarCollapsed((c) => !c)}\\n          rankingPulseOn={rankingPulseOn}\\n          onToggleRankingPulse={handleToggleRankingPulse}\\n          mobileOpen={mobileMenuOpen}\\n          onCloseMobile={() => setMobileMenuOpen(false)}\\n        />\\n      )}\\n\\n      {/* Main Content Shell */}\\n      <div className=\\\"flex-1 flex flex-col min-w-0\\\">\\n        <TopBar\\n          activeTab={activeTab}\\n          darkMode={store.darkMode}\\n          onToggleDarkMode={() => store.setDarkMode((d) => !d)}\\n          focusMode={focusMode}\\n          onToggleFocusMode={() => setFocusMode((f) => !f)}\\n          onOpenMobileMenu={() => setMobileMenuOpen(true)}\\n        />\\n\\n        <main\\n          className={cn(\\n            \'flex-1 w-full mx-auto px-4 sm:px-6 lg:px-8 py-6\',\\n            focusMode ? \'max-w-4xl\' : \'max-w-[1440px]\'\\n          )}\\n        >\\n          {/* TAB 1: BANCO DE QUEST\303\225ES */}\\n          {activeTab === \'questoes\' && (\\n            <div className={cn(\'mx-auto w-full\', !focusMode && \'max-w-5xl\')}>\\n              {/* Primary Question Column */}\\n              <div className=\\\"space-y-5 min-w-0\\\">\", \"StartLine\":245, \"TargetContent\":\"      {/* Persistent Navigation Sidebar (hidden cleanly in Focus Mode) */}\\n      {!focusMode && (\\n        <Sidebar\\n          activeTab={activeTab}\\n          onSelectTab={setActiveTab}\\n          profile={store.profile}\\n          errorNotebookCount={store.errorNotebookQuestions.length}\\n          dueFlashcardsCount={store.dueFlashcardsCount}\\n          onlineTotal={store.liveRanking.onlineTotal}\\n          currentUserRank={store.liveRanking.currentUser.rank}\\n          mobileOpen={mobileMenuOpen}\\n          onCloseMobile={() => setMobileMenuOpen(false)}\\n        />\\n      )}\\n\\n      {/* Main Content Shell */}\\n      <div className=\\\"flex-1 flex flex-col min-w-0\\\">\\n        <TopBar\\n          activeTab={activeTab}\\n          darkMode={store.darkMode}\\n          onToggleDarkMode={() => store.setDarkMode((d) => !d)}\\n          focusMode={focusMode}\\n          onToggleFocusMode={() => setFocusMode((f) => !f)}\\n          onOpenMobileMenu={() => setMobileMenuOpen(true)}\\n        />\\n\\n        <main\\n          className={cn(\\n            \'flex-1 w-full mx-auto px-4 sm:px-6 lg:px-8 py-6\',\\n            focusMode ? \'max-w-4xl\' : \'max-w-[1440px]\'\\n          )}\\n        >\\n          {/* TAB 1: BANCO DE QUEST\303\225ES */}\\n          {activeTab === \'questoes\' && (\\n            <div\\n              className={cn(\\n                \'grid grid-cols-1 gap-6 items-start\',\\n                !focusMode && \'xl:grid-cols-12\'\\n              )}\\n            >\\n              {/* Primary Question Column */}\\n              <div\\n                className={cn(\\n                  \'space-y-5 min-w-0\',\\n                  !focusMode && \'xl:col-span-8 2xl:col-span-9\'\\n                )}\\n              >\"}, {\"AllowMultiple\":false, \"EndLine\":555, \"ReplacementContent\":\"              </div>\\n            </div>\\n          )}\\n\\n          {/* TAB 2: DESEMPENHO & MEDIANA */}\\n          {activeTab === \'desempenho\' && (\\n            <PerformanceDashboard\\n              analytics={store.analytics}\\n              darkMode={store.darkMode}\\n              targetBoard={store.targetBoard}\\n              onFilterQuestionsByTopic={handleFilterQuestionsFromPareto}\\n              onFilterFlashcardsByTopic={handleFilterFlashcardsFromPareto}\\n            />\\n          )}\\n\\n          {/* TAB 3: RANKING AO VIVO DEDICADO */}\\n          {activeTab === \'ranking\' && (\\n            <LiveRankingPage\\n              allEntries={store.liveRanking.all}\\n              currentUser={store.liveRanking.currentUser}\\n              onlineTotal={store.liveRanking.onlineTotal}\\n              profile={store.profile}\\n              onUpdateProfile={store.updateProfile}\\n              onGeneratePseudonym={store.generateRandomPseudonym}\\n              rankingPulseOn={rankingPulseOn}\\n              onToggleRankingPulse={handleToggleRankingPulse}\\n            />\\n          )}\", \"StartLine\":505, \"TargetContent\":\"              </div>\\n\\n              {/* Right Side Widget: Live Online Top 10+ Ranking (hidden in Focus Mode) */}\\n              {!focusMode && (\\n                <div className=\\\"xl:col-span-4 2xl:col-span-3 xl:sticky xl:top-22\\\">\\n                  <LiveRankingWidget\\n                    top10={store.liveRanking.top10}\\n                    currentUser={store.liveRanking.currentUser}\\n                    onlineTotal={store.liveRanking.onlineTotal}\\n                    profile={store.profile}\\n                    onUpdateProfile={store.updateProfile}\\n                    onGeneratePseudonym={store.generateRandomPseudonym}\\n                    onOpenFullRanking={() => setActiveTab(\'ranking\')}\\n                  />\\n                </div>\\n              )}\\n            </div>\\n          )}\\n\\n          {/* TAB 2: DESEMPENHO & MEDIANA */}\\n          {activeTab === \'desempenho\' && (\\n            <PerformanceDashboard\\n              analytics={store.analytics}\\n              darkMode={store.darkMode}\\n              targetBoard={store.targetBoard}\\n              onFilterQuestionsByTopic={handleFilterQuestionsFromPareto}\\n              onFilterFlashcardsByTopic={handleFilterFlashcardsFromPareto}\\n            />\\n          )}\\n\\n          {/* TAB 3: RANKING AO VIVO DEDICADO */}\\n          {activeTab === \'ranking\' && (\\n            <LiveRankingPage\\n              allEntries={store.liveRanking.all}\\n              currentUser={store.liveRanking.currentUser}\\n              onlineTotal={store.liveRanking.onlineTotal}\\n              profile={store.profile}\\n              onUpdateProfile={store.updateProfile}\\n              onGeneratePseudonym={store.generateRandomPseudonym}\\n            />\\n          )}\"}], \"TargetFile\":\"/src/App.tsx\", \"toolAction\":\"Hiding side ranking widget and wiring retractable Sidebar toggle\", \"toolSummary\":\"Update App.tsx for on-click Ranking and Sidebar toggle\"}"
