      arguments_json: "{\"Description\":\"Wire StudentVsMedianBar into QuestionCard post-answer view in Study Mode\", \"Instruction\":\"Import StudentVsMedianBar, accept benchmark props, and render the visual comparison bar in the revealed post-answer panel\", \"ReplacementChunks\":[{\"AllowMultiple\":false, \"EndLine\":28, \"ReplacementContent\":\"import { computeDifficulty, cn } from \'../../lib/utils\';\\nimport { ClinicalImageViewer } from \'./ClinicalImageViewer\';\\nimport {\\n  StudentVsMedianBar,\\n  type BenchmarkSlice,\\n} from \'./StudentVsMedianBar\';\\nimport { Button } from \'../ui/Button\';\", \"StartLine\":25, \"TargetContent\":\"import { computeDifficulty, cn } from \'../../lib/utils\';\\nimport { ClinicalImageViewer } from \'./ClinicalImageViewer\';\\nimport { Button } from \'../ui/Button\';\"}, {\"AllowMultiple\":false, \"EndLine\":48, \"ReplacementContent\":\"  onPrev: () => void;\\n  onNext: () => void;\\n  benchmarks?: {\\n    topic: BenchmarkSlice;\\n    area: BenchmarkSlice;\\n    overall: BenchmarkSlice;\\n  };\\n}\", \"StartLine\":44, \"TargetContent\":\"  onPrev: () => void;\\n  onNext: () => void;\\n}\"}, {\"AllowMultiple\":false, \"EndLine\":69, \"ReplacementContent\":\"  onPrev,\\n  onNext,\\n  benchmarks,\\n}: QuestionCardProps) {\", \"StartLine\":65, \"TargetContent\":\"  onPrev,\\n  onNext,\\n}: QuestionCardProps) {\"}, {\"AllowMultiple\":false, \"EndLine\":470, \"ReplacementContent\":\"            <div>\\n              <p className=\\\"text-xs text-slate-500 dark:text-slate-400\\\">\\n                Respostas na Plataforma\\n              </p>\\n              <p className=\\\"mt-1 inline-flex items-center gap-1.5 font-mono text-base font-semibold tabular-nums text-slate-800 dark:text-slate-200\\\">\\n                <Users className=\\\"h-4 w-4 text-slate-400\\\" />\\n                {question.totalRespostasComunidade.toLocaleString(\'pt-BR\')}\\n              </p>\\n            </div>\\n          </div>\\n\\n          {/* Immediate Student vs. Community Median Progress Comparison (Study Mode) */}\\n          {mode === \'estudo\' && benchmarks && (\\n            <StudentVsMedianBar\\n              topicBenchmark={benchmarks.topic}\\n              areaBenchmark={benchmarks.area}\\n              overallBenchmark={benchmarks.overall}\\n            />\\n          )}\", \"StartLine\":455, \"TargetContent\":\"            <div>\\n              <p className=\\\"text-xs text-slate-500 dark:text-slate-400\\\">\\n                Respostas na Plataforma\\n              </p>\\n              <p className=\\\"mt-1 inline-flex items-center gap-1.5 font-mono text-base font-semibold tabular-nums text-slate-800 dark:text-slate-200\\\">\\n                <Users className=\\\"h-4 w-4 text-slate-400\\\" />\\n                {question.totalRespostasComunidade.toLocaleString(\'pt-BR\')}\\n              </p>\\n            </div>\\n          </div>\"}], \"TargetFile\":\"/src/components/questions/QuestionCard.tsx\", \"toolAction\":\"Integrating StudentVsMedianBar in QuestionCard\", \"toolSummary\":\"Update QuestionCard with median comparison\"}"
