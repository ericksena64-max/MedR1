    tool_calls {
      id: "call_13380961175014090735"
      name: "ask_question"
      arguments_json: "{\"questions\":[{\"options\":[\"(Recommended) Matriz 2D de Incidencia x Volume de Questoes\", \"Grade por Grande Area com blocos de temas por banca\", \"Matriz Temas x Bancas (UEPA, ENARE e Geral)\"], \"question\":\"Qual formato visual voce prefere para o Mapa de Calor na aba de Desempenho?\"}, {\"options\":[\"(Recommended) Alta incidencia com baixo volume ou acerto < 70%\", \"Alta incidencia com baixo volume de questoes respondidas\", \"Qualquer tema com acerto abaixo da mediana da comunidade\"], \"question\":\"Qual criterio deve destacar um tema como lacuna critica de conhecimento?\"}, {\"options\":[\"(Recommended) Abrir resumo do tema com botoes para Questoes e Flashcards\", \"Ir direto para o Banco de Questoes filtrado no tema\", \"Apenas mostrar os dados detalhados no tooltip ao passar o mouse\"], \"question\":\"Qual acao deve ocorrer ao clicar em uma celula do Mapa de Calor?\"}], \"toolAction\":\"Asking clarifying questions about Heatmap design\", \"toolSummary\":\"Ask Heatmap preferences\"}"
