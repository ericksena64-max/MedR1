            }
            lines {
              text: "      individualReason = \'Ponto de aten\303\247\303\243o\';"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    } else if (diff > 10) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      deltaIndividual = -0.01;"
