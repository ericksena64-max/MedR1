      thinking_signature: "\022\214\006\n\211\006\001i\024}\023\327\333\276\366W\302\255#\230h\022L1h\036e&\222\306\340\b@\025\371\210\351g0\371\330\241\237\351\001W\201\225\376\326\017&\366\277:\\\316\346\374\271\372\006\260\366\207\215`2\264\366\350e\333.\004\360\312\223\370\277\206%\3565\345\375Af\312\261v\005f\377\021\342\232\213qm\331\365\214g\377\244\355\r\251\350&<\177+t,\001\332\240\230\000B\371\022]\362r2\333k\246{\037\020\343A\343b\260Uf\306CF\271j\211\027\353U\002v\341\017^\214}t\f\001i\236\335tD\003\265\257\313\226\342\277\300\024\253s\201n\240\f\301^kV\371\036\274\227\3226\ar\032\240\320\204H\353}>6\367\327\264\321\315z\266\031\005\036\201@\376\034q\021\317\374\036IH:V\356w\272t\244\331\t\034\\\002\t\r\335\327\212\b\325\f\f\372\375\232\326\215\016Gy2,:G\243G\021<}\\\225\235\336\242Yf8j\021\024\241.u\"\374\022\a\373\2108\0278\273\020Dt*\305\362+\177ba\330i\v\246\'\352\02005\017$L;\\\204c\226i\336\232\341\020x.\310,\212\273z\245Ham{\017\234\255\364(\313Pk\377\261$\353(\036\301\356\036\2365\341\aV\302\204*\262\355s<\377\335\342\222\177\302\017\220\217\'\256\223\374I \317(A\n\267\324\335\344\273b,\352\207\222.\245n4\2650\025\254N\210\224U\344\2558\"\247\321\202\363\v\352%O\250\345\332\006\226s3\253a\373\345Y\266nw\355yv\366nw6\241\204\276#\272\242&\213\203\243\353\246\214\303j\355\255\227\325T\334\210\243~\224\263s\260=\327\a;>^s\365\210\2433L\365PT\a(\314|\256\265\352\260\221\313\271L\001\257?\347\241\306\252\327\"\352,\345*.\360\0269$\240\026\320^wGC\337k\340o\337G\020\354\351\277\277\263\233\036\221\342E\f\001p\200\232Q\317\257\302\330\231H\001J_\t )<\v\337g\330T\022\252bqi\f;I3\316\307\\\022\241\344\340\"e>\315\320\2340\313G\250\267\003\305n\372H)\326L\003\302W0\237\302\\\n\214\276\321\'\266<\341\257\206\"~\370\265\202\342\266\336Fh\366\323w\271`\322\337P\362\374\321K\246\215[\314\236\226\276\";\347\t\340\271\201\021\256_j}#\2047m\243\203\345\370\351!\177\203=1y\211{S\254w\243\310\371\3675\023\006X\237\277EJ\nr\354~\246=ll&\005B>\3015\245z\225\254\213j\322\324\216\354\301\236\377\244fF\002\332\343\360m\313\364Ac\ta\275\307\261\272\232\231\372\255\333\363\223j\200\273O\277\260\372\362^\371\263)Q\325T\"\330\271\307\203\253\177/\036\0201eDyq\201\020\334\v\273\237\200S\241C\346\332\304\270\255s\345\223\375\357\236\346R"
