              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    comentarioGeral:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Os atributos da Aten\303\247\303\243o Prim\303\241ria descritos por B\303\241rbara Starfield (4 essenciais: Acesso de primeiro contato, Longitudinalidade, Integralidade, Coordena\303\247\303\243o do cuidado; 3 derivados: Orienta\303\247\303\243o familiar, Orienta\303\247\303\243o comunit\303\241ria, Compet\303\252ncia cultural) integrados aos princ\303\255pios da Lei 8.080/90 s\303\243o presen\303\247a garantida em praticamente todas as provas de Medicina Preventiva.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    perolaClinica:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'4 Atributos Essenciais da APS (Starfield): Acesso \302\267 Longitudinalidade \302\267 Integralidade \302\267 Coordena\303\247\303\243o. 3 Derivados: Orienta\303\247\303\243o Familiar \302\267 Orienta\303\247\303\243o Comunit\303\241ria \302\267 Compet\303\252ncia Cultural.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
