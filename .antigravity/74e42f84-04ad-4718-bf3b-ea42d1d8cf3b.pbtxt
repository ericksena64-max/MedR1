              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    baseRetention: BASE_DYNAMIC_RETENTION,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
