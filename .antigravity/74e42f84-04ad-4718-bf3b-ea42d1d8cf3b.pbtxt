      thinking_signature: "\022\335\016\n\332\016\001i\024}\023\201\303q\fB\271\233=6cH6\357\230\357p\300\017u\264\006\215\367\262_\323*\\\320\215\241S\316\275\322Nf?\246\376\376X\022;\275\374\361+\315\313\302\303F\352\243#\302\026\226^\226\331\235\273\003\347(\267\345\215d\273\177b\n\261\266\rw/h\2069\236\260>\230\231\244k\377I\230u\266\026kzF\217?\'\327%\272N\212\337n\214\2457$\276\266\022\373\a\301-p\343d\303\305\364p\223\275\246:h\313\271\261=d\316Og\211wD\324\314\001\0310=n\330\247\"?\242w\345/\357a\v\247\261\263V\031\363I\331V\266\223WJ\223\256 /\312x\317\301r\325\266\0320\212\006\205\354\202]\333Y\202/\366\364d{\243\324\232\264\367v\'\030\'%\037\374<\016\342\252;ee)d\240\3275\301\017I\vU\b\260\337\323\024\'\346II\000`E\205\024\375\240\356U\354\374SxAx\336\335\f\212\357\370\330\232\375\241g\240 c\2407\211\003?\203\031\203,d\364\r\325\355|\203\343\354\323\al\260\216o\336\361\351\333\302\243\000o\324@\341\270\024\177\337\365d\0318\033\221\234\357\205\356\023xu\221\320=w\234\266t\266&m.\307t\376\272\322J\220V&\274:\204A\361\356|\264\337\237CV\232\315B\275\177;)\371\270\256 \255\235\243C\232Qu\361\026\022h~L\314e\227\232S:5\025\252\306\322!\355\2329\262a\345\023\310\205\205\250\207\204\360$\'\017\225\363h\245w\037\2235B\272\022\'\361e\303\314C\226ac4\033\237RRm\215A\374\265{pc\357}\374v\316Y\315P\021\"\324\366m\004t\244\366\234C\036\020NL\252\036\237\343\323\313rOFm\f\234\355@&\215\264c@\323\216( x\333(\360\335\177k\214N\377\263~\317\320\251^\232\272g\317\270[\230\f;\347\220k3l7vHn\257\237\245\336\256\3066-9\rl?2\2077\305\370\002\344g\237={\330\0232\377\036u\372\022\314\227\216\205s\302\000\227G\331\021\326\243\360\267\264t\241\354\016_\323\373\372=\276\301\320d\257\237\327\364\250\215\f\023\230\220\277\361S\002_:\235}`\226\033<\244TO{V\f;\017\353NE6\316\202\aR=]1Q\2274\017\266^\335\035\0045\276>\330\231\240\334\'\236\363?\232p\270}\270\271D.\267\356\275\221\327\333\207(QK\244\310\030w\003\266\267\250r\252\025\000\235\311U\016\233*\321^S\274Z\305GEW\250\366\206a\3