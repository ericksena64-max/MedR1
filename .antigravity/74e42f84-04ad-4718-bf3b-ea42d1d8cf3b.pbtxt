\\ntype SortKey = \'label\' | \'answered\' | \'studentPct\' | \'communityMedianPct\' | \'delta\';\\n\\nexport function PerformanceDashboard({\\n  analytics,\\n  darkMode,\\n}: PerformanceDashboardProps) {\"}, {\"AllowMultiple\":false, \"EndLine\":531, \"ReplacementContent\":\"      </div>\\n\\n      {/* Combined Pareto (80/20) Chart + Top 3 ROI Topics */}\\n      <ParetoChart\\n        initialBoard={targetBoard}\\n        topicRows={analytics.topicRows}\\n        areaRows={analytics.areaRows}\\n        darkMode={darkMode}\\n        onFilterQuestionsByTopic={onFilterQuestionsByTopic}\\n        onFilterFlashcardsByTopic={onFilterFlashcardsByTopic}\\n      />\\n\\n      {/* Sortable Detailed Analytical Table */}\", \"StartLine\":525, \"TargetContent\":\"      </div>\\n\\n      {/* Sortable Detailed Analytical Table */}\"}], \"TargetFile\":\"/src/components/analytics/PerformanceDashboard.tsx\", \"toolAction\":\"Adding ParetoChart to PerformanceDashboard\", \"toolSummary\":\"Mount ParetoChart in PerformanceDashboard\"}"
