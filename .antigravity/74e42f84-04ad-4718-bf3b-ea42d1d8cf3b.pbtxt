        replacement_chunks {
          target_content: "          {/* Didactic Commentary Navigation + Transformar P\303\251rola em Flashcard CTA */}\n          <div className=\"space-y-4\">\n            <div className=\"flex flex-wrap items-center justify-between gap-3\">\n              <div className=\"flex flex-wrap items-center gap-1 rounded-lg bg-slate-200/70 p-1 w-fit dark:bg-slate-800\">\n                <button\n                  type=\"button\"\n                  onClick={() => setCommentTab(\'alternativas\')}\n                  className={cn(\n                    \'inline-flex items-center gap-1.5 rounded-md px-3 py-1.5 text-xs font-semibold transition-colors cursor-pointer whitespace-nowrap\',\n                    commentTab === \'alternativas\'\n                      ? \'bg-white text-slate-900 shadow-sm dark:bg-slate-950 dark:text-white\'\n                      : \'text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-200\'\n                  )}\n                >\n                  <BookOpen className=\"h-3.5 w-3.5\" />\n                  <span>Coment\303\241rio por Alternativa</span>\n                </button>\n                <button\n                  type=\"button\"\n                  onClick={() => setCommentTab(\'perola\')}\n                  className={cn(\n                    \'inline-flex items-center gap-1.5 rounded-md px-3 py-1.5 text-xs font-semibold transition-colors cursor-pointer whitespace-nowrap\',\n                    commentTab === \'perola\'\n                      ? \'bg-white text-slate-900 shadow-sm dark:bg-slate-950 dark:text-white\'\n                      : \'text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-200\'\n                  )}\n                >\n                  <Sparkles className=\"h-3.5 w-3.5\" />\n                  <span>P\303\251rola Cl\303\255nica</span>\n                </button>\n                <button\n                  type=\"button\"\n                  onClick={() => setCommentTab(\'referencias\')}\n                  className={cn(\n                    \'inline-flex items-center gap-1.5 rounded-md px-3 py-1.5 text-xs font-semibold transition-colors cursor-pointer whitespace-nowrap\',\n                    commentTab === \'referencias\'\n                      ? \'bg-white text-slate-900 shadow-sm dark:bg-slate-950 dark:text-white\'\n                      : \'text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-200\'\n                  )}\n                >\n                  <FileText className=\"h-3.5 w-3.5\" />\n                  <span>Refer\303\252ncias ({question.referencias.length})</span>\n                </button>\n              </div>\n\n              {onCreateFlashcard && (\n                hasFlashcard ? (\n                  <Button\n                    variant=\"outline\"\n                    size=\"sm\"\n                    onClick={onOpenFlashcards}\n                    className=\"border-emerald-300 bg-emerald-50/70 text-emerald-700 hover:bg-emerald-100/70 dark:border-emerald-800 dark:bg-emerald-950/40 dark:text-emerald-300 dark:hover:bg-emerald-950/70\"\n                  >\n                    <Check className=\"h-3.5 w-3.5\" />\n                    <span>Salvo nos Flashcards</span>\n                  </Button>\n                ) : (\n                  <Button\n                    variant=\"outline\"\n                    size=\"sm\"\n                    onClick={onCreateFlashcard}\n                    className=\"border-sky-300 bg-white text-sky-700 hover:bg-sky-50 dark:border-sky-800 dark:bg-slate-900 dark:text-sky-300 dark:hover:bg-sky-950/40\"\n                  >\n                    <Layers className=\"h-3.5 w-3.5\" />\n                    <span>Transformar P\303\251rola em Flashcard</span>\n                  </Button>\n                )\n              )}\n            </div>"
          replacement_content: "          {/* Didactic Commentary Navigation + Criar Flashcard CTA */}\n          <div className=\"space-y-4\">\n            <div className=\"flex flex-wrap items-center justify-between gap-3\">\n              <div className=\"flex flex-wrap items-center gap-1 rounded-lg bg-slate-200/70 p-1 w-fit dark:bg-slate-800\">\n                <button\n                  type=\"button\"\n                  onClick={() => setCommentTab(\'alternativas\')}\n                  className={cn(\n                    \'inline-flex items-center gap-1.5 rounded-md px-3 py-1.5 text-xs font-semibold transition-colors cursor-pointer whitespace-nowrap\',\n                    commentTab === \'alternativas\'\n                      ? \'bg-white text-slate-900 shadow-sm dark:bg-slate-950 dark:text-white\'\n                      : \'text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-200\'\n                  )}\n                >\n                  <BookOpen className=\"h-3.5 w-3.5\" />\n                  <span>Coment\303\241rio por Alternativa</span>\n                </button>\n                <button\n                  type=\"button\"\n                  onClick={() => setCommentTab(\'referencias\')}\n                  className={cn(\n                    \'inline-flex items-center gap-1.5 rounded-md px-3 py-1.5 text-xs font-semibold transition-colors cursor-pointer whitespace-nowrap\',\n                    commentTab === \'referencias\'\n                      ? \'bg-white text-slate-900 shadow-sm dark:bg-slate-950 dark:text-white\'\n                      : \'text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-200\'\n                  )}\n                >\n                  <FileText className=\"h-3.5 w-3.5\" />\n                  <span>Refer\303\252ncias ({question.referencias.length})</span>\n                </button>\n              </div>\n\n              {onCreateFlashcard && (\n                hasFlashcard ? (\n                  <Button\n                    variant=\"outline\"\n                    size=\"sm\"\n                    onClick={onOpenFlashcards}\n                    className=\"border-emerald-300 bg-emerald-50/70 text-emerald-700 hover:bg-emerald-100/70 dark:border-emerald-800 dark:bg-emerald-950/40 dark:text-emerald-300 dark:hover:bg-emerald-950/70\"\n                  >\n                    <Check className=\"h-3.5 w-3.5\" />\n                    <span>Salvo nos Flashcards</span>\n                  </Button>\n                ) : (\n                  <Button\n                    variant=\"outline\"\n                    size=\"sm\"\n                    onClick={onCreateFlashcard}\n                    className=\"border-sky-300 bg-white text-sky-700 hover:bg-sky-50 dark:border-sky-800 dark:bg-slate-900 dark:text-sky-300 dark:hover:bg-sky-950/40\"\n                  >\n                    <Layers className=\"h-3.5 w-3.5\" />\n                    <span>Criar Flashcard</span>\n                  </Button>\n                )\n              )}\n            </div>"
