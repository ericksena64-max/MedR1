            lines {
              text: "export function getFsrsRatingPreviews("
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  card: Flashcard,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  targetRetention: TargetRetention = DEFAULT_TARGET_RETENTION"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "): Record<SrsRating, string> {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const outcomes = computeAllFsrsOutcomes(card, targetRetention, new Date());"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  return {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    1: outcomes[1].previewLabel,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    2: outcomes[2].previewLabel,"
