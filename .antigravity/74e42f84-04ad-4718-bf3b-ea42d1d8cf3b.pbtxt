              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    totalRespostasComunidade: 1950,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    taxaAcertoGlobal: 39.5,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    comentarioGeral:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Quest\303\243o oficialmente anulada pela banca organizadora por imprecis\303\243o na pontua\303\247\303\243o do desvio \303\240 esquerda no escore MANTRELS. Utilize o filtro \"Excluir anuladas/desatualizadas\" no painel superior quando desejar treinar apenas quest\303\265es v\303\241lidas.\',"
