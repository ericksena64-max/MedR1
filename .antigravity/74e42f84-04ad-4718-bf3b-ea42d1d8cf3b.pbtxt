      name: "multi_replace_file_content"
      arguments_json: "{\"Description\":\"Integrate ExamWeightsModal and Calibrar Matriz button into FlashcardsView with instant FSRS recalculation\", \"Instruction\":\"Import Settings, ExamWeightsModal, and getBoardCustomizationCount; add modal state and weightsVersion dependency; place Calibrar Matriz button beside Banca-Alvo selector and render ExamWeightsModal in FlashcardsView.tsx\", \"ReplacementChunks\":[{\"AllowMultiple\":false, \"EndLine\":36, \"ReplacementContent\":\"  Clock,\\n  CalendarClock,\\n  SlidersHorizontal,\\n  Settings,\\n  Sparkles,\\n  BookOpen,\\n  X,\\n} from \'lucide-react\';\\nimport type {\\n  ExamBoard,\\n  Flashcard,\\n  FsrsState,\\n  GrandeAreaId,\\n  RetentionMode,\\n  SrsRating,\\n} from \'../../types/medical\';\\nimport { GRANDES_AREAS } from \'../../data/taxonomy\';\\nimport { getBoardCustomizationCount } from \'../../lib/examWeights\';\\nimport {\\n  computeAllFsrsOutcomes,\\n  formatFsrsInterval,\\n  getCardCurrentRetrievabilityPct,\\n  isCardDueToday,\\n  resolveCardRetention,\\n  type FsrsScheduleOutcome,\\n} from \'../../lib/srs\';\\nimport { ExamWeightsModal } from \'./ExamWeightsModal\';\\nimport { Button } from \'../ui/Button\';\\nimport { Select } from \'../ui/Select\';\\nimport { cn } from \'../../lib/utils\';\", \"StartLine\":9, \"TargetContent\":\"  Clock,\\n  CalendarClock,\\n  SlidersHorizontal,\\n  Sparkles,\\n  BookOpen,\\n  X,\\n} from \'lucide-react\';\\nimport type {\\n  ExamBoard,\\n  Flashcard,\\n  FsrsState,\\n  GrandeAreaId,\\n  RetentionMode,\\n  SrsRating,\\n} from \'../../types/medical\';\\nimport { GRANDES_AREAS } from \'../../data/taxonomy\';\\nimport {\\n  computeAllFsrsOutcomes,\\n  formatFsrsInterval,\\n  getCardCurrentRetrievabilityPct,\\n  isCardDueToday,\\n  resolveCardRetention,\\n  type FsrsScheduleOutcome,\\n} from \'../../lib/srs\';\\nimport { Button } from \'../ui/Button\';\\nimport { Select } from \'../ui/Select\';\\nimport { cn } from \'../../lib/utils\';\"}, {\"AllowMultiple\":false, \"EndLine\":166, \"ReplacementContent\":\"  const [sessionIndex, setSessionIndex] = useState(0);\\n  const [showCreateForm, setShowCreateForm] = useState(false);\\n  const [weightsModalOpen, setWeightsModalOpen] = useState(false);\\n  const [weightsVersion, setWeightsVersion] = useState(0);\", \"StartLine\":157, \"TargetContent\":\"  const [sessionIndex, setSessionIndex] = useState(0);\\n  const [showCreateForm, setShowCreateForm] = useState(false);\"}, {\"AllowMultiple\":false, \"EndLine\":315, \"ReplacementContent\":\"  const activeBoardCustomCount = useMemo(\\n    () => getBoardCustomizationCount(targetBoard),\\n    // eslint-disable-next-line react-hooks/exhaustive-deps\\n    [targetBoard, weightsVersion]\\n  );\\n\\n  const activeCalibration = useMemo(\\n    () =>\\n      activeCard\\n        ? resolveCardRetention(\\n            activeCard,\\n            retentionMode,\\n            targetBoard,\\n            userAccuracyByTopic,\\n            communityMedianByTopic\\n          )\\n        : null,\\n    // eslint-disable-next-line react-hooks/exhaustive-deps\\n    [\\n      activeCard,\\n      retentionMode,\\n      targetBoard,\\n      userAccuracyByTopic,\\n      communityMedianByTopic,\\n      weightsVersion,\\n    ]\\n  );\", \"StartLine\":290, \"TargetContent\":\"  const activeCalibration = useMemo(\\n    () =>\\n      activeCard\\n        ? resolveCardRetention(\\n            activeCard,\\n            retentionMode,\\n            targetBoard,\\n            userAccuracyByTopic,\\n            communityMedianByTopic\\n          )\\n        : null,\\n    [\\n      activeCard,\\n      retentionMode,\\n      targetBoard,\\n      userAccuracyByTopic,\\n      communityMedianByTopic,\\n    ]\\n  );\"}, {\"AllowMultiple\":false, \"EndLine\":455, \"ReplacementContent\":\"            {/* Banca-Alvo Selector (UEPA, ENARE, Geral) + Calibrar Matriz Modal Trigger */}\\n            <div className=\\\"flex flex-wrap items-center gap-2\\\">\\n              <span className=\\\"text-xs text-slate-500 dark:text-slate-400 whitespace-nowrap\\\">\\n                Banca-Alvo:\\n              </span>\\n              <div\\n                role=\\\"group\\\"\\n                aria-label=\\\"Selecionar banca-alvo para calibra\303\247\303\243o FSRS\\\"\\n                className=\\\"inline-flex rounded-lg border border-slate-200 bg-slate-50 p-0.5 dark:border-slate-700 dark:bg-slate-950/60\\\"\\n              >\\n                {BOARD_OPTIONS.map((opt) => {\\n                  const active = targetBoard === opt.value;\\n                  return (\\n                    <button\\n                      key={opt.value}\\n                      type=\\\"button\\\"\\n                      onClick={() => onChangeTargetBoard(opt.value)}\\n                      aria-pressed={active}\\n                      className={cn(\\n                        \'rounded-md px-2.5 py-1 text-[11px] font-semibold transition-colors cursor-pointer whitespace-nowrap\',\\n                        active\\n                          ? retentionMode === \'dinamica\'\\n                            ? \'bg-white text-sky-700 shadow-sm dark:bg-slate-800 dark:text-sky-300\'\\n                            : \'bg-white text-slate-800 shadow-sm dark:bg-slate-800 dark:text-slate-200\'\\n                          : \'text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-200\'\\n                      )}\\n                    >\\n                      {opt.label}\\n                    </button>\\n                  );\\n                })}\\n              </div>\\n\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => setWeightsModalOpen(true)}\\n                className=\\\"inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-2.5 py-1.5 text-[11px] font-semibold text-slate-700 hover:border-sky-300 hover:bg-sky-50/70 hover:text-sky-800 dark:border-slate-700 dark:bg-slate-950/60 dark:text-slate-200 dark:hover:border-sky-700 dark:hover:bg-sky-950/40 dark:hover:text-sky-300 transition-colors cursor-pointer whitespace-nowrap focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-500\\\"\\n                title=\\\"Configurar matriz de incid\303\252ncia por banca (UEPA, ENARE, Geral)\\\"\\n              >\\n                <Settings className=\\\"h-3.5 w-3.5 text-slate-500 dark:text-slate-400\\\" />\\n                <span>Calibrar Matriz</span>\\n                {activeBoardCustomCount > 0 && (\\n                  <span className=\\\"font-mono text-[10px] font-bold text-sky-600 dark:text-sky-400 tabular-nums\\\">\\n                    ({activeBoardCustomCount})\\n                  </span>\\n                )}\\n              </button>\\n            </div>\", \"StartLine\":410, \"TargetContent\":\"            {/* Banca-Alvo Selector (UEPA, ENARE, Geral) */}\\n            <div className=\\\"flex items-center gap-2\\\">\\n              <span className=\\\"text-xs text-slate-500 dark:text-slate-400 whitespace-nowrap\\\">\\n                Banca-Alvo:\\n              </span>\\n              <div\\n                role=\\\"group\\\"\\n                aria-label=\\\"Selecionar banca-alvo para calibra\303\247\303\243o FSRS\\\"\\n                className=\\\"inline-flex rounded-lg border border-slate-200 bg-slate-50 p-0.5 dark:border-slate-700 dark:bg-slate-950/60\\\"\\n              >\\n                {BOARD_OPTIONS.map((opt) => {\\n                  const active = targetBoard === opt.value;\\n                  return (\\n                    <button\\n                      key={opt.value}\\n                      type=\\\"button\\\"\\n                      onClick={() => onChangeTargetBoard(opt.value)}\\n                      aria-pressed={active}\\n                      className={cn(\\n                        \'rounded-md px-2.5 py-1 text-[11px] font-semibold transition-colors cursor-pointer whitespace-nowrap\',\\n                        active\\n                          ? retentionMode === \'dinamica\'\\n                            ? \'bg-white text-sky-700 shadow-sm dark:bg-slate-800 dark:text-sky-300\'\\n                            : \'bg-white text-slate-800 shadow-sm dark:bg-slate-800 dark:text-slate-200\'\\n                          : \'text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-200\'\\n                      )}\\n                    >\\n                      {opt.label}\\n                    </button>\\n                  );\\n                })}\\n              </div>\\n            </div>\"}, {\"AllowMultiple\":false, \"EndLine\":1199, \"ReplacementContent\":\"        </section>\\n      )}\\n\\n      {/* Interactive Exam Incidence Matrix Modal */}\\n      <ExamWeightsModal\\n        open={weightsModalOpen}\\n        initialBoard={targetBoard}\\n        onClose={() => {\\n          setWeightsModalOpen(false);\\n          setWeightsVersion((v) => v + 1);\\n        }}\\n        onWeightsChange={() => setWeightsVersion((v) => v + 1)}\\n      />\\n    </div>\\n  );\\n}\", \"StartLine\":1185, \"TargetContent\":\"        </section>\\n      )}\\n    </div>\\n  );\\n}\"}], \"TargetFile\":\"/src/components/flashcards/FlashcardsView.tsx\", \"toolAction\":\"Integrating Calibrar Matriz modal into FlashcardsView\", \"toolSummary\":\"Integrate Calibrar Matriz modal into FlashcardsView\"}"
