            lines {
              text: "    comentarioGeral:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'A pegadinha cl\303\241ssica da Cetoacidose Diab\303\251tica est\303\241 no pot\303\241ssio! Apesar de o paciente com CAD ter sempre d\303\251ficit corporal total de pot\303\241ssio, o valor s\303\251rico inicial pode estar alto, normal ou baixo. Se K\342\201\272 < 3,3 mEq/L (ADA 2024 sugere < 3,5 mEq/L), NUNCA inicie insulina antes de repor K\342\201\272.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    perolaClinica:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Regra do K\342\201\272 na CAD: K\342\201\272 < 3,3 \342\206\222 SEGURA a insulina e rep\303\265e K\342\201\272! K\342\201\272 entre 3,3 e 5,2 \342\206\222 Insulina + rep\303\265e K\342\201\272 no soro. K\342\201\272 > 5,2 \342\206\222 Insulina sem repor K\342\201\272 e reavalia em 2h. Bicarbonato s\303\263 se pH < 6,9!\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    referencias: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
