    execution_id: "74e42f84-04ad-4718-bf3b-ea42d1d8cf3b"
    requested_model {
      model: MODEL_GOOGLE_GEMINI_INTERNAL_BYOM
    }
    source_trajectory_step_info {
      trajectory_id: "74e42f84-04ad-4718-bf3b-ea42d1d8cf3b"
