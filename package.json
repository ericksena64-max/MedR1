  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "NODE_ENV=production node server.mjs",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=server.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.mjs",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "db:seed:questions": "tsx scripts/seed_questions_postgres.ts",
    "db:seed:questions:dry": "tsx scripts/seed_questions_postgres.ts --dry-run",
    "assets:webp": "node scripts/optimize_exam_images.mjs",
    "assets:webp:dry": "node scripts/optimize_exam_images.mjs --dry-run"
  },
  "dependencies": {
